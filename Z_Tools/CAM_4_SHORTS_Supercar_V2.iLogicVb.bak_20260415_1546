' ------------------------------------------------------------------------------------------
oCam.PerspectiveAngle = 0.4 ' Hệ trục góc độ hẹp
Dim framesC3 As Integer = 45
For i As Integer = 1 To framesC3
    Dim p As Double = i / framesC3 
    
    Dim camX = minX - dx * 0.5 + (p * dx * 2.0)
    Dim camY = cy + dy * 0.1
    Dim camZ = cz + max_dim * 0.7
    
    oCam.Eye = tg.CreatePoint(camX, camY, camZ)
    oCam.Target = tg.CreatePoint(cx, cy, cz) ' Target dịch chuyển cùng Eye để tạo sự tịnh tiến thuần
