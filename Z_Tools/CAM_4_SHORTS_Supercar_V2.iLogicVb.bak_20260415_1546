' ------------------------------------------------------------------------------------------
' 🎬 CẢNH 4 (5.5S -> 7.5S): KHÚC CUA BO DRIFT (Corner Drift)
' Lấy đà bẻ cua mượt ở góc máy thấp, mô phỏng xe thể thao bo góc cua gắt.
' ------------------------------------------------------------------------------------------
oCam.PerspectiveAngle = 0.8
Dim framesC4 As Integer = 60
For i As Integer = 1 To framesC4
    Dim t As Double = i / framesC4
    Dim p As Double = Math.Sin(t * Math.PI / 2) 
    
    ' Đi từ góc X-, Z+ trượt vòng sang mặt X+, Z+
    Dim startAng = Math.PI * 0.75
    Dim endAng = Math.PI * 0.1
    Dim angle = startAng + (endAng - startAng) * p
    
    Dim R = max_dim * 1.1
    Dim camY = minY + dy * 0.15 + Math.Sin(p * Math.PI) * dy * 0.3 ' Nhấp nhô bồng bềnh
    
    oCam.Eye = tg.CreatePoint(cx + R * Math.Cos(angle), camY, cz + R * Math.Sin(angle))
    oCam.Target = tg.CreatePoint(cx, cy, cz)
    oCam.UpVector = tg.CreateUnitVector(0, 1, 0)
    oCam.UpVector = tg.CreateUnitVector(0, 1, 0) : oCam.ApplyWithoutTransition()
