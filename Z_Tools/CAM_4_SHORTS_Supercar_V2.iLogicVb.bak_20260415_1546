    Dim angle = t * Math.PI * -1.5 ' Xoáy ngược chiều kim đồng hồ
    
    Dim R = max_dim * 0.4 * (1 - t) ' Hút sát vào lốc xoáy
    Dim camY = maxY + max_dim * 1.2 - (t * max_dim * 0.6) 
    
    oCam.Eye = tg.CreatePoint(cx + R * Math.Cos(angle), camY, cz + R * Math.Sin(angle))
    oCam.Target = tg.CreatePoint(cx, cy, cz)
    
    ' Trục quay bị bẻ gãy khi xoắn vào mắt bão
    oCam.UpVector = tg.CreateUnitVector(0, 1, 0)
    oCam.UpVector = tg.CreateUnitVector(0, 1, 0) : oCam.ApplyWithoutTransition()
