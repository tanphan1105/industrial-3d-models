' ------------------------------------------------------------------------------------------
' 🎬 CẢNH CUỐI: FIT CHIỀU NGANG CHÍNH XÁC (Horizontal-Fit 9:16)
' Thuật toán: project BBox → Right vector → tính D chuẩn theo hFOV
' ------------------------------------------------------------------------------------------
Dim fFOV As Double = 0.75  ' Vertical FOV cố định cho cảnh chốt (radian)
oCam.PerspectiveAngle = fFOV

' Tính góc ngang (Horizontal FOV half) tương ứng khung 1080x1920 (9:16)
Dim hFovHalf As Double = Math.Atan(Math.Tan(fFOV / 2.0) * 1080.0 / 1920.0)

' Vị trí Eye ở frame cuối cảnh 8 (điểm xuất phát pull-out)
Dim sEX = oCam.Eye.X, sEY = oCam.Eye.Y, sEZ = oCam.Eye.Z

' Vector đơn vị hướng nhìn: Eye → Center
Dim diffX = cx - sEX, diffY = cy - sEY, diffZ = cz - sEZ
Dim srcDist = Math.Sqrt(diffX*diffX + diffY*diffY + diffZ*diffZ)
If srcDist < 0.001 Then srcDist = 1.0
Dim ndX = diffX/srcDist, ndY = diffY/srcDist, ndZ = diffZ/srcDist

' Right vector (vuông góc ViewDir & UpVec(0,1,0))
' cross(ViewDir, Up) = (-ndZ, 0, ndX)
Dim rX = -ndZ, rY As Double = 0.0, rZ = ndX
Dim rLen = Math.Sqrt(rX*rX + rZ*rZ)
If rLen < 0.001 Then rLen = 1.0
rX /= rLen : rZ /= rLen

' Project 4 góc đáy BBox lên Right vector → tìm halfWidth thực trên màn hình
Dim bxArr(1) As Double : bxArr(0) = minX : bxArr(1) = maxX
Dim bzArr(1) As Double : bzArr(0) = minZ : bzArr(1) = maxZ
Dim pMin As Double = 1.0E+30, pMax As Double = -1.0E+30
For ix As Integer = 0 To 1
    For iz As Integer = 0 To 1
        Dim proj As Double = rX * bxArr(ix) + rZ * bzArr(iz)
        If proj < pMin Then pMin = proj
        If proj > pMax Then pMax = proj
    Next
Next
Dim halfWidth As Double = (pMax - pMin) / 2.0

' Khoảng cách fit chiều ngang = halfWidth / tan(hFovHalf) + 8% padding
Dim D_fit As Double = halfWidth / Math.Tan(hFovHalf) * 1.08

' Điểm cuối: đặt camera ra theo hướng ngược ViewDir, target về center
Dim eEX = cx - ndX * D_fit
Dim eEY = cy - ndY * D_fit
Dim eEZ = cz - ndZ * D_fit

' Animate 80 frames Smooth Ease-Out
Dim fcF As Integer = 80
For j As Integer = 1 To fcF
    Dim p As Double = j / fcF
    Dim sm As Double = p * p * (3 - 2 * p)
    oCam.Eye = tg.CreatePoint(sEX + (eEX-sEX)*sm, sEY + (eEY-sEY)*sm, sEZ + (eEZ-sEZ)*sm)
    oCam.Target = tg.CreatePoint(cx, cy, cz)
    oCam.UpVector = tg.CreateUnitVector(0, 1, 0) : oCam.ApplyWithoutTransition()
    oApp.UserInterfaceManager.DoEvents()
    oCam.SaveAsBitmap(saveFolder & "\frame_" & frameCount.ToString("0000") & ".png", 1080, 1920) : frameCount += 1
    ThisApplication.UserInterfaceManager.DoEvents() : If System.Windows.Input.Keyboard.IsKeyDown(System.Windows.Input.Key.Escape) Then : MessageBox.Show("🛑 Emergency Stop!") : GoTo RestoreCamera : End If
Next

' ------------------------------------------------------------------------------------------
' 🔄 LOOP BRIDGE (45f): FitToView → Scene 1 Start → Seamless YouTube Loop
' ------------------------------------------------------------------------------------------
Dim lbSX As Double = oCam.Eye.X, lbSY As Double = oCam.Eye.Y, lbSZ As Double = oCam.Eye.Z
Dim lbEX As Double = cx + max_dim * 0.1    ' Scene 1: Macro Pull-Out start
Dim lbEY As Double = cy
Dim lbEZ As Double = cz + max_dim * 0.55
Dim lbPeak As Double = Math.Max(lbSY, lbEY) + max_dim * 0.4
Dim lbN As Integer = 45
For j As Integer = 1 To lbN
    Dim p As Double = j / lbN
    Dim sm As Double = p * p * (3 - 2 * p)
    Dim arcY As Double = lbSY + (lbEY - lbSY) * sm + Math.Sin(p * Math.PI) * (lbPeak - Math.Max(lbSY, lbEY))
    oCam.Eye = tg.CreatePoint(lbSX + (lbEX - lbSX) * sm, arcY, lbSZ + (lbEZ - lbSZ) * sm)
    oCam.Target = tg.CreatePoint(cx, cy, cz)
    oCam.UpVector = tg.CreateUnitVector(0, 1, 0) : oCam.ApplyWithoutTransition()
    oApp.UserInterfaceManager.DoEvents()
    oCam.SaveAsBitmap(saveFolder & "\frame_" & frameCount.ToString("0000") & ".png", 1080, 1920) : frameCount += 1
    ThisApplication.UserInterfaceManager.DoEvents() : If System.Windows.Input.Keyboard.IsKeyDown(System.Windows.Input.Key.Escape) Then : MessageBox.Show("🛑 Emergency Stop!") : GoTo RestoreCamera : End If
Next

