' ------------------------------------------------------------------------------------------
' 🎬 CẢNH 6 (9S -> 11S): CẮN ĐUÔI PHANH GẤP (Predator Chasing)
' Zoom thẳng vào mặt lưng của thiết bị với gia tốc cực lớn, thắng két ở khung cuối
' ------------------------------------------------------------------------------------------
oCam.PerspectiveAngle = 0.6 
Dim framesC6 As Integer = 60
For i As Integer = 1 To framesC6
    Dim t As Double = i / framesC6
    Dim p As Double = 1 - Math.Pow(1 - t, 3) ' Ease out mạnh (Thắng gấp)
    
    Dim camX = cx
    Dim camY = cy - dy * 0.1 + p * dy * 0.4
    Dim camZ = minZ - max_dim * 2.0 + p * max_dim * 1.5 ' Rượt mạnh từ mặt sau thiết bị (Zoom In vào Z-)
    
    oCam.Eye = tg.CreatePoint(camX, camY, camZ)
    oCam.Target = tg.CreatePoint(cx, cy, cz)
    oCam.UpVector = tg.CreateUnitVector(0, 1, 0)
