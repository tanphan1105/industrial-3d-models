' ------------------------------------------------------------------------------------------
' 🎬 CẢNH 2 (2S -> 4S): NHÀO LỘN TỬ THẦN (Kamikaze Dive)
' Rơi tự do từ đỉnh trên cao xuống chân công trình kết hợp xoáy nòng súng.
' ------------------------------------------------------------------------------------------
oCam.PerspectiveAngle = 0.75
Dim framesC2 As Integer = 60
For i As Integer = 1 To framesC2
    Dim t As Double = i / framesC2
    Dim p As Double = Math.Pow(t, 1.5)
    
    Dim R = max_dim * 1.0 - (p * max_dim * 0.3) ' Hút vào nhưng dừng lại vòng ngoài (0.7 max_dim)
    Dim camX = cx + R * 0.707
    Dim camZ = cz - R * 0.707
    Dim camY = maxY + max_dim * 1.0 - (p * (max_dim * 0.8))
    
    oCam.Eye = tg.CreatePoint(camX, camY, camZ)
    oCam.Target = tg.CreatePoint(cx, cy, cz)
    ' Xoáy nòng súng nhẹ rồi trả về thăng bằng
    Dim roll = Math.Sin(t * Math.PI) * 0.5
    oCam.UpVector = tg.CreateUnitVector(0, 1, 0)
    oCam.UpVector = tg.CreateUnitVector(0, 1, 0) : oCam.ApplyWithoutTransition()
