' ------------------------------------------------------------------------------------------
' 🎬 CẢNH 1 (0 -> 2S): TỈNH GIẤC TỪ TRÁI TIM (Macro Pull-Out)
' Zoom cực sâu bên trong thiết bị, lùi nhanh tốc độ để hút mắt người xem.
' ------------------------------------------------------------------------------------------
oCam.Perspective = True
oCam.PerspectiveAngle = 1.6 ' Góc cực rộng, biến dạng mắt cá nhẹ
Dim framesC1 As Integer = 60
For i As Integer = 1 To framesC1
