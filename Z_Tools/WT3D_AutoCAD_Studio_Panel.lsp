  (setq s (wt3d-rep (strcat "E" (chr 207)) "\U+1EB8" s))
  (setq s (wt3d-rep (strcat "e" (chr 249)) "\U+00E9" s))
  (setq s (wt3d-rep (strcat "e" (chr 248)) "\U+00E8" s))
  (setq s (wt3d-rep (strcat "e" (chr 251)) "\U+1EBB" s))
  (setq s (wt3d-rep (strcat "e" (chr 245)) "\U+1EBD" s))
  (setq s (wt3d-rep (strcat "e" (chr 239)) "\U+1EB9" s))
  ;; O
  (setq s (wt3d-rep (strcat "O" (chr 217)) "\U+00D3" s))
  (setq s (wt3d-rep (strcat "O" (chr 216)) "\U+00D2" s))
