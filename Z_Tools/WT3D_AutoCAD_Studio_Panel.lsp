  (setq s (wt3d-rep (strcat "o" (chr 245)) "\U+00F5" s))
  (setq s (wt3d-rep (strcat "o" (chr 239)) "\U+1ECD" s))
  ;; U
  (setq s (wt3d-rep (strcat "U" (chr 217)) "\U+00DA" s))
  (setq s (wt3d-rep (strcat "U" (chr 216)) "\U+00D9" s))
  (setq s (wt3d-rep (strcat "U" (chr 219)) "\U+1EE6" s))
  (setq s (wt3d-rep (strcat "U" (chr 213)) "\U+0168" s))
  (setq s (wt3d-rep (strcat "U" (chr 207)) "\U+1EE4" s))
  (setq s (wt3d-rep (strcat "u" (chr 249)) "\U+00FA" s))
