  (setq s (wt3d-rep (strcat "E" (chr 217)) "\U+00C9" s))
  (setq s (wt3d-rep (strcat "E" (chr 216)) "\U+00C8" s))
  (setq s (wt3d-rep (strcat "E" (chr 219)) "\U+1EBA" s))
