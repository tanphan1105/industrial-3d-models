  (setq s (wt3d-rep (strcat "A" (chr 217)) "\U+00C1" s))
  (setq s (wt3d-rep (strcat "A" (chr 216)) "\U+00C0" s))
  (setq s (wt3d-rep (strcat "A" (chr 219)) "\U+1EA2" s))
  (setq s (wt3d-rep (strcat "A" (chr 213)) "\U+00C3" s))
  (setq s (wt3d-rep (strcat "A" (chr 207)) "\U+1EA0" s))
  (setq s (wt3d-rep (strcat "a" (chr 249)) "\U+00E1" s))
  (setq s (wt3d-rep (strcat "a" (chr 248)) "\U+00E0" s))
  (setq s (wt3d-rep (strcat "a" (chr 251)) "\U+1EA3" s))
  (setq s (wt3d-rep (strcat "a" (chr 245)) "\U+00E3" s))
  (setq s (wt3d-rep (strcat "a" (chr 239)) "\U+1EA1" s))
