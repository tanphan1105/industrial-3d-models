{
  "manifest_version": 3,
  "name": "WT3D CGModel (CG模型网) 1-Click Auto-Fill Studio",
  "version": "1.0.0",
  "description": "Tu dong dien Title Song Ngu Trung-Anh, Mo ta ky thuat, Tags, Gia ¥ RMB (80% Thuc nhan) va ho tro Upload cho CGModel.com",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "tabs"
  ],
  "host_permissions": [
    "https://www.cgmodel.com/*",
    "http://127.0.0.1:18888/*",
    "http://localhost:18888/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.cgmodel.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}