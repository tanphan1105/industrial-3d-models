            AddHandler btnOk.Click, Sub(sender As Object, e As EventArgs) form.Close()
            AddHandler btnCancel.Click, Sub(sender As Object, e As EventArgs) form.Close()

            ' ==================================================================
            ' ĐỒNG BỘ 2 CHIỀU: PRESET <---> CÁC Ô THAM SỐ & HUD GIẢI THÍCH
            ' ==================================================================
            Dim isUpdatingPreset As Boolean = False
            Dim isUpdatingFromCustom As Boolean = False

            Dim applyPreset As Action(Of Integer) = Sub(targetIdx As Integer)
                If targetIdx < 0 OrElse targetIdx >= presets.Count Then Return
                Dim p As SupercarPreset = presets(targetIdx)

                isUpdatingPreset = True

                numDur.Value = CDec(p.Duration)
                numFar.Value = CDec(p.FarScale)
                numNear1.Value = CDec(p.Near1Scale)
                numNear2.Value = CDec(p.Near2Scale)
                numRelease.Value = CDec(p.ReleaseBoost)
                numSweep.Value = CDec(p.SweepDeg)
                numOrganic.Value = CDec(p.OrganicBiasDeg)

                numFast.Value = CDec(p.FastMul)
                numHold.Value = CDec(p.HoldMul)
                numHoldSpeed.Value = CDec(p.HoldSpeedPct)

                numFovFar.Value = CDec(p.FovFar)
                numFovFast.Value = CDec(p.FovFast)
                numFovNear.Value = CDec(p.FovNear)
                numFovReveal.Value = CDec(p.FovReveal)
                numBank.Value = CDec(p.MaxBank)
                numBankGain.Value = CDec(p.BankGain)

                chkBlur.Checked = p.MotionBlur
                numShutter.Value = CDec(p.Shutter)

                ' Update CurveStyle
                If p.CurveStyle = "OPTION_C" Then
                    cboCurve.SelectedIndex = 2
                ElseIf p.CurveStyle = "OPTION_B" Then
                    cboCurve.SelectedIndex = 1
                Else
                    cboCurve.SelectedIndex = 0
                End If

                ' Highlight active Chip Button
                For bIdx As Integer = 0 To chipButtons.Count - 1
                    If bIdx = targetIdx Then
                        chipButtons(bIdx).BackColor = System.Drawing.Color.FromArgb(27, 122, 62)
                        chipButtons(bIdx).ForeColor = System.Drawing.Color.White
                        chipButtons(bIdx).FlatAppearance.BorderColor = System.Drawing.Color.FromArgb(20, 95, 48)
                    Else
                        chipButtons(bIdx).BackColor = System.Drawing.Color.FromArgb(248, 249, 250)
                        chipButtons(bIdx).ForeColor = System.Drawing.Color.FromArgb(50, 50, 50)
                        chipButtons(bIdx).FlatAppearance.BorderColor = System.Drawing.Color.FromArgb(215, 215, 215)
                    End If
                Next

                ' Update Live Explainer HUD
                txtExplain.Clear()
                txtExplain.SelectionColor = System.Drawing.Color.FromArgb(27, 122, 62)
                txtExplain.SelectionFont = New System.Drawing.Font("Segoe UI", 9.0!, FontStyle.Bold)
                txtExplain.AppendText(p.VisualFeeling & vbCrLf)

                txtExplain.SelectionColor = System.Drawing.Color.FromArgb(30, 41, 59)
                txtExplain.SelectionFont = New System.Drawing.Font("Segoe UI", 8.5!, FontStyle.Regular)
                txtExplain.AppendText(p.SpeedTactics & vbCrLf)
                txtExplain.AppendText(p.DistanceTactics & " | " & p.BankTactics & vbCrLf)
                txtExplain.SelectionColor = System.Drawing.Color.FromArgb(20, 95, 48)
                txtExplain.SelectionFont = New System.Drawing.Font("Segoe UI", 8.5!, FontStyle.Bold)
                txtExplain.AppendText(p.CurveTactics)

                ' Update contrast label
                Dim ratio As Double = (CDbl(numFast.Value) / Math.Max(0.01, CDbl(numHoldSpeed.Value) / 100.0))
                lblSpeedContrast.Text = String.Format("ĐỘ TƯƠNG PHẢN TỐC ĐỘ: {0:F1}x (Bổ nhào {1:F1}x / Hãm dừng {2:F0}%)" & vbCrLf & _
                                                      "Nhịp thở cự ly: Xa {3:F2}x -> Nhịp 1 {4:F2}x -> Ép sát {5:F2}x (Bung {6:F2}x)", _
                                                      ratio, numFast.Value, numHoldSpeed.Value, numFar.Value, numNear1.Value, numNear2.Value, numRelease.Value)

                isUpdatingPreset = False
            End Sub

            ' ComboBox Selection Handler
            AddHandler cboPresets.SelectedIndexChanged, Sub(sender As Object, e As EventArgs)
                If isUpdatingFromCustom Then Return
                applyPreset(cboPresets.SelectedIndex)
            End Sub

            ' Chip Buttons Click Handlers
            For Each btn As System.Windows.Forms.Button In chipButtons
                Dim capturedIdx As Integer = CInt(btn.Tag)
                AddHandler btn.Click, Sub(sender As Object, e As EventArgs)
                    cboPresets.SelectedIndex = capturedIdx
                End Sub
            Next

            ' ValueChanged handlers on all numeric inputs
            Dim onCustomValueChanged As EventHandler = Sub(sender As Object, e As EventArgs)
                If isUpdatingPreset Then Return
                isUpdatingFromCustom = True

                ' Switch to Custom preset (index 5)
                cboPresets.SelectedIndex = 5

                For bIdx As Integer = 0 To chipButtons.Count - 1
                    If bIdx = 5 Then
                        chipButtons(bIdx).BackColor = System.Drawing.Color.FromArgb(27, 122, 62)
                        chipButtons(bIdx).ForeColor = System.Drawing.Color.White
                    Else
                        chipButtons(bIdx).BackColor = System.Drawing.Color.FromArgb(248, 249, 250)
                        chipButtons(bIdx).ForeColor = System.Drawing.Color.FromArgb(50, 50, 50)
                    End If
                Next

                Dim ratio As Double = (CDbl(numFast.Value) / Math.Max(0.01, CDbl(numHoldSpeed.Value) / 100.0))
                lblSpeedContrast.Text = String.Format("ĐỘ TƯƠNG PHẢN TỐC ĐỘ: {0:F1}x (Bổ nhào {1:F1}x / Hãm dừng {2:F0}%)" & vbCrLf & _
                                                      "Nhịp thở cự ly: Xa {3:F2}x -> Nhịp 1 {4:F2}x -> Ép sát {5:F2}x (Bung {6:F2}x)", _
                                                      ratio, numFast.Value, numHoldSpeed.Value, numFar.Value, numNear1.Value, numNear2.Value, numRelease.Value)

                txtExplain.Clear()
                txtExplain.SelectionColor = System.Drawing.Color.FromArgb(27, 122, 62)
                txtExplain.SelectionFont = New System.Drawing.Font("Segoe UI", 9.0!, FontStyle.Bold)
                txtExplain.AppendText("🎛️ BẠN ĐANG TÙY CHỈNH THỦ CÔNG CÁC THAM SỐ:" & vbCrLf)
                txtExplain.SelectionColor = System.Drawing.Color.FromArgb(30, 41, 59)
                txtExplain.SelectionFont = New System.Drawing.Font("Segoe UI", 8.5!, FontStyle.Regular)
                txtExplain.AppendText(String.Format("• Tốc độ: Bổ nhào {0:F2}x | Dừng ngắm {1:F2}x | Tốc độ tại Hero {2:F0}%." & vbCrLf, numFast.Value, numHold.Value, numHoldSpeed.Value))
                txtExplain.AppendText(String.Format("• Cự ly: Xa {0:F2}x -> Nhịp 1 {1:F2}x -> Ép sát {2:F2}x | Góc quét {3:F0}° | Nghiêng ngân {4:F1}°.", numFar.Value, numNear1.Value, numNear2.Value, numSweep.Value, numBank.Value))

                isUpdatingFromCustom = False
            End Sub

            Dim wireCustom As Action(Of Object) = Sub(ctrl As Object)
                If TypeOf ctrl Is NumericUpDown Then
                    AddHandler DirectCast(ctrl, NumericUpDown).ValueChanged, Sub(s As Object, e As EventArgs) onCustomValueChanged(s, e)
                ElseIf TypeOf ctrl Is CheckBox Then
                    AddHandler DirectCast(ctrl, CheckBox).CheckedChanged, Sub(s As Object, e As EventArgs) onCustomValueChanged(s, e)
                End If
            End Sub

            wireCustom(numDur)
            wireCustom(numFar)
            wireCustom(numNear1)
            wireCustom(numNear2)
            wireCustom(numRelease)
            wireCustom(numSweep)
            wireCustom(numOrganic)
            wireCustom(numFast)
            wireCustom(numHold)
            wireCustom(numHoldSpeed)
            wireCustom(numFovFar)
            wireCustom(numFovFast)
            wireCustom(numFovNear)
            wireCustom(numFovReveal)
            wireCustom(numBank)
            wireCustom(numBankGain)
            wireCustom(chkBlur)
            wireCustom(numShutter)

            Dim updateCurveButtons As Action = Sub()
                btnCurveA.BackColor = If(cboCurve.SelectedIndex = 0, System.Drawing.Color.FromArgb(27, 122, 62), System.Drawing.Color.FromArgb(248, 249, 250))
                btnCurveA.ForeColor = If(cboCurve.SelectedIndex = 0, System.Drawing.Color.White, System.Drawing.Color.FromArgb(50, 50, 50))
                btnCurveB.BackColor = If(cboCurve.SelectedIndex = 1, System.Drawing.Color.FromArgb(27, 122, 62), System.Drawing.Color.FromArgb(248, 249, 250))
                btnCurveB.ForeColor = If(cboCurve.SelectedIndex = 1, System.Drawing.Color.White, System.Drawing.Color.FromArgb(50, 50, 50))
                btnCurveC.BackColor = If(cboCurve.SelectedIndex = 2, System.Drawing.Color.FromArgb(27, 122, 62), System.Drawing.Color.FromArgb(248, 249, 250))
                btnCurveC.ForeColor = If(cboCurve.SelectedIndex = 2, System.Drawing.Color.White, System.Drawing.Color.FromArgb(50, 50, 50))

                Dim styleCode As String = "OPTION_A"
                If cboCurve.SelectedIndex = 1 Then styleCode = "OPTION_B"
                If cboCurve.SelectedIndex = 2 Then styleCode = "OPTION_C"
                settings.CurveStyle = styleCode
            End Sub

            AddHandler cboCurve.SelectedIndexChanged, Sub(s As Object, e As EventArgs)
                updateCurveButtons()
            End Sub
            AddHandler btnCurveA.Click, Sub(s As Object, e As EventArgs)
                cboCurve.SelectedIndex = 0
            End Sub
            AddHandler btnCurveB.Click, Sub(s As Object, e As EventArgs)
                cboCurve.SelectedIndex = 1
            End Sub
            AddHandler btnCurveC.Click, Sub(s As Object, e As EventArgs)
                cboCurve.SelectedIndex = 2
            End Sub

            ' ==================================================================
            ' TOOLTIPS TIẾNG VIỆT HƯỚNG DẪN CHI TIẾT TỪNG THAM SỐ
            ' ==================================================================
            Dim tip As New System.Windows.Forms.ToolTip()
            tip.AutoPopDelay = 10000
            tip.InitialDelay = 350
            tip.ReshowDelay = 150
            tip.ShowAlways = True

            tip.SetToolTip(cboPresets, "Chọn chế độ quay siêu xe dựng sẵn: Tự động nạp toàn bộ tham số tối ưu và giải thích cơ chế hoạt động.")
            tip.SetToolTip(numFast, "Bội số bứt tốc khi bổ nhào và thoát ra (x). Càng lớn (>1.5x), camera lao vút tới và vút bay ra ngoài càng nhanh xé gió.")
            tip.SetToolTip(numHold, "Hệ số thời gian dừng ngắm Hero (x). Càng lớn (>1.5x), camera lơ lửng quanh linh kiện càng lâu để người xem quan sát.")
            tip.SetToolTip(numHoldSpeed, "% Tốc độ tối thiểu tại điểm dừng ngắm. Càng nhỏ (5-10%), camera khựng lại càng giống slow-motion đóng băng thời gian.")
            tip.SetToolTip(numFar, "Khoảng cách camera ở trạng thái bình thường (bội số bán kính Hero). 2.0-2.5x là cự ly chuẩn mắt nhìn điện ảnh.")
            tip.SetToolTip(numNear1, "Cự ly tiếp cận ở nhịp 1 (x Hero). Nhịp lướt sườn thăm dò linh kiện.")
            tip.SetToolTip(numNear2, "Cự ly ép sát sạt ở nhịp 2 (x Hero). Càng nhỏ (0.4-0.6x), camera áp sát bề mặt càng kịch tính, thấy rõ từng con ốc.")
            tip.SetToolTip(numRelease, "Độ bung lùi ra xa giữa 2 nhịp ép sát (x). Tạo nhịp thở nhấp nhô xa-gần, tránh camera bị dính chặt vào mô hình.")
            tip.SetToolTip(numSweep, "Góc quét quỹ đạo quanh mỗi chi tiết Hero (độ). 140-200° ôm trọn các khúc cua của cụm máy.")
            tip.SetToolTip(numOrganic, "Độ võng cong hữu cơ của quỹ đạo (độ). Giúp đường bay lượn sóng tự nhiên như phi công FPV chuyên nghiệp.")
            tip.SetToolTip(numBank, "Góc nghiêng ngân chân trời khi ôm cua (độ). 8-16° cho cảm giác siêu xe ôm cua. 0-3° cho cảm giác Steadicam phẳng lì.")
            tip.SetToolTip(numBankGain, "Độ nhạy góc nghiêng theo gia tốc cua (x). Càng lớn, camera phản ứng nghiêng càng nhanh khi vào cua gắt.")
            tip.SetToolTip(numFovFar, "Tiêu cự FOV góc nhìn xa (độ). 45-50° cho tỷ lệ phối cảnh chuẩn mắt người.")
            tip.SetToolTip(numFovNear, "Tiêu cự FOV khi áp sát Hero (độ). FOV rộng (65-75°) tạo hiệu ứng kẹp phối cảnh hút mắt.")
            tip.SetToolTip(numFovFast, "Tiêu cự FOV khi bổ nhào bứt tốc (độ). Bung rộng tạo cảm giác tốc độ cao.")
            tip.SetToolTip(numFovReveal, "Tiêu cự FOV khi kết thúc lùi ra xa để lộ toàn bộ mô hình (độ).")

            ' Default to Preset 0 (F1 Sprint)
            cboPresets.SelectedIndex = 0

            form.BringToFront()
            form.Activate()

            If form.ShowDialog() = DialogResult.OK Then
                If cboCurve.SelectedIndex = 1 Then
                settings.CurveStyle = "OPTION_B"
            ElseIf cboCurve.SelectedIndex = 2 Then
                settings.CurveStyle = "OPTION_C"
            Else
                settings.CurveStyle = "OPTION_A"
            End If
            settings.DurationSeconds = CDbl(numDur.Value)

                settings.FarDistanceScale = CDbl(numFar.Value)
                settings.Near1DistanceScale = CDbl(numNear1.Value)
                settings.Near2DistanceScale = CDbl(numNear2.Value)
                settings.ReleaseDistanceBoost = CDbl(numRelease.Value)
                settings.OrbitSweepDegrees = CDbl(numSweep.Value)
                settings.OrbitOrganicBiasDegrees = CDbl(numOrganic.Value)

                settings.FastSpeedMultiplier = CDbl(numFast.Value)
                settings.NearHoldMultiplier = CDbl(numHold.Value)
                settings.NearHoldSpeedPercent = CDbl(numHoldSpeed.Value)

                settings.FOVFarDegrees = CDbl(numFovFar.Value)
                settings.FOVFastDegrees = CDbl(numFovFast.Value)
                settings.FOVNearDegrees = CDbl(numFovNear.Value)
                settings.FOVRevealDegrees = CDbl(numFovReveal.Value)
                settings.MaxBankDegrees = CDbl(numBank.Value)
                settings.BankGainMultiplier = CDbl(numBankGain.Value)

                settings.EnableMotionBlur = chkBlur.Checked
                settings.ShutterAngle = CDbl(numShutter.Value)

                If rbPreview.Checked Then
                    settings.RunMode = "PREVIEW"
                    settings.FPS = 30
                    settings.TotalFrames = CInt(settings.DurationSeconds * settings.FPS)
                ElseIf rbDraft.Checked Then
                    settings.RunMode = "EXPORT_DRAFT"
                    settings.FPS = 30
                    settings.Width = 720
                    settings.Height = 1280
                    settings.EnableMotionBlur = False
                    settings.TotalFrames = CInt(settings.DurationSeconds * settings.FPS)
                ElseIf rbFinal.Checked Then
                    settings.RunMode = "EXPORT_FINAL"
                    settings.FPS = 60
                    settings.Width = 1080
                    settings.Height = 1920
                    settings.TotalFrames = CInt(settings.DurationSeconds * settings.FPS)
                End If

                ExecuteDirector(oDoc, oCam, settings)
            End If
        Catch ex As Exception
            MessageBox.Show("WT3D Supercar Camera Error: " & ex.Message & vbCrLf & ex.StackTrace, "WT3D Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
        End Try
    End Sub


End Class
