            ' ==================================================================
            ' THANH ĐIỀU KHIỂN DƯỚI CÙNG (BOTTOM ACTION BAR)
            ' ==================================================================
            Dim btnOk As New System.Windows.Forms.Button()
            btnOk.Text = "🚀 KHỞI ĐỘNG MÁY QUAY (LAUNCH)"
            btnOk.Location = New System.Drawing.Point(620, 775)
            btnOk.Size = New System.Drawing.Size(220, 44)
            btnOk.BackColor = System.Drawing.Color.FromArgb(27, 122, 62)
            btnOk.ForeColor = System.Drawing.Color.White
            btnOk.FlatStyle = FlatStyle.Flat
            btnOk.Font = New System.Drawing.Font("Segoe UI", 10.5!, FontStyle.Bold)
            btnOk.DialogResult = DialogResult.OK
            form.Controls.Add(btnOk)

            Dim btnCancel As New System.Windows.Forms.Button()
            btnCancel.Text = "HỦY BỎ"
            btnCancel.Location = New System.Drawing.Point(850, 775)
            btnCancel.Size = New System.Drawing.Size(92, 44)
            btnCancel.BackColor = System.Drawing.Color.FromArgb(220, 220, 220)
            btnCancel.FlatStyle = FlatStyle.Flat
            btnCancel.Font = New System.Drawing.Font("Segoe UI", 9.5!, FontStyle.Regular)
            btnCancel.DialogResult = DialogResult.Cancel
