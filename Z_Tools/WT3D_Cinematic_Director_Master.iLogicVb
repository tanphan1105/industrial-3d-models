                Dim updateFovText As Action(Of Integer) = Sub(val As Integer)
                    Dim desc As String = ""
                    If val < 35 Then
                        desc = "◈ Telephoto (Chi tiết phẳng, ít méo)"
                    ElseIf val <= 55 Then
                        desc = "★ Standard 50mm (Chuẩn điện ảnh)"
                    ElseIf val <= 75 Then
                        desc = "❖ Wide 28mm (Góc rộng bao quát)"
                    Else
                        desc = "✦ Ultra-Wide 16mm (Siêu rộng kịch tính)"
                    End If
                    lblFovVal.Text = val.ToString() & "° • " & desc
                End Sub

                updateFovText(tbFov.Value)

                AddHandler tbFov.Scroll, Sub()
                    cfgFovDeg = tbFov.Value
                    updateFovText(cfgFovDeg)
                    Try
                        Dim liveCam As Camera = view.Camera
                        If Not liveCam.Perspective Then liveCam.Perspective = True
                        liveCam.PerspectiveAngle = cfgFovDeg * Math.PI / 180.0
                        liveCam.ApplyWithoutTransition()
                    Catch : End Try
                End Sub

                Dim applyFovPreset As Action(Of Integer) = Sub(val As Integer)
                    tbFov.Value = val
                    cfgFovDeg = val
                    updateFovText(val)
                    Try
                        Dim liveCam As Camera = view.Camera
                        If Not liveCam.Perspective Then liveCam.Perspective = True
                        liveCam.PerspectiveAngle = val * Math.PI / 180.0
                        liveCam.ApplyWithoutTransition()
                    Catch : End Try
                End Sub

