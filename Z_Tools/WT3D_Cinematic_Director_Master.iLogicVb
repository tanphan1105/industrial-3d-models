                ' EVENT HANDLERS (MODELESS ARCHITECTURE - KHÔNG KHÓA CỬA SỔ INVENTOR)
                AddHandler btnAspect916.Click, Sub()
                    Try
                        Dim curView As Inventor.View = app.ActiveView
                        curView.WindowState = WindowsSizeEnum.kNormalWindow
                        Dim vH As Integer = curView.Height
                        Dim vW As Integer = CInt(vH * (9.0 / 16.0))
                        curView.Width = vW
                        app.StatusBarText = "📱 Đã chuyển khung nhìn 3D Inventor sang chuẩn 9:16 Dọc! Thấy gì trên màn hình là video y hệt vậy."
                    Catch ex As Exception
                        MessageBox.Show("Không thể đổi kích thước khung nhìn: " & ex.Message, "WT3D Viewport", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                    End Try
                End Sub

                AddHandler btnAspectMax.Click, Sub()
                    Try
                        Dim curView As Inventor.View = app.ActiveView
                        curView.WindowState = WindowsSizeEnum.kMaximize
                        app.StatusBarText = "🖥️ Đã khôi phục khung nhìn 3D Inventor toàn màn hình."
                    Catch : End Try
                End Sub

                AddHandler btnPick.Click, Sub()
                    Try
                        dlg.Visible = False
                        Dim curDoc As AssemblyDocument = TryCast(app.ActiveDocument, AssemblyDocument)
                        If curDoc IsNot Nothing Then
                            PickAndAddLandmark(app, curDoc, cfgFovDeg)
                            dlg.Text = "🎬 WT3D CINEMATIC DIRECTOR V8.3 • " & m_EpisodeId & " (" & m_OrderedPoints.Count & " ĐIỂM VÀNG)"
                            lblSub.Text = m_EpisodeTitle & " | " & m_OrderedPoints.Count & " Waypoints | Chuyển Động Chậm Rãi Đĩnh Đạc 1:1"
                            tbFov.Value = Math.Max(20, Math.Min(90, cfgFovDeg))
                            updateFovText(cfgFovDeg)
                            TrimProcessMemory()
                            lblRamInfo.Text = "🛡️ RAM: " & GetCurrentRamMB().ToString("F0") & " MB (Tối ưu)"
                        End If
                    Catch ex As Exception
                        MessageBox.Show("Lỗi khi chấm điểm vàng: " & ex.Message, "WT3D", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    Finally
                        dlg.Visible = True
                        dlg.BringToFront()
                    End Try
                End Sub

                Dim runDirectorAction As Action(Of Boolean, Boolean) = Sub(isRender As Boolean, isQuick As Boolean)
                    Dim curDoc As AssemblyDocument = TryCast(app.ActiveDocument, AssemblyDocument)
                    If curDoc Is Nothing Then
                        MessageBox.Show("Vui lòng mở file cụm lắp ráp Assembly (.iam)!", "WT3D", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                        Return
                    End If

                    Dim curCompDef As AssemblyComponentDefinition = curDoc.ComponentDefinition
                    Dim curView As Inventor.View = app.ActiveView
                    Dim curCam As Camera = curView.Camera
                    Dim bBox As Box = curCompDef.RangeBox
                    Dim curCenter As New Vec3((bBox.MinPoint.X + bBox.MaxPoint.X) * 0.5, (bBox.MinPoint.Y + bBox.MaxPoint.Y) * 0.5, (bBox.MinPoint.Z + bBox.MaxPoint.Z) * 0.5)
                    Dim spanX As Double = Math.Abs(bBox.MaxPoint.X - bBox.MinPoint.X)
                    Dim spanY As Double = Math.Abs(bBox.MaxPoint.Y - bBox.MinPoint.Y)
                    Dim spanZ As Double = Math.Abs(bBox.MaxPoint.Z - bBox.MinPoint.Z)
                    Dim curRad As Double = Math.Sqrt(spanX * spanX + spanY * spanY + spanZ * spanZ) * 0.5

                    Dim curStyle As Integer = cmbStyle.SelectedIndex + 1
                    Dim curRes As Integer = If(rbRes1.Checked, 1, If(rbRes2.Checked, 2, If(rbRes3.Checked, 3, 4)))
                    Dim curDur As Integer = If(cmbDur.SelectedIndex = 0, 30, If(cmbDur.SelectedIndex = 1, 45, If(cmbDur.SelectedIndex = 2, 66, If(cmbDur.SelectedIndex = 3, 90, 15))))
                    Dim curFps As Integer = If(cmbFps.SelectedIndex = 0, 30, If(cmbFps.SelectedIndex = 1, 60, 24))
                    Dim curSpeed As Double = If(cmbSpeed.SelectedIndex = 0, 0.65, If(cmbSpeed.SelectedIndex = 1, 1.0, 1.4))
                    Dim curAA As Integer = cmbAA.SelectedIndex + 1
                    Dim curLight As Boolean = chkLightRig.Checked

                    Dim outW As Integer = 1440
                    Dim outH As Integer = 2560
                    If curRes = 2 Then outW = 1080 : outH = 1920
                    If curRes = 3 Then outW = 2560 : outH = 1440
                    If curRes = 4 Then outW = 3840 : outH = 2160

                    btnLive.Enabled = False
                    btnQuickLive.Enabled = False
                    btnRender.Enabled = False
                    btnPick.Enabled = False
                    btnAspect916.Enabled = False
                    btnAspectMax.Enabled = False
                    tbFov.Enabled = False

                    Try
                        ExecuteCinematicTour(app, curDoc, curView, curCam, curCenter, curRad, _
                                             curStyle, outW, outH, curDur, curFps, _
                                             isRender, isQuick, curLight, curAA, curSpeed)
                    Finally
                        btnLive.Enabled = True
                        btnQuickLive.Enabled = True
                        btnRender.Enabled = True
                        btnPick.Enabled = True
                        btnAspect916.Enabled = True
                        btnAspectMax.Enabled = True
                        tbFov.Enabled = True
                    End Try
                End Sub

                AddHandler btnQuickLive.Click, Sub() runDirectorAction(False, True)
                AddHandler btnLive.Click, Sub() runDirectorAction(False, False)
                AddHandler btnRender.Click, Sub() runDirectorAction(True, False)

        ' HIỂN THỊ MODELESS (KHÔNG KHÓA CỬA SỔ INVENTOR):
        ' NGƯỜI DÙNG HOÀN TOÀN TỰ DO XOAY, ZOOM, PAN MÔ HÌNH 3D TRONG VIEWPORT KHI BẢNG ĐANG MỞ!
        dlg.Show()
    End Sub

    ' --------------------------------------------------------------------------
    ' 10. THỰC THI QUAY PHIM & RENDER SUPER-SAMPLING VIDEO (MULTI-TIER ANTI-ALIASING)
    ' --------------------------------------------------------------------------
    Private Sub ExecuteCinematicTour(ByVal app As Inventor.Application, ByVal doc As AssemblyDocument, _
                                     ByVal view As Inventor.View, ByVal cam As Camera, _
                                     ByVal center As Vec3, ByVal radius As Double, _
                                     ByVal style As Integer, ByVal imgW As Integer, ByVal imgH As Integer, _
                                     ByVal durationSec As Integer, ByVal fps As Integer, _
                                     ByVal isRenderVideo As Boolean, ByVal isQuickTour As Boolean, _
                                     ByVal enableDynamicLighting As Boolean, ByVal antiAliasMode As Integer, _
                                     ByVal speedMultiplier As Double)

        Dim tg As TransientGeometry = app.TransientGeometry

        ' Tính toán cấu hình khử răng cưa
        Dim scaleFactor As Double = 1.0
        Select Case antiAliasMode
            Case 1 ' SSAA 1.5X Super-Sampling
                scaleFactor = 1.5
            Case 2 ' Hardware GPU MSAA
                scaleFactor = 1.0
            Case 3 ' SSAA 2.0X Ultra Super-Sampling
                scaleFactor = 2.0
            Case 4 ' Native 1.0X
                scaleFactor = 1.0
        End Select

        Dim captureW As Integer = CInt(imgW * scaleFactor)
        Dim captureH As Integer = CInt(imgH * scaleFactor)

        ' Cấu hình Hardware MSAA trực tiếp trong Inventor Graphics (An toàn tuyệt đối cho Inventor 2025)
        Dim origQuality As DisplayQualityEnum = DisplayQualityEnum.kSmootherDisplayQuality
        Try
            origQuality = app.DisplayOptions.DisplayQuality
            If antiAliasMode = 2 OrElse antiAliasMode = 3 Then
                app.DisplayOptions.DisplayQuality = DisplayQualityEnum.kSmootherDisplayQuality
            End If
        Catch : End Try

        ' ĐỒNG BỘ THỜI LƯỢNG THỰC TẾ THEO HỆ SỐ TỐC ĐỘ CAMERA (SPEED MULTIPLIER)
        ' Khi chọn 0.65x (Chậm rãi), effectiveDurationSec = durationSec / 0.65 (ví dụ 30s -> 46.1s lướt cực êm)
        Dim effectiveDurationSec As Double = If(style = 5 OrElse durationSec = 66, CDbl(durationSec), durationSec / Math.Max(0.2, speedMultiplier))
        Dim totalFrames As Integer = CInt(effectiveDurationSec * fps)
        Dim targetFrameMs As Double = 1000.0 / fps

        If isQuickTour Then
            ' NÂNG CẤP CHẾ ĐỘ XEM NHANH: 180 frames @ 35ms (~6.0s) MỊN ÊM, DỄ QUAN SÁT
            totalFrames = 180
            targetFrameMs = 35.0
        End If

        Dim exportDir As String = "D:\WT3D_Project\industrial-3d-models\05_STANDARD_COMPONENTS\01_TINH_THO_20M3H\VIDEO_FINAL"
        If Not System.IO.Directory.Exists(exportDir) Then
            exportDir = System.IO.Path.Combine(System.IO.Path.GetDirectoryName(doc.FullFileName), "VIDEO_FINAL")
            System.IO.Directory.CreateDirectory(exportDir)
        End If

        ' KIỂM TRA DUNG LƯỢNG Ổ ĐĨA & RAM TRƯỚC KHI RENDER (PRE-FLIGHT AUDIT QUA WIN32 API - MIỄN NHIỄM .NET 8 TYPE-FORWARDING)
        If isRenderVideo Then
            Try
                Dim driveLetter As String = System.IO.Path.GetPathRoot(exportDir)
                Dim freeBytes As ULong = 0UL
                Dim totalBytes As ULong = 0UL
                Dim totalFreeBytes As ULong = 0UL
                If GetDiskFreeSpaceEx(driveLetter, freeBytes, totalBytes, totalFreeBytes) Then
                    Dim freeGB As Double = CDbl(freeBytes) / (1024.0 * 1024.0 * 1024.0)
                    If freeGB < 3.0 Then
                        MessageBox.Show("Ổ đĩa " & driveLetter & " chỉ còn trống " & freeGB.ToString("F1") & " GB!" & vbCrLf & _
                                        "Xuất video Super-Sampling có thể cần ít nhất 3-5 GB trống." & vbCrLf & _
                                        "Vui lòng dọn bớt ổ đĩa trước khi xuất để tránh treo máy.", _
                                        "WT3D Disk Space Guard", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                        Return
                    End If
                End If
            Catch : End Try
        End If

        ' XẢ SẠCH RAM TRƯỚC KHI KHỞI ĐỘNG CHUYẾN BAY CAMERA
        TrimProcessMemory()

        Dim tempFrameDir As String = System.IO.Path.Combine(exportDir, "_temp_frames_" & DateTime.Now.ToString("yyyyMMdd_HHmmss"))
        If isRenderVideo Then
            System.IO.Directory.CreateDirectory(tempFrameDir)
        End If

        ' Trích xuất các điểm mốc chính phục vụ điều phối
        Dim pInlet = If(m_OrderedPoints.Count > 0, m_OrderedPoints(0), GetPt("INLET-DN80", center))
        Dim pCart = If(m_OrderedPoints.Count > 1, m_OrderedPoints(1), GetPt("CF-01A/B", center))
        Dim pGauge = If(m_OrderedPoints.Count > 2, m_OrderedPoints(2), GetPt("PI-01", pCart.Target))
        Dim pSoft = If(m_OrderedPoints.Count > 4, m_OrderedPoints(4), GetPt("SF-01A/B", center))
        Dim pValve = If(m_OrderedPoints.Count > 5, m_OrderedPoints(5), GetPt("AV-01A/B", pSoft.Target))
        Dim pBrine = If(m_OrderedPoints.Count > 6, m_OrderedPoints(6), GetPt("BT-01", pSoft.Target))
        Dim pUF = If(m_OrderedPoints.Count > 7, m_OrderedPoints(7), GetPt("UF-01A/B", center))
        Dim pDrain = If(m_OrderedPoints.Count > 8, m_OrderedPoints(8), GetPt("DRAIN-01", center))
        Dim pOutlet = If(m_OrderedPoints.Count > 9, m_OrderedPoints(9), GetPt("OUTLET-DN80", center))
        Dim pSkid = If(m_OrderedPoints.Count > 10, m_OrderedPoints(10), GetPt("SKID-FRAME", center))

        Dim tStart As DateTime = DateTime.Now
        Dim prevTarget As Vec3 = center
        Dim swFrame As New Stopwatch()

        ' Hệ số làm mượt tâm ngắm quán tính: Tốc độ chậm -> tâm ngắm càng mượt mà bồng bềnh
        Dim dampingAlpha As Double = If(speedMultiplier <= 0.7, 0.12, 0.18)

        Try
            ' === TỰ ĐỘNG CHỤP TRỌN BỘ ẢNH TĨNH ĐIỂM VÀNG (STILL_KEYFRAMES_9_16) KHI XUẤT VIDEO ===
            If isRenderVideo AndAlso m_OrderedPoints.Count > 0 Then
                Dim stillDir As String = "D:\WT3D_Project\industrial-3d-models\05_STANDARD_COMPONENTS\01_TINH_THO_20M3H\STILL_KEYFRAMES_9_16"
                Try
                    If Not System.IO.Directory.Exists(stillDir) Then
                        System.IO.Directory.CreateDirectory(stillDir)
                    End If
                    For idx As Integer = 0 To m_OrderedPoints.Count - 1
                        If CheckEscapeKey() Then Exit For
                        Dim gp As PinnedPoint = m_OrderedPoints(idx)
                        Dim gpEye As Vec3 = gp.Target + gp.Vector * gp.Clearance
                        Dim gpUp As Vec3 = CalcBankUp(gpEye, gp.Target, 0.0)
                        cam.PerspectiveAngle = gp.BestFov
                        cam.Target = tg.CreatePoint(gp.Target.X, gp.Target.Y, gp.Target.Z)
                        cam.Eye = tg.CreatePoint(gpEye.X, gpEye.Y, gpEye.Z)
                        cam.UpVector = tg.CreateUnitVector(gpUp.X, gpUp.Y, gpUp.Z)
                        If enableDynamicLighting Then
                            UpdateDynamicLightingRig(doc, view, gpEye, gp.Target, gpUp, tg)
                        End If
                        cam.Apply()
                        Dim cleanTag As String = Regex.Replace(gp.Tag, "[^a-zA-Z0-9_-]+", "_")
                        Dim kfFile As String = System.IO.Path.Combine(stillDir, String.Format("GOLDEN_STEP_{0:D2}_{1}.png", gp.FlowStep, cleanTag))
                        cam.SaveAsBitmap(kfFile, imgW, imgH)
                        app.StatusBarText = String.Format("📸 Đã chụp Ảnh Điểm Vàng [{0}/{1}]: {2}", idx + 1, m_OrderedPoints.Count, gp.NameVi)
                    Next
                    TrimProcessMemory()
                Catch : End Try
            End If

            For f As Integer = 0 To totalFrames - 1
                swFrame.Restart()

                If CheckEscapeKey() Then
                    app.StatusBarText = "🛑 ĐÃ BẤM GIỮ PHÍM ESC - DỪNG CAMERA KHẨN CẤP (ĐIỀU LỆ 17)!"
                    MessageBox.Show("Đã dừng camera an toàn theo lệnh phím ESC!", "Dừng Khẩn Cấp", MessageBoxButtons.OK, MessageBoxIcon.Information)
                    Exit Sub
                End If

                Dim pTime As Double = f / CDbl(totalFrames - 1)
                Dim curEye As Vec3
                Dim curTarget As Vec3
                Dim curFOV As Double = 0.85
                Dim curBank As Double = 0.0

                ' === TÍNH TOÁN QUỸ ĐẠO BẰNG CENTRIPETAL CATMULL-ROM & SPLINES ===
                Select Case style
                    Case 1 ' 🏆 Style 1: Hero Commercial (Low-Angle Rise, Pipe Run Parallax, 180° Reveal)
                        If pTime < 0.32 Then
                            Dim u As Double = CalcSpeedRamp(pTime / 0.32, 2)
                            curTarget = pInlet.Target + New Vec3(0, 15.0 * u, 0)
                            Dim lowY As Double = -25.0 + 55.0 * (u * u)
                            Dim rPush As Double = pInlet.Clearance - 75.0 * u
                            curEye = pInlet.Target + pInlet.Vector * rPush + New Vec3(0, lowY, 0)
                            curFOV = 0.82 + 0.06 * u
                            curBank = -6.0 * Math.Sin(u * Math.PI)
                        ElseIf pTime < 0.68 Then
                            Dim u As Double = CalcSpeedRamp((pTime - 0.32) / 0.36, 1)
                            curTarget = Vec3.Lerp(pCart.Target, pGauge.Target, u)
                            Dim ang As Double = -Math.PI * 0.28 + u * Math.PI * 0.65
                            curEye = pCart.Target + New Vec3(pCart.Clearance * Math.Cos(ang), 18.0 + 32.0 * u, pCart.Clearance * Math.Sin(ang))
                            curFOV = 0.76 - 0.16 * Math.Sin(u * Math.PI)
                            curBank = 8.0 * Math.Sin(u * Math.PI)
                        Else
                            Dim u As Double = CalcSpeedRamp((pTime - 0.68) / 0.32, 2)
                            curTarget = center
                            Dim isoAng As Double = Math.PI * 0.25 + u * Math.PI * 0.45
                            curEye = center + New Vec3(radius * 1.95 * Math.Cos(isoAng), radius * (0.82 + 0.35 * u), radius * 1.95 * Math.Sin(isoAng))
                            curFOV = 0.85 + 0.05 * u
                            curBank = 0.0
                        End If

                    Case 2 ' 🛸 Style 2: FPV Drone Pipe Alley (Bay luồn lách hành lang ống, nghiêng cánh cua)
                        Dim uGlob As Double = CalcSpeedRamp(pTime, 2)
                        Dim pA As Vec3 = pInlet.Target + New Vec3(0, 40, 100)
                        Dim pB As Vec3 = pCart.Target + New Vec3(30, 20, 40)
                        Dim pC As Vec3 = pSoft.Target + New Vec3(-40, 30, -20)
                        Dim pD As Vec3 = pUF.Target + New Vec3(50, 25, -60)
                        
                        If uGlob < 0.333 Then
                            curEye = CatmullRomCentripetal.Evaluate(pA + New Vec3(20,0,20), pA, pB, pC, uGlob / 0.333)
                        ElseIf uGlob < 0.666 Then
                            curEye = CatmullRomCentripetal.Evaluate(pA, pB, pC, pD, (uGlob - 0.333) / 0.333)
                        Else
                            curEye = CatmullRomCentripetal.Evaluate(pB, pC, pD, pD + New Vec3(20,30,-20), (uGlob - 0.666) / 0.334)
                        End If

                        Dim uTgtLead As Double = Math.Min(1.0, uGlob + 0.08)
                        curTarget = center + New Vec3(radius * 0.35 * Math.Cos(uTgtLead * Math.PI * 1.8), 0, radius * 0.35 * Math.Sin(uTgtLead * Math.PI * 1.8))
                        curBank = -12.0 * Math.Sin(uGlob * Math.PI * 4.0)
                        curFOV = 0.94

                    Case 3 ' 🔬 Style 3: Sci-Fi Tech Macro Scan (Telephoto 85mm, Dolly Zoom Vertigo)
                        If pTime < 0.25 Then
                            Dim u As Double = CalcSpeedRamp(pTime / 0.25, 3)
                            curTarget = pCart.Target
                            curEye = pCart.Target + pCart.Vector * (pCart.Clearance * (0.85 + 0.45 * u))
                            curFOV = 0.60 - 0.25 * u
                        ElseIf pTime < 0.50 Then
                            Dim u As Double = CalcSpeedRamp((pTime - 0.25) / 0.25, 2)
                            curTarget = pValve.Target
                            curEye = pValve.Target + pSoft.Vector * (pValve.Clearance * (1.1 - 0.3 * u)) + New Vec3(0, 12.0 * u, 0)
                            curFOV = 0.52
                        ElseIf pTime < 0.75 Then
                            Dim u As Double = CalcSpeedRamp((pTime - 0.50) / 0.25, 1)
                            curTarget = pUF.Target
                            Dim ufAng As Double = -Math.PI * 0.2 + u * Math.PI * 0.55
                            curEye = pUF.Target + New Vec3(pUF.Clearance * Math.Cos(ufAng), 12.0 + 22.0 * u, pUF.Clearance * Math.Sin(ufAng))
                            curFOV = 0.58
                        Else
                            Dim u As Double = CalcSpeedRamp((pTime - 0.75) / 0.25, 2)
                            curTarget = center
                            curEye = center + New Vec3(radius * 1.85, radius * (0.88 + 0.22 * u), radius * 1.85)
                            curFOV = 0.85
                        End If
                        curBank = 0.0

                    Case 4 ' 🎡 Style 4: 360° Studio Turntable Deluxe (Đế xoay showroom triển lãm, lượn sóng sin)
                        Dim angTurn As Double = pTime * Math.PI * 2.0
                        Dim rTurn As Double = radius * 2.15
                        Dim yBob As Double = center.Y + radius * 0.72 + (radius * 0.18) * Math.Sin(angTurn * 2.0)
                        curEye = center + New Vec3(rTurn * Math.Cos(angTurn), yBob, rTurn * Math.Sin(angTurn))
                        curTarget = center
                        curFOV = 0.85
                        curBank = 0.0

                    Case Else ' ★ Style 5: Quay Full Mô Tả Quy Trình (Đi Qua Đầy Đủ Toàn Bộ Điểm Vàng Đã Ghim)
                        Dim nPts As Integer = Math.Max(1, m_OrderedPoints.Count)
                        Dim scaledT As Double = pTime * nPts
                        Dim segIdx As Integer = Math.Min(nPts - 1, CInt(Math.Floor(scaledT)))
                        Dim uSeg As Double = scaledT - segIdx

                        Dim ptCur As PinnedPoint = m_OrderedPoints(segIdx)
                        Dim ptPrev As PinnedPoint = If(segIdx > 0, m_OrderedPoints(segIdx - 1), ptCur)

                        ' Tính vị trí Eye chuẩn của điểm trước và điểm hiện tại theo đúng Vector + Clearance người dùng đã chọn
                        Dim prevBaseEye As Vec3 = ptPrev.Target + ptPrev.Vector * (ptPrev.Clearance * 0.96)
                        Dim curStartEye As Vec3 = ptCur.Target + ptCur.Vector * (ptCur.Clearance * 1.05)

                        If segIdx > 0 AndAlso uSeg < 0.32 Then
                            ' Pha 1 (32% thời lượng bước): Lướt mượt S-Curve từ thiết bị trước sang thiết bị hiện tại
                            Dim uTrans As Double = CalcSpeedRamp(uSeg / 0.32, 2)
                            curTarget = Vec3.Lerp(ptPrev.Target, ptCur.Target, uTrans)
                            curEye = Vec3.Lerp(prevBaseEye, curStartEye, uTrans)
                            curFOV = ptPrev.BestFov + (ptCur.BestFov - ptPrev.BestFov) * uTrans
                            curBank = 3.5 * Math.Sin(uTrans * Math.PI)
                        Else
                            ' Pha 2 (68% thời lượng bước): Ngắm cận cảnh Điểm Vàng, xoay nhẹ ±7° và zoom chậm rãi vào tâm thiết bị
                            Dim uHoldRaw As Double = If(segIdx = 0, uSeg, (uSeg - 0.32) / 0.68)
                            Dim uHold As Double = CalcSpeedRamp(uHoldRaw, 5)
                            curTarget = ptCur.Target

                            Dim vx As Double = ptCur.Vector.X
                            Dim vy As Double = ptCur.Vector.Y
                            Dim vz As Double = ptCur.Vector.Z
                            Dim horizLen As Double = Math.Sqrt(vx * vx + vz * vz)
                            Dim baseYaw As Double = Math.Atan2(vz, vx)
                            Dim sweepYaw As Double = baseYaw + (uHold - 0.5) * 0.24 ' Xoay nhẹ ±6.8 độ quanh đúng góc nhìn đã chọn
                            Dim zoomDist As Double = ptCur.Clearance * (1.05 - 0.09 * uHold)

                            Dim offX As Double = zoomDist * horizLen * Math.Cos(sweepYaw)
                            Dim offZ As Double = zoomDist * horizLen * Math.Sin(sweepYaw)
                            Dim offY As Double = zoomDist * vy
                            curEye = ptCur.Target + New Vec3(offX, offY, offZ)
                            curFOV = ptCur.BestFov
                            curBank = 0.0
                        End If
                End Select

                ' Mượt hóa tâm ngắm chống giật Steadicam (Target Inertia Damping)
                If f = 0 Then
                    prevTarget = curTarget
                Else
                    prevTarget = Vec3.Lerp(prevTarget, curTarget, dampingAlpha)
                End If
                Dim finalTarget As Vec3 = prevTarget

                Dim curUp As Vec3 = CalcBankUp(curEye, finalTarget, curBank)

                ' === CẬP NHẬT CAMERA TRONG INVENTOR ===
                cam.PerspectiveAngle = curFOV
                cam.Target = tg.CreatePoint(finalTarget.X, finalTarget.Y, finalTarget.Z)
                cam.Eye = tg.CreatePoint(curEye.X, curEye.Y, curEye.Z)
                cam.UpVector = tg.CreateUnitVector(curUp.X, curUp.Y, curUp.Z)

                If f = 0 AndAlso enableDynamicLighting Then
                    UpdateDynamicLightingRig(doc, view, curEye, finalTarget, curUp, tg)
                End If

                If isRenderVideo Then
                    cam.Apply()
                    Dim fName As String = String.Format("frame_{0:D5}.png", f + 1)
                    Dim fPath As String = System.IO.Path.Combine(tempFrameDir, fName)
                    ' Chụp ảnh độ phân giải Super-Sampling để triệt tiêu răng cưa
                    cam.SaveAsBitmap(fPath, captureW, captureH)
                    If SafeYieldWithEscCheck(2) Then
                        app.StatusBarText = "🛑 ĐÃ BẤM GIỮ PHÍM ESC - DỪNG RENDER KHẨN CẤP (ĐIỀU LỆ 17)!"
                        MessageBox.Show("Đã dừng Render an toàn theo lệnh phím ESC!", "Dừng Khẩn Cấp", MessageBoxButtons.OK, MessageBoxIcon.Information)
                        Exit Sub
                    End If
                Else
                    cam.ApplyWithoutTransition()
                    
                    ' ĐỒNG BỘ THỜI GIAN THỰC CHUẨN XÁC QUA STOPWATCH (CHỐNG CHẠY NHANH 2X)
                    Dim elapsedMs As Double = swFrame.Elapsed.TotalMilliseconds
                    Dim remainMs As Integer = CInt(Math.Max(1.0, targetFrameMs - elapsedMs))
                    
                    ' BẮT PHÍM ESC NGAY TRONG KHI ĐANG SLEEP (< 4ms ĐÁP ỨNG)
                    If SafeYieldWithEscCheck(remainMs) Then
                        app.StatusBarText = "🛑 ĐÃ BẤM GIỮ PHÍM ESC - DỪNG CAMERA KHẨN CẤP (ĐIỀU LỆ 17)!"
                        MessageBox.Show("Đã dừng camera an toàn theo lệnh phím ESC!", "Dừng Khẩn Cấp", MessageBoxButtons.OK, MessageBoxIcon.Information)
                        Exit Sub
                    End If
                End If

                ' === HỆ THỐNG BẢO VỆ RAM & BỘ NHỚ THỜI GIAN THỰC (WT3D RAM SENTINEL) ===
                Dim curRamMB As Double = GetCurrentRamMB()

                ' 1. NGƯỠNG ĐỎ: PHANH AN TOÀN KHẨN CẤP NẾU RAM VƯỢT QUÁ 6,500 MB (CHỐNG CRASH INVENTOR)
                If curRamMB > 6500.0 Then
                    TrimProcessMemory()
                    If GetCurrentRamMB() > 6500.0 Then
                        app.StatusBarText = "⚠️ CẢNH BÁO: BỘ NHỚ RAM ĐÃ VƯỢT QUÁ 6.5GB - PHANH DỪNG ĐỂ TRÁNH CRASH INVENTOR!"
                        MessageBox.Show("Bộ nhớ RAM đã vượt ngưỡng an toàn (6.5 GB)!" & vbCrLf & _
                                        "Động cơ đã tự động kích hoạt phanh dừng để bảo vệ Inventor không bị Crash.", _
                                        "WT3D Emergency RAM Guard", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                        Exit Sub
                    End If
                End If

                ' 2. NGƯỠNG VÀNG: TỰ ĐỘNG DEEP PURGE KHI RAM > 4,000 MB
                If curRamMB > 4000.0 AndAlso (f + 1) Mod 5 = 0 Then
                    TrimProcessMemory()
                ' 3. XẢ BỘ NHỚ ĐỊNH KỲ MỖI 20 FRAMES (TRIPLE-STAGE GARBAGE COLLECTION + WORKING SET TRIM)
                ElseIf (f + 1) Mod 20 = 0 Then
                    TrimProcessMemory()
                End If

                If isQuickTour Then
                    If (f + 1) Mod 15 = 0 OrElse f = totalFrames - 1 Then
                        app.StatusBarText = String.Format("⚡ WT3D XEM NHANH 6S [{0:D3}/{1:D3}] ({2:F0}%) | 🛡️ RAM: {3:F0} MB | Giữ ESC để dừng", _
                                                          f + 1, totalFrames, ((f + 1) * 100.0 / totalFrames), curRamMB)
                    End If
                ElseIf isRenderVideo Then
                    If (f + 1) Mod 15 = 0 OrElse f = totalFrames - 1 Then
                        Dim elapsedSec As Double = (DateTime.Now - tStart).TotalSeconds
                        Dim fpsRend As Double = (f + 1) / Math.Max(0.01, elapsedSec)
                        Dim etaSec As Double = (totalFrames - (f + 1)) / Math.Max(0.01, fpsRend)
                        app.StatusBarText = String.Format("🎬 WT3D Render [{0:D4}/{1:D4}] ({2:F1}%) | 🛡️ RAM: {3:F0} MB | {4:F1} fps | ETA: {5:F0}s | Giữ ESC để dừng", _
                                                          f + 1, totalFrames, ((f + 1) * 100.0 / totalFrames), curRamMB, fpsRend, etaSec)
                    End If
                Else
                    If (f + 1) Mod 10 = 0 OrElse f = totalFrames - 1 Then
                        Dim elapsedSec As Double = (DateTime.Now - tStart).TotalSeconds
                        Dim stepIdx As Integer = Math.Min(Math.Max(1, m_OrderedPoints.Count) - 1, CInt(Math.Floor(pTime * Math.Max(1, m_OrderedPoints.Count))))
                        Dim stepName As String = If(m_OrderedPoints.Count > 0, m_OrderedPoints(stepIdx).NameVi, "Toàn cảnh Skid")
                        app.StatusBarText = String.Format("★ [BƯỚC {0}/{1}: {2}] ({3:F0}%) | {4:F1}s/{5:F0}s | RAM: {6:F0}MB | Giữ ESC để dừng", _
                                                          stepIdx + 1, Math.Max(1, m_OrderedPoints.Count), stepName, ((f + 1) * 100.0 / totalFrames), elapsedSec, effectiveDurationSec, curRamMB)
                    End If
                End If
            Next

            If isRenderVideo Then
                app.StatusBarText = "⚡ Đang hạ mẫu Lanczos (SSAA) & đóng gói video MP4 bằng FFmpeg..."
                Dim timeStamp As String = DateTime.Now.ToString("yyyyMMdd_HHmmss")
                Dim styleName As String = "Style" & style
                Dim mp4Name As String = String.Format("WT3D_{0}_{1}_{2}s_{3}x{4}_AA{5}_{6}.mp4", m_EpisodeId, styleName, durationSec, imgW, imgH, antiAliasMode, timeStamp)
                Dim finalMp4Path As String = System.IO.Path.Combine(exportDir, mp4Name)

                Dim ffmpegExe As String = "D:\WT3D_Project\Z_Tools\ffmpeg\bin\ffmpeg.exe"
                If Not System.IO.File.Exists(ffmpegExe) Then ffmpegExe = "ffmpeg.exe"

                ' Chuỗi filter xử lý: Hạ mẫu Lanczos SSAA + Unsharp làm nét viền uPVC + BT.709 Color Matrix
                Dim vfFilter As String = ""
                If scaleFactor > 1.01 Then
                    vfFilter = String.Format("-vf ""scale={0}:{1}:flags=lanczos,unsharp=5:5:0.5:5:5:0.0,format=yuv420p""", imgW, imgH)
                Else
                    vfFilter = "-vf ""format=yuv420p"""
                End If

                Dim args As String = String.Format("-y -framerate {0} -i ""{1}\frame_%05d.png"" -c:v libx264 -preset slow -crf 17 {2} -colorspace bt709 -color_primaries bt709 -color_trc bt709 ""{3}""", _
                                                   fps, tempFrameDir, vfFilter, finalMp4Path)

                Dim psi As New ProcessStartInfo(ffmpegExe, args)
                psi.CreateNoWindow = True
                psi.UseShellExecute = False
                Dim p As Process = Process.Start(psi)
                p.WaitForExit()

                Try
                    System.IO.Directory.Delete(tempFrameDir, True)
                Catch : End Try

                app.StatusBarText = "🎬 WT3D HOLLYWOOD VIDEO HOÀN TẤT: " & mp4Name
                MessageBox.Show("✅ ĐÃ XUẤT XONG VIDEO MP4 HOLLYWOOD CHẤT LƯỢNG CAO!" & vbCrLf & vbCrLf & _
                                "• Tập phim: " & m_EpisodeId & " - " & m_EpisodeTitle & vbCrLf & _
                                "• Độ phân giải: " & imgW & " x " & imgH & " (" & If(imgW > imgH, "16:9 Ngang", "9:16 Dọc") & ")" & vbCrLf & _
                                "• Thời lượng: " & durationSec & "s | " & fps & " FPS | Tốc độ: " & speedMultiplier & "x" & vbCrLf & _
                                "• Công nghệ Khử răng cưa: " & If(antiAliasMode = 1, "SSAA 1.5X Super-Sampling", If(antiAliasMode = 2, "Hardware GPU MSAA", If(antiAliasMode = 3, "SSAA 2.0X Ultra Super-Sampling", "Native 1.0X"))) & vbCrLf & _
                                "• Hệ thống ánh sáng: Dynamic Camera-Tracking Key/Fill/Rim + IBL Shadow Gloss" & vbCrLf & _
                                "• File xuất bản: " & finalMp4Path, _
                                "WT3D Cinematic Director Master V8.3", MessageBoxButtons.OK, MessageBoxIcon.Information)
            Else
                app.StatusBarText = "🎥 ĐÃ HOÀN TẤT TOUR QUAN SÁT CAMERA 3D THÀNH CÔNG!"
            End If

        Catch ex As Exception
            MessageBox.Show("Lỗi trong quá trình quay camera: " & ex.Message, "WT3D Director Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
        Finally
            ' Phục hồi chất lượng hiển thị gốc của người dùng (Điều lệ 12 & 15)
            Try
                app.DisplayOptions.DisplayQuality = origQuality
            Catch : End Try

            ' GIẢI PHÓNG 100% BỘ NHỚ RAM TẠM & RÁC TIẾN TRÌNH KHI KẾT THÚC HOẶC BẤM ESC DỪNG LẠI
            TrimProcessMemory()
        End Try
    End Sub

End Class