Public Class ThisRule
    Private Shared s_DirectorForm As System.Windows.Forms.Form = Nothing

    ' --------------------------------------------------------------------------
    ' HỆ THỐNG BẢO VỆ RAM & BỘ NHỚ TOÀN DIỆN (WT3D RAM SENTINEL & ANTI-FREEZE)
    ' --------------------------------------------------------------------------
    <DllImport("kernel32.dll", SetLastError:=True)> _
    Private Shared Function SetProcessWorkingSetSize(ByVal hProcess As IntPtr, ByVal dwMinimumWorkingSetSize As IntPtr, ByVal dwMaximumWorkingSetSize As IntPtr) As Boolean
    End Function

    <DllImport("kernel32.dll", SetLastError:=True, CharSet:=CharSet.Auto)> _
    Private Shared Function GetDiskFreeSpaceEx(ByVal lpDirectoryName As String, _
                                              ByRef lpFreeBytesAvailable As ULong, _
                                              ByRef lpTotalNumberOfBytes As ULong, _
                                              ByRef lpTotalNumberOfFreeBytes As ULong) As Boolean
    End Function

    Public Shared Function GetCurrentRamMB() As Double
        Try
            Return Process.GetCurrentProcess().WorkingSet64 / (1024.0 * 1024.0)
        Catch
            Return 0.0
        End Try
    End Function

    Public Shared Sub TrimProcessMemory()
        Try
            GC.Collect()
            GC.WaitForPendingFinalizers()
            GC.Collect()
            Dim hProc As IntPtr = Process.GetCurrentProcess().Handle
            SetProcessWorkingSetSize(hProc, New IntPtr(-1), New IntPtr(-1))
        Catch : End Try
    End Sub

    ' --------------------------------------------------------------------------
    ' ĐIỀU LỆ 17: BẪY PHÍM ESC DỪNG KHẨN CẤP WIN32 API (<0.005s)
    ' --------------------------------------------------------------------------
    <DllImport("user32.dll")> _
    Private Shared Function GetAsyncKeyState(ByVal vKey As Integer) As Short
    End Function

    Private Const VK_ESCAPE As Integer = &H1B

    Public Function CheckEscapeKey() As Boolean
        Try
            System.Windows.Forms.Application.DoEvents()
            Dim state As Short = GetAsyncKeyState(VK_ESCAPE)
            ' Bắt cả bit 15 (đang nhấn giữ) và bit 0 (đã nhấn) hoặc số âm
            Return (state And &H8000) <> 0 OrElse (state And &H1) <> 0 OrElse state < 0
        Catch
            Return False
        End Try
    End Function

    Private Function SafeYieldWithEscCheck(ByVal totalSleepMs As Integer) As Boolean
        ' Cắt lát thời gian chờ tối đa 3ms-4ms mỗi nhịp, liên tục bắt phím ESC
        ' Trả về True ngay lập tức nếu người dùng NHẤN hoặc GIỮ phím ESC! (< 4ms đáp ứng)
        Try
            Dim swYield As Stopwatch = Stopwatch.StartNew()
            While swYield.ElapsedMilliseconds < totalSleepMs
                System.Windows.Forms.Application.DoEvents()
                If CheckEscapeKey() Then Return True
                
                Dim remMs As Integer = totalSleepMs - CInt(swYield.ElapsedMilliseconds)
                If remMs <= 0 Then Exit While
                Dim chunk As Integer = Math.Min(remMs, 4)
                System.Threading.Thread.Sleep(chunk)
                
                If CheckEscapeKey() Then Return True
            End While
        Catch
        End Try
        Return CheckEscapeKey()
    End Function

    ' --------------------------------------------------------------------------
    ' 1. LỚP ĐẠI SỐ VECTOR 3D CHÍNH XÁC CAO (VEC3)
    ' --------------------------------------------------------------------------
    Public Class Vec3
        Public X As Double
        Public Y As Double
        Public Z As Double

        Public Sub New()
            X = 0.0 : Y = 0.0 : Z = 0.0
        End Sub

        Public Sub New(ByVal _x As Double, ByVal _y As Double, ByVal _z As Double)
            X = _x : Y = _y : Z = _z
        End Sub

        Public Shared Operator +(ByVal a As Vec3, ByVal b As Vec3) As Vec3
            Return New Vec3(a.X + b.X, a.Y + b.Y, a.Z + b.Z)
        End Operator

        Public Shared Operator -(ByVal a As Vec3, ByVal b As Vec3) As Vec3
            Return New Vec3(a.X - b.X, a.Y - b.Y, a.Z - b.Z)
        End Operator

        Public Shared Operator -(ByVal a As Vec3) As Vec3
            Return New Vec3(-a.X, -a.Y, -a.Z)
        End Operator

        Public Shared Operator *(ByVal s As Double, ByVal a As Vec3) As Vec3
            Return New Vec3(s * a.X, s * a.Y, s * a.Z)
        End Operator

        Public Shared Operator *(ByVal a As Vec3, ByVal s As Double) As Vec3
            Return New Vec3(s * a.X, s * a.Y, s * a.Z)
        End Operator

        Public Shared Operator /(ByVal a As Vec3, ByVal s As Double) As Vec3
            If Math.Abs(s) < 1E-12 Then Return New Vec3(0, 0, 0)
            Return New Vec3(a.X / s, a.Y / s, a.Z / s)
        End Operator

        Public Function Dot(ByVal b As Vec3) As Double
            Return X * b.X + Y * b.Y + Z * b.Z
        End Function

        Public Function Cross(ByVal b As Vec3) As Vec3
            Return New Vec3(Y * b.Z - Z * b.Y, Z * b.X - X * b.Z, X * b.Y - Y * b.X)
        End Function

        Public Function Length() As Double
            Return Math.Sqrt(X * X + Y * Y + Z * Z)
        End Function

        Public Function DistanceTo(ByVal b As Vec3) As Double
            Dim dx As Double = X - b.X
            Dim dy As Double = Y - b.Y
            Dim dz As Double = Z - b.Z
            Return Math.Sqrt(dx * dx + dy * dy + dz * dz)
        End Function

        Public Function Normalize() As Vec3
            Dim l As Double = Length()
            If l < 1E-12 Then Return New Vec3(0, 1, 0)
            Return New Vec3(X / l, Y / l, Z / l)
        End Function

        Public Shared Function Lerp(ByVal a As Vec3, ByVal b As Vec3, ByVal t As Double) As Vec3
            Return a + t * (b - a)
        End Function

        Public Overrides Function ToString() As String
            Return String.Format("[{0:F2}, {1:F2}, {2:F2}]", X, Y, Z)
        End Function
    End Class

    ' --------------------------------------------------------------------------
    ' 2. ĐƯỜNG CONG NỘI SUY CENTRIPETAL CATMULL-ROM C2 SPLINE (ALPHA = 0.5)
    ' --------------------------------------------------------------------------
    Public Class CatmullRomCentripetal
        Private Shared Function GetT(ByVal t As Double, ByVal alpha As Double, ByVal p0 As Vec3, ByVal p1 As Vec3) As Double
            Dim d As Double = p0.DistanceTo(p1)
            Return t + Math.Pow(d, alpha)
        End Function

        Public Shared Function Evaluate(ByVal p0 As Vec3, ByVal p1 As Vec3, ByVal p2 As Vec3, ByVal p3 As Vec3, ByVal tLocal As Double) As Vec3
            Dim alpha As Double = 0.5 ' Centripetal (Triệt tiêu hiện tượng vọt lố Cusp/Loop)
            Dim t0 As Double = 0.0
            Dim t1 As Double = GetT(t0, alpha, p0, p1)
            Dim t2 As Double = GetT(t1, alpha, p1, p2)
            Dim t3 As Double = GetT(t2, alpha, p2, p3)

            If Math.Abs(t2 - t1) < 1E-8 Then Return p1

            Dim t As Double = t1 + tLocal * (t2 - t1)

            Dim a1 As Vec3 = If(Math.Abs(t1 - t0) > 1E-8, ((t1 - t) / (t1 - t0)) * p0 + ((t - t0) / (t1 - t0)) * p1, p1)
            Dim a2 As Vec3 = ((t2 - t) / (t2 - t1)) * p1 + ((t - t1) / (t2 - t1)) * p2
            Dim a3 As Vec3 = If(Math.Abs(t3 - t2) > 1E-8, ((t3 - t) / (t3 - t2)) * p2 + ((t - t2) / (t3 - t2)) * p3, p2)

            Dim b1 As Vec3 = ((t2 - t) / (t2 - t0)) * a1 + ((t - t0) / (t2 - t0)) * a2
            Dim b2 As Vec3 = ((t3 - t) / (t3 - t1)) * a2 + ((t - t1) / (t3 - t1)) * a3

            Return ((t2 - t) / (t2 - t1)) * b1 + ((t - t1) / (t2 - t1)) * b2
        End Function
    End Class

    ' --------------------------------------------------------------------------
    ' 3. ĐIỀU BIÊN TỐC ĐỘ S-CURVE (CINEMATIC SPEED RAMPS)
    ' --------------------------------------------------------------------------
    Public Function CalcSpeedRamp(ByVal t As Double, ByVal mode As Integer) As Double
        t = Math.Max(0.0, Math.Min(1.0, t))
        Select Case mode
            Case 1 ' Linear
                Return t
            Case 2 ' SmoothStep (Hermite S-Curve)
                Return t * t * (3.0 - 2.0 * t)
            Case 3 ' SmootherStep (Perlin S-Curve)
                Return t * t * t * (t * (t * 6.0 - 15.0) + 10.0)
            Case 4 ' EaseOutExpo (Dừng êm ái Hollywood)
                Return If(t >= 1.0, 1.0, 1.0 - Math.Pow(2.0, -10.0 * t))
            Case 5 ' EaseInOutSine (Lượn sóng nhẹ)
                Return -0.5 * (Math.Cos(Math.PI * t) - 1.0)
            Case Else
                Return t * t * (3.0 - 2.0 * t)
        End Select
    End Function

    ' --------------------------------------------------------------------------
    ' 4. TÍNH TOÁN DYNAMIC BANKING CHO UP-VECTOR
    ' --------------------------------------------------------------------------
    Public Function CalcBankUp(ByVal eye As Vec3, ByVal target As Vec3, ByVal bankAngleDeg As Double) As Vec3
        Dim fwd As Vec3 = (target - eye).Normalize()
        Dim worldUp As New Vec3(0, 1, 0)
        If Math.Abs(fwd.Dot(worldUp)) > 0.999 Then
            worldUp = New Vec3(0, 0, 1)
        End If

        Dim right As Vec3 = fwd.Cross(worldUp).Normalize()
        Dim camUp As Vec3 = right.Cross(fwd).Normalize()

        If Math.Abs(bankAngleDeg) < 0.001 Then
            Return camUp
        End If

        Dim rad As Double = bankAngleDeg * Math.PI / 180.0
        Dim cosA As Double = Math.Cos(rad)
        Dim sinA As Double = Math.Sin(rad)

        Return (camUp * cosA + right * sinA).Normalize()
    End Function

    ' --------------------------------------------------------------------------
    ' 5. HỆ THỐNG ÁNH SÁNG CHUẨN ĐIỆN ẢNH BÁM THEO GÓC MÁY QUAY (DYNAMIC LIGHTING RIG)
    ' --------------------------------------------------------------------------
    Public Sub UpdateDynamicLightingRig(ByVal doc As AssemblyDocument, ByVal view As Inventor.View, _
                                         ByVal eye As Vec3, ByVal target As Vec3, ByVal up As Vec3, _
                                         ByVal tg As TransientGeometry)
        Try
            Dim app As Inventor.Application = doc.Parent
            Dim oStyles As LightingStyles = doc.LightingStyles
            Dim targetLs As LightingStyle = Nothing

            If oStyles IsNot Nothing Then
                ' Ưu tiên số 1: Tìm đúng bộ đèn sáng trong "Two Lights" chuẩn Studio (B0_SET_TWO_LIGHTS_STUDIO)
                Try : targetLs = oStyles.Item("Two Lights") : Catch : End Try

                If targetLs Is Nothing Then
                    For Each ls As LightingStyle In oStyles
                        If ls.Name.Equals("Two Lights", StringComparison.OrdinalIgnoreCase) OrElse _
                           ls.Name.ToLower().Contains("two") OrElse ls.Name.Contains("2") Then
                            targetLs = ls
                            Exit For
                        End If
                    Next
                End If

                If targetLs Is Nothing AndAlso oStyles.Count > 0 Then
                    targetLs = oStyles.Item(1)
                End If

                If targetLs IsNot Nothing Then
                    Try
                        If targetLs.StyleLocation = StyleLocationEnum.kLibraryStyleLocation Then
                            targetLs.ConvertToLocal()
                        End If
                    Catch : End Try
                    Try : doc.ActiveLightingStyle = targetLs : Catch : End Try
                End If
            End If

            Dim curStyle As LightingStyle = doc.ActiveLightingStyle
            If curStyle IsNot Nothing Then
                Try : curStyle.ShadowDirection = ShadowDirectionEnum.kAboveShadowDirection : Catch : End Try
                Try : curStyle.Brightness = 0.74 : Catch : End Try
                Try : curStyle.Ambience = 0.30 : Catch : End Try
                Try : curStyle.ShadowDensity = 52.0 : Catch : End Try
                Try : curStyle.ShadowSoftness = 50.0 : Catch : End Try
                Try : curStyle.AmbientShadowIntensity = 18.0 : Catch : End Try

                ' Cấu hình 2 đèn ViewSpace rọi trực diện mặt trước theo góc máy (Từng thuộc tính bọc Try-Catch riêng biệt)
                Dim lNum As Integer = 1
                For Each lt As Light In curStyle.Lights
                    If lNum = 1 Then
                        Try : lt.On = True : Catch : End Try
                        Try : lt.LightType = LightTypeEnum.kViewSpaceLight : Catch : End Try
                        Try : lt.Color = app.TransientObjects.CreateColor(255, 253, 248) : Catch : End Try
                        Try : lt.Intensity = 1.15 : Catch : End Try
                        Try : lt.Direction = tg.CreateVector(0.38, -0.32, -0.865) : Catch : End Try
                    ElseIf lNum = 2 Then
                        Try : lt.On = True : Catch : End Try
                        Try : lt.LightType = LightTypeEnum.kViewSpaceLight : Catch : End Try
                        Try : lt.Color = app.TransientObjects.CreateColor(245, 250, 255) : Catch : End Try
                        Try : lt.Intensity = 0.65 : Catch : End Try
                        Try : lt.Direction = tg.CreateVector(-0.42, -0.22, -0.885) : Catch : End Try
                    Else
                        Try : lt.On = False : Catch : End Try
                    End If
                    lNum += 1
                Next
            End If

            ' Thiết lập nền Light + studio_02.dds + Tắt bóng gương sàn
            Try
                For Each cs As ColorScheme In app.ColorSchemes
                    If cs.Name.Equals("Light", StringComparison.OrdinalIgnoreCase) Then
                        cs.Activate()
                        Try : cs.ReflectionEnvironmentFilename = "studio_02.dds" : Catch : End Try
                        Exit For
                    End If
                Next
            Catch : End Try

            Try : app.ColorSchemes.BackgroundType = BackgroundTypeEnum.kGradientBackgroundType : Catch : End Try
            Try : view.DisplayMode = DisplayModeEnum.kShadedWithEdgesRendering : Catch : End Try
            Try : view.ShowGroundReflections = False : Catch : End Try
            Try : view.ShowShadows = True : Catch : End Try
            Try : view.ShowGroundShadows = True : Catch : End Try
            Try : view.ShowAmbientShadows = True : Catch : End Try
            Try : view.ShowObjectShadows = True : Catch : End Try
        Catch : End Try
    End Sub

    ' --------------------------------------------------------------------------
    ' 6. CẤU TRÚC ĐIỂM ĐỊNH VỊ VÀNG (GOLDEN PINNED POINT)
    ' --------------------------------------------------------------------------
    Public Class PinnedPoint
        Public Tag As String
        Public NameVi As String
        Public Target As Vec3
        Public Vector As Vec3
        Public Clearance As Double
        Public BestFov As Double
        Public FlowStep As Integer
        Public StageRole As String

        Public Sub New(ByVal _tag As String, ByVal _name As String, ByVal _tgt As Vec3, ByVal _vec As Vec3, _
                       ByVal _clr As Double, ByVal _fov As Double, ByVal _step As Integer, ByVal _role As String)
            Tag = _tag : NameVi = _name : Target = _tgt : Vector = _vec.Normalize()
            Clearance = _clr : BestFov = _fov : FlowStep = _step : StageRole = _role
        End Sub
    End Class

    Private m_Points As New Dictionary(Of String, PinnedPoint)()
    Private m_OrderedPoints As New List(Of PinnedPoint)()
    Private m_SeriesTitle As String = "HÀNH TRÌNH CỦA NƯỚC (THE JOURNEY OF WATER)"
    Private m_EpisodeId As String = "EP02"
    Private m_EpisodeTitle As String = "SKID TIỀN XỬ LÝ LỌC THÔ & LÀM MỀM NƯỚC CÔNG NGHIỆP 20M3/H"
    Private m_AudioMasterFile As String = "part2.mp3"

    ' --------------------------------------------------------------------------
    ' 7. BỘ TẢI MANIFEST TỰ ĐỘNG THEO DỰ ÁN (UNIVERSAL MANIFEST LOADER)
    ' --------------------------------------------------------------------------
    Private Sub LoadEpisodeManifest(ByVal doc As AssemblyDocument, ByVal center As Vec3, ByVal radius As Double)
        m_Points.Clear()
        m_OrderedPoints.Clear()

        Dim docDir As String = System.IO.Path.GetDirectoryName(doc.FullFileName)
        Dim manifestPath As String = System.IO.Path.Combine(docDir, "episode_manifest.json")

        If System.IO.File.Exists(manifestPath) Then
            Try
                Dim jsonContent As String = System.IO.File.ReadAllText(manifestPath, System.Text.Encoding.UTF8)

                Dim matchEpId As Match = Regex.Match(jsonContent, """episode_id""\s*:\s*""([^""]+)""")
                If matchEpId.Success Then m_EpisodeId = matchEpId.Groups(1).Value

                Dim matchEpTitle As Match = Regex.Match(jsonContent, """episode_title""\s*:\s*""([^""]+)""")
                If matchEpTitle.Success Then m_EpisodeTitle = matchEpTitle.Groups(1).Value

                Dim matchAudio As Match = Regex.Match(jsonContent, """audio_master_file""\s*:\s*""([^""]+)""")
                If matchAudio.Success Then m_AudioMasterFile = matchAudio.Groups(1).Value

                Dim lmRegex As New Regex("\{[^{}]*""tag""\s*:\s*""([^""]+)""[^{}]*\}", RegexOptions.Singleline)
                Dim matches As MatchCollection = lmRegex.Matches(jsonContent)

                For Each m As Match In matches
                    Dim block As String = m.Value
                    Dim tag As String = Regex.Match(block, """tag""\s*:\s*""([^""]+)""").Groups(1).Value
                    Dim nameVi As String = Regex.Match(block, """name_vi""\s*:\s*""([^""]+)""").Groups(1).Value
                    Dim stageRole As String = Regex.Match(block, """stage_role""\s*:\s*""([^""]+)""").Groups(1).Value

                    Dim tMatch As Match = Regex.Match(block, """target""\s*:\s*\[\s*([-0-9.]+)\s*,\s*([-0-9.]+)\s*,\s*([-0-9.]+)\s*\]")
                    Dim vMatch As Match = Regex.Match(block, """view_vector""\s*:\s*\[\s*([-0-9.]+)\s*,\s*([-0-9.]+)\s*,\s*([-0-9.]+)\s*\]")

                    Dim clrMatch As Match = Regex.Match(block, """clearance""\s*:\s*([-0-9.]+)")
                    Dim fovMatch As Match = Regex.Match(block, """best_fov""\s*:\s*([-0-9.]+)")
                    Dim stepMatch As Match = Regex.Match(block, """flow_step""\s*:\s*([0-9]+)")

                    If tMatch.Success AndAlso vMatch.Success Then
                        Dim tx As Double = Double.Parse(tMatch.Groups(1).Value, System.Globalization.CultureInfo.InvariantCulture)
                        Dim ty As Double = Double.Parse(tMatch.Groups(2).Value, System.Globalization.CultureInfo.InvariantCulture)
                        Dim tz As Double = Double.Parse(tMatch.Groups(3).Value, System.Globalization.CultureInfo.InvariantCulture)

                        Dim vx As Double = Double.Parse(vMatch.Groups(1).Value, System.Globalization.CultureInfo.InvariantCulture)
                        Dim vy As Double = Double.Parse(vMatch.Groups(2).Value, System.Globalization.CultureInfo.InvariantCulture)
                        Dim vz As Double = Double.Parse(vMatch.Groups(3).Value, System.Globalization.CultureInfo.InvariantCulture)

                        Dim clr As Double = If(clrMatch.Success, Double.Parse(clrMatch.Groups(1).Value, System.Globalization.CultureInfo.InvariantCulture), 80.0)
                        Dim fov As Double = If(fovMatch.Success, Double.Parse(fovMatch.Groups(1).Value, System.Globalization.CultureInfo.InvariantCulture), 0.78)
                        Dim stepVal As Integer = If(stepMatch.Success, Integer.Parse(stepMatch.Groups(1).Value), m_OrderedPoints.Count + 1)

                        Dim pt As New PinnedPoint(tag, nameVi, New Vec3(tx, ty, tz), New Vec3(vx, vy, vz), clr, fov, stepVal, stageRole)
                        m_Points(tag) = pt
                        m_OrderedPoints.Add(pt)
                    End If
                Next
            Catch ex As Exception
            End Try
        End If

        ' Nếu manifest chưa tồn tại hoặc rỗng, sinh tự động từ Bounding Box
        If m_OrderedPoints.Count = 0 Then
            GenerateFallbackPoints(center, radius)
        End If
    End Sub

    Private Sub GenerateFallbackPoints(ByVal center As Vec3, ByVal radius As Double)
        Dim pts As PinnedPoint() = { _
            New PinnedPoint("INLET-DN80", "Cổng Cấp Nước Thô Đầu Vào (u-PVC DN80)", center + New Vec3(-radius * 0.75, -radius * 0.25, radius * 0.45), New Vec3(-0.6, 0.3, 0.74), 75.0, 0.78, 1, "Inlet"), _
            New PinnedPoint("CF-01A/B", "Bộ Đôi Bầu Lọc Tinh Cartridge 40 Inch", center + New Vec3(-radius * 0.42, 0, radius * 0.35), New Vec3(-0.4, 0.4, 0.82), 65.0, 0.72, 2, "Sediment Filtration"), _
            New PinnedPoint("PI-01", "Đồng Hồ Đo Áp Suất Màng Dầu Wise", center + New Vec3(-radius * 0.38, radius * 0.22, radius * 0.38), New Vec3(0.0, 0.2, 0.98), 35.0, 0.55, 3, "Monitoring"), _
            New PinnedPoint("PUMP-FEED", "Cụm Bơm Trục Ngang Cấp Nguồn", center + New Vec3(-radius * 0.55, -radius * 0.35, 0), New Vec3(-0.7, 0.4, 0.59), 85.0, 0.80, 4, "Feed Pumping"), _
            New PinnedPoint("SF-01A/B", "Bồn Làm Mềm Nước Composite 2472", center + New Vec3(-radius * 0.05, radius * 0.15, -radius * 0.15), New Vec3(-0.5, 0.3, 0.81), 110.0, 0.82, 5, "Softening"), _
            New PinnedPoint("AV-01A/B", "Cụm Van Điều Khiển Runxin 5 Cửa", center + New Vec3(-radius * 0.05, radius * 0.65, -radius * 0.15), New Vec3(0.0, 0.25, 0.97), 45.0, 0.58, 6, "Valve Control"), _
            New PinnedPoint("BT-01", "Bồn Muối Tái Sinh Hoàn Nguyên", center + New Vec3(radius * 0.22, -radius * 0.15, -radius * 0.45), New Vec3(0.5, 0.4, 0.77), 80.0, 0.78, 7, "Regeneration"), _
            New PinnedPoint("UF-01A/B", "Hệ Thống 4 Cột Màng Siêu Lọc UF PVDF", center + New Vec3(radius * 0.48, radius * 0.10, radius * 0.15), New Vec3(0.6, 0.35, 0.72), 95.0, 0.76, 8, "Ultrafiltration"), _
            New PinnedPoint("DRAIN-01", "Hệ Thống Xả Cặn Tự Động", center + New Vec3(radius * 0.52, -radius * 0.42, radius * 0.10), New Vec3(0.7, 0.2, 0.68), 55.0, 0.65, 9, "Backwash Drain"), _
            New PinnedPoint("OUTLET-DN80", "Đường Nước Mềm Cấp Sang RO (u-PVC DN80)", center + New Vec3(radius * 0.78, -radius * 0.18, radius * 0.25), New Vec3(0.8, 0.3, 0.52), 70.0, 0.75, 10, "RO Feed Outlet"), _
            New PinnedPoint("SKID-FRAME", "Khung Bệ Đỡ Skid Thép Không Gỉ Toàn Cảnh", center, New Vec3(0.5774, 0.5774, 0.5774), radius * 2.1, 0.85, 11, "Overview Staging") _
        }
        For Each p In pts
            m_Points(p.Tag) = p
            m_OrderedPoints.Add(p)
        Next
    End Sub

    Public Function GetPt(ByVal tag As String, ByVal fallbackTgt As Vec3) As PinnedPoint
        If m_Points.ContainsKey(tag) Then Return m_Points(tag)
        Return New PinnedPoint(tag, tag, fallbackTgt, New Vec3(0.5774, 0.5774, 0.5774), 85.0, 0.80, 99, "General")
    End Function

    ' --------------------------------------------------------------------------
    ' 8. TÍNH NĂNG CHẤM ĐIỂM VÀNG 1-CHẠM (POKA-YOKE ANTI-FREEZE ARCHITECTURE)
    ' --------------------------------------------------------------------------
    Private Function PromptInput(ByVal promptText As String, ByVal title As String, ByVal defaultValue As String) As String
        Using f As New System.Windows.Forms.Form()
            f.Text = title
            f.Size = New System.Drawing.Size(560, 310)
            f.StartPosition = FormStartPosition.CenterScreen
            f.FormBorderStyle = FormBorderStyle.FixedDialog
            f.MaximizeBox = False
            f.MinimizeBox = False
            f.BackColor = System.Drawing.Color.FromArgb(248, 250, 252)
            f.Font = New System.Drawing.Font("Segoe UI", 9.5F, System.Drawing.FontStyle.Regular)

            Dim lbl As New System.Windows.Forms.Label()
            lbl.Text = promptText
            lbl.Location = New System.Drawing.Point(18, 12)
            lbl.Size = New System.Drawing.Size(515, 38)
            f.Controls.Add(lbl)

            Dim txt As New System.Windows.Forms.TextBox()
            txt.Text = defaultValue
            txt.Location = New System.Drawing.Point(20, 56)
            txt.Size = New System.Drawing.Size(505, 26)
            f.Controls.Add(txt)

            ' GỢI Ý 1-CHẠM TIẾNG VIỆT NHANH (QUICK VIETNAMESE CHIPS)
            Dim lblChips As New System.Windows.Forms.Label()
            lblChips.Text = "⚡ Chọn nhanh tên tiếng Việt 1-chạm (Hoặc gõ / sửa ở trên rồi bấm Enter):"
            lblChips.Font = New System.Drawing.Font("Segoe UI", 8.5F, System.Drawing.FontStyle.Bold)
            lblChips.ForeColor = System.Drawing.Color.FromArgb(71, 85, 105)
            lblChips.Location = New System.Drawing.Point(18, 90)
            lblChips.Size = New System.Drawing.Size(515, 18)
            f.Controls.Add(lblChips)

            Dim pnlChips As New System.Windows.Forms.FlowLayoutPanel()
            pnlChips.Location = New System.Drawing.Point(18, 112)
            pnlChips.Size = New System.Drawing.Size(515, 95)
            pnlChips.AutoScroll = True
            f.Controls.Add(pnlChips)

            Dim chipNames As String() = { _
                "Cổng cấp nước thô u-PVC DN80", _
                "Phin lọc tinh đôi 40 inch", _
                "Áp kế đo chênh áp", _
                "Dàn màng siêu lọc UF PVDF", _
                "Xả cặn UF", _
                "Cột làm mềm composite FRP 2472", _
                "Van tự động 5 chu trình", _
                "Thùng muối hoàn nguyên 500L", _
                "Cổng nước mềm u-PVC DN80 cấp sang RO", _
                "Toàn cảnh Skid Inox 304 Khung bệ" _
            }

            For Each cName In chipNames
                Dim btnChip As New System.Windows.Forms.Button()
                btnChip.Text = cName
                btnChip.AutoSize = True
                btnChip.Height = 26
                btnChip.BackColor = System.Drawing.Color.FromArgb(241, 245, 249)
                btnChip.ForeColor = System.Drawing.Color.FromArgb(30, 41, 59)
                btnChip.Font = New System.Drawing.Font("Segoe UI", 8.2F, System.Drawing.FontStyle.Regular)
                btnChip.FlatStyle = FlatStyle.Flat
                btnChip.FlatAppearance.BorderColor = System.Drawing.Color.FromArgb(203, 213, 225)
                Dim selName As String = cName
                AddHandler btnChip.Click, Sub()
                    txt.Text = selName
                    f.DialogResult = DialogResult.OK
                    f.Close()
                End Sub
                pnlChips.Controls.Add(btnChip)
            Next

            Dim btnOk As New System.Windows.Forms.Button()
            btnOk.Text = "ĐỒNG Ý (Enter)"
            btnOk.DialogResult = DialogResult.OK
            btnOk.Location = New System.Drawing.Point(295, 218)
            btnOk.Size = New System.Drawing.Size(125, 36)
            btnOk.BackColor = System.Drawing.Color.FromArgb(16, 185, 129)
            btnOk.ForeColor = System.Drawing.Color.White
            btnOk.Font = New System.Drawing.Font("Segoe UI", 9.0F, System.Drawing.FontStyle.Bold)
            btnOk.FlatStyle = FlatStyle.Flat
            btnOk.FlatAppearance.BorderSize = 0
            f.Controls.Add(btnOk)

            Dim btnCancel As New System.Windows.Forms.Button()
            btnCancel.Text = "KẾT THÚC (ESC)"
            btnCancel.DialogResult = DialogResult.Cancel
            btnCancel.Location = New System.Drawing.Point(430, 218)
            btnCancel.Size = New System.Drawing.Size(95, 36)
            btnCancel.BackColor = System.Drawing.Color.FromArgb(226, 232, 240)
            btnCancel.ForeColor = System.Drawing.Color.FromArgb(71, 85, 105)
            btnCancel.FlatStyle = FlatStyle.Flat
            btnCancel.FlatAppearance.BorderSize = 0
            f.Controls.Add(btnCancel)

            f.AcceptButton = btnOk
            f.CancelButton = btnCancel
            AddHandler f.Shown, Sub()
                txt.Focus()
                txt.SelectAll()
            End Sub

            If f.ShowDialog() = DialogResult.OK Then
                Return txt.Text.Trim()
            Else
                Return ""
            End If
        End Using
    End Function

    Private Sub PickAndAddLandmark(ByVal app As Inventor.Application, ByVal doc As AssemblyDocument, ByRef cfgFovDeg As Integer)
        Dim addedCount As Integer = 0
        Dim docDir As String = System.IO.Path.GetDirectoryName(doc.FullFileName)
        Dim manifestPath As String = System.IO.Path.Combine(docDir, "episode_manifest.json")

        Try
            If m_OrderedPoints.Count > 0 Then
                Dim resetAns = MessageBox.Show(String.Format("Hiện đang có {0} Điểm Vàng trong hành trình." & vbCrLf & vbCrLf & _
                                                             "• Bấm YES: Tạo mới hoàn toàn từ Bước 1 (Xóa điểm cũ)" & vbCrLf & _
                                                             "• Bấm NO: Chấm nối tiếp vào cuối danh sách hiện tại" & vbCrLf & _
                                                             "• Bấm CANCEL: Hủy thao tác", m_OrderedPoints.Count), _
                                               "WT3D Multi-Pick • Chế Độ Chấm Điểm Vàng", MessageBoxButtons.YesNoCancel, MessageBoxIcon.Question)
                If resetAns = DialogResult.Cancel Then Return
                If resetAns = DialogResult.Yes Then
                    m_Points.Clear()
                    m_OrderedPoints.Clear()
                End If
            End If

            ' VÒNG LẶP CHỌN ĐIỂM VÀNG LIÊN TỤC (MULTI-PICK CONTINUOUS WORKFLOW)
            ' CHO PHÉP CHẤM 1 CHUỖI CÁC ĐIỂM LIÊN TIẾP, BẤM ESC ĐỂ KẾT THÚC!
            Do
                Dim nextStepNum As Integer = m_OrderedPoints.Count + 1
                Dim promptMsg As String = String.Format("👉 [ĐIỂM {0}] Bấm chuột trái vào mặt phẳng 3D thiết bị (Hoặc bấm ESC / nhấp chuột ra ngoài để KẾT THÚC CHUỖI)...", nextStepNum)
                app.StatusBarText = promptMsg

                Dim selObj As Object = Nothing
                Try
                    selObj = app.CommandManager.Pick(SelectionFilterEnum.kAllPlanarEntities, promptMsg)
                Catch
                    selObj = Nothing
                End Try

                ' NẾU NGƯỜI DÙNG BẤM ESC HOẶC KHÔNG CHỌN GÌ -> THOÁT VÒNG LẶP LIÊN TỤC!
                If selObj Is Nothing Then Exit Do

                Dim face As Face = TryCast(selObj, Face)
                If face Is Nothing Then Continue Do

                ' 1. BẮT TRỌN VẸN THÔNG SỐ KHUNG NHÌN HIỆN TẠI CỦA NGƯỜI DÙNG (DIRECTOR'S VIEWFINDER)
                Dim activeCam As Camera = app.ActiveView.Camera
                Dim camEye As New Vec3(activeCam.Eye.X, activeCam.Eye.Y, activeCam.Eye.Z)
                Dim curFov As Double = activeCam.PerspectiveAngle

                ' 2. Lấy tọa độ điểm 3D trên thiết bị mà người dùng click chọn
                Dim pt As Inventor.Point = face.PointOnFace
                Dim tgtPoint As New Vec3(pt.X, pt.Y, pt.Z)

                ' 3. Vector hướng nhìn (View Vector): Bắt CHÍNH XÁC từ góc máy mà người dùng đang nhìn trên màn hình!
                Dim viewVec As Vec3 = (camEye - tgtPoint).Normalize()
                If viewVec.Length() < 0.1 Then
                    viewVec = New Vec3(0.5774, 0.5774, 0.5774)
                End If

                ' 4. Cự ly phóng to/thu nhỏ (Zoom Clearance): Khoảng cách thực tế từ mắt camera đến chi tiết máy
                Dim userDist As Double = camEye.DistanceTo(tgtPoint)
                Dim clr As Double = Math.Max(20.0, userDist)
                Dim fov As Double = Math.Max(0.2, Math.Min(1.6, curFov))
                cfgFovDeg = Math.Max(20, Math.Min(90, CInt(Math.Round(fov * 180.0 / Math.PI))))

                ' 5. GỢI Ý NHANH THEO SỐ THỨ TỰ (VD: 1 NƯỚC VÀO, 2 LỌC TINH, 3 UF...)
                Dim quickVietNames As String() = { _
                    "Cổng cấp nước thô u-PVC DN80", _
                    "Phin lọc tinh đôi 40 inch", _
                    "Áp kế đo chênh áp", _
                    "Dàn màng siêu lọc UF PVDF", _
                    "Xả cặn UF", _
                    "Cột làm mềm composite FRP 2472", _
                    "Van tự động 5 chu trình", _
                    "Thùng muối hoàn nguyên 500L", _
                    "Cổng nước mềm u-PVC DN80 cấp sang RO", _
                    "Toàn cảnh Skid Inox 304 Khung bệ" _
                }
                Dim defaultInput As String = ""
                If nextStepNum <= quickVietNames.Length Then
                    defaultInput = nextStepNum.ToString() & ". " & quickVietNames(nextStepNum - 1)
                Else
                    defaultInput = String.Format("{0}. Điểm Vàng {0}", nextStepNum)
                End If

                Dim rawInput As String = PromptInput("Nhập nhanh theo cú pháp: [SỐ] [TÊN THIẾT BỊ]" & vbCrLf & _
                                                     "Ví dụ: 1 NƯỚC VÀO, 2 LỌC TINH, 3 UF, 4 BỒN LÀM MỀM..." & vbCrLf & vbCrLf & _
                                                     "• Đã tự động bắt: Zoom " & clr.ToString("F0") & "mm | FOV " & (fov * 180.0 / Math.PI).ToString("F0") & "°" & vbCrLf & _
                                                     "• Bấm Enter để chấp nhận nhanh | Bấm ESC để dừng chuỗi", _
                                                     String.Format("Chấm Điểm Vàng Bước {0} (Chế Độ Liên Tục)", nextStepNum), defaultInput)
                
                ' Nếu người dùng bấm Hủy (ESC) ở hộp thoại nhập tên:
                If String.IsNullOrWhiteSpace(rawInput) Then
                    Dim ans = MessageBox.Show("Anh muốn KẾT THÚC chuỗi chọn điểm vàng liên tục hay tiếp tục chọn điểm khác?", _
                                              "WT3D Multi-Pick", MessageBoxButtons.YesNo, MessageBoxIcon.Question)
                    If ans = DialogResult.Yes Then Exit Do Else Continue Do
                End If

                ' TỰ ĐỘNG BÓC TÁCH THÔNG MINH (SMART QUICK NOTE PARSER)
                Dim flowStep As Integer = nextStepNum
                Dim nameVi As String = rawInput.Trim()
                Dim m As Match = Regex.Match(rawInput.Trim(), "^([0-9]+)[\s.\-_]*(.*)$")
                If m.Success Then
                    flowStep = Integer.Parse(m.Groups(1).Value)
                    Dim restName As String = m.Groups(2).Value.Trim()
                    If Not String.IsNullOrWhiteSpace(restName) Then
                        nameVi = restName
                    End If
                End If

                ' Tạo tag ngắn gọn chuẩn WBS
                Dim cleanSlug As String = Regex.Replace(nameVi, "[^a-zA-Z0-9]+", "-").Trim("-"c).ToUpper()
                If String.IsNullOrWhiteSpace(cleanSlug) Then cleanSlug = "ITEM"
                Dim tag As String = String.Format("STEP{0:D2}-{1}", flowStep, cleanSlug)
                If tag.Length > 24 Then tag = tag.Substring(0, 24)

                Dim newPt As New PinnedPoint(tag, nameVi, tgtPoint, viewVec, clr, fov, flowStep, nameVi)
                m_Points(tag) = newPt

                ' Cập nhật danh sách và TỰ ĐỘNG SẮP XẾP THEO FLOW_STEP TĂNG DẦN
                m_OrderedPoints.RemoveAll(Function(p) p.Tag = tag)
                m_OrderedPoints.Add(newPt)
                m_OrderedPoints.Sort(Function(a, b) a.FlowStep.CompareTo(b.FlowStep))

                ' Lưu ngay vào file manifest
                SaveManifestToFile(manifestPath)
                addedCount += 1

                app.StatusBarText = String.Format("✅ ĐÃ LƯU BƯỚC {0}: {1} (FOV {2:F0}°)! Hãy click tiếp điểm tiếp theo (hoặc bấm ESC để dừng)...", _
                                                  flowStep, nameVi, fov * 180.0 / Math.PI)
            Loop

            If addedCount > 0 Then
                app.StatusBarText = String.Format("🎉 ĐÃ HOÀN TẤT: Đã ghi nhận thành công {0} Điểm Vàng mới vào hành trình!", addedCount)
                MessageBox.Show(String.Format("✅ ĐÃ HOÀN TẤT CHUỖI CHẤM ĐIỂM VÀNG LIÊN TỤC!" & vbCrLf & vbCrLf & _
                                              "• Số điểm vàng vừa thêm: {0} điểm" & vbCrLf & _
                                              "• Tổng số điểm trong hành trình: {1} điểm" & vbCrLf & _
                                              "• Đã lưu vào: {2}" & vbCrLf & vbCrLf & _
                                              "🎬 Bảng điều khiển đã cập nhật toàn bộ Waypoints mới!", _
                                              addedCount, m_OrderedPoints.Count, manifestPath), _
                                "WT3D Multi-Pick Hoàn Tất", MessageBoxButtons.OK, MessageBoxIcon.Information)
            Else
                app.StatusBarText = "Đã kết thúc chế độ chọn điểm vàng liên tục."
            End If

        Catch ex As Exception
            MessageBox.Show("Lỗi trong chuỗi chấm điểm vàng: " & ex.Message, "WT3D Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
        End Try
    End Sub

    Private Sub SaveManifestToFile(ByVal path As String)
        Try
            Dim sb As New StringBuilder()
            sb.AppendLine("{")
            sb.AppendLine("  ""series_title"": """ & m_SeriesTitle & """,")
            sb.AppendLine("  ""episode_id"": """ & m_EpisodeId & """,")
            sb.AppendLine("  ""episode_title"": """ & m_EpisodeTitle & """,")
            sb.AppendLine("  ""audio_master_file"": """ & m_AudioMasterFile & """,")
            sb.AppendLine("  ""landmarks"": [")

            For i As Integer = 0 To m_OrderedPoints.Count - 1
                Dim p = m_OrderedPoints(i)
                sb.AppendLine("    {")
                sb.AppendLine("      ""tag"": """ & p.Tag & """,")
                sb.AppendLine("      ""name_vi"": """ & p.NameVi & """,")
                sb.AppendLine("      ""target"": [" & p.Target.X.ToString("F4", System.Globalization.CultureInfo.InvariantCulture) & ", " & _
                                                       p.Target.Y.ToString("F4", System.Globalization.CultureInfo.InvariantCulture) & ", " & _
                                                       p.Target.Z.ToString("F4", System.Globalization.CultureInfo.InvariantCulture) & "],")
                sb.AppendLine("      ""view_vector"": [" & p.Vector.X.ToString("F4", System.Globalization.CultureInfo.InvariantCulture) & ", " & _
                                                            p.Vector.Y.ToString("F4", System.Globalization.CultureInfo.InvariantCulture) & ", " & _
                                                            p.Vector.Z.ToString("F4", System.Globalization.CultureInfo.InvariantCulture) & "],")
                sb.AppendLine("      ""clearance"": " & p.Clearance.ToString("F1", System.Globalization.CultureInfo.InvariantCulture) & ",")
                sb.AppendLine("      ""best_fov"": " & p.BestFov.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) & ",")
                sb.AppendLine("      ""flow_step"": " & p.FlowStep & ",")
                sb.AppendLine("      ""stage_role"": """ & p.StageRole & """")
                sb.Append("    }")
                If i < m_OrderedPoints.Count - 1 Then sb.AppendLine(",") Else sb.AppendLine()
            Next

            sb.AppendLine("  ]")
            sb.AppendLine("}")
            System.IO.File.WriteAllText(path, sb.ToString(), New System.Text.UTF8Encoding(False))
        Catch : End Try
    End Sub

    ' --------------------------------------------------------------------------
    ' 9. HỘP THOẠI ĐIỀU KHIỂN APPLE BENTO (STUDIO DIRECTOR PANEL)
    ' --------------------------------------------------------------------------
    Public Sub Main()
        Dim app As Inventor.Application = ThisApplication
        Dim doc As AssemblyDocument = TryCast(app.ActiveDocument, AssemblyDocument)

        If doc Is Nothing Then
            MessageBox.Show("Vui lòng mở file cụm lắp ráp Assembly (.iam) trước khi khởi chạy!", _
                            "WT3D Camera Director", MessageBoxButtons.OK, MessageBoxIcon.Warning)
            Return
        End If

        ' NẾU BẢNG ĐIỀU KHIỂN CŨ ĐANG MỞ: ĐÓNG LẠI ĐỂ KHỞI TẠO GIAO DIỆN MỚI NHẤT
        If s_DirectorForm IsNot Nothing AndAlso Not s_DirectorForm.IsDisposed Then
            Try
                s_DirectorForm.Close()
                s_DirectorForm.Dispose()
            Catch : End Try
            s_DirectorForm = Nothing
        End If

        Dim compDef As AssemblyComponentDefinition = doc.ComponentDefinition
        Dim view As Inventor.View = app.ActiveView
        Dim cam As Camera = view.Camera

        Dim totalBox As Box = compDef.RangeBox
        Dim cx As Double = (totalBox.MinPoint.X + totalBox.MaxPoint.X) * 0.5
        Dim cy As Double = (totalBox.MinPoint.Y + totalBox.MaxPoint.Y) * 0.5
        Dim cz As Double = (totalBox.MinPoint.Z + totalBox.MaxPoint.Z) * 0.5
        Dim center As New Vec3(cx, cy, cz)

        Dim dx As Double = Math.Abs(totalBox.MaxPoint.X - totalBox.MinPoint.X)
        Dim dy As Double = Math.Abs(totalBox.MaxPoint.Y - totalBox.MinPoint.Y)
        Dim dz As Double = Math.Abs(totalBox.MaxPoint.Z - totalBox.MinPoint.Z)
        Dim radius As Double = Math.Sqrt(dx * dx + dy * dy + dz * dz) * 0.5

        LoadEpisodeManifest(doc, center, radius)

        ' Kích hoạt ngay Ánh Sáng Studio Sáng Trong Tỷ Lệ Vàng khi vừa mở bảng Director
        Try
            Dim initEye As New Vec3(cam.Eye.X, cam.Eye.Y, cam.Eye.Z)
            Dim initTgt As New Vec3(cam.Target.X, cam.Target.Y, cam.Target.Z)
            Dim initUp As New Vec3(cam.UpVector.X, cam.UpVector.Y, cam.UpVector.Z)
            UpdateDynamicLightingRig(doc, view, initEye, initTgt, initUp, app.TransientGeometry)
            view.Update()
        Catch : End Try

        Dim cfgStyle As Integer = 5 ' Mặc định Style 5: Chế độ quay Full Mô Tả Quy Trình
        Dim cfgRes As Integer = 1
        Dim cfgDuration As Integer = 66 ' Mặc định 66 giây Full Mô Tả
        Dim cfgFps As Integer = 30
        Dim cfgAction As String = "CANCEL"
        Dim cfgDynamicLight As Boolean = True
        Dim cfgAntiAliasMode As Integer = 1 ' 1: SSAA 1.5X, 2: Hardware MSAA, 3: SSAA 2.0X, 4: Native 1.0X
        Dim cfgSpeedMultiplier As Double = 0.65 ' Mặc định 0.65x Chậm rãi đĩnh đạc
        Dim cfgSpeedIndex As Integer = 0
        Dim cfgDurIndex As Integer = 2 ' Mặc định chọn 66 Giây (Full Mô Tả Quy Trình)
        Dim cfgFpsIndex As Integer = 0
        Dim cfgFovDeg As Integer = 50
        Try
            If cam.Perspective Then
                cfgFovDeg = Math.Max(20, Math.Min(90, CInt(Math.Round(cam.PerspectiveAngle * 180.0 / Math.PI))))
            Else
                cfgFovDeg = 50
            End If
        Catch
            cfgFovDeg = 50
        End Try

        Dim needPickLandmark As Boolean = False

        Dim dlg As New System.Windows.Forms.Form()
        s_DirectorForm = dlg
        dlg.Text = "★ WT3D CINEMATIC DIRECTOR V8.4 • " & m_EpisodeId & " (" & m_OrderedPoints.Count & " ĐIỂM VÀNG)"
        dlg.Size = New System.Drawing.Size(600, 930)
        dlg.StartPosition = FormStartPosition.Manual
        dlg.Location = New System.Drawing.Point(30, 60)
        dlg.FormBorderStyle = FormBorderStyle.FixedDialog
        dlg.MaximizeBox = False
        dlg.MinimizeBox = True
        dlg.TopMost = True
        dlg.BackColor = System.Drawing.Color.FromArgb(248, 250, 252)
        dlg.Font = New System.Drawing.Font("Segoe UI", 9.5F, System.Drawing.FontStyle.Regular)

        AddHandler dlg.FormClosed, Sub()
            s_DirectorForm = Nothing
        End Sub

                Dim pnlHeader As New System.Windows.Forms.Panel()
                pnlHeader.Dock = DockStyle.Top
                pnlHeader.Height = 88
                pnlHeader.BackColor = System.Drawing.Color.FromArgb(255, 255, 255)
                dlg.Controls.Add(pnlHeader)

                Dim lblTitle As New System.Windows.Forms.Label()
                lblTitle.Text = "★ " & m_SeriesTitle & " • " & m_EpisodeId
                lblTitle.Font = New System.Drawing.Font("Segoe UI", 11.5F, System.Drawing.FontStyle.Bold)
                lblTitle.ForeColor = System.Drawing.Color.FromArgb(15, 23, 42)
                lblTitle.Location = New System.Drawing.Point(20, 12)
                lblTitle.AutoSize = True
                pnlHeader.Controls.Add(lblTitle)

                Dim lblSub As New System.Windows.Forms.Label()
                lblSub.Text = m_EpisodeTitle & " • " & m_OrderedPoints.Count & " Điểm Vàng • Quay Full Mô Tả Quy Trình"
                lblSub.Font = New System.Drawing.Font("Segoe UI", 8.8F, System.Drawing.FontStyle.Regular)
                lblSub.ForeColor = System.Drawing.Color.FromArgb(100, 116, 139)
                lblSub.Location = New System.Drawing.Point(22, 44)
                lblSub.AutoSize = True
                pnlHeader.Controls.Add(lblSub)

                ' HUY HIỆU GIÁM SÁT RAM BẢO VỆ CHỐNG TREO MÁY (RAM SENTINEL BADGE)
                Dim curRamInit As Double = GetCurrentRamMB()
                Dim lblRamInfo As New System.Windows.Forms.Label()
                lblRamInfo.Text = "✓ RAM: " & curRamInit.ToString("F0") & " MB"
                lblRamInfo.Font = New System.Drawing.Font("Segoe UI", 8.5F, System.Drawing.FontStyle.Bold)
                lblRamInfo.ForeColor = System.Drawing.Color.FromArgb(16, 185, 129)
                lblRamInfo.Location = New System.Drawing.Point(435, 14)
                lblRamInfo.Size = New System.Drawing.Size(130, 20)
                lblRamInfo.TextAlign = System.Drawing.ContentAlignment.MiddleRight
                pnlHeader.Controls.Add(lblRamInfo)

                Dim sep As New System.Windows.Forms.Panel()
                sep.Dock = DockStyle.Bottom
                sep.Height = 1
                sep.BackColor = System.Drawing.Color.FromArgb(226, 232, 240)
                pnlHeader.Controls.Add(sep)

                Dim bodyY As Integer = 100

                ' 1. CHỌN PHONG CÁCH QUAY
                Dim lbl1 As New System.Windows.Forms.Label()
                lbl1.Text = "1. PHONG CÁCH ĐẠO DIỄN HOLLYWOOD (CINEMATIC STYLE)"
                lbl1.Font = New System.Drawing.Font("Segoe UI", 9.0F, System.Drawing.FontStyle.Bold)
                lbl1.ForeColor = System.Drawing.Color.FromArgb(51, 65, 85)
                lbl1.Location = New System.Drawing.Point(24, bodyY)
                lbl1.AutoSize = True
                dlg.Controls.Add(lbl1)
                bodyY += 24

                Dim cmbStyle As New System.Windows.Forms.ComboBox()
                cmbStyle.DropDownStyle = ComboBoxStyle.DropDownList
                cmbStyle.Items.Add("❖ Style 1: Hero Commercial (Góc thấp vươn cao, Parallax, Reveal)")
                cmbStyle.Items.Add("✦ Style 2: FPV Drone Pipe Alley (Bay luồn lách qua cụm ống lọc)")
                cmbStyle.Items.Add("◈ Style 3: Sci-Fi Tech Macro Scan (Telephoto 85mm, Dolly Zoom Vertigo)")
                cmbStyle.Items.Add("● Style 4: 360° Studio Turntable Deluxe (Đế xoay triển lãm, lượn sóng sin)")
