                    Dim eT As Double = Math.Sin(t * Math.PI / 2)
                    chk_ParamScaled = True
                    curR = maxDim * activeProfile.CameraRadiusFactor * 0.35
                    Dim eyeYMFS As Double = cY + dy*0.3*mY + mEyeDrop + safeYGap
                    oCam.Eye = tg.CreatePoint(cX + curR * Math.Cos(Math.PI*1.1)*eyeX, eyeYMFS, cZ + curR * Math.Sin(Math.PI*1.1)*eyeZ)
                    oCam.Target = tg.CreatePoint(cX + dx*0.25 * tarZ, cY + dy*0.3 * mY, cZ + dz*0.25 * tarX) 
                    oCam.UpVector = tg.CreateUnitVector(0, 1, 0)
                    oCam.ApplyWithoutTransition() : oCam.SaveAsBitmap(exportDir & "\frame_" & fc.ToString("000") & ".png", 1080, 1920) : fc += 1
                Next
                VisualAnchorPause(oCam, 3, exportDir, fc)

            Case "Slow_Macro_Creep" ' Đứng yên ở 1 góc siêu cận và nhích rất chậm
                Dim startAngle As Double = Math.PI * 1.7
                For i As Integer = 1 To 60
                    Dim t As Double = i / 60.0
                    chk_ParamScaled = True
                    curR = maxDim * activeProfile.CameraRadiusFactor * (0.45 - 0.05 * t) 
                    Dim eyeYSMC As Double = cY + dy*0.35*mY + mEyeDrop + safeYGap
                    Dim tarYSMC As Double = cY + dy*0.35 * mY
                    oCam.Eye = tg.CreatePoint(cX + curR * Math.Cos(startAngle) * eyeX, eyeYSMC, cZ + curR * Math.Sin(startAngle) * eyeZ)
                    oCam.Target = tg.CreatePoint(cX + dx*0.25 * tarX, tarYSMC, cZ + dz*0.25 * tarZ) 
                    oCam.UpVector = tg.CreateUnitVector(0, 1, 0)
                    oCam.ApplyWithoutTransition() : oCam.SaveAsBitmap(exportDir & "\frame_" & fc.ToString("000") & ".png", 1080, 1920) : fc += 1
                Next
                VisualAnchorPause(oCam, 4, exportDir, fc)

            Case "Internal_Core_Sweep" ' Lặn sâu vào tâm nội tạng (B2B Deep Penetration)
                Dim asmDef As AssemblyComponentDefinition = Nothing
                If oDoc.DocumentType = DocumentTypeEnum.kAssemblyDocumentObject Then
                    asmDef = oDoc.ComponentDefinition
                    Try 
                        asmDef.RepresentationsManager.DesignViewRepresentations.Item("VR_3_NAKED").Activate()
                    Catch 
                    End Try
                End If

                oCam.SetExtents(initExtW * 0.45, initExtH * 0.45) ' Zoom Siêu Cận Cảnh (Extreme Macro / Tight FOV)
                
                For i As Integer = 1 To 75
                    Dim t As Double = i / 75.0
                    Dim eT As Double = Math.Pow(t, 1.2) ' Tốc độ trượt đều đặn êm ái
                    
                    ' Lùi xa 0.8 (đủ lách khỏi gờ khung nhôm) -> đâm thọc sâu tới rốn 0.15
                    chk_ParamScaled = True
                    curR = maxDim * activeProfile.CameraRadiusFactor * (0.8 - 0.65 * eT)
                    theta = Math.PI * activeProfile.MaxAngularSpeed * 0.25 - (Math.PI * 0.15) * eT ' Ống kính vuốt ngang linh kiện nhẹ nhàng
                    
                    ' Bay là là từ dưới lên ngang rốn
                    Dim sweepY As Double = cY - dy * 0.15 + (dy * 0.2) * eT
                    
                    oCam.Eye = tg.CreatePoint(cX + curR * Math.Cos(theta), sweepY, cZ + curR * Math.Sin(theta))
                    oCam.Target = tg.CreatePoint(cX, cY - dy * 0.05, cZ)
                    oCam.UpVector = tg.CreateUnitVector(0, 1, 0)
                    
                    oCam.ApplyWithoutTransition() 
                    ThisApplication.UserInterfaceManager.DoEvents()
                    oView.Update()
                    oCam.SaveAsBitmap(exportDir & "\frame_" & fc.ToString("000") & ".png", 1080, 1920) : fc += 1
                Next
                
                Try 
                    If asmDef IsNot Nothing Then 
                        asmDef.RepresentationsManager.DesignViewRepresentations.Item("Default").Activate()
                    End If
                Catch 
                End Try
                VisualAnchorPause(oCam, 4, exportDir, fc)

            ' -------------------------------------------------------------
            ' KHỐI GỌN/LINH KIỆN (COMPACT / CONTROL COMPONENT)
            ' -------------------------------------------------------------
            Case "Dynamic_Section_MRI" 
                If oDoc.DocumentType = DocumentTypeEnum.kAssemblyDocumentObject Then
                    Dim asmDef As AssemblyComponentDefinition = CType(oDoc, AssemblyDocument).ComponentDefinition
                    Dim basePlane As WorkPlane = Nothing
                    Try
                        basePlane = asmDef.WorkPlanes.Item(1) 
                    Catch
                    End Try
                    If basePlane Is Nothing Then
                        Try : basePlane = asmDef.WorkPlanes.AddByPlaneAndOffset(asmDef.WorkPlanes.Item(3), 0) : Catch : End Try
                    End If
                    If basePlane IsNot Nothing Then
                        Dim startCut As Double = (dx / 2) + 2.0 
                        Dim endCut As Double = 0.0 
                        Dim mriPlane As WorkPlane = asmDef.WorkPlanes.AddByPlaneAndOffset(basePlane, startCut)
                        mriPlane.Visible = False
                        chk_ParamScaled = True
                    curR = maxDim * activeProfile.CameraRadiusFactor * 1.25
                        oCam.Eye = tg.CreatePoint(cX + curR * Math.Cos(Math.PI * 0.25), cY + dy * 0.4, cZ + curR * Math.Sin(Math.PI * 0.25))
                        oCam.Target = tg.CreatePoint(cX, cY - dy * 0.1, cZ)
                        oCam.UpVector = SolveUpVector(oCam.Eye, oCam.Target, tg)
                        Dim mriFrames As Integer = 75 
                        For i As Integer = 1 To mriFrames
                            Dim t As Double = i / CDbl(mriFrames)
                            Dim eT As Double = 1.0 - Math.Pow(1.0 - t, 2.5) 
                            Dim curOffset As Double = startCut - (startCut - endCut) * eT
                            mriPlane.SetByPlaneAndOffset(basePlane, curOffset)
                            oDoc.Update2(True) 
                            oView.SetHalfSectionView(mriPlane)
                            oView.Update()
                            oCam.ApplyWithoutTransition() 
                            oCam.SaveAsBitmap(exportDir & "\frame_" & fc.ToString("000") & ".png", 1080, 1920) 
                            fc += 1
                            ThisApplication.UserInterfaceManager.DoEvents() 
                        Next
                        VisualAnchorPause(oCam, 4, exportDir, fc) 
                        oView.SetSectionView(SectionViewTypeEnum.kNoSectionView)
                        Try : mriPlane.Delete() : Catch : End Try
                        oDoc.Update2(True)
                    End If
                End If

