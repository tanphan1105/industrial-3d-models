
' ===== V6.4.4 PRE-FLIGHT SIMULATION =====
If RiskScore >= 0.9 Then
    EngineHealthScore -= 10
    logReport.AppendLine("PRE_FLIGHT: HIGH RISK DETECTED")
End If



Sub Main()
    ' [V5.0] GLOBAL CHECKLIST FLAGS
    Dim chk_ProfileDetected As Boolean = False
    Dim chk_ShotBlocked As Boolean = False
    Dim chk_ParamScaled As Boolean = False
    Dim chk_IBLAllowed As Boolean = False
    Dim chk_SafeProfileUsed As Boolean = False
    Dim chk_LearningOverride As Boolean = False
    Dim RiskScore As Double = 0.0
    Dim RiskPattern As String = "NONE"
    Dim OverrideSource As String = "RULE"
    Dim blockedShotCount As Integer = 0
    Dim EngineHealthScore As Integer = 100
    Dim logReport As New System.Text.StringBuilder()
    Dim LearningBuffer As New List(Of String)()

    Dim GlobalSafetyMode As Integer = 1 ' 0:Aggressive, 1:Balanced, 2:Safe
    
    Dim oDoc As Document = ThisDoc.Document
    Dim baseName As String = System.IO.Path.GetFileNameWithoutExtension(oDoc.FullFileName)
    ThisApplication.StatusBarText = "[MAXSKILLS 4.2 AI] Phân tích ngữ nghĩa: " & baseName
    
    ' ==============================================
    ' 1. Trí tuệ Phân loại Đa tầng (SmartClassifyAI)
    ' ==============================================
    Dim activeProfile As ModelProfile = SmartClassifyAI(oDoc)
    If activeProfile.Name <> "SafeProfile" Then
        chk_ProfileDetected = True
    Else
        chk_SafeProfileUsed = True
        EngineHealthScore -= 30
    End If
    
    Dim partCount As Integer = 0
    If oDoc.DocumentType = DocumentTypeEnum.kAssemblyDocumentObject Then
        partCount = CType(oDoc, AssemblyDocument).ComponentDefinition.Occurrences.AllLeafOccurrences.Count
    End If

    ApplyLearningGovernor(activeProfile, partCount, RiskScore, RiskPattern, chk_LearningOverride)
    
    ' Layer 4: [V6.1] PRE-FLIGHT RISK SIMULATION (Shadow Mode)
    If RiskScore >= 0.9 Then
        EngineHealthScore -= 10 ' Cảnh báo sớm
        logReport.AppendLine("PreFlight-Status: HIGH_RISK_DETECTED")
    End If

    
    ' [V6.2] PRE-FLIGHT SIMULATION LAYER
    If RiskScore >= 0.9 Then
        EngineHealthScore -= 10
        logReport.AppendLine("PRE_FLIGHT: HIGH RISK DETECTED")
    End If

    


    Dim vWeight As String = If(activeProfile.Name = "Dense_Piping", "Heavy", "Light")
    
    ' Gán Ý đồ Bán hàng (Commercial Intent) - Khởi tạo mặc định
    Dim commercialIntent As String = "Hero_Product" ' Có thể đổi thành Catalog_Item
    
    ThisApplication.StatusBarText = "[MAXSKILLS V6.0] Profile: " & activeProfile.Name & " | RiskScore=" & RiskScore
    logReport.AppendLine("=== MAXSKILLS V6.0 ADAPTIVE REPORT ===")
    logReport.AppendLine("ProfileDetected: " & activeProfile.Name)
    
    ' ==============================================
    ' 2. AI Director Decision Tree (Lập kịch bản)
    ' ==============================================
    Dim cameraPresets As List(Of String) = SelectCinematicCameraAI(activeProfile.Name, "General_Part", vWeight, commercialIntent)
    
    ' ==============================================
    ' 3. THIẾT LẬP MÔI TRƯỜNG QUAY
    ' ==============================================
    Dim oView As Inventor.View = ThisApplication.ActiveView
    Dim oCam As Inventor.Camera = oView.Camera
    
    Try
        ' ĐÃ FIX LỖI SILENT NÊN BÂY GIỜ SHADED_WITH_EDGES SẼ VẪN RENDER ĐƯỢC KÍNH TRONG SUỐT (NHỜ CARD ĐỒ HỌA ĐÃ ACTIVE)
        oView.DisplayMode = DisplayModeEnum.kShadedWithEdgesRendering
        ThisApplication.ColorSchemes.BackgroundType = BackgroundTypeEnum.kOneColorBackgroundType
        Try
            oDoc.ActiveLightingStyle = oDoc.LightingStyles.Item("Photo Booth")
        Catch
            Try : oDoc.ActiveLightingStyle = oDoc.LightingStyles.Item("Empty Lab") : Catch : End Try
        End Try
        oView.ShowGroundShadows = True
        oView.ShowAmbientShadows = True
        oView.ShowObjectShadows = True

        ' Tự động dọn rác khung hình (Tắt hêt Mặt phẳng, Trục, Điểm, Sketch thừa)
        Try
            oDoc.ObjectVisibility.AllWorkFeatures = False
            oDoc.ObjectVisibility.Sketches = False
            oDoc.ObjectVisibility.Sketches3D = False
            oDoc.ObjectVisibility.WeldmentSymbols = False
            oDoc.ObjectVisibility.ConstructionSurfaces = False
        Catch : End Try
    Catch : End Try
    
    oCam.Perspective = True
    
    Dim cX As Double = 0, cY As Double = 0, cZ As Double = 0
    Dim maxDim As Double = 100
    Dim dx As Double = 100, dy As Double = 100, dz As Double = 100
    
    If oDoc.DocumentType = DocumentTypeEnum.kAssemblyDocumentObject Then
        Dim oAsm As AssemblyDocument = CType(oDoc, AssemblyDocument)
        Dim rB As Box = oAsm.ComponentDefinition.RangeBox
        dx = rB.MaxPoint.X - rB.MinPoint.X
        dy = rB.MaxPoint.Y - rB.MinPoint.Y
        dz = rB.MaxPoint.Z - rB.MinPoint.Z
        cX = rB.MinPoint.X + dx / 2
        cY = rB.MinPoint.Y + dy * 0.4
        cZ = rB.MinPoint.Z + dz / 2
        maxDim = Math.Max(dx, Math.Max(dy, dz))
    End If
    
    ' ==============================================
    ' 4. THỰC THI QUAY PHIM
    ' ==============================================
    Dim exportDir As String = "d:\WT3D_Project\1_Exports_Batch\" & baseName & "\MAXSKILLS_SHORTS"
    If Not System.IO.Directory.Exists(exportDir) Then System.IO.Directory.CreateDirectory(exportDir)
    For Each f In System.IO.Directory.GetFiles(exportDir, "*.png")
        Try : System.IO.File.Delete(f) : Catch : End Try
    Next

    Dim tg As TransientGeometry = ThisApplication.TransientGeometry
    
    ' ==============================================
    ' 3.5 BẮT BUỘC CHUẨN HÓA CAMERA TRƯỚC KHI QUAY
    ' Xóa bỏ lỗi rác khung hình (Zoom/Pan lỡ chân của người dùng)
    ' ==============================================
    oCam.Perspective = True
    oCam.Target = tg.CreatePoint(cX, cY, cZ)
    oCam.UpVector = tg.CreateUnitVector(0, 1, 0)
    oCam.ViewOrientationType = ViewOrientationTypeEnum.kIsoTopRightViewOrientation
    oCam.Fit()
    Dim initExtW, initExtH As Double
    oCam.GetExtents(initExtW, initExtH)
    
    ' [AI DIRECTOR] 4. THUMBNAIL KILLER (Kích thích thị giác)
    ' Xử lý riêng cho mô hình Flat (băng chuyền dài) để không xén chiều dọc
    Dim thumbExt As Double = If(activeProfile.Name = "Horizontal_Long", 0.95, 0.65)
    oCam.SetExtents(initExtW * thumbExt, initExtH * thumbExt)
    oCam.ApplyWithoutTransition()
    
    ' [V5.0] DUAL THRESHOLD ADAPTIVE CAPTURE
    Dim captureW As Integer = 3840
    Dim captureH As Integer = 2160
    If oDoc.DocumentType = DocumentTypeEnum.kAssemblyDocumentObject Then
        Dim oAsm As AssemblyDocument = CType(oDoc, AssemblyDocument)
        Dim ptsCount As Integer = oAsm.ComponentDefinition.Occurrences.AllLeafOccurrences.Count
        Dim bboxVol As Double = dx * dy * dz
        Dim volThreshold As Double = 1200000000 ' 1.2e9
        If GlobalSafetyMode = 2 Or ptsCount > 450 Or bboxVol > volThreshold Then
            captureW = 2560
            captureH = 1440
        ElseIf GlobalSafetyMode = 0 Then
            captureW = 7680
            captureH = 4320
        End If
    End If
    
    Dim oImageOptions As NameValueMap = ThisApplication.TransientObjects.CreateNameValueMap()
    oImageOptions.Add("Resolution", 3)
    oImageOptions.Add("Background", 1) ' Transparent
    Try : oCam.SaveAsBitmapWithOptions(exportDir & "\_HERO_BANNER_" & captureW & ".png", captureW, captureH, oImageOptions) : Catch : End Try
    oCam.SaveAsBitmap(exportDir & "\_THUMBNAIL.png", 1080, 1080)
    
    ' CẢI TIẾN SHORTS: Thu hẹp hoặc nới rộng Extents tùy Form Factor
    Dim baseExt As Double = If(activeProfile.Name = "Horizontal_Long", 1.45, 0.80)
    oCam.SetExtents(initExtW * baseExt, initExtH * baseExt) ' Lock an toàn chặt chẽ 16:9
    oCam.ApplyWithoutTransition()

    Dim fc As Integer = 1
    
    Dim macQ As Integer = 1
    For Each shotType As String In cameraPresets
        ThisApplication.StatusBarText = "[AI Director] " & shotType & " | Thước phim: " & baseName

        ' [V5.0] PHANH SINH TỒN HEALTH SCORE
        If EngineHealthScore < 60 Then
            activeProfile.AllowIBLSweep = False
            activeProfile.AllowSpeedRamp = False
        End If

        ' =============================================================
        ' [V5.0] SHOT GOVERNOR – LUẬT THÉP BẢO VỆ ENGINE
        ' =============================================================
        Dim blockMsg As String = ""
        If shotType = "Dolly_Vertigo" AndAlso Not activeProfile.AllowVertigo Then blockMsg = "Vertigo Disabled"
        If shotType = "Phase_Shift_Orbit" AndAlso Not activeProfile.AllowTopFlip Then blockMsg = "TopFlip Disabled"
        If shotType = "Top_Orbit_Zoom" AndAlso Not activeProfile.AllowTopFlip Then blockMsg = "TopFlip Disabled"
        If shotType = "Internal_Core_Sweep" AndAlso Not activeProfile.AllowDeepZoom Then blockMsg = "DeepZoom Disabled"
        If shotType = "Tesla_Speed_Ramp" AndAlso Not activeProfile.AllowSpeedRamp Then blockMsg = "SpeedRamp Disabled"
        If shotType = "FPV_Drone_Dive" AndAlso Not activeProfile.AllowTopFlip Then blockMsg = "TopFlip Disabled"
        If shotType = "Dynamic_Section_MRI" AndAlso Not activeProfile.AllowDynamicSection Then blockMsg = "DynSection Disabled"

        If blockMsg <> "" Then
            blockedShotCount += 1
            chk_ShotBlocked = True
            logReport.AppendLine("ShotBlocked: TRUE - " & shotType & " (" & blockMsg & ")")
            EngineHealthScore -= 5
            ThisApplication.StatusBarText = "[MAXSKILLS V5.0] Profile=" & activeProfile.Name & " | Shot=" & shotType & " | Blocked=True | Health=" & EngineHealthScore
            Continue For
        End If

        
        ' --- ĐIỀU CHỈNH MOOD LIGHTING VÀ SHOT GOVERNOR [V5.0] ---
        ThisApplication.StatusBarText = "[MAXSKILLS V6.0] Prof=" & activeProfile.Name & " | Score=" & RiskScore & " | Health=" & EngineHealthScore & " | Override=" & chk_LearningOverride & " | Shot=" & shotType
        Dim curTier As String = "Rhythm"
        Dim actLight As LightingStyle = Nothing
        If shotType = "Orbit_Majestic" Or shotType = "Detail_Spin_Focus" Or shotType = "Top_Orbit_Zoom" Or shotType = "Turn_Around_Majestic" Or shotType = "Vertical_Crane_Scan" Then
            SetMoodLighting(oDoc, "Hero")
            curTier = "Hero"
            Try : actLight = oDoc.ActiveLightingStyle : Catch : End Try
        ElseIf shotType.Contains("Macro") Or shotType.Contains("Focus") Or shotType.Contains("Lock") Or shotType.Contains("Kiss") Or shotType.Contains("Creep") Then
            SetMoodLighting(oDoc, "Macro")
            curTier = "Support"
        ElseIf shotType.Contains("Wireframe") Or shotType.Contains("XRay") Or shotType.Contains("Blueprint") Or shotType.Contains("Scan") Then
            SetMoodLighting(oDoc, "XRay")
            curTier = "Support"
        Else
            SetMoodLighting(oDoc, "Rhythm")
            curTier = "Rhythm"
        End If
        
        ' Thuật toán Đảo Góc Liên Hoàn: Mỗi lần gọi Zoom Cận, tự động xoay mục tiêu sang 1 góc phần tư khác trên đỉnh/đáy máy
        If shotType.Contains("Macro") Or shotType.Contains("Focus") Or shotType.Contains("Kiss") Or shotType.Contains("Lock") Then
            macQ += 1
        End If
        Dim mX As Double = If(macQ Mod 2 = 0, 1.0, -1.0)
        Dim mZ As Double = If(macQ Mod 4 < 2, 1.0, -1.0)
        
        Dim phase3 As Integer = macQ Mod 3
        Dim mY As Double
        Dim tarX As Double = mX
        Dim tarZ As Double = mZ
        Dim eyeX As Double = mX
        Dim eyeZ As Double = mZ
        
        If phase3 = 0 Then
            mY = -1.0 ' Chân đáy
        ElseIf phase3 = 1 Then
            mY = 0.0 ' Khúc Thân bụng
        Else
            mY = 1.0 ' Chóp đầu
            tarX = 0.0 ' Hút tâm về điểm giữa đỉnh để lấy bao quát
            tarZ = 0.0
            eyeX = mX * 1.5 ' Bẩy máy quay lùi xa ra tránh nghẽn hình
            eyeZ = mZ * 1.5
        End If
        
        ' Cảm biến Góc ngẩng/cúi
        Dim mEyeDrop As Double = If(mY = 1.0, maxDim*0.6, maxDim*0.1 + maxDim*0.25*mY)
        ' Bảo hiểm Gimbal Lock: đảm bảo Eye luôn cao hơn Target ít nhất 1 khoảng an toàn
        ' (tránh Eye và Target cùng mức Y -> UpVector (0,1,0) flip -> camera đảo)
        Dim safeYGap As Double = maxDim * 0.15 ' Phù hợp cả mô hình cao lẫn mô hình nhỏ
        
        ' --- Bien dung chung (tranh loi Dim hides variable) ---
        Dim curR As Double = 0
        Dim theta As Double = 0
        Select Case shotType
            ' -------------------------------------------------------------
            ' BỘ SHOT CƠ BẢN (Establishing & General)
            ' -------------------------------------------------------------
            Case "Orbit_Majestic" ' (Establishing)
                Dim baseIBL As Double = 0.0
                Try : If curTier = "Hero" AndAlso actLight IsNot Nothing Then baseIBL = actLight.IBLRotation : Catch : End Try
                For i As Integer = 1 To 60
                    Dim t As Double = i / 60.0
                    
                    ' [V5.0] IBL Sweep cho Hero Shot
                    Try
                        If curTier = "Hero" AndAlso actLight IsNot Nothing Then
                            Dim easeInOutT As Double = t * t * (3 - 2 * t)
                            actLight.IBLRotation = baseIBL + (Math.PI * 0.66) * easeInOutT ' ~120 độ
                        End If
                    Catch : End Try

                    Dim eT As Double = 3*Math.Pow(t,2) - 2*Math.Pow(t,3) 
                    theta = Math.PI * activeProfile.MaxAngularSpeed * 1.5 * Math.Pow(t, 1.2) ' Tăng tốc độ quỹ đạo lên 1.5x góc vòng
                    ' Giảm bán kính vòng quay để góc Majestic nhìn cận cảnh và uy nghi hơn
                    chk_ParamScaled = True
                    curR = maxDim * activeProfile.CameraRadiusFactor * 1.5
                    oCam.Eye = tg.CreatePoint(cX + curR * Math.Cos(theta), cY + maxDim * 0.4, cZ + curR * Math.Sin(theta))
                    oCam.Target = tg.CreatePoint(cX, cY + maxDim * 0.1, cZ)
                    oCam.UpVector = SolveUpVector(oCam.Eye, oCam.Target, tg)
                    oCam.ApplyWithoutTransition() : oCam.SaveAsBitmap(exportDir & "\frame_" & fc.ToString("000") & ".png", 1080, 1920) : fc += 1
                Next

            Case "Dolly_Vertigo" ' (Scale / Tension)
                Dim baseAngleVer As Double = oCam.PerspectiveAngle
                For i As Integer = 1 To 45
                    Dim t As Double = i / 45.0
                    Dim eT As Double = Math.Pow(t, 0.4) 
                    chk_ParamScaled = True
                    curR = maxDim * activeProfile.CameraRadiusFactor * (1.1 + 1.2 * eT)
                    oCam.Eye = tg.CreatePoint(cX + curR * Math.Cos(Math.PI*1.5), cY + maxDim * 0.1, cZ + curR * Math.Sin(Math.PI*1.5))
                    oCam.Target = tg.CreatePoint(cX, cY, cZ)
                    oCam.UpVector = SolveUpVector(oCam.Eye, oCam.Target, tg)
                    Try 
                        Dim curFOV As Double = baseAngleVer * (1 - 0.4 * eT)
                        curFOV = Math.Max(25.0 * Math.PI / 180.0, curFOV)
                        oCam.PerspectiveAngle = curFOV
                    Catch : End Try
                    oCam.ApplyWithoutTransition() : oCam.SaveAsBitmap(exportDir & "\frame_" & fc.ToString("000") & ".png", 1080, 1920) : fc += 1
                Next
                Try : oCam.PerspectiveAngle = baseAngleVer : Catch : End Try

            Case "Fit_To_View_Finale" ' (Signature SEO Shot) Trượt mượt (Lerp) về góc chuẩn ViewCube (Iso Home)
                ' 1. Phục kích bắt dính trạng thái Camera hiện tại
                Dim startEye As Inventor.Point = oCam.Eye.Copy()
                Dim startTarget As Inventor.Point = oCam.Target.Copy()
                Dim startUpVector As Inventor.UnitVector = oCam.UpVector.Copy()
                Dim startExtW As Double, startExtH As Double
                oCam.GetExtents(startExtW, startExtH)
                
                ' 2. Nhảy vượt thời gian để lấy tham số của Đích đến (Perfect Iso Home)
                oCam.Target = tg.CreatePoint(cX, cY, cZ)
                oCam.UpVector = tg.CreateUnitVector(0, 1, 0)
                oCam.ViewOrientationType = ViewOrientationTypeEnum.kIsoTopRightViewOrientation
                oCam.Fit()
                Dim endEye As Inventor.Point = oCam.Eye.Copy()
                Dim endTarget As Inventor.Point = oCam.Target.Copy()
                Dim endUpVector As Inventor.UnitVector = oCam.UpVector.Copy()
                Dim endExtW As Double, endExtH As Double
                oCam.GetExtents(endExtW, endExtH)
                
                ' Pha A: Lao vào khung hình to cực đại để uy hiếp thị giác
                ' (Với Flat thì không được đâm sâu quá sẽ đứt đầu/đuôi)
                Dim peakWFactor As Double = If(activeProfile.Name = "Horizontal_Long", 1.05, 0.65)
                Dim peakExtW As Double = endExtW * peakWFactor
                Dim peakExtH As Double = endExtH * peakWFactor
                
                ' 3. Vòng lặp Nội suy (Linear Interpolation Lerp + Ease Out Cubic)
                Dim transFrames As Integer = 40 ' Trượt nhanh đâm sầm
                For i As Integer = 1 To transFrames
                    Dim t As Double = i / CDbl(transFrames)
                    Dim eT As Double = 1.0 - Math.Pow(1.0 - t, 3.0) ' Ease Out (thắng phanh từ từ khi vào bến)
                    
                    oCam.Eye = tg.CreatePoint(startEye.X + (endEye.X - startEye.X) * eT, startEye.Y + (endEye.Y - startEye.Y) * eT, startEye.Z + (endEye.Z - startEye.Z) * eT)
                    oCam.Target = tg.CreatePoint(startTarget.X + (endTarget.X - startTarget.X) * eT, startTarget.Y + (endTarget.Y - startTarget.Y) * eT, startTarget.Z + (endTarget.Z - startTarget.Z) * eT)
                    oCam.UpVector = tg.CreateUnitVector(startUpVector.X + (endUpVector.X - startUpVector.X) * eT, startUpVector.Y + (endUpVector.Y - startUpVector.Y) * eT, startUpVector.Z + (endUpVector.Z - startUpVector.Z) * eT)
                    oCam.SetExtents(startExtW + (peakExtW - startExtW) * eT, startExtH + (peakExtH - startExtH) * eT)
                    
                    oCam.ApplyWithoutTransition() : oCam.SaveAsBitmap(exportDir & "\frame_" & fc.ToString("000") & ".png", 1080, 1920) : fc += 1
                Next
                
                ' Pha B: Ngưng 1 nhịp (Neo thị giác) trên màn hình khổng lồ
                VisualAnchorPause(oCam, 8, exportDir, fc)
                
                ' Pha C: Thu nhỏ nhẹ (Relax) về khung chốt an toàn để chừa chỗ điền Text SEO
                Dim finalWFactor As Double = If(activeProfile.Name = "Horizontal_Long", 1.55, 0.85)
                Dim finalExtW As Double = endExtW * finalWFactor
                Dim finalExtH As Double = endExtH * finalWFactor
                For i As Integer = 1 To 20
                    Dim t As Double = i / 20.0
                    Dim eT As Double = 1.0 - Math.Pow(1.0 - t, 2.0) ' Ease Out
                    oCam.SetExtents(peakExtW + (finalExtW - peakExtW) * eT, peakExtH + (finalExtH - peakExtH) * eT)
                    oCam.ApplyWithoutTransition() : oCam.SaveAsBitmap(exportDir & "\frame_" & fc.ToString("000") & ".png", 1080, 1920) : fc += 1
                Next
                
                ' 4. THUẬT TOÁN ĐÓNG BĂNG GIỜ VÀNG (13 GIÂY CHUẨN SEO)
                ' Tự động tính toán số khung hình còn thiếu để kéo độ dài video lên chuẩn 390 frames (13.0 giây @30fps)
                Dim freezeFrames As Integer = 390 - fc + 1
                If freezeFrames < 30 Then freezeFrames = 30 ' Khóa tối thiểu 1 giây nếu kịch bản đã quá dài
                
                For i As Integer = 1 To freezeFrames
                    oCam.ApplyWithoutTransition() : oCam.SaveAsBitmap(exportDir & "\frame_" & fc.ToString("000") & ".png", 1080, 1920) : fc += 1
                Next

            ' -------------------------------------------------------------
            ' BỘ SHOT CỘNG THÊM (SUPPLEMENTARY B2B CINEMA)
            ' -------------------------------------------------------------
            Case "Extents_Pullback_Reveal" ' Đòn tâm lý kích thích tò mò 
                Dim startExtW As Double = maxDim * 0.4 
                Dim endExtW As Double = initExtW * 0.80
                Dim startExtH As Double = startExtW * (initExtH / initExtW)
                Dim endExtH As Double = initExtH * 0.80
                
                oCam.Eye = tg.CreatePoint(cX + maxDim*1.2 * Math.Cos(Math.PI*0.25), cY + dy * 0.4, cZ + maxDim*1.2 * Math.Sin(Math.PI*0.25))
                oCam.Target = tg.CreatePoint(cX - dx*0.2, cY + dy*0.2, cZ + dz*0.15) 
                oCam.UpVector = tg.CreateUnitVector(0, 1, 0)
                
                For i As Integer = 1 To 25 
                    Dim t As Double = i / 25.0
                    Dim eT As Double = 1.0 - Math.Pow(1.0 - t, 3.0) ' Ease Out
                    oCam.SetExtents(startExtW + (endExtW - startExtW) * eT, startExtH + (endExtH - startExtH) * eT)
                    oCam.ApplyWithoutTransition() : oCam.SaveAsBitmap(exportDir & "\frame_" & fc.ToString("000") & ".png", 1080, 1920) : fc += 1
                Next
                oCam.SetExtents(initExtW * 0.80, initExtH * 0.80) 
                
            Case "Low_Tracking_Sneak"  ' Lướt lén ngang sườn siêu sát đáy
                For i As Integer = 1 To 20
                    Dim t As Double = i / 20.0
                    Dim eT As Double = t ' Linear
                    theta = Math.PI * activeProfile.MaxAngularSpeed * 0.4 + (Math.PI * 0.3) * eT 
                    oCam.Eye = tg.CreatePoint(cX + maxDim*1.2 * Math.Cos(theta), cY - dy*0.4, cZ + maxDim*1.2 * Math.Sin(theta))
                    oCam.Target = tg.CreatePoint(cX - dx*0.2, cY + dy*0.1, cZ + dz*0.2) 
                    oCam.UpVector = tg.CreateUnitVector(0, 1, 0)
                    oCam.ApplyWithoutTransition() : oCam.SaveAsBitmap(exportDir & "\frame_" & fc.ToString("000") & ".png", 1080, 1920) : fc += 1
                Next

            Case "Tension_Zoom"  ' Lùi rớt khung hình hồi hộp
                For i As Integer = 1 To 15
                    Dim t As Double = i / 15.0
                    chk_ParamScaled = True
                    curR = maxDim * activeProfile.CameraRadiusFactor * (0.8 + 1.2 * t)
                    oCam.Eye = tg.CreatePoint(cX + curR * Math.Cos(Math.PI*1.2), cY + maxDim*0.2, cZ + curR * Math.Sin(Math.PI*1.2))
                    oCam.Target = tg.CreatePoint(cX + dx*0.1, cY - dy*0.1, cZ - dz*0.25) 
                    oCam.UpVector = tg.CreateUnitVector(0, 1, 0)
                    oCam.ApplyWithoutTransition() : oCam.SaveAsBitmap(exportDir & "\frame_" & fc.ToString("000") & ".png", 1080, 1920) : fc += 1
                Next

            Case "Top_Down_God_Eye"  ' Góc nhìn thẳng từ chóp mũi xuống
                For i As Integer = 1 To 15
                    Dim t As Double = i / 15.0
                    Dim curY As Double = cY + maxDim * (1.8 - 0.4 * t)
                    oCam.Eye = tg.CreatePoint(cX + 0.01, curY, cZ) 
                    oCam.Target = tg.CreatePoint(cX, cY, cZ)
                    oCam.UpVector = tg.CreateUnitVector(0, 0, -1) 
                    oCam.ApplyWithoutTransition() : oCam.SaveAsBitmap(exportDir & "\frame_" & fc.ToString("000") & ".png", 1080, 1920) : fc += 1
                Next

            Case "Vertical_Crane_Scan" ' Trượt dọc từ gốc lên đỉnh để khoe trọn chiều cao (Đặc trị 9:16)
                For i As Integer = 1 To 45
                    Dim t As Double = i / 45.0
