            ' -------------------------------------------------------------
            ' KỊCH BẢN ĐIỆN ẢNH KỊCH TÍNH (TESLA / APPLE REVEAL STYLE)
            ' -------------------------------------------------------------
            Case "Tesla_Speed_Ramp" ' Kỹ thuật bóp méo thời gian
                For i As Integer = 1 To 35
                    Dim t As Double = i / 35.0
                    chk_ParamScaled = True
                    curR = maxDim * activeProfile.CameraRadiusFactor * 0.8
                    Dim sT As Double
                    If i <= 10 Then
                        sT = (i / 10.0) * 0.15 
                    ElseIf i <= 35 Then
                        sT = 0.15 + ((i - 10) / 25.0) * 0.6 
                    Else
                        sT = 0.75 + ((i - 35) / 10.0) * 0.25 
                    End If
                    
                    theta = Math.PI * activeProfile.MaxAngularSpeed * 0.3 + (Math.PI * 0.8) * sT 
                    Dim yH As Double = cY - dy*0.2 + dy*0.7 * Math.Sin(sT * Math.PI) 
                    
                    oCam.Eye = tg.CreatePoint(cX + curR * Math.Cos(theta), yH, cZ + curR * Math.Sin(theta))
                    oCam.Target = tg.CreatePoint(cX + dx*0.2, cY + dy*0.1, cZ)
                    
                    oCam.UpVector = tg.CreateUnitVector(0, 1, 0)
                    oCam.ApplyWithoutTransition() : oCam.SaveAsBitmap(exportDir & "\frame_" & fc.ToString("000") & ".png", 1080, 1920) : fc += 1
