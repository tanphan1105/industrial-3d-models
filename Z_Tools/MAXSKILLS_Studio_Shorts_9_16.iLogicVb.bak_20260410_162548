                        oCam.Eye = tg.CreatePoint(cX + maxDim*1.2 * Math.Sin(theta), cY + maxDim*0.3, cZ + maxDim*1.2 * Math.Cos(theta))
                        oCam.Target = tg.CreatePoint(cX - dx*0.25, cY + dy*0.2, cZ)
                    Else
                        oCam.Eye = tg.CreatePoint(cX + maxDim*1.2 * Math.Cos(theta), cY + maxDim*0.3, cZ + maxDim*1.2 * Math.Sin(theta))
                        oCam.Target = tg.CreatePoint(cX, cY + dy*0.2, cZ - dz*0.25)
                    End If
                    oCam.UpVector = tg.CreateUnitVector(0, 1, 0)
                    oCam.ApplyWithoutTransition() : oCam.SaveAsBitmap(exportDir & "\frame_" & fc.ToString("000") & ".png", 1080, 1920) : fc += 1
                Next

