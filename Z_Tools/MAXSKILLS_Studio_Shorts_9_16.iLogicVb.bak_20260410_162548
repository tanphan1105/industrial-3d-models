            Case "Phase_Shift_Orbit" ' Lột xác 3 giai đoạn: Solid -> Glass -> Naked
                Dim asmDef As AssemblyComponentDefinition = Nothing
                If oDoc.DocumentType = DocumentTypeEnum.kAssemblyDocumentObject Then
                    asmDef = oDoc.ComponentDefinition
                End If
                
                ' Bắn khung hình vừa khít (Fit to View) để máy to rõ chà bá
                Dim phaseEx As Double = If(activeProfile.Name = "Horizontal_Long", 1.5, 1.05) ' Hệ số 1.05 cho Tủ đứng để viền áp sát
                oCam.SetExtents(initExtW * phaseEx, initExtH * phaseEx)

                For i As Integer = 1 To 150
                    Dim t As Double = i / 150.0
                    theta = Math.PI * activeProfile.MaxAngularSpeed * 2.0 * t ' Quay 1 vòng tròn trọn vẹn
                    
                    ' Phase 1: Solid (1 -> 50) | Phase 2: Glass (51 -> 100) | Phase 3: Naked (101 -> 150)
                    Try
                        If asmDef IsNot Nothing Then
                            If i = 1 Then
                                asmDef.RepresentationsManager.DesignViewRepresentations.Item("VR_1_SOLID").Activate()
                            ElseIf i = 51 Then
                                asmDef.RepresentationsManager.DesignViewRepresentations.Item("VR_2_GLASS").Activate()
                            ElseIf i = 101 Then
                                asmDef.RepresentationsManager.DesignViewRepresentations.Item("VR_3_NAKED").Activate()
                            End If
                        End If
                    Catch : End Try

                    chk_ParamScaled = True
                    curR = maxDim * activeProfile.CameraRadiusFactor * If(activeProfile.Name = "Horizontal_Long", 1.8, 1.5) ' Thu hẹp bán kính bay, dí sát vào khung máy
                    Dim shiftEyeY As Double = cY + maxDim * 0.25 ' Hạ thấp góc ngửa xuống để chớp cận
                    
