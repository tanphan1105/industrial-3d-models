                    oCam.ApplyWithoutTransition() : oCam.SaveAsBitmap(exportDir & "\frame_" & fc.ToString("000") & ".png", 1080, 1920) : fc += 1
                Next
                VisualAnchorPause(oCam, 4, exportDir, fc)

            Case "Detail_Spin_Focus" ' Xoay cực chậm quanh trục và Zoom thắt xoáy
                For i As Integer = 1 To 60
                    Dim t As Double = i / 60.0
                    theta = Math.PI * activeProfile.MaxAngularSpeed * 0.6 * t
                    chk_ParamScaled = True
                    curR = maxDim * activeProfile.CameraRadiusFactor * (0.75 - 0.4 * t)
                    Dim eyeYDSF As Double = cY + dy*0.35*mY + mEyeDrop + safeYGap
                    oCam.Eye = tg.CreatePoint(cX + curR * Math.Cos(theta) * eyeX, eyeYDSF, cZ + curR * Math.Sin(theta) * eyeZ)
                    oCam.Target = tg.CreatePoint(cX + dx*0.2 * tarX, cY + dy*0.35*mY, cZ + dz*0.2 * tarZ)
                    oCam.UpVector = tg.CreateUnitVector(0, 1, 0)
                    oCam.ApplyWithoutTransition() : oCam.SaveAsBitmap(exportDir & "\frame_" & fc.ToString("000") & ".png", 1080, 1920) : fc += 1
                Next
                VisualAnchorPause(oCam, 4, exportDir, fc)

            Case "Top_Orbit_Zoom" ' Xoay quanh đỉnh rồi zoom thẳng vào tâm đỉnh
                For i As Integer = 1 To 60
                    Dim t As Double = i / 60.0
                    Dim eT As Double = 1.0 - Math.Pow(1.0 - t, 2.5) 
                    theta = Math.PI * activeProfile.MaxAngularSpeed * 1.2 * t 
                    
                    chk_ParamScaled = True
                    curR = maxDim * activeProfile.CameraRadiusFactor * (0.8 - 0.5 * eT)
                    Dim eyeY As Double = cY + dy*0.45 + maxDim * (0.6 - 0.35 * eT)
                    Dim topY As Double = cY + dy * 0.45
                    
                    oCam.Eye = tg.CreatePoint(cX + curR * Math.Cos(theta), eyeY, cZ + curR * Math.Sin(theta))
                    oCam.Target = tg.CreatePoint(cX, topY, cZ)
                    oCam.UpVector = tg.CreateUnitVector(0, 1, 0)
                    oCam.ApplyWithoutTransition() : oCam.SaveAsBitmap(exportDir & "\frame_" & fc.ToString("000") & ".png", 1080, 1920) : fc += 1
                Next
                VisualAnchorPause(oCam, 5, exportDir, fc)

            Case "Pulse_Zoom_In" ' Thấy là vụt sát vào luôn
                For i As Integer = 1 To 15
                    Dim t As Double = i / 15.0
                    Dim eT As Double = Math.Pow(t, 2.0) 
                    chk_ParamScaled = True
                    curR = maxDim * activeProfile.CameraRadiusFactor * (1.0 - 0.6 * eT) 
                    oCam.Eye = tg.CreatePoint(cX + curR * Math.Cos(Math.PI*0.3), cY + maxDim * 0.1, cZ + curR * Math.Sin(Math.PI*0.3))
                    oCam.Target = tg.CreatePoint(cX, cY, cZ)
                    oCam.UpVector = tg.CreateUnitVector(0, 1, 0)
                    oCam.ApplyWithoutTransition() : oCam.SaveAsBitmap(exportDir & "\frame_" & fc.ToString("000") & ".png", 1080, 1920) : fc += 1
                Next

            Case "Micro_Focus_Snap" ' Giật máy khóa ngàm
                For i As Integer = 1 To 18
