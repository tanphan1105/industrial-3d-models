            Case "Macro_Surface_Glide" ' Lướt miết dọc theo ĐƯỜNG KẼ/SỐNG VÁT
                For i As Integer = 1 To 45
                    Dim t As Double = i / 45.0
                    Dim edgeY As Double = cY - dy*0.3 + (dy*0.6) * t
                    oCam.Eye = tg.CreatePoint(cX + dx*0.4 * mX, edgeY + dy*0.1, cZ + dz*0.4 * mZ)
