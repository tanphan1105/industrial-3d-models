            ' -------------------------------------------------------------
            Case "Precision_Lock" ' Giật chớp focus ngẫu nhiên quanh bệ đứng
                For i As Integer = 1 To 15
                    Dim t As Double = i / 15.0
                    chk_ParamScaled = True
                    curR = maxDim * activeProfile.CameraRadiusFactor * (1.2 - 0.5 * t)
                    Dim eyeYPL As Double = cY + dy*0.4*mY + mEyeDrop + safeYGap
                    Dim tarYPL As Double = cY + dy*0.4*mY
                    oCam.Eye = tg.CreatePoint(cX + curR*eyeX, eyeYPL, cZ + curR*eyeZ)
                    oCam.Target = tg.CreatePoint(cX + dx*0.3 * tarX, tarYPL, cZ + dz*0.3 * tarZ)
                    oCam.UpVector = tg.CreateUnitVector(0, 1, 0)
                    oCam.ApplyWithoutTransition() : oCam.SaveAsBitmap(exportDir & "\frame_" & fc.ToString("000") & ".png", 1080, 1920) : fc += 1
                Next
                VisualAnchorPause(oCam, 4, exportDir, fc)

            Case "Wireframe_Hidden_Orbit" ' X-Quang: Wireframe With Hidden Edges (kHiddenLineVisualStyle)
                ' Fit lại khung nhìn: Nới rộng bề ngang/cao tột độ đảm bảo không bao giờ khuất đỉnh/cạnh
                Dim xrayEx As Double = If(activeProfile.Name = "Horizontal_Long", 2.2, 1.45)
                oCam.SetExtents(initExtW * xrayEx, initExtH * xrayEx)
                Try
                    oView.DisplayMode = DisplayModeEnum.kWireframeRendering
                    ThisApplication.UserInterfaceManager.DoEvents()
                    oView.Update()
                Catch : End Try

                For i As Integer = 1 To 90
                    Dim t As Double = i / 90.0
                    theta = Math.PI * activeProfile.MaxAngularSpeed * 1.5 * t
                    chk_ParamScaled = True
                    curR = maxDim * activeProfile.CameraRadiusFactor * If(activeProfile.Name = "Horizontal_Long", 2.0, 1.7) ' Băng chuyền dài cần lùi xa hơn
                    Dim eyeHt As Double = cY + maxDim * 0.6 ' Nâng máy quay lên cao hơn đỉnh
                    oCam.Eye = tg.CreatePoint(cX + curR * Math.Cos(theta), eyeHt, cZ + curR * Math.Sin(theta))
                    oCam.Target = tg.CreatePoint(cX, cY, cZ)
                    oCam.UpVector = tg.CreateUnitVector(0, 1, 0)
                    oCam.ApplyWithoutTransition()
                    ThisApplication.UserInterfaceManager.DoEvents()
                    oView.Update()
                    oCam.SaveAsBitmap(exportDir & "\frame_" & fc.ToString("000") & ".png", 1080, 1920) : fc += 1
                Next

