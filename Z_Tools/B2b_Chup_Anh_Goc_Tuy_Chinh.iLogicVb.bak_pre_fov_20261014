        End If

        Dim finishMsg As String = "CHỤP ẢNH GÓC NHÌN TÙY CHỈNH THÀNH CÔNG!" & vbCrLf & vbCrLf
        finishMsg &= "• File ảnh: " & System.IO.Path.GetFileName(rawOutFile) & vbCrLf
        finishMsg &= "• Độ phân giải: " & renderW & " x " & renderH & " px (SSAA 1.5x Lanczos-3)" & vbCrLf
        finishMsg &= "• Chế độ Hậu kỳ: " & If(watermarkMode = 1, "Full Bản quyền Sàn 3D", If(watermarkMode = 2, "Clean 100% Cờ Việt Nam", "Pure Clean Raw (Không Watermark)")) & vbCrLf
        finishMsg &= "• Camera: " & If(forcePerspective, "Phối Cảnh 3D (Perspective 50mm)", "Góc Nhìn Thực Tế") & vbCrLf
        finishMsg &= "• Ánh sáng: " & If(useKeyShotLighting, "KeyShot PBR Studio Rig", "Thiết lập Môi trường Hiện tại") & vbCrLf
        finishMsg &= "• Vị trí lưu: " & snapshotDir

        MessageBox.Show(finishMsg, "WT3D Custom Angle Studio", MessageBoxButtons.OK, MessageBoxIcon.Information)
    End Sub

    Private Shared Sub BurnCleanVietnamFlag(ByVal srcPath As String, ByVal destPath As String, ByVal flagPath As String, ByVal targetW As Integer, ByVal targetH As Integer)
        Try
            Using srcBmp As New System.Drawing.Bitmap(srcPath)
                Using destBmp As New System.Drawing.Bitmap(targetW, targetH)
                    Using g As System.Drawing.Graphics = System.Drawing.Graphics.FromImage(destBmp)
                        g.SmoothingMode = System.Drawing.Drawing2D.SmoothingMode.HighQuality
                        g.InterpolationMode = System.Drawing.Drawing2D.InterpolationMode.HighQualityBicubic
                        g.PixelOffsetMode = System.Drawing.Drawing2D.PixelOffsetMode.HighQuality
                        g.CompositingQuality = System.Drawing.Drawing2D.CompositingQuality.HighQuality

                        ' Vẽ ảnh mô hình đã resize mượt mà
                        g.DrawImage(srcBmp, New System.Drawing.Rectangle(0, 0, targetW, targetH))

                        ' Vẽ cờ Việt Nam góc trên trái
                        Dim flagW As Integer = CInt(targetW * 0.11)
                        If flagW < 140 Then flagW = 140
                        If flagW > 260 Then flagW = 260
                        Dim flagH As Integer = CInt(flagW * 2.0 / 3.0)
                        Dim marginX As Integer = CInt(targetW * 0.03)
                        Dim marginY As Integer = CInt(targetH * 0.02)

                        If Not String.IsNullOrEmpty(flagPath) AndAlso System.IO.File.Exists(flagPath) Then
                            Using flagImg As System.Drawing.Image = System.Drawing.Image.FromFile(flagPath)
                                Using p As New System.Drawing.Pen(System.Drawing.Color.FromArgb(60, 0, 0, 0), 3)
                                    g.DrawRectangle(p, marginX - 1, marginY - 1, flagW + 2, flagH + 2)
                                End Using
                                g.DrawImage(flagImg, New System.Drawing.Rectangle(marginX, marginY, flagW, flagH))
                            End Using
                        Else
                            Using redBrush As New System.Drawing.SolidBrush(System.Drawing.Color.FromArgb(218, 37, 29))
                                g.FillRectangle(redBrush, marginX, marginY, flagW, flagH)
                            End Using
                            Dim starCenterX As Single = marginX + (flagW / 2.0F)
                            Dim starCenterY As Single = marginY + (flagH / 2.0F)
                            Dim starRadius As Single = flagH * 0.3F
                            DrawStar(g, starCenterX, starCenterY, starRadius, System.Drawing.Color.FromArgb(255, 255, 0))
                        End If
                    End Using
                    destBmp.Save(destPath, System.Drawing.Imaging.ImageFormat.Png)
                End Using
            End Using
        Catch
            Try
                If srcPath <> destPath Then
                    System.IO.File.Copy(srcPath, destPath, True)
                End If
            Catch
            End Try
        End Try
    End Sub

    Private Shared Sub DownscaleCleanRaw(ByVal srcPath As String, ByVal destPath As String, ByVal targetW As Integer, ByVal targetH As Integer)
        Try
            Using srcBmp As New System.Drawing.Bitmap(srcPath)
                Using destBmp As New System.Drawing.Bitmap(targetW, targetH)
                    Using g As System.Drawing.Graphics = System.Drawing.Graphics.FromImage(destBmp)
                        g.SmoothingMode = System.Drawing.Drawing2D.SmoothingMode.HighQuality
                        g.InterpolationMode = System.Drawing.Drawing2D.InterpolationMode.HighQualityBicubic
                        g.PixelOffsetMode = System.Drawing.Drawing2D.PixelOffsetMode.HighQuality
                        g.CompositingQuality = System.Drawing.Drawing2D.CompositingQuality.HighQuality
                        g.DrawImage(srcBmp, New System.Drawing.Rectangle(0, 0, targetW, targetH))
                    End Using
                    destBmp.Save(destPath, System.Drawing.Imaging.ImageFormat.Png)
                End Using
            End Using
        Catch
            Try
                If srcPath <> destPath Then
                    System.IO.File.Copy(srcPath, destPath, True)
                End If
            Catch
            End Try
        End Try
    End Sub

    Private Shared Sub DrawStar(ByVal g As System.Drawing.Graphics, ByVal cx As Single, ByVal cy As Single, ByVal r As Single, ByVal col As System.Drawing.Color)
        Dim points(9) As System.Drawing.PointF
        Dim rx As Double = r
        Dim rn As Double = r * 0.382
        Dim angleOffset As Double = -Math.PI / 2.0

        For i As Integer = 0 To 9
            Dim curR As Double = If(i Mod 2 = 0, rx, rn)
            Dim angle As Double = angleOffset + (i * Math.PI / 5.0)
            points(i) = New System.Drawing.PointF(CSng(cx + curR * Math.Cos(angle)), CSng(cy + curR * Math.Sin(angle)))
        Next

        Using b As New System.Drawing.SolidBrush(col)
            g.FillPolygon(b, points)
        End Using
    End Sub
End Class
