            Next

            BurnCleanVietnamFlag(rawTmpFile, rawOutFile, flagPath, renderW, renderH)
            Try
                System.IO.File.Delete(rawTmpFile)
            Catch
            End Try

        ElseIf watermarkMode = 3 Then
            ' MODE 3: PURE RAW CLEAN (KHÔNG WATERMARK)
            DownscaleCleanRaw(rawTmpFile, rawOutFile, renderW, renderH)
            Try
                System.IO.File.Delete(rawTmpFile)
            Catch
            End Try

        Else
