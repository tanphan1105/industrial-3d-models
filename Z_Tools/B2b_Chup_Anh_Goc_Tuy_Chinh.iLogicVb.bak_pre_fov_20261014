            ElseIf rad916_2K.Checked Then
                renderW = 1440 : renderH = 2560
            ElseIf rad45_4K.Checked Then
                renderW = 2160 : renderH = 2700
            ElseIf rad169_4K.Checked Then
                renderW = 3840 : renderH = 2160
            ElseIf rad169_2K.Checked Then
                renderW = 2560 : renderH = 1440
            ElseIf rad169_FHD.Checked Then
                renderW = 1920 : renderH = 1080
            ElseIf rad11_2K.Checked Then
                renderW = 2048 : renderH = 2048
            End If

            useKeyShotLighting = radLightKeyShot.Checked
            forcePerspective = chkPersp.Checked

            If radWmkFull.Checked Then
                watermarkMode = 1
            ElseIf radWmkCleanVN.Checked Then
                watermarkMode = 2
            ElseIf radWmkPureRaw.Checked Then
                watermarkMode = 3
            End If

            includeIconsPillar = chkPillar.Checked
            enableOpticalPolish = chkPolish.Checked
            autoOpenResult = chkOpen.Checked
        End Using

        ' TIẾN HÀNH CHỤP ẢNH TỪ KHUNG NHÌN CAMERA VIEW HIỆN TẠI (1.5x SSAA)
        Dim ssaaScale As Double = 1.5
        Dim captureW As Integer = CInt(renderW * ssaaScale)
        Dim captureH As Integer = CInt(renderH * ssaaScale)

        oApp.StatusBarText = "Dang chup anh goc nhin tuy chinh (SSAA 1.5x: " & captureW & "x" & captureH & " -> " & renderW & "x" & renderH & ")..."
        SafeYield(10)

        If CheckEscapeKey() Then Exit Sub

        ' Tắt các đối tượng rác
        Try
            oDoc.ObjectVisibility.AllWorkFeatures = False
            oDoc.ObjectVisibility.UserWorkPlanes = False
            oDoc.ObjectVisibility.OriginWorkPlanes = False
            oDoc.ObjectVisibility.Sketches = False
            oDoc.ObjectVisibility.Sketches3D = False
        Catch
        End Try

        ' Thiết lập chế độ khử răng cưa và nền Gradient Studio dịu mắt
        Try
            oApp.ColorSchemes.BackgroundType = BackgroundTypeEnum.kGradientBackgroundType
            oApp.DisplayOptions.DisplayQuality = DisplayQualityEnum.kSmootherDisplayQuality
            oApp.DisplayOptions.AntiAliasing = True
            oApp.DisplayOptions.SmoothLines = True
            oApp.DisplayOptions.ShowSilhouettes = True

            oView.ShowAmbientShadows = True
            oView.ShowObjectShadows = True
            oView.ShowGroundShadows = True
            oView.ShowGroundReflections = True
        Catch
        End Try

        ' Thiết lập camera perspective nếu chọn
        Dim oCam As Inventor.Camera = oView.Camera
        If forcePerspective Then
            Try
                oCam.Perspective = True
                Try : oCam.PerspectiveAngle = 0.52 : Catch : End Try
                oCam.ApplyWithoutTransition()
                oView.Update()
            Catch
            End Try
        End If

        ' Thiết lập KeyShot Lighting Rig nếu chọn
        If useKeyShotLighting Then
            Try
                Dim isPartDocB2 As Boolean = (TypeOf oDoc Is PartDocument)
                Dim isAsmDocB2 As Boolean = (TypeOf oDoc Is AssemblyDocument)
                Dim curStyle As LightingStyle = Nothing

                If isPartDocB2 Then
                    curStyle = CType(oDoc, PartDocument).ActiveLightingStyle
                ElseIf isAsmDocB2 Then
                    curStyle = CType(oDoc, AssemblyDocument).ActiveLightingStyle
                End If

                If curStyle IsNot Nothing Then
                    Try : curStyle.ShadowDirection = ShadowDirectionEnum.kAboveShadowDirection : Catch : End Try
                    Try : curStyle.Brightness = 0.85 : Catch : End Try
                    Try : curStyle.Ambience = 0.32 : Catch : End Try
                    Try : curStyle.ShadowDensity = 0.45 : Catch : End Try
                End If
            Catch
            End Try
        End If

        Dim rawOutFile As String = System.IO.Path.Combine(snapshotDir, baseName & chosenSuffix & ".png")
        Dim rawTmpFile As String = System.IO.Path.Combine(snapshotDir, baseName & chosenSuffix & "_raw.png")

        ' Chụp ảnh bằng cơ chế SSAA
        Dim capturedSuccess As Boolean = False
        For attempt As Integer = 1 To 3
            Try
                oCam.SaveAsBitmap(rawTmpFile, captureW, captureH)
                capturedSuccess = True
                Exit For
            Catch ex As Exception
                SafeYield(30)
                Try : oView.Update() : Catch : End Try
            End Try
        Next

        If Not capturedSuccess OrElse Not System.IO.File.Exists(rawTmpFile) Then
            Try
                oView.SaveAsBitmap(rawTmpFile, captureW, captureH)
                capturedSuccess = True
            Catch ex As Exception
                MessageBox.Show("Loi khi chup anh tu man hinh Inventor: " & ex.Message, "WT3D Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Exit Sub
            End Try
        End If

        ' XỬ LÝ HẬU KỲ THEO 3 MODE:
        oApp.StatusBarText = "Dang xu ly hau ky anh theo Mode " & watermarkMode & "..."
        SafeYield(10)

        If watermarkMode = 2 Then
            ' MODE 2: CLEAN CỜ VIỆT NAM (DỌC CLEAN)
            Dim flagPath As String = ""
            Dim candidates As String() = { _
                System.IO.Path.Combine(docDir, "vietnam_flag.png"), _
                "D:\WT3D_Project\Z_Tools\vietnam_flag.png", _
                "D:\INVENTOR_DATA\05_STANDARD_COMPONENTS\00_Standards_and_Templates\02_iLogic_Rules\vietnam_flag.png", _
                "D:\WT3D_Project\industrial-3d-models\Z_Tools\vietnam_flag.png" _
            }
            For Each c As String In candidates
                If System.IO.File.Exists(c) Then
                    flagPath = c
                    Exit For
