' ==============================================================================
' NIGHT-CRAWLER: AUTO SEO METADATA ENGINE (V6 - CGTRADER BOT ASSASSIN)
' Đọc tệp draft.txt, kết hợp tọa độ vật lý (RangeBox) và Part Count để đúc HTML
' Mục tiêu: Giết chết hệ thống nhận diện Spam của CGTrader bằng 100% Unique Metrics
' ==============================================================================
Try
    Dim oDoc As Document = ThisDoc.Document
    Dim baseName As String = System.IO.Path.GetFileNameWithoutExtension(oDoc.FullFileName)
    Dim niceName As String = baseName.Replace("_", " ")
    
    ' 1. TRÍCH XUẤT CHỈ SỐ CƠ KHÍ KHÔNG THỂ ĐỤNG HÀNG (UNIQUE METRICS)
    Dim w As Long = 0, d As Long = 0, h As Long = 0
    Try
        Dim rBox As Box = oDoc.ComponentDefinition.RangeBox
        ' Inventor xài cm, chuyển mượt sang mm cho Dân Cơ Khí
        w = Math.Round((rBox.MaxPoint.X - rBox.MinPoint.X) * 10)
        d = Math.Round((rBox.MaxPoint.Z - rBox.MinPoint.Z) * 10)
        h = Math.Round((rBox.MaxPoint.Y - rBox.MinPoint.Y) * 10)
    Catch
    End Try

    Dim ptCount As Long = 0
    If oDoc.DocumentType = DocumentTypeEnum.kAssemblyDocumentObject Then
        Try
            Dim oAsm As AssemblyDocument = oDoc
            ptCount = oAsm.ComponentDefinition.Occurrences.AllLeafOccurrences.Count
        Catch
        End Try
    Else
        ptCount = 1
    End If

    ' 2. ĐỌC FILE DRAFT CỦA SẾP NẾU CÓ
    Dim dirPath As String = System.IO.Path.GetDirectoryName(oDoc.FullFileName)
    Dim txtPath As String = dirPath & "\" & baseName & ".txt"
    Dim draftDesc As String = ""
    
    If System.IO.File.Exists(txtPath) Then
        draftDesc = System.IO.File.ReadAllText(txtPath)
    Else
        ' NAME-FALLBACK: Sếp không rảnh viết thì xài Template Cứng Dựa theo Tên BaseName
        draftDesc = "A completely modeled industrial equipment assembly: " & niceName & "." & vbCrLf & _
                    "Modeled based on real-world industrial processing plants. Suitable for mineral water, pharmaceutical, food & beverage, or chemical engineering plant layouts." & vbCrLf & _
                    "Includes primary logic piping, mechanical structure, and instrumentation stubs where applicable."
    End If

    ' =========================================================================
    ' 2.5. HỆ THỐNG ĐÚC SEO TEXT 2026 (Z_COPY_PASTE_SEO.TXT) (KẾT QUẢ TỨC THÌ)
    ' =========================================================================
    Dim fNameLowerRaw As String = niceName.ToLower()
    Dim charsToParse As String = fNameLowerRaw.Normalize(System.Text.NormalizationForm.FormD)
    Dim fNameLowerBuilder As New System.Text.StringBuilder()
    For Each c As Char In charsToParse
        If System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) <> System.Globalization.UnicodeCategory.NonSpacingMark Then
            fNameLowerBuilder.Append(c)
        End If
    Next
    Dim fNameLower As String = fNameLowerBuilder.ToString().Normalize(System.Text.NormalizationForm.FormC).Replace("đ", "d").Replace("-", " ")
    
    Dim coreBrand As String = "Industrial Water System"
    Dim subTags As String = "industrial, water, engineering, plant"
    
    If fNameLower.Contains("ro") OrElse fNameLower.Contains("tinh khiet") Then
        coreBrand = "Reverse Osmosis System" : subTags &= ", reverse_osmosis, water_purification"
    ElseIf fNameLower.Contains("uf") OrElse fNameLower.Contains("sieu loc") Then
        coreBrand = "Ultrafiltration System" : subTags &= ", ultrafiltration, membrane"
    ElseIf fNameLower.Contains("edi") Then
        coreBrand = "Electrodeionization System" : subTags &= ", edi, ultrapure_water"
    ElseIf fNameLower.Contains("bom") Then
        coreBrand = "Pump Station System" : subTags &= ", pump_station, fluid_dynamics"
    ElseIf fNameLower.Contains("ozone") Then
        coreBrand = "Ozone Generator System" : subTags &= ", ozone_generator"
    ElseIf fNameLower.Contains("uv") OrElse fNameLower.Contains("diet khuan") Then
        coreBrand = "UV Sterilizer System" : subTags &= ", uv_sterilizer"
    ElseIf fNameLower.Contains("loc tho") OrElse fNameLower.Contains("da tang") Then
        coreBrand = "Multimedia Filter System" : subTags &= ", water_filter"
    ElseIf fNameLower.Contains("nuoc thai") OrElse fNameLower.Contains("xlnt") Then
        coreBrand = "Wastewater Treatment System" : subTags &= ", wastewater"
    End If

    Dim rnd As New Random()
    Dim emojis As String() = {"🚀", "⚙️", "🔥", "💎"}
    Dim chosenEmoji As String = emojis(rnd.Next(0, emojis.Length))
    
    Dim ytTitle As String = chosenEmoji & " Industrial " & coreBrand & " CAD Model #Shorts"
    If ytTitle.Length > 60 Then ytTitle = chosenEmoji & " " & coreBrand & " CAD Model #Shorts"
    Dim hooks As String() = {
        "Download the native 3D source files here 👇",
        "Get this engineering-grade CAD asset now 👇",
        "Instant download for this P&ID ready model 👇"
    }
    Dim chosenHook As String = hooks(rnd.Next(0, hooks.Length))
    Dim ytHashtags As String = "#Shorts #Engineering #3DModel #" & coreBrand.Replace(" ", "")

    Dim ytSection As String = "=============================================" & vbCrLf &
                            "🟥 YOUTUBE SHORTS / VIDEO SEO (Copy/Paste):" & vbCrLf &
                            "=============================================" & vbCrLf &
                            "[TITLE (Under 60 Chars)]:" & vbCrLf & ytTitle & vbCrLf & vbCrLf &
                            "[DESCRIPTION (Result-First Hook)]:" & vbCrLf &
                            chosenHook & vbCrLf & 
                            "🔗 CGTrader: https://www.cgtrader.com/designers/tanphan1105" & vbCrLf & 
                            "🔗 Fab: https://www.fab.com/sellers/Trong%20Tan%20Phan" & vbCrLf & vbCrLf &
                            "💼 Custom Engineering? DM: trongtan.p@icloud.com" & vbCrLf & vbCrLf &
                            ytHashtags & vbCrLf & vbCrLf

    Dim txtContent As String = ytSection &
                            "=============================================" & vbCrLf &
                            "🔥 CGTRADER TITLE:" & vbCrLf &
                            "=============================================" & vbCrLf &
                            "Industrial " & coreBrand & " - High Fidelity 3D Model | CAD & STEP Ready" & vbCrLf & vbCrLf &
                            "=============================================" & vbCrLf &
                            "📋 TECHNICAL DESCRIPTION:" & vbCrLf &
                            "=============================================" & vbCrLf &
                            "Engineering-grade 3D model of an Industrial " & coreBrand & ". " & vbCrLf &
                            "Designed directly from real-world manufacturing standards to provide maximum realism for industrial visualization, factory layouts, and EPC B2B marketing." & vbCrLf & vbCrLf &
                            draftDesc & vbCrLf & vbCrLf &
                            "PHYSICAL FOOTPRINT & METRICS:" & vbCrLf &
                            "• Length: " & w & " mm" & vbCrLf &
                            "• Width: " & d & " mm" & vbCrLf &
                            "• Height: " & h & " mm" & vbCrLf &
                            "• Exact Component Count: " & ptCount & " discrete parts." & vbCrLf & vbCrLf &
                            "Note: Built natively in Autodesk Inventor for perfect 1:1 real-world scaling and technical accuracy."
                            
    Dim seoDir As String = "d:\WT3D_Project\Preview_Image\" & baseName
    If Not System.IO.Directory.Exists(seoDir) Then System.IO.Directory.CreateDirectory(seoDir)
    System.IO.File.WriteAllText(seoDir & "\Z_Copy_Paste_SEO_Data.txt", txtContent, System.Text.Encoding.UTF8)

    ' 3. ĐÚC THẲNG RA FILE HTML DASHBOARD ĐỂ SẾP BẤM 1 CHẠM COPY
    Dim exportDir As String = "d:\WT3D_Project\1_Exports_Batch\" & baseName
    If Not System.IO.Directory.Exists(exportDir) Then
        System.IO.Directory.CreateDirectory(exportDir)
    End If
    Dim htmlOut As String = exportDir & "\Dashboard_SEO_" & baseName & ".html"

    ' Tính toán Auto Pricing cho Sếp chống lại rào cản Sale Sập Sàn của CGTrader
    Dim targetPriceTop As Integer = 150
    If ptCount < 50 Then
        targetPriceTop = 35
    ElseIf ptCount < 300 Then
        targetPriceTop = 75
    ElseIf ptCount < 1000 Then
        targetPriceTop = 150
    Else
        targetPriceTop = 300
    End If
    
    Dim base30 As Integer = Math.Ceiling(targetPriceTop / 0.7)
    If base30 Mod 10 = 0 Then base30 -= 1
    
    Dim base50 As Integer = Math.Ceiling(targetPriceTop / 0.5)
    If base50 Mod 10 = 0 Then base50 -= 1
    
    Dim base70 As Integer = Math.Ceiling(targetPriceTop / 0.3)
    If base70 Mod 10 = 0 Then base70 -= 1

    ' Title Length Control (Tuân thủ luật 4-6 words của thuật toán CGTrader)
    Dim finalTitle As String = niceName
    Dim wordCount As Integer = 1
    For Each c As Char In finalTitle
        If c = " "c Then wordCount += 1
    Next
    If wordCount <= 3 Then
        finalTitle &= " 3D CAD Model"
    End If

    Dim htmlContent As String = _
