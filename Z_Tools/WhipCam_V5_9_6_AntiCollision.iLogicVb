            grpGuide.Size = New System.Drawing.Size(360, 282)

            ' Attach preset handler only AFTER all referenced controls are declared.

            AddHandler btnPreset.Click, Sub(sender As Object, e As EventArgs)

                numFar.Value = 2.65D

                numNear1.Value = 1.05D

                numNear2.Value = 0.62D

                numRelease.Value = 0.30D

                numSweep.Value = 190D

                numOrganic.Value = 5D

                numFast.Value = 1.55D

                numHold.Value = 1.50D

                numHoldSpeed.Value = 9D

                numFovFar.Value = 48D

                numFovFast.Value = 62D

                numFovNear.Value = 70D

                numFovReveal.Value = 47D

                numBank.Value = 8.5D

                numBankGain.Value = 1.10D

                chkBlur.Checked = True

                numShutter.Value = 180D

            End Sub




            ' --- NUT LUU THONG SO ---
            AddHandler btnSave.Click, Sub(snd2 As Object, ev2 As EventArgs)
                Try
                    Dim savePath As String = System.IO.Path.ChangeExtension(oDoc.FullFileName, ".whipcam_settings.ini")
                    Dim sb As New System.Text.StringBuilder()
                    sb.AppendLine("[WhipCam_V5_Settings]")
                    sb.AppendLine("Far="          & numFar.Value.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))
                    sb.AppendLine("Near1="         & numNear1.Value.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))
                    sb.AppendLine("Near2="         & numNear2.Value.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))
                    sb.AppendLine("Release="       & numRelease.Value.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))
                    sb.AppendLine("Sweep="         & numSweep.Value.ToString("F0", System.Globalization.CultureInfo.InvariantCulture))
                    sb.AppendLine("Organic="       & numOrganic.Value.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))
                    sb.AppendLine("Duration="      & numDur.Value.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))
                    sb.AppendLine("Fast="          & numFast.Value.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))
                    sb.AppendLine("Hold="          & numHold.Value.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))
                    sb.AppendLine("HoldSpeed="     & numHoldSpeed.Value.ToString("F0", System.Globalization.CultureInfo.InvariantCulture))
                    sb.AppendLine("FovFar="        & numFovFar.Value.ToString("F0", System.Globalization.CultureInfo.InvariantCulture))
                    sb.AppendLine("FovFast="       & numFovFast.Value.ToString("F0", System.Globalization.CultureInfo.InvariantCulture))
                    sb.AppendLine("FovNear="       & numFovNear.Value.ToString("F0", System.Globalization.CultureInfo.InvariantCulture))
                    sb.AppendLine("FovReveal="     & numFovReveal.Value.ToString("F0", System.Globalization.CultureInfo.InvariantCulture))
                    sb.AppendLine("Bank="          & numBank.Value.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))
                    sb.AppendLine("BankGain="      & numBankGain.Value.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))
                    sb.AppendLine("MotionBlur="    & chkBlur.Checked.ToString())
                    sb.AppendLine("Shutter="       & numShutter.Value.ToString("F0", System.Globalization.CultureInfo.InvariantCulture))
                    System.IO.File.WriteAllText(savePath, sb.ToString(), System.Text.Encoding.UTF8)
                    MessageBox.Show("Da luu: " & System.IO.Path.GetFileName(savePath), "WhipCam Luu", MessageBoxButtons.OK, MessageBoxIcon.Information)
                Catch exSave As Exception
                    MessageBox.Show("Loi luu: " & exSave.Message, "WhipCam Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                End Try
            End Sub

            ' --- NUT TAI THONG SO ---
            AddHandler btnLoad.Click, Sub(snd3 As Object, ev3 As EventArgs)
                Try
                    Dim savePath As String = System.IO.Path.ChangeExtension(oDoc.FullFileName, ".whipcam_settings.ini")
                    If Not System.IO.File.Exists(savePath) Then
                        MessageBox.Show("Chua co file luu: " & System.IO.Path.GetFileName(savePath) & vbCrLf & "Hay nhan LUU THONG SO truoc.", "WhipCam Tai", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                        Return
                    End If
                    Dim kv As New Dictionary(Of String, String)()
                    For Each rawLine As String In System.IO.File.ReadAllLines(savePath, System.Text.Encoding.UTF8)
                        Dim trimmed As String = rawLine.Trim()
                        If trimmed.StartsWith("[") OrElse trimmed = "" Then Continue For
                        Dim eq As Integer = trimmed.IndexOf("="c)
                        If eq > 0 Then kv(trimmed.Substring(0, eq).Trim()) = trimmed.Substring(eq + 1).Trim()
                    Next
                    Dim parseD As Func(Of String, Decimal, Decimal) = Function(k As String, def As Decimal) As Decimal
                        If kv.ContainsKey(k) Then Return CDec(Double.Parse(kv(k), System.Globalization.CultureInfo.InvariantCulture))
                        Return def
                    End Function
                    numFar.Value       = Math.Max(numFar.Minimum,       Math.Min(numFar.Maximum,       parseD("Far",       2.65D)))
                    numNear1.Value     = Math.Max(numNear1.Minimum,     Math.Min(numNear1.Maximum,     parseD("Near1",     1.05D)))
                    numNear2.Value     = Math.Max(numNear2.Minimum,     Math.Min(numNear2.Maximum,     parseD("Near2",     0.62D)))
                    numRelease.Value   = Math.Max(numRelease.Minimum,   Math.Min(numRelease.Maximum,   parseD("Release",   0.30D)))
                    numSweep.Value     = Math.Max(numSweep.Minimum,     Math.Min(numSweep.Maximum,     parseD("Sweep",     190D)))
                    numOrganic.Value   = Math.Max(numOrganic.Minimum,   Math.Min(numOrganic.Maximum,   parseD("Organic",   5D)))
                    numDur.Value       = Math.Max(numDur.Minimum,       Math.Min(numDur.Maximum,       parseD("Duration",  10.5D)))
                    numFast.Value      = Math.Max(numFast.Minimum,      Math.Min(numFast.Maximum,      parseD("Fast",      1.55D)))
                    numHold.Value      = Math.Max(numHold.Minimum,      Math.Min(numHold.Maximum,      parseD("Hold",      1.50D)))
                    numHoldSpeed.Value = Math.Max(numHoldSpeed.Minimum,  Math.Min(numHoldSpeed.Maximum, parseD("HoldSpeed", 9D)))
                    numFovFar.Value    = Math.Max(numFovFar.Minimum,    Math.Min(numFovFar.Maximum,    parseD("FovFar",    48D)))
                    numFovFast.Value   = Math.Max(numFovFast.Minimum,   Math.Min(numFovFast.Maximum,   parseD("FovFast",   62D)))
                    numFovNear.Value   = Math.Max(numFovNear.Minimum,   Math.Min(numFovNear.Maximum,   parseD("FovNear",   70D)))
                    numFovReveal.Value = Math.Max(numFovReveal.Minimum, Math.Min(numFovReveal.Maximum, parseD("FovReveal", 47D)))
                    numBank.Value      = Math.Max(numBank.Minimum,      Math.Min(numBank.Maximum,      parseD("Bank",      8.5D)))
                    numBankGain.Value  = Math.Max(numBankGain.Minimum,  Math.Min(numBankGain.Maximum,  parseD("BankGain",  1.10D)))
                    If kv.ContainsKey("MotionBlur") Then chkBlur.Checked = (kv("MotionBlur").ToLower() = "true")
                    numShutter.Value   = Math.Max(numShutter.Minimum,   Math.Min(numShutter.Maximum,   parseD("Shutter",   180D)))
                    MessageBox.Show("Da tai: " & System.IO.Path.GetFileName(savePath), "WhipCam Tai", MessageBoxButtons.OK, MessageBoxIcon.Information)
                Catch exLoad As Exception
                    MessageBox.Show("Loi tai: " & exLoad.Message, "WhipCam Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                End Try
            End Sub

            ' Vietnamese tooltips: explain what changes visually, not just the variable name.

            tips.SetToolTip(numFar, "Khoảng cách nền khi camera ở XA. Tăng số này = toàn cảnh hơn. Khuyên dùng 2.4–3.0x; preset 2.65x.")

            tips.SetToolTip(numNear1, "Khoảng cách cận lần 1. Số nhỏ = camera áp sát hơn. Khuyên dùng 0.95–1.15x.")

            tips.SetToolTip(numNear2, "Cận cảnh mạnh nhất. Chỉ nên rất gần trong thời gian ngắn. Khuyên dùng 0.58–0.75x; preset 0.62x.")

            tips.SetToolTip(numRelease, "Mức camera bật/lùi xa giữa hai lần áp sát. Tăng = nhịp XA/GẦN rõ hơn. Khuyên 0.20–0.40.")

            tips.SetToolTip(numSweep, "Góc camera bay vòng quanh Hero. 180° ≈ nửa vòng. Khuyên 170–210° để vừa tròn vừa không thành tour 360°.")

            tips.SetToolTip(numOrganic, "Độ uốn nhẹ làm quỹ đạo bớt cơ khí. Quá cao dễ rung. Khuyên 3–8°.")

            tips.SetToolTip(numFast, "Độ nhanh khi lao từ XA vào GẦN và khi vọt ra. Khuyên 1.4–1.8x.")

            tips.SetToolTip(numHold, "Kéo dài đoạn chậm/giữ gần Hero để người xem kịp nhìn. Khuyên 1.3–1.8x.")

            tips.SetToolTip(numHoldSpeed, "Tốc độ còn lại khi đang nhấn gần Hero. 0% = gần như dừng. Khuyên 6–12%; preset 9%.")

            tips.SetToolTip(numFovFar, "FOV khi ở xa. FOV nhỏ = khung chặt hơn. Khuyên 46–52°.")

            tips.SetToolTip(numFovFast, "FOV lúc bay nhanh. Tăng FOV tạo cảm giác tốc độ/parallax mạnh hơn. Khuyên 58–65°.")

            tips.SetToolTip(numFovNear, "FOV lúc close-pass. Lưu ý: FOV lớn là góc rộng, KHÔNG phải zoom gần; độ gần đến từ camera di chuyển thật. Khuyên 66–72°.")

            tips.SetToolTip(numFovReveal, "FOV cảnh kết/reveal. Khuyên 45–50° để hình ổn định, ít méo.")

            tips.SetToolTip(numBank, "Góc nghiêng khung hình tối đa khi cua. Quá cao sẽ có cảm giác đảo/lật. Khuyên 7–10°.")

            tips.SetToolTip(numBankGain, "Độ nhạy của banking theo độ cong/tốc độ. Khuyên 0.9–1.3x.")

            tips.SetToolTip(chkBlur, "Motion Blur giúp đoạn bay nhanh mượt hơn, che micro-jitter. Nên bật khi xuất Master.")

            tips.SetToolTip(numShutter, "Shutter angle cho motion blur. 180° là cân bằng; 120–150° nét hơn; 210–240° mờ mạnh hơn.")



            Dim btnOk As New System.Windows.Forms.Button()

            btnOk.Text = "▶ CHAY CAMERA"

            btnOk.Location = New System.Drawing.Point(555, 710)

            btnOk.Size = New System.Drawing.Size(140, 38)

            btnOk.BackColor = System.Drawing.Color.FromArgb(27, 122, 62)

            btnOk.ForeColor = System.Drawing.Color.White

            btnOk.FlatStyle = FlatStyle.Flat

            btnOk.Font = New System.Drawing.Font("Segoe UI", 10.0!, FontStyle.Bold)

            btnOk.DialogResult = DialogResult.OK

            form.Controls.Add(btnOk)



            Dim btnCancel As New System.Windows.Forms.Button()

            btnCancel.Text = "HUY"

            btnCancel.Location = New System.Drawing.Point(705, 710)

            btnCancel.Size = New System.Drawing.Size(90, 38)

            btnCancel.BackColor = System.Drawing.Color.FromArgb(220, 220, 220)

            btnCancel.FlatStyle = FlatStyle.Flat

            btnCancel.DialogResult = DialogResult.Cancel

            form.Controls.Add(btnCancel)



            AddHandler btnOk.Click, Sub(sender As Object, e As EventArgs) form.Close()

            AddHandler btnCancel.Click, Sub(sender As Object, e As EventArgs) form.Close()



            form.BringToFront()

            form.Activate()



            If form.ShowDialog() = DialogResult.OK Then

                settings.DurationSeconds = CDbl(numDur.Value)



                settings.FarDistanceScale = CDbl(numFar.Value)

                settings.Near1DistanceScale = CDbl(numNear1.Value)

                settings.Near2DistanceScale = CDbl(numNear2.Value)

                settings.ReleaseDistanceBoost = CDbl(numRelease.Value)

                settings.OrbitSweepDegrees = CDbl(numSweep.Value)

                settings.OrbitOrganicBiasDegrees = CDbl(numOrganic.Value)



                settings.FastSpeedMultiplier = CDbl(numFast.Value)

                settings.NearHoldMultiplier = CDbl(numHold.Value)

                settings.NearHoldSpeedPercent = CDbl(numHoldSpeed.Value)



                settings.FOVFarDegrees = CDbl(numFovFar.Value)

                settings.FOVFastDegrees = CDbl(numFovFast.Value)

                settings.FOVNearDegrees = CDbl(numFovNear.Value)

                settings.FOVRevealDegrees = CDbl(numFovReveal.Value)

                settings.MaxBankDegrees = CDbl(numBank.Value)

                settings.BankGainMultiplier = CDbl(numBankGain.Value)



                settings.EnableMotionBlur = chkBlur.Checked

                settings.ShutterAngle = CDbl(numShutter.Value)



                If rbPreview.Checked Then

                    settings.RunMode = "PREVIEW"

                    settings.FPS = 30

                    settings.TotalFrames = CInt(settings.DurationSeconds * settings.FPS)

                ElseIf rbDraft.Checked Then

                    settings.RunMode = "EXPORT_DRAFT"

                    settings.FPS = 30

                    settings.Width = 720

                    settings.Height = 1280

                    settings.EnableMotionBlur = False

                    settings.TotalFrames = CInt(settings.DurationSeconds * settings.FPS)

                ElseIf rbFinal.Checked Then

                    settings.RunMode = "EXPORT_FINAL"

                    settings.FPS = 60

                    settings.Width = 1080

                    settings.Height = 1920

                    settings.TotalFrames = CInt(settings.DurationSeconds * settings.FPS)

                End If



                ExecuteDirector(oDoc, oCam, settings)

            End If

        Catch ex As Exception

            MessageBox.Show("WT3D Camera Error: " & ex.Message & vbCrLf & ex.StackTrace, "WT3D Error", MessageBoxButtons.OK, MessageBoxIcon.Error)

        End Try

    End Sub



End Class

