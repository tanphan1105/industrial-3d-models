    Public Class CameraState

        Public Eye As Vec3

        Public Target As Vec3

        Public UpVector As Vec3

        Public FOV As Double

        Public RollDeg As Double

        Public Speed As Double

        Public Accel As Double

        Public Jerk As Double

        Public ActiveHeroName As String



        Public Sub New()

            Eye = New Vec3() : Target = New Vec3() : UpVector = New Vec3(0, 1, 0) ' True Y-up default

            FOV = 50.0 : RollDeg = 0.0 : Speed = 0.0 : Accel = 0.0 : Jerk = 0.0

            ActiveHeroName = "Overview"

        End Sub

    End Class



    Public Class HeroTarget

