            Dim lblFovReveal As New System.Windows.Forms.Label() : lblFovReveal.Text = "□ FOV canh ket / reveal  [20 – 100°]" : lblFovReveal.Location = New System.Drawing.Point(18, 126) : lblFovReveal.AutoSize = False : lblFovReveal.Size = New System.Drawing.Size(208, 18) : grpLens.Controls.Add(lblFovReveal)

            Dim numFovReveal As New System.Windows.Forms.NumericUpDown() : numFovReveal.Location = New System.Drawing.Point(230, 123) : numFovReveal.Size = New System.Drawing.Size(105, 22) : numFovReveal.DecimalPlaces = 0 : numFovReveal.Minimum = 20D : numFovReveal.Maximum = 100D : numFovReveal.Value = 47D : grpLens.Controls.Add(numFovReveal)



            Dim lblBank As New System.Windows.Forms.Label() : lblBank.Text = "↶ Nghieng camera toi da  [0 – 25°]" : lblBank.Location = New System.Drawing.Point(18, 158) : lblBank.AutoSize = False : lblBank.Size = New System.Drawing.Size(208, 18) : grpLens.Controls.Add(lblBank)

            Dim numBank As New System.Windows.Forms.NumericUpDown() : numBank.Location = New System.Drawing.Point(230, 155) : numBank.Size = New System.Drawing.Size(105, 22) : numBank.DecimalPlaces = 1 : numBank.Increment = 0.5D : numBank.Minimum = 0D : numBank.Maximum = 25D : numBank.Value = 8.5D : grpLens.Controls.Add(numBank)



            Dim lblBankGain As New System.Windows.Forms.Label() : lblBankGain.Text = "∿ Nhay nghieng theo curvature  [0 – 3x]" : lblBankGain.Location = New System.Drawing.Point(18, 190) : lblBankGain.AutoSize = False : lblBankGain.Size = New System.Drawing.Size(208, 18) : grpLens.Controls.Add(lblBankGain)

            Dim numBankGain As New System.Windows.Forms.NumericUpDown() : numBankGain.Location = New System.Drawing.Point(230, 187) : numBankGain.Size = New System.Drawing.Size(105, 22) : numBankGain.DecimalPlaces = 2 : numBankGain.Increment = 0.05D : numBankGain.Minimum = 0D : numBankGain.Maximum = 3D : numBankGain.Value = 1.10D : grpLens.Controls.Add(numBankGain)



            Dim chkBlur As New System.Windows.Forms.CheckBox()

            chkBlur.Text = "≈ Bat Motion Blur"

            chkBlur.Location = New System.Drawing.Point(18, 224)

            chkBlur.Size = New System.Drawing.Size(170, 24)

            chkBlur.Checked = True

            grpLens.Controls.Add(chkBlur)



            Dim lblShutter As New System.Windows.Forms.Label() : lblShutter.Text = "Shutter °" : lblShutter.Location = New System.Drawing.Point(195, 227) : lblShutter.AutoSize = True : grpLens.Controls.Add(lblShutter)

            Dim numShutter As New System.Windows.Forms.NumericUpDown() : numShutter.Location = New System.Drawing.Point(270, 224) : numShutter.Size = New System.Drawing.Size(70, 22) : numShutter.DecimalPlaces = 0 : numShutter.Increment = 30D : numShutter.Minimum = 0D : numShutter.Maximum = 360D : numShutter.Value = 180D : grpLens.Controls.Add(numShutter)



            ' V5.9.6: FOV annotation label

            Dim lblLensNote As New System.Windows.Forms.Label()

            lblLensNote.Text = "GHI CHU FOV:" & vbCrLf & "  FOV nho (20-50°) = khung chat/telephoto, it meo, nhung canh xem co the chop mat" & vbCrLf & "  FOV lon (60-90°) = goc rong/wide, tang toc do cam giac va parallax khi bay nhanh" & vbCrLf & "  Nghieng (Bank): tang = kich tinh hon; qua 12° de gay dau mat. Preset 8.5° la on."

            lblLensNote.Location = New System.Drawing.Point(18, 248)

            lblLensNote.Size = New System.Drawing.Size(344, 70)

            lblLensNote.Font = New System.Drawing.Font("Segoe UI", 7.5!, FontStyle.Italic)

            lblLensNote.ForeColor = System.Drawing.Color.FromArgb(80, 80, 140)

            grpLens.Controls.Add(lblLensNote)

            grpLens.Size = New System.Drawing.Size(380, 330)




            ' --- NUT LUU / TAI THONG SO ---
            Dim btnSave As New System.Windows.Forms.Button()
            btnSave.Text = "SAVE  LUU THONG SO"
            btnSave.Location = New System.Drawing.Point(18, 232)
            btnSave.Size = New System.Drawing.Size(148, 34)
            btnSave.BackColor = System.Drawing.Color.FromArgb(230, 240, 255)
            btnSave.ForeColor = System.Drawing.Color.FromArgb(30, 80, 160)
            btnSave.FlatStyle = FlatStyle.Flat
            btnSave.Font = New System.Drawing.Font("Segoe UI", 9.0!, FontStyle.Bold)
            grpGuide.Controls.Add(btnSave)

            Dim btnLoad As New System.Windows.Forms.Button()
            btnLoad.Text = "OPEN  TAI THONG SO"
            btnLoad.Location = New System.Drawing.Point(175, 232)
            btnLoad.Size = New System.Drawing.Size(148, 34)
            btnLoad.BackColor = System.Drawing.Color.FromArgb(255, 245, 220)
            btnLoad.ForeColor = System.Drawing.Color.FromArgb(140, 80, 10)
            btnLoad.FlatStyle = FlatStyle.Flat
            btnLoad.Font = New System.Drawing.Font("Segoe UI", 9.0!, FontStyle.Bold)
