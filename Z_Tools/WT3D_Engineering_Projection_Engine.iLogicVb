    ' 3. Áp dụng Lighting Style: Two Lights + Đầy đủ 4 tầng Shadow tự nhiên, sắc nét, không lem
    Try
        oApp.SilentOperation = True
        Dim hasTwoLights As Boolean = False
        For Each ls As LightingStyle In oDoc.LightingStyles
            If ls.Name.ToLower() = "two lights" Then hasTwoLights = True : Exit For
        Next
        If hasTwoLights Then
            oDoc.ActiveLightingStyle = oDoc.LightingStyles.Item("Two Lights")
        Else
            Try
                oDoc.ActiveLightingStyle = oDoc.LightingStyles.Item("Default Lights")
            Catch
                oDoc.ActiveLightingStyle = oDoc.LightingStyles.Item(1)
            End Try
        End If

        Dim curStyle As LightingStyle = oDoc.ActiveLightingStyle
        If curStyle IsNot Nothing Then
            curStyle.Ambience = 0.38
            Try : curStyle.ShadowDensity = 0.50 : Catch : End Try
            
            Dim lNum As Integer = 1
            For Each lt As Light In curStyle.Lights
                lt.Enabled = True
                If lNum = 1 Then
                    lt.Intensity = 1.25
                    lt.Color = ThisApplication.TransientObjects.CreateColor(255, 253, 250)
                ElseIf lNum = 2 Then
                    lt.Intensity = 0.85
                    lt.Color = ThisApplication.TransientObjects.CreateColor(245, 248, 255)
                ElseIf lNum = 3 Then
                    lt.Intensity = 1.30
                    lt.Color = ThisApplication.TransientObjects.CreateColor(255, 255, 255)
                Else
                    lt.Intensity = 0.90
                    lt.Color = ThisApplication.TransientObjects.CreateColor(255, 255, 255)
                End If
                lNum += 1
            Next
        End If
    Catch
    End Try
    Finally















        oApp.SilentOperation = False















    End Try















