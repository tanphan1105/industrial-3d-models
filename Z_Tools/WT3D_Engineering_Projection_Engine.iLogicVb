' Lambda lưu frame an toàn 100% (chống lỗi COMException 0x80004005 / buffer lock)















Dim SaveSafeFrame As Action(Of String, Integer, Integer) = Sub(fPath As String, w As Integer, h As Integer)















    For attempt As Integer = 1 To 3















        Try















            oCam.SaveAsBitmap(fPath, w, h)















            Exit Sub















        Catch exCom As Exception















            oApp.UserInterfaceManager.DoEvents()















            System.Threading.Thread.Sleep(15)















            Try















oView.Update()















Catch















End Try















            Try















oCam.ApplyWithoutTransition()















Catch















End Try















        End Try















    Next















    Try















oView.SaveAsBitmap(fPath, w, h)















Catch















End Try















End Sub















