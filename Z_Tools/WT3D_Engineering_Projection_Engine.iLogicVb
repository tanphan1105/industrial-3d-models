    Try















        Dim ipnFile As String = System.IO.Path.Combine(docDir, baseName & ".ipn")















        If System.IO.File.Exists(ipnFile) Then















            oApp.StatusBarText = "💥 Phát hiện File Phân Rã (.ipn) -> Đang tự động chụp Exploded View..."















            Dim ipnDoc As Inventor.Document = Nothing















            Dim ipnAlreadyOpen As Boolean = False















            For Each d As Document In oApp.Documents















                If d.FullFileName.ToLower() = ipnFile.ToLower() Then















                    ipnDoc = d : ipnAlreadyOpen = True : Exit For















                End If















            Next















            If ipnDoc Is Nothing Then















                ipnDoc = oApp.Documents.Open(ipnFile, True)















            End If















            If ipnDoc IsNot Nothing Then















                ipnDoc.Activate()















                Dim ipnView As Inventor.View = oApp.ActiveView















                Dim ipnCam As Inventor.Camera = ipnView.Camera















                Try















                    ipnDoc.ObjectVisibility.AllWorkFeatures = False















                    ipnDoc.ObjectVisibility.UserWorkPlanes = False















                    ipnDoc.ObjectVisibility.OriginWorkPlanes = False















                    ipnDoc.ObjectVisibility.Sketches = False















                Catch















End Try















                ipnView.DisplayMode = DisplayModeEnum.kShadedWithEdgesRendering















                ipnView.ShowAmbientShadows = True : ipnView.ShowObjectShadows = True : ipnView.ShowGroundShadows = True















                ipnView.Update()















                ipnCam.Perspective = True : ipnCam.PerspectiveAngle = 0.52















                ipnCam.Fit() : ipnCam.ApplyWithoutTransition()















                Dim cW As Double, cH As Double















                ipnCam.GetExtents(cW, cH)















                ipnCam.SetExtents(cW * 0.72, cH * 0.72)















                ipnCam.ApplyWithoutTransition() : oApp.UserInterfaceManager.DoEvents()















                Dim snapExploded As String = System.IO.Path.Combine(snapshotDir, baseName & "_20_Exploded_BOM_Assembly.png")















                ipnCam.SaveAsBitmap(snapExploded, CFG_RenderW, CFG_RenderH)















                If Not ipnAlreadyOpen Then















                    Try















ipnDoc.Close(True)















Catch















End Try















                End If















                oDoc.Activate()















            End If















        End If















    Catch















End Try















