AddReference "PresentationCore"















AddReference "WindowsBase"















AddReference "System.Drawing"















AddReference "System.Windows.Forms"















Imports System.Windows.Forms















Public Class ThisRule















    Private Declare Auto Function GetAsyncKeyState Lib "user32.dll" (ByVal vKey As Integer) As Short















    Private Const VK_ESCAPE As Integer = &H1B















    Private Function CheckEscapeKey() As Boolean

        Try

            System.Windows.Forms.Application.DoEvents()

            If (GetAsyncKeyState(&H1B) And &H8000) <> 0 Then

                Try : SharedVariable("WT3D_ABORT_REQUESTED") = True : Catch : End Try

                Return True

            End If

        Catch

        End Try

        Return False

    End Function















    Sub Main()

        Try : SharedVariable("WT3D_ABORT_REQUESTED") = False : Catch : End Try

        Try : GetAsyncKeyState(&H1B) : Catch : End Try















Dim oApp  As Inventor.Application = ThisApplication















Dim oDoc  As Inventor.Document    = oApp.ActiveDocument















If oDoc Is Nothing OrElse (oDoc.DocumentType <> DocumentTypeEnum.kAssemblyDocumentObject AndAlso oDoc.DocumentType <> DocumentTypeEnum.kPartDocumentObject) Then















    MessageBox.Show("Vui lòng mở một mô hình 3D (.iam hoặc .ipt) trước khi chạy!", "WT3D", MessageBoxButtons.OK, MessageBoxIcon.Warning)















    Exit Sub















End If















' ==============================================================================















' DỌN DẸP HIỂN THỊ TRIỆT ĐỂ 100% NGAY TỪ ĐẦU (TẮT TOÀN BỘ MẶT PHẲNG, TRỤC, SKETCH)















' ==============================================================================















Try















    ' 1. ÉP TẮT QUA ĐIỀU KHIỂN HỆ THỐNG COMMANDMANAGER CỦA INVENTOR (TƯƠNG ĐƯƠNG BẤM TẮT TRÊN GIAO DIỆN)















    Try















        Dim ctrlDef As ControlDefinition = ThisApplication.CommandManager.ControlDefinitions.Item("AppAllWorkFeaturesCmd")















        If ctrlDef IsNot Nothing AndAlso ctrlDef.Pressed Then















            ctrlDef.Execute()















        End If















    Catch















End Try















    ' 2. Tắt toàn bộ Work Features ở cấp View & Tài liệu















    oDoc.ObjectVisibility.AllWorkFeatures = False















    oDoc.ObjectVisibility.UserWorkPlanes = False















    oDoc.ObjectVisibility.OriginWorkPlanes = False















    oDoc.ObjectVisibility.UserWorkAxes = False















    oDoc.ObjectVisibility.OriginWorkAxes = False















    oDoc.ObjectVisibility.UserWorkPoints = False















    oDoc.ObjectVisibility.OriginWorkPoints = False















    oDoc.ObjectVisibility.OriginWorkFeatures = False















    oDoc.ObjectVisibility.Sketches = False















    oDoc.ObjectVisibility.Sketches3D = False















    oDoc.ObjectVisibility.WeldmentSymbols = False















    oDoc.ObjectVisibility.ConstructionSurfaces = False















    ' 3. Quét đệ quy từng Part con để ép Visible = False cho toàn bộ WorkPlanes / WorkAxes















    If TypeOf oDoc Is AssemblyDocument Then















        Dim oAsmDoc As AssemblyDocument = DirectCast(oDoc, AssemblyDocument)















        For Each wp As WorkPlane In oAsmDoc.ComponentDefinition.WorkPlanes















            Try















wp.Visible = False















Catch















End Try















        Next















        For Each wa As WorkAxis In oAsmDoc.ComponentDefinition.WorkAxes















            Try















wa.Visible = False















Catch















End Try















        Next















        For Each wpnt As WorkPoint In oAsmDoc.ComponentDefinition.WorkPoints















            Try















wpnt.Visible = False















Catch















End Try















        Next















        For Each occ As ComponentOccurrence In oAsmDoc.ComponentDefinition.Occurrences















            If Not occ.Suppressed Then















                Try















                    If occ.DefinitionDocumentType = DocumentTypeEnum.kPartDocumentObject Then















                        Dim pDef As PartComponentDefinition = DirectCast(occ.Definition, PartComponentDefinition)















                        For Each wp As WorkPlane In pDef.WorkPlanes















                            Try















wp.Visible = False















Catch















End Try















                        Next















                        For Each wa As WorkAxis In pDef.WorkAxes















                            Try















wa.Visible = False















Catch















End Try















                        Next















                        For Each wpnt As WorkPoint In pDef.WorkPoints















                            Try















wpnt.Visible = False















Catch















End Try















                        Next















                    ElseIf occ.DefinitionDocumentType = DocumentTypeEnum.kAssemblyDocumentObject Then















                        Dim subAsmDef As AssemblyComponentDefinition = DirectCast(occ.Definition, AssemblyComponentDefinition)















                        For Each wp As WorkPlane In subAsmDef.WorkPlanes















                            Try















wp.Visible = False















Catch















End Try















                        Next















                        For Each subOcc As ComponentOccurrence In subAsmDef.Occurrences















                            If Not subOcc.Suppressed AndAlso subOcc.DefinitionDocumentType = DocumentTypeEnum.kPartDocumentObject Then















                                Dim subPDef As PartComponentDefinition = DirectCast(subOcc.Definition, PartComponentDefinition)















                                For Each wp As WorkPlane In subPDef.WorkPlanes















                                    Try















wp.Visible = False















Catch















End Try















                                Next















                            End If















                        Next















                    End If















                Catch















End Try















            End If















        Next















    ElseIf TypeOf oDoc Is PartDocument Then















        Dim oPartDoc As PartDocument = DirectCast(oDoc, PartDocument)















        For Each wp As WorkPlane In oPartDoc.ComponentDefinition.WorkPlanes















            Try















wp.Visible = False















Catch















End Try















        Next















        For Each wa As WorkAxis In oPartDoc.ComponentDefinition.WorkAxes















            Try















wa.Visible = False















Catch















End Try















        Next















        For Each wpnt As WorkPoint In oPartDoc.ComponentDefinition.WorkPoints















            Try















wpnt.Visible = False















Catch















End Try















        Next















    End If















    oApp.ActiveView.Update()















Catch















End Try















' ==============================================================================















' SECTION 0: BẢNG ĐIỀU KHIỂN CHỌN CHẾ ĐỘ RENDER (INTERACTIVE GUI DIALOG)















' ==============================================================================















Dim isVertical As Boolean = True















Dim is2K       As Boolean = False















Dim is4K       As Boolean = False















Dim isBatchAuto As Boolean = False















If SharedVariable.Exists("WT3D_BATCH_MODE") Then















    Try















isBatchAuto = CBool(SharedVariable("WT3D_BATCH_MODE"))















Catch















End Try















End If















If isBatchAuto Then















    isVertical = False















    is2K = True















    is4K = False















Else















    Using frm As New System.Windows.Forms.Form()















        frm.Text = "🎬 WT3D Projection Studio - Thiết Lập Xuất Video & Bản Vẽ"















        frm.Size = New System.Drawing.Size(480, 420)















        frm.StartPosition = System.Windows.Forms.FormStartPosition.CenterScreen















        frm.FormBorderStyle = System.Windows.Forms.FormBorderStyle.FixedDialog















        frm.MaximizeBox = False















        frm.MinimizeBox = False















        frm.BackColor = System.Drawing.Color.FromArgb(248, 249, 252)















        frm.Font = New System.Drawing.Font("Segoe UI", 9.5F, System.Drawing.FontStyle.Regular)















        ' Tiêu đề Header















        Dim lblTitle As New System.Windows.Forms.Label()















        lblTitle.Text = "📐 THIẾT LẬP RENDER MÔ HÌNH 3D"















        lblTitle.Font = New System.Drawing.Font("Segoe UI", 12.0F, System.Drawing.FontStyle.Bold)















        lblTitle.ForeColor = System.Drawing.Color.FromArgb(10, 45, 120)















        lblTitle.Location = New System.Drawing.Point(25, 15)















        lblTitle.AutoSize = True















        frm.Controls.Add(lblTitle)















        ' GroupBox 1: Khung Hình (Ngang / Dọc)















        Dim grpOrientation As New System.Windows.Forms.GroupBox()















        grpOrientation.Text = " 📱 Định Dạng Khung Hình "















        grpOrientation.Location = New System.Drawing.Point(25, 50)















        grpOrientation.Size = New System.Drawing.Size(415, 90)















        Dim radVertical As New System.Windows.Forms.RadioButton()















        radVertical.Text = "📱 DỌC 9:16 (Shorts / TikTok / Reels / Mobile)"















        radVertical.Location = New System.Drawing.Point(20, 26)















        radVertical.AutoSize = True















        radVertical.Checked = False















        radVertical.Font = New System.Drawing.Font("Segoe UI", 9.5F, System.Drawing.FontStyle.Bold)















        grpOrientation.Controls.Add(radVertical)















        Dim radLandscape As New System.Windows.Forms.RadioButton()















        radLandscape.Text = "🖥️ NGANG 16:9 (YouTube / Website / B2B Catalog)"















        radLandscape.Location = New System.Drawing.Point(20, 55)















        radLandscape.AutoSize = True















        radLandscape.Checked = True















        grpOrientation.Controls.Add(radLandscape)















        frm.Controls.Add(grpOrientation)















        ' Tự động nhận diện Dự án lớn hay Linh kiện tiêu chuẩn để đặt mặc định















        Dim isComponent As Boolean = False















        If oDoc.FullFileName.ToLower().Contains("05_standard_components") OrElse oDoc.FullFileName.ToLower().EndsWith(".ipt") Then















            isComponent = True















        End If















        ' GroupBox 2: Độ Phân Giải (HD / 2K / 4K)















        Dim grpQuality As New System.Windows.Forms.GroupBox()















        grpQuality.Text = " 💎 Độ Phân Giải & Tốc Độ "















        grpQuality.Location = New System.Drawing.Point(25, 150)















        grpQuality.Size = New System.Drawing.Size(415, 120)















        Dim radHD As New System.Windows.Forms.RadioButton()















        radHD.Text = "⚡ Full HD 1080p (Mặc Định Linh Kiện • Render Nhanh ~25-35s)"















        radHD.Location = New System.Drawing.Point(20, 26)















        radHD.AutoSize = True















        radHD.Checked = isComponent















        radHD.Font = New System.Drawing.Font("Segoe UI", 9.5F, System.Drawing.FontStyle.Bold)















        grpQuality.Controls.Add(radHD)















        Dim rad2K As New System.Windows.Forms.RadioButton()















        rad2K.Text = "✨ 2K QHD 1440p (Mặc Định Dự Án Hệ Thống • Chuẩn Sàn 3D)"















        rad2K.Location = New System.Drawing.Point(20, 55)















        rad2K.AutoSize = True















        rad2K.Checked = Not isComponent















        rad2K.Font = New System.Drawing.Font("Segoe UI", 9.5F, System.Drawing.FontStyle.Bold)















        grpQuality.Controls.Add(rad2K)















        Dim rad4K As New System.Windows.Forms.RadioButton()















        rad4K.Text = "💎 Ultra HD 4K (Chất Lượng Tối Thượng • Siêu Nét Bán Sàn)"















        rad4K.Location = New System.Drawing.Point(20, 84)















        rad4K.AutoSize = True















        grpQuality.Controls.Add(rad4K)















        frm.Controls.Add(grpQuality)















        ' Nút Bắt Đầu















        Dim btnRun As New System.Windows.Forms.Button()















        btnRun.Text = "🚀 BẮT ĐẦU RENDER"















        btnRun.Location = New System.Drawing.Point(200, 288)















        btnRun.Size = New System.Drawing.Size(240, 45)















        btnRun.BackColor = System.Drawing.Color.FromArgb(10, 110, 60)















        btnRun.ForeColor = System.Drawing.Color.White















        btnRun.Font = New System.Drawing.Font("Segoe UI", 10.5F, System.Drawing.FontStyle.Bold)















        btnRun.FlatStyle = System.Windows.Forms.FlatStyle.Flat















        btnRun.DialogResult = System.Windows.Forms.DialogResult.OK















        frm.Controls.Add(btnRun)















        ' Nút Hủy















        Dim btnCancel As New System.Windows.Forms.Button()















        btnCancel.Text = "HỦY"















        btnCancel.Location = New System.Drawing.Point(25, 288)















        btnCancel.Size = New System.Drawing.Size(160, 45)















        btnCancel.BackColor = System.Drawing.Color.FromArgb(225, 230, 240)















        btnCancel.ForeColor = System.Drawing.Color.FromArgb(60, 70, 85)















        btnCancel.FlatStyle = System.Windows.Forms.FlatStyle.Flat















        btnCancel.DialogResult = System.Windows.Forms.DialogResult.Cancel















        frm.Controls.Add(btnCancel)















        frm.AcceptButton = btnRun















        frm.CancelButton = btnCancel















        Dim dr As System.Windows.Forms.DialogResult = frm.ShowDialog()















        If dr <> System.Windows.Forms.DialogResult.OK Then















            Exit Sub















        End If















        isVertical = radVertical.Checked















        is2K = rad2K.Checked















        is4K = rad4K.Checked















    End Using















End If















' ==============================================================================















' SECTION 1: CẤU HÌNH THÔNG SỐ ĐỘ PHÂN GIẢI & KHUNG HÌNH















' ==============================================================================















Dim CFG_FPS     As Integer = 30      ' 30 fps tiêu chuẩn















Dim CFG_RenderW As Integer = 1080















Dim CFG_RenderH As Integer = 1920















Dim modeTag     As String  = "9x16_Portrait"















Dim qualityTag  As String  = "1080p_FHD"















Dim fullTag     As String  = "9x16_Portrait_1080p"















Dim snapshotSubDir As String = "9_16_Portrait_1080p"















If isVertical Then















    If is4K Then















        CFG_RenderW = 2160 : CFG_RenderH = 3840















        modeTag = "9x16_Portrait" : qualityTag = "4K_UHD" : fullTag = "9x16_Portrait_4K" : snapshotSubDir = "9_16_Portrait_4K"















    ElseIf is2K Then















        CFG_RenderW = 1440 : CFG_RenderH = 2560















        modeTag = "9x16_Portrait" : qualityTag = "2K_QHD" : fullTag = "9x16_Portrait_2K" : snapshotSubDir = "9_16_Portrait_2K"















    Else















        CFG_RenderW = 1080 : CFG_RenderH = 1920















        modeTag = "9x16_Portrait" : qualityTag = "1080p_FHD" : fullTag = "9x16_Portrait_1080p" : snapshotSubDir = "9_16_Portrait_1080p"















    End If















Else















    If is4K Then















        CFG_RenderW = 3840 : CFG_RenderH = 2160















        modeTag = "16x9_Landscape" : qualityTag = "4K_UHD" : fullTag = "16x9_Landscape_4K" : snapshotSubDir = "16_9_Landscape_4K"















    ElseIf is2K Then















        CFG_RenderW = 2560 : CFG_RenderH = 1440















        modeTag = "16x9_Landscape" : qualityTag = "2K_QHD" : fullTag = "16x9_Landscape_2K" : snapshotSubDir = "16_9_Landscape_2K"















    Else















        CFG_RenderW = 1920 : CFG_RenderH = 1080















        modeTag = "16x9_Landscape" : qualityTag = "1080p_FHD" : fullTag = "16x9_Landscape_1080p" : snapshotSubDir = "16_9_Landscape_1080p"















    End If















End If















Dim fIntro  As Integer = 90   ' Số frame Cảnh đầu: Xoay 3/4 DƯỚI 360 độ (3.0 giây - Siêu mượt mà)















Dim fFlight As Integer = 28   ' Số frame chuyển động bay (0.95 giây - Lướt êm ái)















Dim fHold   As Integer = 45   ' Số frame khóa mặt chiếu 2D (1.5 giây - Đọc rõ kích thước L, W, H)















Dim fOutro  As Integer = 75   ' Số frame Cảnh cuối: Xoay 3/4 TRÊN (2.5 giây - Bao quát siêu mượt mà)















Dim fFinale As Integer = 45   ' Số frame CHỐT CẢNH FIT TO VIEW VIEWCUBE (1.5 giây - Giữ tĩnh)















Dim CFG_FitPadding As Double = 0.72 ' Tỷ lệ 72% (chừa lề 14% cho đường kích thước CAD)















Dim oView As Inventor.View        = oApp.ActiveView















Dim oCam  As Inventor.Camera      = oView.Camera















Dim tg    As TransientGeometry    = oApp.TransientGeometry















' ==============================================================================















' SECTION 2: LƯU TRẠNG THÁI GỐC















' ==============================================================================















Dim orgEyeX As Double = oCam.Eye.X, orgEyeY As Double = oCam.Eye.Y, orgEyeZ As Double = oCam.Eye.Z















Dim orgTgtX As Double = oCam.Target.X, orgTgtY As Double = oCam.Target.Y, orgTgtZ As Double = oCam.Target.Z















Dim orgUpX  As Double = oCam.UpVector.X, orgUpY  As Double = oCam.UpVector.Y, orgUpZ  As Double = oCam.UpVector.Z















Dim orgPersp As Boolean = oCam.Perspective















Dim orgPerspAng As Double = 0.52















Try















orgPerspAng = oCam.PerspectiveAngle















Catch















End Try















Dim orgDispMode As DisplayModeEnum = oView.DisplayMode















Dim orgAmbient As Boolean = oView.ShowAmbientShadows















Dim orgObject As Boolean = oView.ShowObjectShadows















Dim orgGround As Boolean = oView.ShowGroundShadows















' ==============================================================================















' SECTION 3: TÍNH TOÁN KÍCH THƯỚC PHỦ BÌ (BOUNDING BOX & DIMENSIONS IN MM)















' ==============================================================================















Dim rb As Box = Nothing















Try















rb = oDoc.ComponentDefinition.RangeBox















Catch















End Try















Dim minX_init As Double = 0, minY_init As Double = 0, minZ_init As Double = 0















Dim maxX_init As Double = 100, maxY_init As Double = 100, maxZ_init As Double = 100















If rb IsNot Nothing AndAlso rb.MinPoint IsNot Nothing AndAlso rb.MaxPoint IsNot Nothing Then















    minX_init = rb.MinPoint.X : minY_init = rb.MinPoint.Y : minZ_init = rb.MinPoint.Z















    maxX_init = rb.MaxPoint.X : maxY_init = rb.MaxPoint.Y : maxZ_init = rb.MaxPoint.Z















Else















    Try















        oCam.Fit()















        oCam.ApplyWithoutTransition()















        Dim extW As Double, extH As Double















        oCam.GetExtents(extW, extH)















        minX_init = -extW / 2 : maxX_init = extW / 2















        minY_init = 0 : maxY_init = extH















        minZ_init = -extW / 2 : maxZ_init = extW / 2















    Catch















End Try















End If















Dim cx As Double = (minX_init + maxX_init) / 2.0















Dim cy As Double = (minY_init + maxY_init) / 2.0















Dim cz As Double = (minZ_init + maxZ_init) / 2.0















Dim dx As Double = Math.Max(0.1, maxX_init - minX_init)















Dim dy As Double = Math.Max(0.1, maxY_init - minY_init)















Dim dz As Double = Math.Max(0.1, maxZ_init - minZ_init)















' Kích thước phủ bì chính xác theo Milimét (1 cm trong Inventor = 10 mm)















Dim dx_mm As Long = CLng(Math.Round(dx * 10.0))















Dim dy_mm As Long = CLng(Math.Round(dy * 10.0))















Dim dz_mm As Long = CLng(Math.Round(dz * 10.0))















Dim aspect As Double = CDbl(CFG_RenderW) / CDbl(CFG_RenderH)















Dim maxHoriz As Double = Math.Max(dx, dz)















Dim maxDim As Double = Math.Max(maxHoriz * 1.77, dy)















Dim camDist As Double = maxDim * 1.40















' ==============================================================================















' LẤY TỌA ĐỘ VÀ VECTOR CHUẨN XÁC 100% TRỰC TIẾP DỰA THEO VIEWCUBE CỦA INVENTOR















' ==============================================================================















Dim origCam As Camera = oView.Camera















' 1. FRONT VIEW TỪ VIEWCUBE (Nhân cự ly camDist chống dính góc 3D)















origCam.ViewOrientationType = ViewOrientationTypeEnum.kFrontViewOrientation















origCam.Fit()















origCam.ApplyWithoutTransition()















Dim vFront As Vector = tg.CreateVector(origCam.Eye.X - cx, origCam.Eye.Y - cy, origCam.Eye.Z - cz)















vFront.Normalize()















Dim frontEye As Inventor.Point = tg.CreatePoint(cx + vFront.X * camDist, cy + vFront.Y * camDist, cz + vFront.Z * camDist)















Dim frontUp  As UnitVector = origCam.UpVector















' 2. TOP VIEW TỪ VIEWCUBE (Nhân cự ly camDist)















origCam.ViewOrientationType = ViewOrientationTypeEnum.kTopViewOrientation















origCam.Fit()















origCam.ApplyWithoutTransition()















Dim vTop As Vector = tg.CreateVector(origCam.Eye.X - cx, origCam.Eye.Y - cy, origCam.Eye.Z - cz)















vTop.Normalize()















Dim topEye As Inventor.Point = tg.CreatePoint(cx + vTop.X * camDist, cy + vTop.Y * camDist, cz + vTop.Z * camDist)















Dim topUp  As UnitVector = origCam.UpVector















' 3. RIGHT VIEW TỪ VIEWCUBE (Nhân cự ly camDist)















origCam.ViewOrientationType = ViewOrientationTypeEnum.kRightViewOrientation















origCam.Fit()















origCam.ApplyWithoutTransition()















Dim vRight As Vector = tg.CreateVector(origCam.Eye.X - cx, origCam.Eye.Y - cy, origCam.Eye.Z - cz)















vRight.Normalize()















Dim rightEye As Inventor.Point = tg.CreatePoint(cx + vRight.X * camDist, cy + vRight.Y * camDist, cz + vRight.Z * camDist)















Dim rightUp  As UnitVector = origCam.UpVector















' 4. BACK VIEW TỪ VIEWCUBE (Nhân cự ly camDist)















origCam.ViewOrientationType = ViewOrientationTypeEnum.kBackViewOrientation















origCam.Fit()















origCam.ApplyWithoutTransition()















Dim vBack As Vector = tg.CreateVector(origCam.Eye.X - cx, origCam.Eye.Y - cy, origCam.Eye.Z - cz)















vBack.Normalize()















Dim backEye As Inventor.Point = tg.CreatePoint(cx + vBack.X * camDist, cy + vBack.Y * camDist, cz + vBack.Z * camDist)















Dim backUp  As UnitVector = origCam.UpVector















' 5. LEFT VIEW TỪ VIEWCUBE (Nhân cự ly camDist)















origCam.ViewOrientationType = ViewOrientationTypeEnum.kLeftViewOrientation















origCam.Fit()















origCam.ApplyWithoutTransition()















Dim vLeft As Vector = tg.CreateVector(origCam.Eye.X - cx, origCam.Eye.Y - cy, origCam.Eye.Z - cz)















vLeft.Normalize()















Dim leftEye As Inventor.Point = tg.CreatePoint(cx + vLeft.X * camDist, cy + vLeft.Y * camDist, cz + vLeft.Z * camDist)















Dim leftUp  As UnitVector = origCam.UpVector















' 6. BOTTOM VIEW TỪ VIEWCUBE (Nhân cự ly camDist)















origCam.ViewOrientationType = ViewOrientationTypeEnum.kBottomViewOrientation















origCam.Fit()















origCam.ApplyWithoutTransition()















Dim vBottom As Vector = tg.CreateVector(origCam.Eye.X - cx, origCam.Eye.Y - cy, origCam.Eye.Z - cz)















vBottom.Normalize()















Dim bottomEye As Inventor.Point = tg.CreatePoint(cx + vBottom.X * camDist, cy + vBottom.Y * camDist, cz + vBottom.Z * camDist)















Dim bottomUp  As UnitVector = origCam.UpVector















' Khung nhìn Extents cho 3 mặt chiếu Ortho (Chừa lề cho đường kích thước)















Dim orthoH_Front As Double, orthoW_Front As Double















Dim orthoH_Top   As Double, orthoW_Top   As Double















Dim orthoH_Right As Double, orthoW_Right As Double















If isVertical Then















    orthoW_Front = Math.Max(dx, dy * aspect) / CFG_FitPadding















    orthoH_Front = orthoW_Front / aspect















    orthoW_Top   = Math.Max(dx, dz * aspect) / CFG_FitPadding















    orthoH_Top   = orthoW_Top / aspect















    orthoW_Right = Math.Max(dz, dy * aspect) / CFG_FitPadding















    orthoH_Right = orthoW_Right / aspect















Else















    ' KHUNG NGANG 16:9: Khóa chặt chiều cao để mô hình to lớn sừng sững chiếm trọn chiều cao















    orthoH_Front = Math.Max(dy, dx / aspect) / CFG_FitPadding















    orthoW_Front = orthoH_Front * aspect















    orthoH_Top   = Math.Max(dz, dx / aspect) / CFG_FitPadding















    orthoW_Top   = orthoH_Top * aspect















    orthoH_Right = Math.Max(dy, dz / aspect) / CFG_FitPadding















    orthoW_Right = orthoH_Right * aspect















End If















' TÂM QUAY VẬT LÝ CHÍNH XÁC 100% (TRỌNG TÂM HÌNH HỌC RANGEBOX)















Dim centerPt As Inventor.Point = tg.CreatePoint(cx, cy, cz)















' ==============================================================================















' SECTION 3.1: CỰ LY TIÊU CỰ FIT 3D CHỐNG GẦN CHO VẬT DÀI NẰM NGANG & VẬT CAO ĐỨNG















' ==============================================================================















' Đường kính bao trên mặt phẳng đáy XZ khi mô hình xoay tròn 360 độ quanh trục Y















Dim diagXZ As Double = Math.Sqrt(dx * dx + dz * dz)















' Góc nghiêng Camera (Elevation Angles)















Dim elevAngle_Bottom As Double = -0.16 ' Nghiêng -10 độ (3/4 dưới nhìn ngước lên)















Dim elevAngle_Top    As Double = 0.25  ' Nghiêng +14 độ (3/4 trên nhìn bao quát)















' Chiều cao và chiều rộng biểu kiến 3D khi nhìn nghiêng ở góc 3/4















Dim apparentH_Bottom As Double = dy * Math.Cos(Math.Abs(elevAngle_Bottom)) + Math.Max(dx, dz) * 0.707 * Math.Sin(Math.Abs(elevAngle_Bottom))















Dim apparentH_Top    As Double = dy * Math.Cos(Math.Abs(elevAngle_Top)) + Math.Max(dx, dz) * 0.707 * Math.Sin(Math.Abs(elevAngle_Top))















Dim apparentW_3D     As Double = (dx + dz) * 0.707 ' Bề rộng thực tế nhìn ở góc 45 độ















' Góc mở nửa của Camera Perspective (PerspectiveAngle = 0.52 rad)















Dim tanHalfFOV_V As Double = Math.Tan(0.52 / 2.0) ' ~0.266















Dim tanHalfFOV_H As Double = tanHalfFOV_V * aspect















Dim heroDist3D_Bottom As Double















Dim heroDist3D_Top    As Double















If isVertical Then

    ' KHUNG DỌC 9:16: Phóng to tối đa chiếm 96% - 98% diện tích khung hình (Cận Cảnh Cực Đại, Đậm Đà Hoành Tráng)

    Dim distV_Bottom As Double = (apparentH_Bottom / 0.96) / (2.0 * tanHalfFOV_V) * 0.82

    Dim distH_Bottom As Double = (apparentW_3D / 0.95) / (2.0 * tanHalfFOV_H) * 0.82

    heroDist3D_Bottom = Math.Max(distV_Bottom, distH_Bottom)



    Dim distV_Top As Double = (apparentH_Top / 0.96) / (2.0 * tanHalfFOV_V) * 0.82

    Dim distH_Top As Double = (apparentW_3D / 0.95) / (2.0 * tanHalfFOV_H) * 0.82

    heroDist3D_Top = Math.Max(distV_Top, distH_Top)

Else

    ' KHUNG NGANG 16:9: Phóng to tối đa chiếm 96% - 98% diện tích khung hình (Cận Cảnh Cực Đại, Hoành Tráng Rõ Từng Chi Tiết)

    Dim distV_Bottom As Double = (apparentH_Bottom / 0.96) / (2.0 * tanHalfFOV_V) * 0.78

    Dim distH_Bottom As Double = (apparentW_3D / 0.95) / (2.0 * tanHalfFOV_H) * 0.78

    heroDist3D_Bottom = Math.Max(distV_Bottom, distH_Bottom)



    Dim distV_Top As Double = (apparentH_Top / 0.96) / (2.0 * tanHalfFOV_V) * 0.78

    Dim distH_Top As Double = (apparentW_3D / 0.95) / (2.0 * tanHalfFOV_H) * 0.78

    heroDist3D_Top = Math.Max(distV_Top, distH_Top)

End If















' 1. Cảnh đầu (3/4 DƯỚI): Bán kính quay và cao độ trục Y















Dim orbitHeightY_Bottom As Double = cy + heroDist3D_Bottom * Math.Sin(elevAngle_Bottom)















Dim orbitR_XZ_Bottom    As Double = heroDist3D_Bottom * Math.Cos(elevAngle_Bottom)















' 2. Cảnh cuối (3/4 TRÊN): Bán kính quay và cao độ trục Y















Dim orbitHeightY_Top As Double = cy + heroDist3D_Top * Math.Sin(elevAngle_Top)















Dim orbitR_XZ_Top    As Double = heroDist3D_Top * Math.Cos(elevAngle_Top)















' GÓC QUAY BAN ĐẦU CHUẨN XÁC (ISOMETRIC 45 ĐỘ TRỌNG TÂM)















Dim initialAngle As Double = -Math.PI / 4.0 ' -45 độ chuẩn Isometric Front-Right















' 3. Điểm ViewCube Fit-To-View (Góc 3/4 Trên chuẩn cơ khí, UpVector=(0,1,0) ĐỂ MÔ HÌNH LUÔN ĐỨNG THẲNG 90 ĐỘ)















Dim fitCubeEye As Inventor.Point = tg.CreatePoint(cx + orbitR_XZ_Top * Math.Cos(initialAngle), orbitHeightY_Top, cz + orbitR_XZ_Top * Math.Sin(initialAngle))















Dim fitCubeTgt As Inventor.Point = centerPt















Dim fitCubeUp  As UnitVector = tg.CreateUnitVector(0, 1, 0)















' Điểm xuất phát Scene 1 (Góc 3/4 Dưới - Thẳng đứng hoàn hảo)















Dim introEye As Inventor.Point = tg.CreatePoint(cx + orbitR_XZ_Bottom * Math.Cos(initialAngle), orbitHeightY_Bottom, cz + orbitR_XZ_Bottom * Math.Sin(initialAngle))















