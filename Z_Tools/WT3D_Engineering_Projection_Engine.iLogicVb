' SECTION 6: XỬ LÝ NÉT XANH ĐẬM & VẼ KÍCH THƯỚC PHỦ BÌ (CAD DIMENSIONS)















' ==============================================================================















oApp.StatusBarText = "🎨 Đang dập Nét Xanh Dương & Vẽ Kích Thước Phủ Bì CAD..."















' Log lỗi thay vì nuốt im lặng — hiển thị ở cuối nếu có sự cố















Dim renderErrors As New System.Collections.Generic.List(Of String)()















' Định nghĩa danh sách các frame cần xử lý (Dùng mảng chuỗi thuần túy)















' Format: {FilePath, ViewTitle, DimHorizValString, DimVertValString, HorizLabel, VertLabel}















Dim processTasks As New System.Collections.Generic.List(Of String())()















' 0. Wireframe 3D Topology (Đồng bộ nét xanh sạch sẽ cho ảnh sàn 3D)















Dim snapWireframe3D As String = System.IO.Path.Combine(snapshotDir, baseName & "_04_Wireframe3D_Topology_CheckMate.png")















If System.IO.File.Exists(snapWireframe3D) Then















    processTasks.Add(New String() {snapWireframe3D, "WIREFRAME 3D TOPOLOGY", "0", "0", "", ""})















End If















Dim snapWFFront As String = System.IO.Path.Combine(snapshotDir, baseName & "_16_Wireframe_Clean_Front.png")















If System.IO.File.Exists(snapWFFront) Then processTasks.Add(New String() {snapWFFront, "WIREFRAME FRONT ELEVATION", "0", "0", "", ""})















Dim snapWFTop As String = System.IO.Path.Combine(snapshotDir, baseName & "_17_Wireframe_Clean_Top.png")















If System.IO.File.Exists(snapWFTop) Then processTasks.Add(New String() {snapWFTop, "WIREFRAME TOP PLAN", "0", "0", "", ""})















' Tính toán kích thước phủ bì thực tế theo hướng chiếu của ViewCube:















Dim len_front_mm As Long = Math.Max(dx_mm, dz_mm) ' Chiều dài thân chính















Dim wid_side_mm  As Long = Math.Min(dx_mm, dz_mm) ' Chiều rộng đầu hồi















Dim hei_mm       As Long = dy_mm                  ' Chiều cao















' 1. Front View: Thể hiện chiều dài lớn nhất x Chiều cao















processTasks.Add(New String() {snapFront, "FRONT ELEVATION (HÌNH CHIẾU ĐỨNG)", len_front_mm.ToString(), hei_mm.ToString(), "L", "H"})















processTasks.Add(New String() {frameDir & "\FRAME_" & frontStartFrame.ToString("00000") & ".png", "FRONT ELEVATION", len_front_mm.ToString(), hei_mm.ToString(), "L", "H"})















' 2. Top View: Thể hiện chiều dài lớn nhất x Chiều rộng đầu hồi















processTasks.Add(New String() {snapTop, "TOP PLAN VIEW (HÌNH CHIẾU BẰNG)", len_front_mm.ToString(), wid_side_mm.ToString(), "L", "W"})















processTasks.Add(New String() {frameDir & "\FRAME_" & topStartFrame.ToString("00000") & ".png", "TOP PLAN VIEW", len_front_mm.ToString(), wid_side_mm.ToString(), "L", "W"})















' 3. Left View: Thể hiện chiều rộng đầu hồi x Chiều cao















processTasks.Add(New String() {snapLeft, "LEFT SIDE ELEVATION (HÌNH CHIẾU CẠNH TRÁI)", wid_side_mm.ToString(), hei_mm.ToString(), "W", "H"})















processTasks.Add(New String() {frameDir & "\FRAME_" & rightStartFrame.ToString("00000") & ".png", "LEFT SIDE ELEVATION", wid_side_mm.ToString(), hei_mm.ToString(), "W", "H"})















' MÀU XANH DƯƠNG ĐẬM SÂU CHUẨN BẢN VẼ: #043296 (R=4, G=50, B=150)















Dim targetR As Byte = 4















Dim targetG As Byte = 50















Dim targetB As Byte = 150















' Tỷ lệ co giãn font chữ và nét vẽ theo độ phân giải (1080p → 1.0, 4K → 2.0)















Dim resScale As Single = CSng(CFG_RenderH) / 1920.0F















If Not isVertical Then resScale = CSng(CFG_RenderH) / 1080.0F















For Each task In processTasks















    Dim fPath As String = task(0)















    Dim vTitle As String = task(1)















    Dim dHorizVal As Long = CLng(task(2))















    Dim dVertVal As Long = CLng(task(3))















    Dim hLbl As String = task(4)















    Dim vLbl As String = task(5)















    Try















        If System.IO.File.Exists(fPath) Then















            Dim imgBytes As Byte() = System.IO.File.ReadAllBytes(fPath)















            Using msIn As New System.IO.MemoryStream(imgBytes)















            Using rawBmp As New System.Drawing.Bitmap(msIn)















                Dim w As Integer = rawBmp.Width















                Dim h As Integer = rawBmp.Height















                ' Tạo Bitmap 32-bit ARGB độc lập chuẩn hóa để đảm bảo LockBits và GDI+ Graphics hoạt động 100% ổn định















                Using bmp As New System.Drawing.Bitmap(w, h, System.Drawing.Imaging.PixelFormat.Format32bppArgb)















                    Using gInit As System.Drawing.Graphics = System.Drawing.Graphics.FromImage(bmp)















                        gInit.DrawImage(rawBmp, 0, 0, w, h)















                    End Using















                    Dim rect As New System.Drawing.Rectangle(0, 0, w, h)















                    Dim bmpData As System.Drawing.Imaging.BitmapData = bmp.LockBits(rect, System.Drawing.Imaging.ImageLockMode.ReadWrite, System.Drawing.Imaging.PixelFormat.Format32bppArgb)















                    Dim ptr As IntPtr = bmpData.Scan0















                    Dim bytes As Integer = Math.Abs(bmpData.Stride) * h















                    Dim rgbValues(bytes - 1) As Byte















                    System.Runtime.InteropServices.Marshal.Copy(ptr, rgbValues, 0, bytes)















                    Dim outValues As Byte() = DirectCast(rgbValues.Clone(), Byte())















                    Dim stride As Integer = Math.Abs(bmpData.Stride)















                    Dim minX As Integer = w, maxX As Integer = 0















                    Dim minY As Integer = h, maxY As Integer = 0















                    ' Quét pixel tìm viền biên mô hình & nhuộm màu Xanh Dương Deep Navy















                    Dim scanMarginX As Integer = CInt(w * 0.05)















                    Dim scanMarginY As Integer = CInt(h * 0.05)















                    For y As Integer = scanMarginY To h - scanMarginY - 1















                        For x As Integer = scanMarginX To w - scanMarginX - 1















                            Dim idx As Integer = y * stride + x * 4















                            Dim b As Byte = rgbValues(idx)















                            Dim g As Byte = rgbValues(idx + 1)















                            Dim r As Byte = rgbValues(idx + 2)















                            Dim brightnessSum As Integer = CInt(r) + CInt(g) + CInt(b)















                            ' Chỉ ghi nhận Bounding Box khi là nét vẽ thực tế của mô hình















                            If brightnessSum < 450 Then















                                If x < minX Then minX = x















                                If x > maxX Then maxX = x















                                If y < minY Then minY = y















                                If y > maxY Then maxY = y















                            End If















                            ' Nhuộm màu Xanh Dương Deep Navy ĐẬM ĐÀ, SẮC NÉT & KHỬ RĂNG CƯA















                            If brightnessSum < 580 Then















                                Dim normalizedDark As Double = (580.0 - CDbl(brightnessSum)) / 580.0















                                Dim darkFactor As Double = Math.Min(1.0, Math.Pow(normalizedDark, 0.42) * 1.45)















                                Dim curB As Byte = outValues(idx)















                                Dim curG As Byte = outValues(idx + 1)















                                Dim curR As Byte = outValues(idx + 2)















                                outValues(idx)     = CByte(Math.Min(255.0, CDbl(curB) * (1.0 - darkFactor) + CDbl(targetB) * darkFactor))















                                outValues(idx + 1) = CByte(Math.Min(255.0, CDbl(curG) * (1.0 - darkFactor) + CDbl(targetG) * darkFactor))















                                outValues(idx + 2) = CByte(Math.Min(255.0, CDbl(curR) * (1.0 - darkFactor) + CDbl(targetR) * darkFactor))















                                ' Tăng cường độ dày cho tim nét chính















                                If brightnessSum < 380 Then















                                    Dim maxDilate As Integer = If(resScale >= 1.8F, 3, If(resScale >= 1.2F, 2, 1))















                                    For dStep As Integer = 1 To maxDilate















                                        Dim blendFactor As Double = If(dStep = 1, 0.85, If(dStep = 2, 0.60, 0.35))















                                        Dim invFactor As Double = 1.0 - blendFactor















                                        Dim offX As Integer = dStep * 4















                                        Dim offY As Integer = dStep * stride















                                        Dim d1 As Integer = idx + offX, d2 As Integer = idx - offX















                                        Dim d3 As Integer = idx + offY, d4 As Integer = idx - offY















                                        If d1 < bytes - 4 Then outValues(d1) = CByte(CDbl(outValues(d1)) * invFactor + CDbl(targetB) * blendFactor) : outValues(d1 + 1) = CByte(CDbl(outValues(d1 + 1)) * invFactor + CDbl(targetG) * blendFactor) : outValues(d1 + 2) = CByte(CDbl(outValues(d1 + 2)) * invFactor + CDbl(targetR) * blendFactor)















                                        If d2 >= 0 Then outValues(d2) = CByte(CDbl(outValues(d2)) * invFactor + CDbl(targetB) * blendFactor) : outValues(d2 + 1) = CByte(CDbl(outValues(d2 + 1)) * invFactor + CDbl(targetG) * blendFactor) : outValues(d2 + 2) = CByte(CDbl(outValues(d2 + 2)) * invFactor + CDbl(targetR) * blendFactor)















                                        If d3 < bytes - 4 Then outValues(d3) = CByte(CDbl(outValues(d3)) * invFactor + CDbl(targetB) * blendFactor) : outValues(d3 + 1) = CByte(CDbl(outValues(d3 + 1)) * invFactor + CDbl(targetG) * blendFactor) : outValues(d3 + 2) = CByte(CDbl(outValues(d3 + 2)) * invFactor + CDbl(targetR) * blendFactor)















                                        If d4 >= 0 Then outValues(d4) = CByte(CDbl(outValues(d4)) * invFactor + CDbl(targetB) * blendFactor) : outValues(d4 + 1) = CByte(CDbl(outValues(d4 + 1)) * invFactor + CDbl(targetG) * blendFactor) : outValues(d4 + 2) = CByte(CDbl(outValues(d4 + 2)) * invFactor + CDbl(targetR) * blendFactor)















                                    Next















                                End If















                            End If















                        Next















                    Next















                    System.Runtime.InteropServices.Marshal.Copy(outValues, 0, ptr, bytes)















                    bmp.UnlockBits(bmpData)















                    ' VẼ ĐƯỜNG KÍCH THƯỚC PHỦ BÌ (CAD DIMENSION OVERLAY) - CHỈ VẼ CHO CÁC HÌNH CHIẾU 2D (dHorizVal > 0)















                    If maxX > minX AndAlso maxY > minY AndAlso dHorizVal > 0 Then















                        Using gDraw As System.Drawing.Graphics = System.Drawing.Graphics.FromImage(bmp)















                            gDraw.SmoothingMode = System.Drawing.Drawing2D.SmoothingMode.AntiAlias















                            gDraw.TextRenderingHint = System.Drawing.Text.TextRenderingHint.ClearTypeGridFit















                            gDraw.InterpolationMode = System.Drawing.Drawing2D.InterpolationMode.HighQualityBicubic















                            gDraw.PixelOffsetMode = System.Drawing.Drawing2D.PixelOffsetMode.HighQuality















                            Dim mainBlue As System.Drawing.Color = System.Drawing.Color.FromArgb(4, 50, 150)















                            Using dimPen As New System.Drawing.Pen(mainBlue, Math.Max(2.5F, 3.0F * resScale))















                            Using extPen As New System.Drawing.Pen(System.Drawing.Color.FromArgb(140, 160, 190), Math.Max(1.5F, 2.0F * resScale))















                            Using fontDim As New System.Drawing.Font("Arial", Math.Max(16.0F, 24.0F * resScale), System.Drawing.FontStyle.Bold)















                            Using fontBadge As New System.Drawing.Font("Arial", Math.Max(14.0F, 22.0F * resScale), System.Drawing.FontStyle.Bold)















                            Using brushBlue As New System.Drawing.SolidBrush(mainBlue)















                            Using brushWhite As New System.Drawing.SolidBrush(System.Drawing.Color.White)















                            Using brushLightBlue As New System.Drawing.SolidBrush(System.Drawing.Color.FromArgb(240, 245, 255))















                            Using penBorder As New System.Drawing.Pen(mainBlue, Math.Max(1.5F, 2.0F * resScale))















                            Using penBadge As New System.Drawing.Pen(mainBlue, Math.Max(2.0F, 2.5F * resScale))















                                extPen.DashStyle = System.Drawing.Drawing2D.DashStyle.Dash















                                ' 1. ĐƯỜNG KÍCH THƯỚC NGANG (HORIZONTAL DIMENSION) DƯỚI ĐÁY















                                Dim gapBottom As Integer = CInt(70 * resScale)















                                Dim dimY As Integer = Math.Min(h - CInt(90 * resScale), maxY + gapBottom)















                                gDraw.DrawLine(extPen, minX, maxY + CInt(15 * resScale), minX, dimY + CInt(25 * resScale))















                                gDraw.DrawLine(extPen, maxX, maxY + CInt(15 * resScale), maxX, dimY + CInt(25 * resScale))















                                gDraw.DrawLine(dimPen, minX, dimY, maxX, dimY)















                                ' Mũi tên 2 đầu ngang















                                Dim arrowL As Integer = CInt(16 * resScale)















                                Dim arrowH As Integer = CInt(6 * resScale)















                                gDraw.FillPolygon(brushBlue, New System.Drawing.Point() {New System.Drawing.Point(minX, dimY), New System.Drawing.Point(minX + arrowL, dimY - arrowH), New System.Drawing.Point(minX + arrowL, dimY + arrowH)})















                                gDraw.FillPolygon(brushBlue, New System.Drawing.Point() {New System.Drawing.Point(maxX, dimY), New System.Drawing.Point(maxX - arrowL, dimY - arrowH), New System.Drawing.Point(maxX - arrowL, dimY + arrowH)})















                                ' Nhãn kích thước ngang















                                Dim textH As String = hLbl & ": " & dHorizVal.ToString("#,##0") & " mm"















                                Dim sizeH As System.Drawing.SizeF = gDraw.MeasureString(textH, fontDim)















                                Dim posX As Single = (minX + maxX - sizeH.Width) / 2.0F















                                Dim posY As Single = dimY + CInt(18 * resScale)















                                gDraw.FillRectangle(brushWhite, posX - 10 * resScale, posY - 2 * resScale, sizeH.Width + 20 * resScale, sizeH.Height + 4 * resScale)















                                gDraw.DrawRectangle(penBorder, posX - 10 * resScale, posY - 2 * resScale, sizeH.Width + 20 * resScale, sizeH.Height + 4 * resScale)















                                gDraw.DrawString(textH, fontDim, brushBlue, posX, posY)















                                ' 2. ĐƯỜNG KÍCH THƯỚC DỌC (VERTICAL DIMENSION) BÊN PHẢI















                                Dim gapRight As Integer = CInt(70 * resScale)















                                Dim dimX As Integer = Math.Min(w - CInt(120 * resScale), maxX + gapRight)















                                gDraw.DrawLine(extPen, maxX + CInt(15 * resScale), minY, dimX + CInt(25 * resScale), minY)















                                gDraw.DrawLine(extPen, maxX + CInt(15 * resScale), maxY, dimX + CInt(25 * resScale), maxY)















                                gDraw.DrawLine(dimPen, dimX, minY, dimX, maxY)















                                ' Mũi tên 2 đầu đứng















                                Dim arrowL_V As Integer = CInt(16 * resScale)















                                Dim arrowH_V As Integer = CInt(6 * resScale)















                                gDraw.FillPolygon(brushBlue, New System.Drawing.Point() {New System.Drawing.Point(dimX, minY), New System.Drawing.Point(dimX - arrowH_V, minY + arrowL_V), New System.Drawing.Point(dimX + arrowH_V, minY + arrowL_V)})















                                gDraw.FillPolygon(brushBlue, New System.Drawing.Point() {New System.Drawing.Point(dimX, maxY), New System.Drawing.Point(dimX - arrowH_V, maxY - arrowL_V), New System.Drawing.Point(dimX + arrowH_V, maxY - arrowL_V)})















                                ' Nhãn kích thước dọc (Xoay 90 độ)















                                Dim textV As String = vLbl & ": " & dVertVal.ToString("#,##0") & " mm"















                                Dim sizeV As System.Drawing.SizeF = gDraw.MeasureString(textV, fontDim)















                                Dim midVY As Single = (minY + maxY) / 2.0F















                                Dim posVX As Single = dimX + CInt(24 * resScale) + (sizeV.Height / 2.0F)















                                Dim stateV As System.Drawing.Drawing2D.GraphicsState = gDraw.Save()















                                gDraw.TranslateTransform(posVX, midVY)















                                gDraw.RotateTransform(-90.0F)















                                Dim rectVW As Single = sizeV.Width + 16.0F * resScale















                                Dim rectVH As Single = sizeV.Height + 4.0F * resScale















                                gDraw.FillRectangle(brushWhite, -rectVW / 2.0F, -rectVH / 2.0F, rectVW, rectVH)















                                gDraw.DrawRectangle(penBorder, -rectVW / 2.0F, -rectVH / 2.0F, rectVW, rectVH)















                                gDraw.DrawString(textV, fontDim, brushBlue, -sizeV.Width / 2.0F, -sizeV.Height / 2.0F)















                                gDraw.Restore(stateV)















                                ' 3. THẺ TIÊU ĐỀ PHỦ BÌ TRÊN ĐẦU















                                Dim headerText As String = vTitle & "  |  " & hLbl & "=" & dHorizVal.ToString("#,##0") & " × " & vLbl & "=" & dVertVal.ToString("#,##0") & " mm"















                                Dim sizeBadge As System.Drawing.SizeF = gDraw.MeasureString(headerText, fontBadge)















                                Dim badgeW As Single = sizeBadge.Width + 40 * resScale















                                Dim badgeH As Single = sizeBadge.Height + 16 * resScale















                                Dim badgeX As Single = (w - badgeW) / 2.0F















                                Dim badgeY As Single = Math.Max(30.0F * resScale, CSng(minY - badgeH - 35.0F * resScale))















                                gDraw.FillRectangle(brushLightBlue, badgeX, badgeY, badgeW, badgeH)















                                gDraw.DrawRectangle(penBadge, badgeX, badgeY, badgeW, badgeH)















                                gDraw.DrawString(headerText, fontBadge, brushBlue, badgeX + 20 * resScale, badgeY + 8 * resScale)















                            End Using : End Using : End Using : End Using : End Using : End Using : End Using : End Using : End Using















                        End Using ' gDraw















                    End If















                    ' Xuất ảnh ra MemoryStream rồi ghi đè file đĩa cực sạch bằng File.WriteAllBytes















                    Using msOut As New System.IO.MemoryStream()















                        bmp.Save(msOut, System.Drawing.Imaging.ImageFormat.Png)















                        System.IO.File.WriteAllBytes(fPath, msOut.ToArray())















                    End Using















                End Using ' bmp















            End Using ' rawBmp















            End Using ' msIn















        End If















    Catch exImage As Exception















        renderErrors.Add(System.IO.Path.GetFileName(fPath) & ": " & exImage.Message)















    End Try















Next















' NHÂN BẢN SIÊU TỐC TỨC THÌ (0.01s): Copy frame đầu tiên đã vẽ DIM cho toàn bộ các frame giữ tĩnh















Dim srcFront As String = frameDir & "\FRAME_" & frontStartFrame.ToString("00000") & ".png"















If System.IO.File.Exists(srcFront) Then















    For fIdx As Integer = frontStartFrame + 1 To frontEndFrame















        Try















System.IO.File.Copy(srcFront, frameDir & "\FRAME_" & fIdx.ToString("00000") & ".png", True)















Catch















End Try















    Next















End If















Dim srcTop As String = frameDir & "\FRAME_" & topStartFrame.ToString("00000") & ".png"















If System.IO.File.Exists(srcTop) Then















    For fIdx As Integer = topStartFrame + 1 To topEndFrame















        Try















System.IO.File.Copy(srcTop, frameDir & "\FRAME_" & fIdx.ToString("00000") & ".png", True)















Catch















End Try















    Next















End If















Dim srcRight As String = frameDir & "\FRAME_" & rightStartFrame.ToString("00000") & ".png"















If System.IO.File.Exists(srcRight) Then















    For fIdx As Integer = rightStartFrame + 1 To rightEndFrame















        Try















System.IO.File.Copy(srcRight, frameDir & "\FRAME_" & fIdx.ToString("00000") & ".png", True)















Catch















End Try















    Next















End If















GoTo NormalComplete















' ==============================================================================















' ABORT HANDLER















' ==============================================================================















AbortRender:















    oApp.StatusBarText = "🛑 ĐÃ DỪNG TIẾN TRÌNH RENDER THEO LỆNH (ESC)!"















    Try















        oView.DisplayMode = DisplayModeEnum.kShadedWithEdgesRendering















        oView.ShowAmbientShadows = True















        oView.ShowObjectShadows  = True















        oView.ShowGroundShadows  = True















        oView.ShowGroundReflections = True















    Catch















    End Try















    oCam.Eye = tg.CreatePoint(orgEyeX, orgEyeY, orgEyeZ)















    oCam.Target = tg.CreatePoint(orgTgtX, orgTgtY, orgTgtZ)















    oCam.UpVector = tg.CreateUnitVector(orgUpX, orgUpY, orgUpZ)















    oCam.Perspective = orgPersp















    If orgPersp Then















        Try















oCam.PerspectiveAngle = orgPerspAng















Catch















End Try















    End If















    oCam.Apply() : oView.Update()















    MessageBox.Show("🛑 Đã dừng Render thành công và khôi phục góc nhìn ban đầu!", "WT3D", MessageBoxButtons.OK, MessageBoxIcon.Information)















    Exit Sub















' ==============================================================================















' HOÀN TẤT & GHÉP VIDEO















' ==============================================================================















NormalComplete:















    ' Khôi phục góc nhìn















    Try















        oView.DisplayMode = DisplayModeEnum.kShadedWithEdgesRendering















        oView.ShowAmbientShadows = True















        oView.ShowObjectShadows  = True















        oView.ShowGroundShadows  = True















        oView.ShowGroundReflections = True















    Catch















    End Try















    oCam.Eye = tg.CreatePoint(orgEyeX, orgEyeY, orgEyeZ)















    oCam.Target = tg.CreatePoint(orgTgtX, orgTgtY, orgTgtZ)















    oCam.UpVector = tg.CreateUnitVector(orgUpX, orgUpY, orgUpZ)















    oCam.Perspective = orgPersp















    If orgPersp Then















        Try















oCam.PerspectiveAngle = orgPerspAng















Catch















End Try















    End If















    oCam.Apply() : oView.Update()















    ' ✅ FIX: Hiển thị lỗi render ảnh nếu có (thay vì nuốt im lặng)















    If renderErrors.Count > 0 Then















        oApp.StatusBarText = "⚠️ Có " & renderErrors.Count & " ảnh gặp lỗi khi xử lý pixel/dimension."















        MessageBox.Show("⚠️ Một số ảnh gặp lỗi khi xử lý:" & vbCrLf & String.Join(vbCrLf, renderErrors.ToArray()), "WT3D - Cảnh Báo", MessageBoxButtons.OK, MessageBoxIcon.Warning)















    End If















    ' Ghép video qua FFmpeg & Đính kèm Thumbnail Cover Art (ViewCube Fit To View)















    ' ✅ FIX: Tìm ffmpeg động theo thư mục script, fallback sang hardcode















    Dim ffmpegExe As String = System.IO.Path.Combine(System.IO.Path.GetDirectoryName(oDoc.FullFileName), "..\Z_Tools\ffmpeg\ffmpeg.exe")















    If Not System.IO.File.Exists(ffmpegExe) Then















        ffmpegExe = "d:\WT3D_Project\Z_Tools\ffmpeg\ffmpeg.exe"















    End If















    Dim thumbCover As String = System.IO.Path.Combine(snapshotDir, baseName & "_01_Hero3D_Iso_TopRight.png")















    If Not System.IO.File.Exists(ffmpegExe) Then















        ' ✅ FIX: Cảnh báo rõ ràng thay vì im lặng chuyển nhánh















        MessageBox.Show("⚠️ Không tìm thấy ffmpeg tại:" & vbCrLf & ffmpegExe & vbCrLf & vbCrLf & "Các frame ảnh đã được xuất tại:" & vbCrLf & frameDir & vbCrLf & vbCrLf & "Để ghép video, hãy cài ffmpeg và đặt tại đường dẫn trên.", "WT3D - Thiếu FFmpeg", MessageBoxButtons.OK, MessageBoxIcon.Warning)















        Try















System.Diagnostics.Process.Start("explorer.exe", snapshotDir)















Catch















End Try















    Else















        Dim outMp4 As String = System.IO.Path.Combine(videoDir, baseName & "_EngineeringProjection_" & fullTag & ".mp4")















        ' ✅ FIX: Escape dấu nháy đơn trong tên file để tránh vỡ cú pháp PowerShell















        Dim safeFrameDir As String = frameDir.Replace("'", "''")















        Dim safeThumb As String = thumbCover.Replace("'", "''")















        Dim safeOut As String = outMp4.Replace("'", "''")















        Dim safeFfmpeg As String = ffmpegExe.Replace("'", "''")















        Dim psCmd As String















        If System.IO.File.Exists(thumbCover) Then















            ' Thumbnail ViewCube + CRF 16 medium → chất lượng cao, encode nhanh















            psCmd = "powershell.exe -ExecutionPolicy Bypass -WindowStyle Hidden -Command ""& '" & safeFfmpeg & "' -y -framerate " & CFG_FPS & " -i '" & safeFrameDir & "\FRAME_%05d.png' -i '" & safeThumb & "' -map 0:v -map 1:v -c:v:0 libx264 -preset medium -crf 16 -pix_fmt yuv420p -c:v:1 png -disposition:v:1 attached_pic '" & safeOut & "'; if (Test-Path '" & safeOut & "') { Remove-Item '" & safeFrameDir & "' -Recurse -Force }"""















        Else















            psCmd = "powershell.exe -ExecutionPolicy Bypass -WindowStyle Hidden -Command ""& '" & safeFfmpeg & "' -y -framerate " & CFG_FPS & " -i '" & safeFrameDir & "\FRAME_%05d.png' -c:v libx264 -preset medium -crf 16 -pix_fmt yuv420p '" & safeOut & "'; if (Test-Path '" & safeOut & "') { Remove-Item '" & safeFrameDir & "' -Recurse -Force }"""















        End If















        Try















            Dim sh As Object = CreateObject("WScript.Shell")















            sh.Run(psCmd, 0, True)















        Catch exFfmpeg As Exception















            renderErrors.Add("FFmpeg: " & exFfmpeg.Message)















        End Try















        ' Dập 'Bản Quyền Sàn 3D' tự động cho toàn bộ bộ ảnh Snapshot xuất ra















        Dim pyWatermarkScript As String = System.IO.Path.Combine(System.IO.Path.GetDirectoryName(oDoc.FullFileName), "..\Z_Tools\Apply_Marketplace_Watermark.py")















        If Not System.IO.File.Exists(pyWatermarkScript) Then















            pyWatermarkScript = "d:\WT3D_Project\Z_Tools\Apply_Marketplace_Watermark.py"















        End If















        If System.IO.File.Exists(pyWatermarkScript) AndAlso System.IO.Directory.Exists(snapshotDir) Then















            Dim safePyScript As String = pyWatermarkScript.Replace("'", "''")















            Dim safeSnapDir As String = snapshotDir.Replace("'", "''")















            Dim psWatermarkCmd As String = "powershell.exe -ExecutionPolicy Bypass -WindowStyle Hidden -Command ""python '" & safePyScript & "' '" & safeSnapDir & "'"""















            Try















                Dim shWmk As Object = CreateObject("WScript.Shell")















                shWmk.Run(psWatermarkCmd, 0, True)















            Catch















End Try















        End If















        Dim isEngineSilent As Boolean = False















        If SharedVariable.Exists("WT3D_SILENT_MODE") Then















            Try















isEngineSilent = CBool(SharedVariable("WT3D_SILENT_MODE"))















Catch















End Try















        End If















        If SharedVariable.Exists("WT3D_BATCH_MODE") Then















            Try















                If CBool(SharedVariable("WT3D_BATCH_MODE")) Then isEngineSilent = True















            Catch















            End Try















        End If















        If Not isEngineSilent Then















            Try















System.Diagnostics.Process.Start("explorer.exe", videoDir)















Catch















End Try















            Try















System.Diagnostics.Process.Start("explorer.exe", snapshotDir)















