AddReference "PresentationCore"
AddReference "WindowsBase"
Imports System.Windows.Input
' ==============================================================================
' CAM_2_YT_TechnicalXRay.iLogicVb
' Mục đích: Video ngang 16:9 kỹ thuật. Biến đổi hiển thị Sang Khung Dây/Trong bộ.
' ==============================================================================
Dim oApp As Inventor.Application = ThisApplication
Dim oDoc As Document = oApp.ActiveDocument
Dim oView As Inventor.View = oApp.ActiveView
Dim oCam As Camera = oView.Camera
Dim tg As TransientGeometry = oApp.TransientGeometry

If oDoc.DocumentType <> DocumentTypeEnum.kAssemblyDocumentObject And oDoc.DocumentType <> DocumentTypeEnum.kPartDocumentObject Then Exit Sub

' ============================================================
' 🧠 AUTO-GENERATE SEO METADATA (ZERO-TOUCH - Chạy trước render)
' Đảm bảo Dashboard_SEO & Z_Copy_Paste_SEO_Data.txt luôn mới nhất
' ============================================================
Dim isBatch As Boolean = False
Try : isBatch = SharedVariable("BatchMode") : Catch : End Try

If Not isBatch Then
    ThisApplication.StatusBarText = "🧠 CAM 2: Generating SEO Metadata..."
    Try : iLogicVb.RunExternalRule("d:\WT3D_Project\Z_Tools\Auto_SEO_Metadata_Engine.iLogicVb") : Catch : End Try
End If
ThisApplication.StatusBarText = "🎥 CAM 2: Starting render..."
' ============================================================

' --- LƯU TRẠNG THÁI CAMERA GỐC ---
Dim oTg2 As TransientGeometry = ThisApplication.TransientGeometry
Dim orgEyeX = oCam.Eye.X, orgEyeY = oCam.Eye.Y, orgEyeZ = oCam.Eye.Z
Dim orgTgx = oCam.Target.X, orgTgy = oCam.Target.Y, orgTgz = oCam.Target.Z
Dim orgUpX = oCam.UpVector.X, orgUpY = oCam.UpVector.Y, orgUpZ = oCam.UpVector.Z
Dim orgPersp = oCam.Perspective
Dim orgPerspAng = 0.0
Try
    orgPerspAng = oCam.PerspectiveAngle
Catch
End Try
' -----------------------------------

Dim rb = oDoc.ComponentDefinition.RangeBox
Dim cx = (rb.MinPoint.X + rb.MaxPoint.X) / 2
Dim cy = (rb.MinPoint.Y + rb.MaxPoint.Y) / 2
Dim cz = (rb.MinPoint.Z + rb.MaxPoint.Z) / 2
Dim dx = rb.MaxPoint.X - rb.MinPoint.X
Dim dy = rb.MaxPoint.Y - rb.MinPoint.Y
Dim dz = rb.MaxPoint.Z - rb.MinPoint.Z
Dim max_dim = Math.Max(dx, Math.Max(dy, dz))

' --- SETUP M?I TR??NG ?NH S?NG & ?? B?NG ---
Try
    oView.ShowShadows = True
    oView.ShowAmbientShadows = True
    oView.ShowObjectShadows = True
    oView.ShowGroundReflections = False
    oDoc.ActiveLightingStyle = oDoc.LightingStyles.Item("Dark Sky")
Catch
    Try : oDoc.ActiveLightingStyle = oDoc.LightingStyles.Item("Empty Lab") : Catch : End Try
End Try
' -----------------------------------------

' --- XUÁT VIDEO FRAMES ---
Dim tempPath = "d:\WT3D_Project\2_Video_Renders\"
If Not System.IO.Directory.Exists(tempPath) Then System.IO.Directory.CreateDirectory(tempPath)
Dim saveFolder = tempPath & System.IO.Path.GetFileNameWithoutExtension(oDoc.FullFileName) & "_CAM_2"
If Not System.IO.Directory.Exists(saveFolder) Then System.IO.Directory.CreateDirectory(saveFolder)
Dim frameCount = 1
' -------------------------

' MessageBox.Show("▶ BẤM OK ĐỂ CHẠY: CAM 2 - YOUTUBE TECHNICAL X-RAY (16:9)" & vbCrLf & "Phân rã kết cấu với Wireframe và tia quét X-Ray chuyên sâu.", "Đạo Diễn B2B")

' Cảnh 1: Cận cảnh vật lý
oView.DisplayMode = DisplayModeEnum.kShadedWithEdgesRendering
oView.Update()
oCam.Perspective = True
oCam.PerspectiveAngle = 0.4
For i = 1 To 120
    Dim p = i/120
    oCam.Eye = tg.CreatePoint(cx - max_dim * 0.8 * p, cy, cz + max_dim * (1.5 - p * 0.7))
    oCam.Target = tg.CreatePoint(cx, cy, cz)
    oCam.UpVector = tg.CreateUnitVector(0, 1, 0)
    oCam.UpVector = tg.CreateUnitVector(0, 1, 0) : oCam.ApplyWithoutTransition() : oApp.UserInterfaceManager.DoEvents() : oCam.SaveAsBitmap(saveFolder & "\frame_" & frameCount.ToString("0000") & ".png", 1920, 1080) : frameCount += 1
    ThisApplication.UserInterfaceManager.DoEvents() : If System.Windows.Input.Keyboard.IsKeyDown(System.Windows.Input.Key.Escape) Then : MessageBox.Show("🛑 Emergency Stop!") : GoTo RestoreCamera : End If
Next

' Cảnh 2: Hóa phép khung dây (Wireframe Scan)
oView.DisplayMode = DisplayModeEnum.kWireframeNoHiddenEdges
oView.Update()
For i = 1 To 120
    Dim p = i/120
    Dim R = max_dim * 1.0
    Dim angle = p * Math.PI
    oCam.Eye = tg.CreatePoint(cx + R * Math.Cos(angle), cy + max_dim * 0.5, cz + R * Math.Sin(angle))
    oCam.Target = tg.CreatePoint(cx, cy, cz)
    oCam.UpVector = tg.CreateUnitVector(0, 1, 0) : oCam.ApplyWithoutTransition() : oApp.UserInterfaceManager.DoEvents() : oCam.SaveAsBitmap(saveFolder & "\frame_" & frameCount.ToString("0000") & ".png", 1920, 1080) : frameCount += 1
    ThisApplication.UserInterfaceManager.DoEvents() : If System.Windows.Input.Keyboard.IsKeyDown(System.Windows.Input.Key.Escape) Then : MessageBox.Show("🛑 Emergency Stop!") : GoTo RestoreCamera : End If
Next

' Cảnh 3: Bản in Kỹ thuật (Trực giao) - Hidden Line
oCam.Perspective = False ' Orthographic
oView.DisplayMode = DisplayModeEnum.kWireframeNoHiddenEdges
oView.Update()
For i = 1 To 120
    Dim p = i/120
    oCam.Eye = tg.CreatePoint(cx, rb.MaxPoint.Y + max_dim * 1.5, cz - max_dim * p)
    oCam.Target = tg.CreatePoint(cx, cy, cz)
    oCam.UpVector = tg.CreateUnitVector(0, 1, 0)
    oCam.UpVector = tg.CreateUnitVector(0, 1, 0) : oCam.ApplyWithoutTransition() : oApp.UserInterfaceManager.DoEvents() : oCam.SaveAsBitmap(saveFolder & "\frame_" & frameCount.ToString("0000") & ".png", 1920, 1080) : frameCount += 1
    ThisApplication.UserInterfaceManager.DoEvents() : If System.Windows.Input.Keyboard.IsKeyDown(System.Windows.Input.Key.Escape) Then : MessageBox.Show("🛑 Emergency Stop!") : GoTo RestoreCamera : End If
Next

' Cảnh 4: Trở về thực tại chốt sale
oCam.Perspective = True
oView.DisplayMode = DisplayModeEnum.kShadedWithEdgesRendering
oView.Update()
oCam.UpVector = tg.CreateUnitVector(0, 1, 0)
For i = 1 To 120
    Dim p = i/120
    Dim R = max_dim * 0.8 + p * max_dim * 1.2
    Dim angle = Math.PI * 0.25
    oCam.Eye = tg.CreatePoint(cx + R * Math.Cos(angle), cy + p * max_dim, cz + R * Math.Sin(angle))
    oCam.Target = tg.CreatePoint(cx, cy, cz)
    oCam.UpVector = tg.CreateUnitVector(0, 1, 0) : oCam.ApplyWithoutTransition() : oApp.UserInterfaceManager.DoEvents() : oCam.SaveAsBitmap(saveFolder & "\frame_" & frameCount.ToString("0000") & ".png", 1920, 1080) : frameCount += 1
    ThisApplication.UserInterfaceManager.DoEvents() : If System.Windows.Input.Keyboard.IsKeyDown(System.Windows.Input.Key.Escape) Then : MessageBox.Show("🛑 Emergency Stop!") : GoTo RestoreCamera : End If
Next

RestoreCamera:
' --- TRẢ VỀ CAMERA GỐC ---
oCam.Eye = oTg2.CreatePoint(orgEyeX, orgEyeY, orgEyeZ)
oCam.Target = oTg2.CreatePoint(orgTgx, orgTgy, orgTgz)
oCam.UpVector = oTg2.CreateUnitVector(orgUpX, orgUpY, orgUpZ)
oCam.Perspective = orgPersp
If orgPersp Then
    Try
    oCam.PerspectiveAngle = orgPerspAng
Catch
End Try
End If
oCam.Apply()
oView.Update()
    ' TỰ ĐỘNG GỌI FFMPEG SAU KHI RENDER (ZERO TOUCH)
    Try : Dim sh As Object = CreateObject("WScript.Shell") : sh.Run("powershell.exe -ExecutionPolicy Bypass -WindowStyle Hidden -File d:\WT3D_Project\Z_Tools\Auto_Stitch_Master.ps1", 0, True) : Catch : End Try
    ' MỞ FOLDER VIDEO VÀ DASHBOARD HTML TỰ ĐỘNG SAU KHI HOÀN THÀNH
    Dim _baseName As String = System.IO.Path.GetFileNameWithoutExtension(oDoc.FullFileName)
    Dim _videoDir As String = "d:\WT3D_Project\2_Video_Renders"
    Dim _dashHtml As String = "d:\WT3D_Project\1_Exports_Batch\" & _baseName & "\Dashboard_SEO_" & _baseName & ".html"
    If Not isBatch Then
        Try : Dim _sh1 As Object = CreateObject("WScript.Shell") : _sh1.Run("explorer.exe """ & _videoDir & """", 1, False) : Catch : End Try
        Try : Dim _sh2 As Object = CreateObject("WScript.Shell") : _sh2.Run("explorer.exe """ & _dashHtml & """", 1, False) : Catch : End Try
        ThisApplication.StatusBarText = "✅ CAM 2 HOÀN TẤT! Folder + Dashboard đã mở sẵn."
        MessageBox.Show("✅ CAM 2 - YOUTUBE X-RAY TECHNICAL HOÀN TẤT!" & vbCrLf & vbCrLf &
                       "🎧 NHẠC: CAM2_SciFi.mp3 đã được ép vào Video." & vbCrLf &
                       "📄 FILE: 2_Video_Renders\ (_CAM_2_FINAL.mp4)" & vbCrLf & vbCrLf &
                       "🚀 QUY TRÌNH UPLOAD (Playbook Bước 4):" & vbCrLf &
                       "1. Upload video lên YouTube Video (16:9)" & vbCrLf &
                       "2. Copy Title/Description từ Dashboard HTML (mục CAM 2)" & vbCrLf &
                       "3. Hashtag: #ReverseEngineering #Wireframe #IndustrialDesign", "🎥 CAM 2 XONG!", MessageBoxButtons.OK, MessageBoxIcon.Information)
    End If
' -------------------------
