{
  "manifest_version": 3,
  "name": "WT3D Fab.com 1-Click Draft Auto-Fill",
  "version": "3.9.106",
  "description": "WT3D Fab Helper v3.9.106 - KeyShot Studio 1-Click Render (Preserve Clear & Translucent Materials + 20-Preset Auto-Map + Classic #AAB9C5 Background)",
  "permissions": [
    "clipboardWrite",
    "storage",
    "tabs",
    "scripting"
  ],
  "action": {
    "default_title": "WT3D Fab Helper v3.9.106 - Bấm để hiện bảng điều khiển"
  },
  "host_permissions": [
    "https://*.fab.com/*",
    "https://fab.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.fab.com/portal/listings/*",
        "https://fab.com/portal/listings/*",
        "https://*.fab.com/listings/*",
        "https://fab.com/listings/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.fab.com/dope/*",
        "https://fab.com/dope/*"
      ],
      "all_frames": true,
      "match_about_blank": false,
      "js": [
        "render-toolbar.js",
        "material-presets.js",
        "dope-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.fab.com/dope/*",
        "https://fab.com/dope/*"
      ],
      "all_frames": true,
      "js": [
        "color-bridge.js",
        "render-preset.js",
        "render-engine.js",
        "render-reader.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}