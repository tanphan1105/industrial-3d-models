{
  "manifest_version": 3,
  "name": "WT3D Fab.com 1-Click Draft Auto-Fill",
  "version": "3.1.0",
  "description": "Tu dong dien Title, Description, 15 Tags, Price, Category va ho tro mo thu muc media 1-click cho Fab.com",
  "permissions": [
    "clipboardWrite",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.fab.com/portal/listings/*",
    "https://fab.com/portal/listings/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.fab.com/portal/listings/*",
        "https://fab.com/portal/listings/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}