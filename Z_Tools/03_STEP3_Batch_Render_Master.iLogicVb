' ==============================================================================
' 03_STEP3_Batch_Render_Master.iLogicVb
' BƯỚC 3: Render Video Master 2K (16:9) & Video Shorts (9:16) cho Mô hình đang mở (hoặc Hàng loạt)
' ==============================================================================
Try
    If ThisApplication.ActiveDocument IsNot Nothing Then
        ' Đang mở mô hình -> Render Video trực tiếp cho mô hình đang mở
        iLogicVb.Automation.RunExternalRule(ThisApplication.ActiveDocument, "d:\WT3D_Project\Z_Tools\CAM_0_RENDER_ALL.iLogicVb")
    Else
        ' Chưa mở file -> Kích hoạt bảng chọn file render video hàng loạt
        iLogicVb.Automation.RunExternalRule(Nothing, "d:\WT3D_Project\Z_Tools\Batch_Render_Master.iLogicVb")
    End If
Catch ex As Exception
    MessageBox.Show("Lỗi thực thi Bước 3: " & ex.Message, "Báo Động Bước 3")
End Try
