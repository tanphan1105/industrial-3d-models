    ' --------------------------------------------------------------------------
    ' 4. QUỸ ĐẠO BÉZIER CHO CẢNH 1 & CẢNH 2
    ' --------------------------------------------------------------------------
    Public Class FlyInRail
        Public P0 As Vec3
        Public P1 As Vec3
        Public P2 As Vec3
        Public P3 As Vec3
        Public TargetStart As Vec3
        Public TargetEnd As Vec3

        Public Sub Build(ByVal model As ModelInfo, ByVal s As Shot01Settings)
            Dim C As Vec3 = model.Center
            Dim U As Vec3 = model.U : Dim V As Vec3 = model.V : Dim W As Vec3 = model.W
            Dim RU As Double = model.RU : Dim RV As Double = model.RV : Dim RH As Double = model.RH

            Dim diag As Double = If(model.Diag > 50.0, model.Diag, Math.Sqrt(4.0 * RU * RU + 4.0 * RV * RV + 4.0 * RH * RH))
            Dim halfFovRad As Double = (Math.Max(5.0, Math.Min(160.0, s.FOVEnd)) * 0.5) * Math.PI / 180.0
            Dim endScale As Double = Math.Max(0.05, Math.Min(10.0, s.EndDistanceScale))
            Dim fitDist As Double = (diag * 0.5) / Math.Tan(halfFovRad) * 1.18 * endScale

            Dim sgnU As Double = -1.0 : Dim sgnV As Double = 1.0
            Select Case s.CornerMode
                Case "FRONT_RIGHT" : sgnU = 1.0 : sgnV = -1.0
                Case "BACK_RIGHT"  : sgnU = 1.0 : sgnV = 1.0
                Case "FRONT_LEFT"  : sgnU = -1.0 : sgnV = -1.0
                Case Else          : sgnU = -1.0 : sgnV = 1.0
            End Select

            Dim elevAngleDeg As Double = -4.0
            Select Case s.ViewAngleMode
                Case "34_TOP"
                    elevAngleDeg = 28.0 : TargetStart = C : TargetEnd = C - 0.05 * RH * W
                Case "34_LEVEL"
                    elevAngleDeg = 0.0 : TargetStart = C : TargetEnd = C
                Case Else
                    elevAngleDeg = -4.0 : TargetStart = C + 0.15 * RH * W : TargetEnd = C + 0.20 * RH * W
            End Select

            Dim elevRad As Double = elevAngleDeg * Math.PI / 180.0
            Dim horizDist As Double = fitDist * Math.Cos(elevRad)
            Dim vertDist As Double = fitDist * Math.Sin(elevRad)

            Dim dirU As Double = sgnU * horizDist * 0.70710678
            Dim dirV As Double = sgnV * horizDist * 0.70710678
            Dim dirW As Double = vertDist

            Dim BaseOffset As New Vec3(dirU, dirW, dirV)
            Dim NormalSide As Vec3 = W.Cross(BaseOffset).Normalize()

            Dim distScale As Double = Math.Max(0.5, s.StartDistanceScale)
            Dim curve As Double = Math.Max(0.0, s.SwoopCurvature)

            P0 = C + BaseOffset * distScale
            P1 = C + BaseOffset * (distScale * 0.65) + (curve * 0.15 * RH) * W + (curve * 0.10 * RU) * NormalSide
            P2 = C + BaseOffset * (distScale * 0.35) + (curve * 0.06 * RH) * W + (curve * 0.04 * RU) * NormalSide
            P3 = C + BaseOffset
        End Sub

        Public Function EvaluateEye(ByVal t As Double) As Vec3
            t = Math.Max(0.0, Math.Min(1.0, t))
            Dim u As Double = 1.0 - t
            Dim tt As Double = t * t : Dim uu As Double = u * u
            Return uu * u * P0 + 3.0 * uu * t * P1 + 3.0 * u * tt * P2 + tt * t * P3
        End Function

        Public Function EvaluateTarget(ByVal t As Double) As Vec3
            t = Math.Max(0.0, Math.Min(1.0, t))
            Return Vec3.Lerp(TargetStart, TargetEnd, t)
        End Function
    End Class

    Public Class RailShot03
        Public CenterFocus As Vec3
        Public TargetFocus As Vec3
        Public EyeStart As Vec3
        Public TargetStart As Vec3
        Public BaseAngleRad As Double = -Math.PI * 0.5
        Public HasPrevEye As Boolean = False

        Public Sub Build(ByVal model As ModelInfo, ByVal heroes As Dictionary(Of String, HeroTarget), ByVal s03 As Shot03Settings, Optional ByVal fromPrevEye As Vec3 = Nothing, Optional ByVal fromPrevTarget As Vec3 = Nothing)
            If fromPrevEye IsNot Nothing Then HasPrevEye = True
            Dim C As Vec3 = model.Center
            Dim RU As Double = If(model.RU > 20.0, model.RU, 60.0)
            Dim RV As Double = If(model.RV > 20.0, model.RV, 100.0)
            Dim RH As Double = If(model.RH > 20.0, model.RH, 130.0)
            Dim diag As Double = If(model.Diag > 50.0, model.Diag, 360.0)

            ' 1. Xác định góc cơ sở và tâm máy (Chuẩn góc 3/4 đối xứng cân đều 2 bên 100%)
            Select Case s03.FocusMode
                Case "CORNER_1"
                    ' Góc 1: Trước - Trái (-X, -Z) chuẩn 45 độ cân đều 2 bên
                    CenterFocus = C
                    BaseAngleRad = -135.0 * Math.PI / 180.0
                Case "CORNER_2"
                    ' Góc 2: Trước - Phải (+X, -Z) chuẩn 45 độ cân đều 2 bên
                    CenterFocus = C
                    BaseAngleRad = -45.0 * Math.PI / 180.0
                Case "CORNER_3"
                    ' Góc 3: Sau - Phải (+X, +Z) chuẩn 45 độ cân đều 2 bên
                    CenterFocus = C
                    BaseAngleRad = 45.0 * Math.PI / 180.0
                Case "CORNER_4"
                    ' Góc 4: Sau - Trái (-X, +Z) chuẩn 45 độ cân đều 2 bên
                    CenterFocus = C
                    BaseAngleRad = 135.0 * Math.PI / 180.0
                Case "BACK_FACADE"
                    ' Mặt Sau máy (Quét giàn ống sau)
                    CenterFocus = C
                    BaseAngleRad = 90.0 * Math.PI / 180.0
                Case "SKID_CENTER"
                    ' Tâm toàn bộ skid
                    CenterFocus = C
                    BaseAngleRad = -135.0 * Math.PI / 180.0
                Case "CUSTOM_PICK"
                    ' Điểm chi tiết được chọn (SelectSet)
                    CenterFocus = If(s03.CustomPickPoint IsNot Nothing, s03.CustomPickPoint, C)
                    BaseAngleRad = -90.0 * Math.PI / 180.0
                Case Else
                    ' MẶT TIỀN PHÍA TRƯỚC (Góc 1 Trước-Trái ➔ Góc 2 Trước-Phải) [Khuyến nghị]
                    CenterFocus = C
                    BaseAngleRad = -90.0 * Math.PI / 180.0
            End Select

            ' 2. Xác định điểm ngắm Target và độ dốc (Mục 2 có hiệu lực rõ rệt 100%)
            Dim targetYShift As Double = 0.0
            Dim baseElevDeg As Double = 0.0
            Select Case s03.ViewAngleMode
                Case "34_BOTTOM"
                    baseElevDeg = -8.0
                    targetYShift = 0.20 * RH  ' Hất từ dưới bệ thép lên trên máy
                Case "34_TOP"
                    baseElevDeg = 28.0
                    targetYShift = -0.05 * RH ' Nhìn từ trên cao dốc xuống
                Case Else ' 34_LEVEL
                    baseElevDeg = 0.0
                    targetYShift = 0.0       ' Ngang tầm mắt chuẩn kỹ thuật
            End Select

            TargetFocus = CenterFocus + New Vec3(0, targetYShift, 0)

            ' 3. Điểm xuất phát
            If fromPrevEye IsNot Nothing Then
                EyeStart = fromPrevEye
                TargetStart = If(fromPrevTarget IsNot Nothing, fromPrevTarget, TargetFocus)
            Else
                Dim elevRadS As Double = baseElevDeg * Math.PI / 180.0
                Dim baseDist As Double = (diag * 0.5) / 0.466307658 * 1.18 * s03.FarDistanceScale
                Dim hDistS As Double = baseDist * Math.Cos(elevRadS)
                Dim vDistS As Double = baseDist * Math.Sin(elevRadS)
                Dim swayMaxRad As Double = (s03.SwayArcDeg * (s03.SwayPercent / 100.0)) * Math.PI / 180.0
                Dim startAngle As Double = BaseAngleRad - swayMaxRad
                EyeStart = CenterFocus + New Vec3(hDistS * Math.Cos(startAngle), vDistS, hDistS * Math.Sin(startAngle))
                TargetStart = TargetFocus
            End If
        End Sub

        Public Function EvaluateEye(ByVal t As Double, ByVal model As ModelInfo, ByVal s03 As Shot03Settings, ByRef outBankDeg As Double) As Vec3
            t = Math.Max(0.0, Math.Min(1.0, t))
            Dim CF As Vec3 = CenterFocus
            Dim diag As Double = If(model.Diag > 50.0, model.Diag, 360.0)
            Dim RH As Double = If(model.RH > 20.0, model.RH, 130.0)

            Dim nearDist As Double = (diag * 0.5) / 0.466307658 * 1.18 * s03.NearDistanceScale
            Dim farDist As Double = (diag * 0.5) / 0.466307658 * 1.18 * s03.FarDistanceScale
            Dim swayMaxRad As Double = (s03.SwayArcDeg * (s03.SwayPercent / 100.0)) * Math.PI / 180.0
            Dim bobMax As Double = (s03.VerticalBobPercent / 100.0) * RH

            Dim phase As Double
            If s03.CycleMode = "HALF_CYCLE" Then
                phase = -Math.PI * 0.5 + Math.PI * t
            ElseIf s03.CycleMode = "2_CYCLES" Then
                phase = -Math.PI * 0.5 + 4.0 * Math.PI * t
            Else
                phase = -Math.PI * 0.5 + 2.0 * Math.PI * t
            End If

            Dim swayOffset As Double = swayMaxRad * Math.Sin(phase)
            Dim normAngle As Double = Math.Abs(swayOffset) / Math.Max(0.001, swayMaxRad)

            Dim r As Double = nearDist + (farDist - nearDist) * normAngle
            Dim baseElevDeg As Double
            Select Case s03.ViewAngleMode
                Case "34_BOTTOM" : baseElevDeg = -8.0
                Case "34_TOP"    : baseElevDeg = 28.0
                Case Else        : baseElevDeg = 0.0
            End Select

            Dim curElevDeg As Double = baseElevDeg + (bobMax / Math.Max(1.0, r) * 57.3) * (1.0 - normAngle)
            Dim elevRad As Double = curElevDeg * Math.PI / 180.0

            Dim hR As Double = r * Math.Cos(elevRad)
            Dim vR As Double = r * Math.Sin(elevRad)

            Dim curAngle As Double = BaseAngleRad + swayOffset
            Dim idealX As Double = CF.X + hR * Math.Cos(curAngle)
            Dim idealY As Double = CF.Y + vR
            Dim idealZ As Double = CF.Z + hR * Math.Sin(curAngle)
            Dim idealEye As New Vec3(idealX, idealY, idealZ)

            Dim blend As Double = Math.Min(1.0, t / 0.15)
            Dim eye As Vec3 = Vec3.Lerp(EyeStart, idealEye, blend)
            Dim tSmooth As Double = t * t * (3.0 - 2.0 * t)
            Dim effBankStart As Double = If(HasPrevEye, 0.0, s03.BankStart)
            outBankDeg = effBankStart + (s03.BankEnd - effBankStart) * tSmooth

            Return eye
        End Function

        Public Function EvaluateTarget(ByVal t As Double) As Vec3
            t = Math.Max(0.0, Math.Min(1.0, t))
            Dim blend As Double = Math.Min(1.0, t / 0.15)
            Return Vec3.Lerp(TargetStart, TargetFocus, blend)
        End Function
    End Class

    Public Class RailShot02
        Public P0 As Vec3
        Public P1 As Vec3
        Public P2 As Vec3
        Public P3 As Vec3
        Public TargetStart As Vec3
        Public TargetEnd As Vec3

        Public Sub Build(ByVal model As ModelInfo, ByVal s02 As Shot02Settings, ByVal s01 As Shot01Settings, Optional ByVal fromPrevEye As Vec3 = Nothing, Optional ByVal fromPrevTarget As Vec3 = Nothing)
            Dim C As Vec3 = model.Center
            Dim U As Vec3 = model.U : Dim V As Vec3 = model.V : Dim W As Vec3 = model.W
            Dim RU As Double = model.RU : Dim RV As Double = model.RV : Dim RH As Double = model.RH
            Dim diag As Double = If(model.Diag > 50.0, model.Diag, Math.Sqrt(4.0 * RU * RU + 4.0 * RV * RV + 4.0 * RH * RH))

            ' 1. Xác định góc đầu
            Dim startCorner As String = s02.CornerStart
            If startCorner = "AUTO_C1" Then startCorner = s01.CornerMode

            Dim sgnU_S As Double = -1.0 : Dim sgnV_S As Double = 1.0
            Select Case startCorner
                Case "FRONT_RIGHT" : sgnU_S = 1.0 : sgnV_S = -1.0
                Case "BACK_RIGHT"  : sgnU_S = 1.0 : sgnV_S = 1.0
                Case "FRONT_LEFT"  : sgnU_S = -1.0 : sgnV_S = -1.0
                Case Else          : sgnU_S = -1.0 : sgnV_S = 1.0
            End Select

            ' 2. Xác định góc cuối
            Dim sgnU_E As Double = -1.0 : Dim sgnV_E As Double = -1.0
            Select Case s02.CornerEnd
                Case "FRONT_RIGHT" : sgnU_E = 1.0 : sgnV_E = -1.0
                Case "BACK_RIGHT"  : sgnU_E = 1.0 : sgnV_E = 1.0
                Case "BACK_LEFT"   : sgnU_E = -1.0 : sgnV_E = 1.0
                Case Else          : sgnU_E = -1.0 : sgnV_E = -1.0
            End Select

            ' 3. Tính P0 (Vị trí bắt đầu lùi)
            If fromPrevEye IsNot Nothing Then
                P0 = fromPrevEye
                TargetStart = If(fromPrevTarget IsNot Nothing, fromPrevTarget, C)
            Else
                Dim halfFovRadS As Double = (Math.Max(5.0, Math.Min(160.0, s02.FOVStart)) * 0.5) * Math.PI / 180.0
                Dim fitDistS As Double = (diag * 0.5) / Math.Tan(halfFovRadS) * 1.18 * s02.StartDistanceScale
                Dim elevDegS As Double = If(s01.ViewAngleMode = "34_TOP", 28.0, If(s01.ViewAngleMode = "34_LEVEL", 0.0, -4.0))
                Dim elevRadS As Double = elevDegS * Math.PI / 180.0
                Dim hDistS As Double = fitDistS * Math.Cos(elevRadS)
                Dim vDistS As Double = fitDistS * Math.Sin(elevRadS)
                P0 = C + New Vec3(sgnU_S * hDistS * 0.70710678, vDistS, sgnV_S * hDistS * 0.70710678)
                TargetStart = C + If(elevDegS < 0, 0.15 * RH * W, If(elevDegS > 0, -0.05 * RH * W, New Vec3(0, 0, 0)))
            End If

            ' 4. Tính P3 (Vị trí kết thúc ở xa)
            Dim halfFovRadE As Double = (Math.Max(5.0, Math.Min(160.0, s02.FOVEnd)) * 0.5) * Math.PI / 180.0
            Dim fitDistE As Double = (diag * 0.5) / Math.Tan(halfFovRadE) * 1.18 * s02.EndDistanceScale
            Dim elevDegE As Double = If(s02.ViewAngleModeEnd = "34_BOTTOM", -4.0, If(s02.ViewAngleModeEnd = "34_LEVEL", 0.0, 28.0))
            Dim elevRadE As Double = elevDegE * Math.PI / 180.0
            Dim hDistE As Double = fitDistE * Math.Cos(elevRadE)
            Dim vDistE As Double = fitDistE * Math.Sin(elevRadE)
            P3 = C + New Vec3(sgnU_E * hDistE * 0.70710678, vDistE, sgnV_E * hDistE * 0.70710678)
            TargetEnd = C + If(elevDegE < 0, 0.15 * RH * W, If(elevDegE > 0, -0.05 * RH * W, New Vec3(0, 0, 0)))

            ' 5. Quỹ đạo P1, P2 (Đường bay lùi: THẲNG hoặc CONG CÁNH CUNG)
            Dim flightVec As Vec3 = (P3 - P0)
            If s02.TrajectoryMode = "STRAIGHT" Then
                P1 = P0 + flightVec * 0.333
                P2 = P0 + flightVec * 0.666
            Else
                ' TÍNH VÉC-TƠ PHÁP TUYẾN NGANG 90 ĐỘ TRÊN MẶT PHẲNG SÀN X-Z (100% ORTHOGONAL)
                Dim horizFlight As New Vec3(flightVec.X, 0.0, flightVec.Z)
                Dim sideNormal As Vec3
                If horizFlight.Length() < 1E-3 Then
                    sideNormal = New Vec3(-sgnV_E, 0.0, sgnU_E).Normalize()
                Else
                    Dim uDir As Vec3 = horizFlight.Normalize()
                    Dim n1 As New Vec3(-uDir.Z, 0.0, uDir.X)
                    Dim n2 As New Vec3(uDir.Z, 0.0, -uDir.X)
                    ' Chọn hướng vồng ra ngoài xưởng (xa tâm mô hình C) để tuyệt đối không va chạm vào máy
                    Dim testDist1 As Double = ((P0 + n1 * 100.0) - C).Length()
                    Dim testDist2 As Double = ((P0 + n2 * 100.0) - C).Length()
                    sideNormal = If(testDist1 > testDist2, n1, n2)
                End If

                Dim curve As Double = Math.Max(0.0, s02.SwoopCurvature)
                ' Độ uốn vồng ngang sang sườn máy (từ 50cm đến trên 200cm rõ rệt)
                Dim lateralBulge As Double = curve * (0.015 * diag)
                ' Độ nâng nhẹ cao độ (tạo vòng cung 3D êm ái, giữ tầm nhìn bám sát máy)
                Dim verticalArch As Double = curve * (0.005 * RH)

                P1 = P0 + flightVec * 0.35 + sideNormal * lateralBulge + W * verticalArch
                P2 = P0 + flightVec * 0.70 + sideNormal * (lateralBulge * 1.15) + W * (verticalArch * 0.6)
            End If
        End Sub

        Public Function EvaluateEye(ByVal t As Double) As Vec3
            t = Math.Max(0.0, Math.Min(1.0, t))
            Dim u As Double = 1.0 - t
            Dim tt As Double = t * t : Dim uu As Double = u * u
            Return uu * u * P0 + 3.0 * uu * t * P1 + 3.0 * u * tt * P2 + tt * t * P3
        End Function

        Public Function EvaluateTarget(ByVal t As Double) As Vec3
            t = Math.Max(0.0, Math.Min(1.0, t))
            Return Vec3.Lerp(TargetStart, TargetEnd, t)
        End Function
    End Class

    Public Shared Function SmoothStepQuintic(ByVal t As Double) As Double
        t = Math.Max(0.0, Math.Min(1.0, t))
        Return t * t * t * (t * (t * 6.0 - 15.0) + 10.0)
    End Function

    ' --------------------------------------------------------------------------
    ' 5. QUÉT DỮ LIỆU SKID VÀ PHÁT HIỆN HERO TARGETS
    ' --------------------------------------------------------------------------
    Private Function ScanSkidModel(ByVal oDoc As Document) As ModelInfo
        Dim info As New ModelInfo()
        info.U = New Vec3(1, 0, 0)
        info.W = New Vec3(0, 1, 0)
        info.V = New Vec3(0, 0, 1)

        Try
            Dim oAsm As AssemblyDocument = CType(oDoc, AssemblyDocument)
            Dim box As Box = oAsm.ComponentDefinition.RangeBox
            info.MinPt = New Vec3(box.MinPoint.X, box.MinPoint.Y, box.MinPoint.Z)
            info.MaxPt = New Vec3(box.MaxPoint.X, box.MaxPoint.Y, box.MaxPoint.Z)
            info.Center = New Vec3((box.MinPoint.X + box.MaxPoint.X) * 0.5, (box.MinPoint.Y + box.MaxPoint.Y) * 0.5, (box.MinPoint.Z + box.MaxPoint.Z) * 0.5)

            info.RU = Math.Max(30.0, Math.Abs(box.MaxPoint.X - box.MinPoint.X) * 0.5)
            info.RH = Math.Max(40.0, Math.Abs(box.MaxPoint.Y - box.MinPoint.Y) * 0.5)
            info.RV = Math.Max(40.0, Math.Abs(box.MaxPoint.Z - box.MinPoint.Z) * 0.5)
            info.Diag = Math.Sqrt(info.RU * info.RU * 4.0 + info.RH * info.RH * 4.0 + info.RV * info.RV * 4.0)
        Catch
            info.Center = New Vec3(-8.19, 121.98, -5.78)
            info.MinPt = New Vec3(-69.89, -9.45, -111.55)
            info.MaxPt = New Vec3(53.50, 253.41, 100.00)
            info.RU = 61.70 : info.RH = 131.43 : info.RV = 105.78 : info.Diag = 360.0
        End Try

        Return info
    End Function

    Private Function DiscoverHeroes(ByVal oDoc As Document, ByVal model As ModelInfo) As Dictionary(Of String, HeroTarget)
        Dim dict As New Dictionary(Of String, HeroTarget)()

        Dim hPump As New HeroTarget() : hPump.Name = "Cụm Bơm" : hPump.Radius = 35.0 : hPump.Found = False
        Dim hUF As New HeroTarget() : hUF.Name = "Màng UF" : hUF.Radius = 45.0 : hUF.Found = False
        Dim hPanel As New HeroTarget() : hPanel.Name = "Tủ Điện" : hPanel.Radius = 40.0 : hPanel.Found = False

        hPump.Center = model.Center + (-0.35 * model.RU) * model.U + (-0.20 * model.RV) * model.V + (-0.25 * model.RH) * model.W
        hUF.Center = model.Center + (0.30 * model.RU) * model.U + (0.0 * model.RV) * model.V + (0.15 * model.RH) * model.W
        hPanel.Center = model.Center + (-0.25 * model.RU) * model.U + (0.35 * model.RV) * model.V + (0.05 * model.RH) * model.W

        Try
            If oDoc.DocumentType = DocumentTypeEnum.kAssemblyDocumentObject Then
                Dim oAsm As AssemblyDocument = CType(oDoc, AssemblyDocument)
                For Each occ As ComponentOccurrence In oAsm.ComponentDefinition.Occurrences
                    If occ.Visible Then
                        Dim n As String = occ.Name.ToLower()
                        If Not hPump.Found AndAlso (n.Contains("bom") OrElse n.Contains("pump")) Then
                            Dim b As Box = occ.RangeBox
                            hPump.Center = New Vec3((b.MinPoint.X + b.MaxPoint.X) * 0.5, (b.MinPoint.Y + b.MaxPoint.Y) * 0.5, (b.MinPoint.Z + b.MaxPoint.Z) * 0.5)
                            hPump.Found = True
                        ElseIf Not hUF.Found AndAlso (n.Contains("uf") OrElse n.Contains("membrane")) Then
                            Dim b As Box = occ.RangeBox
                            hUF.Center = New Vec3((b.MinPoint.X + b.MaxPoint.X) * 0.5, (b.MinPoint.Y + b.MaxPoint.Y) * 0.5, (b.MinPoint.Z + b.MaxPoint.Z) * 0.5)
                            hUF.Found = True
                        ElseIf Not hPanel.Found AndAlso (n.Contains("hop") OrElse n.Contains("panel") OrElse n.Contains("dien")) Then
                            Dim b As Box = occ.RangeBox
                            hPanel.Center = New Vec3((b.MinPoint.X + b.MaxPoint.X) * 0.5, (b.MinPoint.Y + b.MaxPoint.Y) * 0.5, (b.MinPoint.Z + b.MaxPoint.Z) * 0.5)
                            hPanel.Found = True
                        End If
                    End If
                Next
            End If
        Catch
        End Try

        dict("PUMP") = hPump
        dict("UF") = hUF
        dict("PANEL") = hPanel
        Return dict
    End Function

    ' --------------------------------------------------------------------------
    ' 6. THỰC THI CÁC CẢNH
    ' --------------------------------------------------------------------------
    Public Function ExecuteShot01(ByVal oDoc As Document, ByVal settings As Shot01Settings, _
                                  Optional ByRef outLastEye As Vec3 = Nothing, _
                                  Optional ByRef outLastTarget As Vec3 = Nothing, _
                                  Optional ByRef outLastUp As Vec3 = Nothing, _
                                  Optional ByRef outLastFOV As Double = 50.0, _
                                  Optional ByVal exportCtx As VideoExportContext = Nothing) As Boolean
        Dim oApp As Inventor.Application = oDoc.Parent
        Dim oView As Inventor.View = oApp.ActiveView
        Dim oCam As Inventor.Camera = oView.Camera
        Dim tg As TransientGeometry = oApp.TransientGeometry

        Dim model As ModelInfo = ScanSkidModel(oDoc)
        Dim rail As New FlyInRail()
        rail.Build(model, settings)

        Dim effectiveDur As Double = settings.DurationSeconds / Math.Max(0.05, settings.SpeedMultiplier)
        Dim totalFrames As Integer = Math.Max(10, CInt(effectiveDur * settings.FPS))

        oCam.Perspective = True

        Dim lastEye As Vec3 = rail.P3
        Dim lastTarget As Vec3 = rail.TargetEnd
        Dim lastUp As New Vec3(0, 1, 0)
        Dim lastFOV As Double = settings.FOVEnd

        ' Pha 1: Bay vào Fit View
        For frame As Integer = 0 To totalFrames
            If CheckEscapeKey() Then
                MessageBox.Show("Đã dừng Cảnh 1 (Phím ESC)", "WT3D WhipCam", MessageBoxButtons.OK, MessageBoxIcon.Information)
                Return False
            End If

            Dim tRaw As Double = CDbl(frame) / CDbl(totalFrames)
            Dim tSmooth As Double = SmoothStepQuintic(tRaw)

            Dim eye As Vec3 = rail.EvaluateEye(tSmooth)
            Dim targetPt As Vec3 = rail.EvaluateTarget(tSmooth)

            Dim curFOV As Double = settings.FOVStart + (settings.FOVEnd - settings.FOVStart) * tSmooth
            Dim curBankDeg As Double = settings.BankStart + (settings.BankEnd - settings.BankStart) * tSmooth
            Dim bankRad As Double = curBankDeg * Math.PI / 180.0

            Dim forward As Vec3 = (targetPt - eye).Normalize()
            Dim worldUp As New Vec3(0, 1, 0)
            Dim camRight As Vec3 = worldUp.Cross(forward).Normalize()
            If camRight.Length() < 1E-6 Then camRight = New Vec3(1, 0, 0)
            Dim camUp0 As Vec3 = forward.Cross(camRight).Normalize()
            Dim rolledUp As Vec3 = camUp0 * Math.Cos(bankRad) + camRight * Math.Sin(bankRad)

            lastEye = eye : lastTarget = targetPt : lastUp = rolledUp : lastFOV = curFOV

            oCam.Eye = tg.CreatePoint(eye.X, eye.Y, eye.Z)
            oCam.Target = tg.CreatePoint(targetPt.X, targetPt.Y, targetPt.Z)
            oCam.UpVector = tg.CreateUnitVector(rolledUp.X, rolledUp.Y, rolledUp.Z)
            oCam.PerspectiveAngle = curFOV * Math.PI / 180.0
            oCam.ApplyWithoutTransition()

            If exportCtx IsNot Nothing AndAlso exportCtx.IsExporting Then
                CaptureVideoFrame(oCam, exportCtx, oApp)
                SafeYield(2)
            Else
                If settings.RunMode = "PREVIEW" Then
                    System.Threading.Thread.Sleep(CInt(1000.0 / settings.FPS))
                    System.Windows.Forms.Application.DoEvents()
                End If
            End If
        Next

        ' Pha 2: Dừng ngắm tĩnh tại Fit View
        If settings.HoldSeconds > 0.0 Then
            Dim holdFrames As Integer = Math.Max(1, CInt(settings.HoldSeconds * settings.FPS))
            For frame As Integer = 0 To holdFrames
                If CheckEscapeKey() Then
                    MessageBox.Show("Đã dừng Cảnh 1 (Phím ESC)", "WT3D WhipCam", MessageBoxButtons.OK, MessageBoxIcon.Information)
                    Return False
                End If
                If exportCtx IsNot Nothing AndAlso exportCtx.IsExporting Then
                    CaptureVideoFrame(oCam, exportCtx, oApp)
                    SafeYield(2)
                Else
                    If settings.RunMode = "PREVIEW" Then
                        System.Threading.Thread.Sleep(CInt(1000.0 / settings.FPS))
                        System.Windows.Forms.Application.DoEvents()
                    End If
                End If
            Next
        End If

        ' Pha 3: Bay ra xa lại nếu bật trong Cảnh 1
        If settings.EnableFlyOut AndAlso settings.FlyOutDuration > 0.0 Then
            Dim effectiveDurOut As Double = settings.FlyOutDuration / Math.Max(0.05, settings.SpeedMultiplier)
            Dim totalFramesOut As Integer = Math.Max(10, CInt(effectiveDurOut * settings.FPS))

            For frame As Integer = 0 To totalFramesOut
                If CheckEscapeKey() Then
                    MessageBox.Show("Đã dừng Cảnh 1 (Phím ESC)", "WT3D WhipCam", MessageBoxButtons.OK, MessageBoxIcon.Information)
                    Return False
                End If

                Dim tRaw As Double = CDbl(frame) / CDbl(totalFramesOut)
                Dim tSmooth As Double = SmoothStepQuintic(tRaw)
                Dim tRail As Double = 1.0 - tSmooth

                Dim eye As Vec3 = rail.EvaluateEye(tRail)
                Dim targetPt As Vec3 = rail.EvaluateTarget(tRail)

                Dim curFOV As Double = settings.FOVStart + (settings.FOVEnd - settings.FOVStart) * tRail
                Dim curBankDeg As Double = settings.BankStart + (settings.BankEnd - settings.BankStart) * tRail
                Dim bankRad As Double = curBankDeg * Math.PI / 180.0

                Dim forward As Vec3 = (targetPt - eye).Normalize()
                Dim worldUp As New Vec3(0, 1, 0)
                Dim camRight As Vec3 = worldUp.Cross(forward).Normalize()
                If camRight.Length() < 1E-6 Then camRight = New Vec3(1, 0, 0)
                Dim camUp0 As Vec3 = forward.Cross(camRight).Normalize()
                Dim rolledUp As Vec3 = camUp0 * Math.Cos(bankRad) + camRight * Math.Sin(bankRad)

                lastEye = eye : lastTarget = targetPt : lastUp = rolledUp : lastFOV = curFOV

                oCam.Eye = tg.CreatePoint(eye.X, eye.Y, eye.Z)
                oCam.Target = tg.CreatePoint(targetPt.X, targetPt.Y, targetPt.Z)
                oCam.UpVector = tg.CreateUnitVector(rolledUp.X, rolledUp.Y, rolledUp.Z)
                oCam.PerspectiveAngle = curFOV * Math.PI / 180.0
                oCam.ApplyWithoutTransition()

                If exportCtx IsNot Nothing AndAlso exportCtx.IsExporting Then
                    CaptureVideoFrame(oCam, exportCtx, oApp)
                    SafeYield(2)
                Else
                    If settings.RunMode = "PREVIEW" Then
                        System.Threading.Thread.Sleep(CInt(1000.0 / settings.FPS))
                        System.Windows.Forms.Application.DoEvents()
                    End If
                End If
            Next
        End If

        outLastEye = lastEye : outLastTarget = lastTarget : outLastUp = lastUp : outLastFOV = lastFOV
        Return True
    End Function

    Public Function ExecuteShot02(ByVal oDoc As Document, ByVal s02 As Shot02Settings, ByVal s01 As Shot01Settings, ByVal model As ModelInfo, _
                                  Optional ByVal fromPrevEye As Vec3 = Nothing, _
                                  Optional ByVal fromPrevTarget As Vec3 = Nothing, _
                                  Optional ByRef outLastEye As Vec3 = Nothing, _
                                  Optional ByRef outLastTarget As Vec3 = Nothing, _
                                  Optional ByRef outLastUp As Vec3 = Nothing, _
                                  Optional ByRef outLastFOV As Double = 50.0, _
                                  Optional ByVal exportCtx As VideoExportContext = Nothing) As Boolean
        Dim oApp As Inventor.Application = oDoc.Parent
        Dim oView As Inventor.View = oApp.ActiveView
        Dim oCam As Inventor.Camera = oView.Camera
        Dim tg As TransientGeometry = oApp.TransientGeometry

        Dim rail As New RailShot02()
        rail.Build(model, s02, s01, fromPrevEye, fromPrevTarget)

        Dim effectiveDur As Double = s02.DurationSeconds / Math.Max(0.05, s02.SpeedMultiplier)
        Dim totalFrames As Integer = Math.Max(10, CInt(effectiveDur * s02.FPS))

        oCam.Perspective = True

        Dim lastEye As Vec3 = rail.P3
        Dim lastTarget As Vec3 = rail.TargetEnd
        Dim lastUp As New Vec3(0, 1, 0)
        Dim lastFOV As Double = s02.FOVEnd

        ' Pha 1: Bay lùi ra xa (Thẳng hoặc Cong)
        For frame As Integer = 0 To totalFrames
            If CheckEscapeKey() Then
                MessageBox.Show("Đã dừng Cảnh 2 (Phím ESC)", "WT3D WhipCam", MessageBoxButtons.OK, MessageBoxIcon.Information)
                Return False
            End If

            Dim tRaw As Double = CDbl(frame) / CDbl(totalFrames)
            Dim tSmooth As Double
            Select Case s02.EasingMode
                Case "EASE_OUT"
                    ' Chậm dần: Vút nhanh lúc đầu, hãm phanh êm dịu lúc kết thúc
                    tSmooth = 1.0 - Math.Pow(1.0 - tRaw, 3.0)
                Case "EASE_IN"
                    ' Nhanh dần: Bắt đầu từ tốn, tăng tốc phóng nhanh dần ra xa
                    tSmooth = Math.Pow(tRaw, 3.0)
                Case "LINEAR"
                    ' Đều đặn: Tốc độ đều tắp không đổi
                    tSmooth = tRaw
                Case Else
                    ' Mượt cả 2 đầu: Êm đầu chặng, nhanh giữa, êm cuối chặng
                    tSmooth = SmoothStepQuintic(tRaw)
            End Select

            Dim eye As Vec3 = rail.EvaluateEye(tSmooth)
            Dim targetPt As Vec3 = rail.EvaluateTarget(tSmooth)

            Dim effFOVStart As Double = If(fromPrevEye IsNot Nothing, s01.FOVEnd, s02.FOVStart)
            Dim curFOV As Double = effFOVStart + (s02.FOVEnd - effFOVStart) * tSmooth
            Dim effBankStart As Double = If(fromPrevEye IsNot Nothing, 0.0, s02.BankStart)
            Dim curBankDeg As Double = effBankStart + (s02.BankEnd - effBankStart) * tSmooth
            Dim bankRad As Double = curBankDeg * Math.PI / 180.0

            Dim forward As Vec3 = (targetPt - eye).Normalize()
            Dim worldUp As New Vec3(0, 1, 0)
            Dim camRight As Vec3 = worldUp.Cross(forward).Normalize()
            If camRight.Length() < 1E-6 Then camRight = New Vec3(1, 0, 0)
            Dim camUp0 As Vec3 = forward.Cross(camRight).Normalize()
            Dim rolledUp As Vec3 = camUp0 * Math.Cos(bankRad) + camRight * Math.Sin(bankRad)

            lastEye = eye : lastTarget = targetPt : lastUp = rolledUp : lastFOV = curFOV

            oCam.Eye = tg.CreatePoint(eye.X, eye.Y, eye.Z)
            oCam.Target = tg.CreatePoint(targetPt.X, targetPt.Y, targetPt.Z)
            oCam.UpVector = tg.CreateUnitVector(rolledUp.X, rolledUp.Y, rolledUp.Z)
            oCam.PerspectiveAngle = curFOV * Math.PI / 180.0
            oCam.ApplyWithoutTransition()

            If exportCtx IsNot Nothing AndAlso exportCtx.IsExporting Then
                CaptureVideoFrame(oCam, exportCtx, oApp)
                SafeYield(2)
            Else
                If s02.RunMode = "PREVIEW" Then
                    System.Threading.Thread.Sleep(CInt(1000.0 / s02.FPS))
                    System.Windows.Forms.Application.DoEvents()
                End If
            End If
        Next

        ' Pha 2: Dừng ngắm tại vị trí xa
        If s02.HoldSeconds > 0.0 Then
            Dim holdFrames As Integer = Math.Max(1, CInt(s02.HoldSeconds * s02.FPS))
            For frame As Integer = 0 To holdFrames
                If CheckEscapeKey() Then
                    MessageBox.Show("Đã dừng Cảnh 2 (Phím ESC)", "WT3D WhipCam", MessageBoxButtons.OK, MessageBoxIcon.Information)
                    Return False
                End If
                If exportCtx IsNot Nothing AndAlso exportCtx.IsExporting Then
                    CaptureVideoFrame(oCam, exportCtx, oApp)
                    SafeYield(2)
                Else
                    If s02.RunMode = "PREVIEW" Then
                        System.Threading.Thread.Sleep(CInt(1000.0 / s02.FPS))
                        System.Windows.Forms.Application.DoEvents()
                    End If
                End If
            Next
        End If

        outLastEye = lastEye : outLastTarget = lastTarget : outLastUp = lastUp : outLastFOV = lastFOV
        Return True
    End Function

    Public Function ExecuteShot03(ByVal oDoc As Document, ByVal s03 As Shot03Settings, ByVal s02 As Shot02Settings, ByVal s01 As Shot01Settings, ByVal model As ModelInfo, ByVal heroes As Dictionary(Of String, HeroTarget), _
                                  Optional ByVal fromPrevEye As Vec3 = Nothing, _
                                  Optional ByVal fromPrevTarget As Vec3 = Nothing, _
                                  Optional ByRef outLastEye As Vec3 = Nothing, _
                                  Optional ByRef outLastTarget As Vec3 = Nothing, _
                                  Optional ByRef outLastUp As Vec3 = Nothing, _
                                  Optional ByRef outLastFOV As Double = 50.0, _
                                  Optional ByVal exportCtx As VideoExportContext = Nothing) As Boolean
        Dim oApp As Inventor.Application = oDoc.Parent
        Dim oView As Inventor.View = oApp.ActiveView
        Dim oCam As Inventor.Camera = oView.Camera
        Dim tg As TransientGeometry = oApp.TransientGeometry

        Dim rail As New RailShot03()
        rail.Build(model, heroes, s03, fromPrevEye, fromPrevTarget)

        Dim effectiveDur As Double = s03.DurationSeconds / Math.Max(0.05, s03.SpeedMultiplier)
        Dim totalFrames As Integer = Math.Max(10, CInt(effectiveDur * s03.FPS))

        oCam.Perspective = True

        Dim lastEye As Vec3 = rail.EyeStart
        Dim lastTarget As Vec3 = rail.CenterFocus
        Dim lastUp As New Vec3(0, 1, 0)
        Dim lastFOV As Double = 50.0

        For frame As Integer = 0 To totalFrames
            If CheckEscapeKey() Then
                MessageBox.Show("Đã dừng Cảnh 3 (Phím ESC)", "WT3D WhipCam", MessageBoxButtons.OK, MessageBoxIcon.Information)
                Return False
            End If

            Dim tRaw As Double = CDbl(frame) / CDbl(totalFrames)
            Dim tSmooth As Double
            Select Case s03.EasingMode
                Case "EASE_OUT"
                    tSmooth = 1.0 - Math.Pow(1.0 - tRaw, 3.0)
                Case "EASE_IN"
                    tSmooth = Math.Pow(tRaw, 3.0)
                Case "LINEAR"
                    tSmooth = tRaw
                Case Else
                    tSmooth = SmoothStepQuintic(tRaw)
            End Select

            Dim curBankDeg As Double = 0.0
            Dim eye As Vec3 = rail.EvaluateEye(tSmooth, model, s03, curBankDeg)
            Dim targetPt As Vec3 = rail.EvaluateTarget(tSmooth)

            Dim bankRad As Double = curBankDeg * Math.PI / 180.0
            Dim forward As Vec3 = (targetPt - eye).Normalize()
            Dim worldUp As New Vec3(0, 1, 0)
            Dim camRight As Vec3 = worldUp.Cross(forward).Normalize()
            If camRight.Length() < 1E-6 Then camRight = New Vec3(1, 0, 0)
            Dim camUp0 As Vec3 = forward.Cross(camRight).Normalize()
            Dim rolledUp As Vec3 = camUp0 * Math.Cos(bankRad) + camRight * Math.Sin(bankRad)

            Dim effFOV As Double = If(fromPrevEye IsNot Nothing, s02.FOVEnd, 50.0)
            lastEye = eye : lastTarget = targetPt : lastUp = rolledUp : lastFOV = effFOV

            oCam.Eye = tg.CreatePoint(eye.X, eye.Y, eye.Z)
            oCam.Target = tg.CreatePoint(targetPt.X, targetPt.Y, targetPt.Z)
            oCam.UpVector = tg.CreateUnitVector(rolledUp.X, rolledUp.Y, rolledUp.Z)
            oCam.PerspectiveAngle = effFOV * Math.PI / 180.0
            oCam.ApplyWithoutTransition()

            If exportCtx IsNot Nothing AndAlso exportCtx.IsExporting Then
                CaptureVideoFrame(oCam, exportCtx, oApp)
                SafeYield(2)
            Else
                If s03.RunMode = "PREVIEW" Then
                    System.Threading.Thread.Sleep(CInt(1000.0 / s03.FPS))
                    System.Windows.Forms.Application.DoEvents()
                End If
            End If
        Next

        If s03.HoldSeconds > 0.0 Then
            Dim holdFrames As Integer = Math.Max(1, CInt(s03.HoldSeconds * s03.FPS))
            For frame As Integer = 0 To holdFrames
                If CheckEscapeKey() Then
                    MessageBox.Show("Đã dừng Cảnh 3 (Phím ESC)", "WT3D WhipCam", MessageBoxButtons.OK, MessageBoxIcon.Information)
                    Return False
                End If
                If exportCtx IsNot Nothing AndAlso exportCtx.IsExporting Then
                    CaptureVideoFrame(oCam, exportCtx, oApp)
                    SafeYield(2)
                Else
                    If s03.RunMode = "PREVIEW" Then
                        System.Threading.Thread.Sleep(CInt(1000.0 / s03.FPS))
                        System.Windows.Forms.Application.DoEvents()
                    End If
                End If
            Next
        End If

        outLastEye = lastEye : outLastTarget = lastTarget : outLastUp = lastUp : outLastFOV = lastFOV
        Return True
    End Function

    ' --------------------------------------------------------------------------
    ' 6.4. ENGINE THI CÔNG CẢNH 4: POLYGON SNAP-ORBIT & MULTI-POINT MACRO ZOOM
    ' --------------------------------------------------------------------------
    Public Function ExecuteShot04(ByVal oDoc As Document, ByVal s04 As Shot04Settings, ByVal s03 As Shot03Settings, ByVal s02 As Shot02Settings, ByVal s01 As Shot01Settings, ByVal model As ModelInfo, ByVal heroes As Dictionary(Of String, HeroTarget), _
                                  Optional ByVal fromPrevEye As Vec3 = Nothing, _
                                  Optional ByVal fromPrevTarget As Vec3 = Nothing, _
                                  Optional ByRef outLastEye As Vec3 = Nothing, _
                                  Optional ByRef outLastTarget As Vec3 = Nothing, _
                                  Optional ByRef outLastUp As Vec3 = Nothing, _
                                  Optional ByRef outLastFOV As Double = 50.0, _
                                  Optional ByVal exportCtx As VideoExportContext = Nothing) As Boolean
        Dim oApp As Inventor.Application = oDoc.Parent
        Dim oView As Inventor.View = oApp.ActiveView
        Dim oCam As Inventor.Camera = oView.Camera
        Dim tg As TransientGeometry = oApp.TransientGeometry

        Dim C As Vec3 = model.Center
        Dim RU As Double = model.RU
        Dim RV As Double = model.RV
        Dim RH As Double = model.RH
        Dim baseR As Double = Math.Sqrt(RU * RU + RV * RV)

        ' 1. Xác định danh sách các điểm mục tiêu (Targets)
        Dim targets As New List(Of Vec3)()
        Dim targetNames As New List(Of String)()

        If s04.PointsMode = "CUSTOM_PICK" AndAlso s04.CustomPickPoints.Count >= 2 Then
            For idx As Integer = 0 To s04.CustomPickPoints.Count - 1
                targets.Add(s04.CustomPickPoints(idx))
                targetNames.Add("Điểm chọn #" & (idx + 1).ToString())
            Next
        ElseIf s04.PointsMode = "3_POINTS" Then
            ' 3 Điểm chính: Bơm -> Màng RO/UF -> Tủ điện
            Dim tPump As Vec3 = If(heroes.ContainsKey("PUMP") AndAlso heroes("PUMP").Found, heroes("PUMP").Center, C + New Vec3(-0.35 * RU, -0.15 * RH, -0.35 * RV))
            Dim tMem As Vec3 = If(heroes.ContainsKey("MEMBRANE") AndAlso heroes("MEMBRANE").Found, heroes("MEMBRANE").Center, C + New Vec3(0.35 * RU, 0.20 * RH, 0.35 * RV))
            Dim tPanel As Vec3 = If(heroes.ContainsKey("PANEL") AndAlso heroes("PANEL").Found, heroes("PANEL").Center, C + New Vec3(-0.35 * RU, 0.10 * RH, 0.35 * RV))
            targets.Add(tPump) : targetNames.Add("Cụm Bơm Cao Áp")
            targets.Add(tMem) : targetNames.Add("Cụm Màng Lọc RO/UF")
            targets.Add(tPanel) : targetNames.Add("Tủ Điện Điều Khiển PLC")
        Else
            ' 4 Điểm TVC High-Tech: Bơm -> Đồng hồ áp -> Màng RO/UF -> Tủ điện
            Dim tPump As Vec3 = If(heroes.ContainsKey("PUMP") AndAlso heroes("PUMP").Found, heroes("PUMP").Center, C + New Vec3(-0.35 * RU, -0.15 * RH, -0.35 * RV))
            Dim tGauge As Vec3 = C + New Vec3(0.35 * RU, 0.0 * RH, -0.35 * RV)
            Dim tMem As Vec3 = If(heroes.ContainsKey("MEMBRANE") AndAlso heroes("MEMBRANE").Found, heroes("MEMBRANE").Center, C + New Vec3(0.35 * RU, 0.20 * RH, 0.35 * RV))
            Dim tPanel As Vec3 = If(heroes.ContainsKey("PANEL") AndAlso heroes("PANEL").Found, heroes("PANEL").Center, C + New Vec3(-0.35 * RU, 0.10 * RH, 0.35 * RV))
            targets.Add(tPump) : targetNames.Add("Cụm Bơm Cao Áp")
            targets.Add(tGauge) : targetNames.Add("Cụm Đồng Hồ & Van Tự Động")
            targets.Add(tMem) : targetNames.Add("Cụm Màng Lọc RO/UF")
            targets.Add(tPanel) : targetNames.Add("Tủ Điện Điều Khiển PLC")
        End If

        Dim numStages As Integer = targets.Count
        If numStages < 2 Then
            MessageBox.Show("Cần ít nhất 2 điểm mục tiêu cho Cảnh 4.", "WT3D WhipCam", MessageBoxButtons.OK, MessageBoxIcon.Warning)
            Return False
        End If

        ' 2. Tính toán Hướng Tiếp Cận & Các Đỉnh Đa Giác (Approach Vectors & Dynamic Polygon Nodes)
        Dim orbitR As Double = baseR * s04.OrbitDistanceScale
        Dim nearDist As Double = Math.Max(15.0, baseR * s04.ZoomDollyScale)

        Dim polyNodes As New List(Of Vec3)()
        Dim zoomInEyes As New List(Of Vec3)()
        Dim approachDirs As New List(Of Vec3)()

        For i As Integer = 0 To numStages - 1
            Dim curTgt As Vec3 = targets(i)
            Dim dirToHero As Vec3 = Nothing

            Select Case s04.ApproachMode
                Case "RECORDED_VIEW"
                    ' Ưu tiên lấy theo vector góc nhìn đã ghi nhận lúc người dùng click chọn điểm
                    If s04.PointsMode = "CUSTOM_PICK" AndAlso i < s04.CustomApproachVectors.Count AndAlso s04.CustomApproachVectors(i) IsNot Nothing Then
                        dirToHero = s04.CustomApproachVectors(i)
                    Else
                        Dim oCamNow As Inventor.Camera = oView.Camera
                        dirToHero = (New Vec3(oCamNow.Eye.X, oCamNow.Eye.Y, oCamNow.Eye.Z) - New Vec3(oCamNow.Target.X, oCamNow.Target.Y, oCamNow.Target.Z)).Normalize()
                    End If

                Case "ISOMETRIC_FL"
                    dirToHero = New Vec3(-0.7071, 0.5, -0.7071).Normalize()

                Case "ISOMETRIC_FR"
                    dirToHero = New Vec3(0.7071, 0.5, -0.7071).Normalize()

                Case "FRONT_LOOK"
                    dirToHero = New Vec3(0.0, 0.35, -1.0).Normalize()

                Case "TOP_DOWN"
                    dirToHero = New Vec3(0.0, 1.0, -0.2).Normalize()

                Case Else ' "AUTO_EXTERIOR" (Mặc định thông minh theo vị trí chi tiết trên mô hình)
                    Dim dx As Double = curTgt.X - C.X
                    Dim dz As Double = curTgt.Z - C.Z
                    Dim absDx As Double = Math.Abs(dx)
                    Dim absDz As Double = Math.Abs(dz)

                    Dim outX As Double = 0.0
                    Dim outZ As Double = 0.0

                    If absDz >= absDx * 0.6 Then
                        outZ = If(dz < 0, -1.0, 1.0)
                    End If
                    If absDx >= absDz * 0.6 Then
                        outX = If(dx < 0, -1.0, 1.0)
                    End If
                    If Math.Abs(outX) < 1E-4 AndAlso Math.Abs(outZ) < 1E-4 Then
                        outZ = -1.0
                    End If

                    Dim elRad As Double = Math.Max(0.0, s04.ElevationDeg) * Math.PI / 180.0
                    If elRad < 0.08 Then elRad = 0.20 ' ~12 độ nâng nhẹ để nhìn khối 3D rõ nét
                    Dim outY As Double = Math.Sin(elRad)
                    Dim horizScale As Double = Math.Cos(elRad)
                    dirToHero = New Vec3(outX * horizScale, outY, outZ * horizScale).Normalize()
            End Select

            If dirToHero Is Nothing OrElse dirToHero.Length() < 1E-5 Then
                dirToHero = New Vec3(-0.7071, 0.5, -0.7071).Normalize()
            End If

            approachDirs.Add(dirToHero)

            ' Vị trí phóng zoom cận cảnh (Macro Zoom-In Position)
            Dim zEye As Vec3 = curTgt + dirToHero * nearDist
            zoomInEyes.Add(zEye)

            ' Đỉnh ngoài đa giác tương ứng: nằm ngay trên trục tiếp cận ở cự ly orbitR
            Dim pNode As Vec3 = curTgt + dirToHero * orbitR
            polyNodes.Add(pNode)
        Next

        ' 3. Thiết lập thông số thời lượng & khung hình
        Dim effectiveDur As Double = s04.DurationSeconds / Math.Max(0.05, s04.SpeedMultiplier)
        Dim totalFrames As Integer = Math.Max(20, CInt(effectiveDur * s04.FPS))
        Dim framesPerStage As Integer = Math.Max(6, CInt(totalFrames / CDbl(numStages)))

        oCam.Perspective = True

        Dim lastEye As Vec3 = If(fromPrevEye IsNot Nothing, fromPrevEye, polyNodes(0))
        Dim lastTarget As Vec3 = If(fromPrevTarget IsNot Nothing, fromPrevTarget, targets(0))
        Dim lastUp As New Vec3(0, 1, 0)
        Dim lastFOV As Double = s04.NormalFOV

        Dim totalFramesRun As Integer = 0

        ' 4. Thực thi từng chặng đa giác (Stage-by-Stage Staccato Zoom)
        For stage As Integer = 0 To numStages - 1
            Dim curTarget As Vec3 = targets(stage)
            Dim curPolyNode As Vec3 = polyNodes(stage)
            Dim zoomInEye As Vec3 = zoomInEyes(stage)
            Dim dirToHero As Vec3 = approachDirs(stage)
            Dim prevPolyNode As Vec3 = If(stage = 0, (If(fromPrevEye IsNot Nothing, fromPrevEye, polyNodes(numStages - 1))), polyNodes(stage - 1))
            Dim stageStartTarget As Vec3 = If(stage = 0, (If(fromPrevTarget IsNot Nothing, fromPrevTarget, targets(0))), targets(stage - 1))

            ' --- PHA A: TIẾP CẬN & LAO VÀO PHÓNG ZOOM (Glide & Punch-In) ---
            Dim framesIn As Integer = Math.Max(4, CInt(framesPerStage * 0.60))
            For f As Integer = 0 To framesIn
                If CheckEscapeKey() Then
                    MessageBox.Show("Đã dừng Cảnh 4 (Phím ESC)", "WT3D WhipCam", MessageBoxButtons.OK, MessageBoxIcon.Information)
                    Return False
                End If

                Dim u As Double = CDbl(f) / CDbl(framesIn)
                Dim eye As Vec3
                Dim targetPt As Vec3
                Dim curFOV As Double = s04.NormalFOV
                Dim curBankDeg As Double = 0.0

                If u < 0.55 Then
                    ' 1. Lướt từ đỉnh đa giác trước sang đỉnh hiện tại (Nội suy mượt mà C2)
                    Dim w As Double = u / 0.55
                    Dim ws As Double = SmoothStepQuintic(w)
                    eye = Vec3.Lerp(prevPolyNode, curPolyNode, ws)
                    targetPt = Vec3.Lerp(stageStartTarget, curTarget, ws)
                    Dim baseFOV As Double = If(stage = 0 AndAlso fromPrevEye IsNot Nothing, 50.0, s04.NormalFOV)
                    curFOV = baseFOV + (s04.NormalFOV - baseFOV) * ws
                    curBankDeg = s04.BankApex * Math.Sin(Math.PI * ws)
                Else
                    ' 2. Punch-In lao thẳng vào chi tiết theo đúng hướng tiếp cận
                    Dim w As Double = (u - 0.55) / 0.45
                    Dim ws As Double = SmoothStepQuintic(w)
                    eye = Vec3.Lerp(curPolyNode, zoomInEye, ws)
                    targetPt = curTarget
                    curFOV = s04.NormalFOV + (s04.ZoomFOV - s04.NormalFOV) * ws
                    curBankDeg = s04.BankApex * (1.0 - ws)
                End If

                Dim bankRad As Double = curBankDeg * Math.PI / 180.0
                Dim forward As Vec3 = (targetPt - eye).Normalize()
                Dim worldUp As New Vec3(0, 1, 0)
                Dim camRight As Vec3 = worldUp.Cross(forward).Normalize()
                If camRight.Length() < 1E-6 Then camRight = New Vec3(1, 0, 0)
                Dim camUp0 As Vec3 = forward.Cross(camRight).Normalize()
                Dim rolledUp As Vec3 = camUp0 * Math.Cos(bankRad) + camRight * Math.Sin(bankRad)

                lastEye = eye : lastTarget = targetPt : lastUp = rolledUp : lastFOV = curFOV

                oCam.Eye = tg.CreatePoint(eye.X, eye.Y, eye.Z)
                oCam.Target = tg.CreatePoint(targetPt.X, targetPt.Y, targetPt.Z)
                oCam.UpVector = tg.CreateUnitVector(rolledUp.X, rolledUp.Y, rolledUp.Z)
                oCam.PerspectiveAngle = curFOV * Math.PI / 180.0
                oCam.ApplyWithoutTransition()

                totalFramesRun += 1
                If exportCtx IsNot Nothing AndAlso exportCtx.IsExporting Then
                    CaptureVideoFrame(oCam, exportCtx, oApp)
                    SafeYield(2)
                Else
                    If s04.RunMode = "PREVIEW" Then
                        System.Threading.Thread.Sleep(CInt(1000.0 / s04.FPS))
                        System.Windows.Forms.Application.DoEvents()
                    End If
                End If
            Next

            ' --- PHA B: DỪNG NGẮM TĨNH CÓ HIỆU LỰC CHÍNH XÁC (Hold Loop) ---
            If s04.MicroHoldSeconds > 0.0 Then
                Dim holdFrames As Integer = Math.Max(1, CInt(s04.MicroHoldSeconds * s04.FPS))
                For hf As Integer = 0 To holdFrames
                    If CheckEscapeKey() Then
                        MessageBox.Show("Đã dừng Cảnh 4 (Phím ESC)", "WT3D WhipCam", MessageBoxButtons.OK, MessageBoxIcon.Information)
                        Return False
                    End If

                    Dim hw As Double = CDbl(hf) / CDbl(holdFrames)
                    ' Vi trôi siêu nhẹ 0.6cm sống động
                    Dim microDrift As Vec3 = dirToHero * (Math.Sin(hw * Math.PI) * 0.6)
                    Dim hEye As Vec3 = zoomInEye + microDrift

                    Dim forward As Vec3 = (curTarget - hEye).Normalize()
                    Dim worldUp As New Vec3(0, 1, 0)
                    Dim camRight As Vec3 = worldUp.Cross(forward).Normalize()
                    If camRight.Length() < 1E-6 Then camRight = New Vec3(1, 0, 0)
                    Dim camUp0 As Vec3 = forward.Cross(camRight).Normalize()

                    lastEye = hEye : lastTarget = curTarget : lastUp = camUp0 : lastFOV = s04.ZoomFOV

                    oCam.Eye = tg.CreatePoint(hEye.X, hEye.Y, hEye.Z)
                    oCam.Target = tg.CreatePoint(curTarget.X, curTarget.Y, curTarget.Z)
                    oCam.UpVector = tg.CreateUnitVector(camUp0.X, camUp0.Y, camUp0.Z)
                    oCam.PerspectiveAngle = s04.ZoomFOV * Math.PI / 180.0
                    oCam.ApplyWithoutTransition()

                    totalFramesRun += 1
                    If exportCtx IsNot Nothing AndAlso exportCtx.IsExporting Then
                        CaptureVideoFrame(oCam, exportCtx, oApp)
                        SafeYield(2)
                    Else
                        If s04.RunMode = "PREVIEW" Then
                            System.Threading.Thread.Sleep(CInt(1000.0 / s04.FPS))
                            System.Windows.Forms.Application.DoEvents()
                        End If
                    End If
                Next
            End If

            ' --- PHA C: SNAP PULL-BACK GIẬT LÙI BUNG RA NGOÀI (Pull-Back) ---
            Dim framesOut As Integer = Math.Max(3, CInt(framesPerStage * 0.40))
            For f As Integer = 0 To framesOut
                If CheckEscapeKey() Then
                    MessageBox.Show("Đã dừng Cảnh 4 (Phím ESC)", "WT3D WhipCam", MessageBoxButtons.OK, MessageBoxIcon.Information)
                    Return False
                End If

                Dim u As Double = CDbl(f) / CDbl(framesOut)
                Dim ws As Double = SmoothStepQuintic(u)

                Dim eye As Vec3 = Vec3.Lerp(zoomInEye, curPolyNode, ws)
                Dim targetPt As Vec3 = curTarget
                Dim curFOV As Double = s04.ZoomFOV + (s04.NormalFOV - s04.ZoomFOV) * ws

                Dim forward As Vec3 = (targetPt - eye).Normalize()
                Dim worldUp As New Vec3(0, 1, 0)
                Dim camRight As Vec3 = worldUp.Cross(forward).Normalize()
                If camRight.Length() < 1E-6 Then camRight = New Vec3(1, 0, 0)
                Dim camUp0 As Vec3 = forward.Cross(camRight).Normalize()

                lastEye = eye : lastTarget = targetPt : lastUp = camUp0 : lastFOV = curFOV

                oCam.Eye = tg.CreatePoint(eye.X, eye.Y, eye.Z)
                oCam.Target = tg.CreatePoint(targetPt.X, targetPt.Y, targetPt.Z)
                oCam.UpVector = tg.CreateUnitVector(camUp0.X, camUp0.Y, camUp0.Z)
                oCam.PerspectiveAngle = curFOV * Math.PI / 180.0
                oCam.ApplyWithoutTransition()

                totalFramesRun += 1
                If exportCtx IsNot Nothing AndAlso exportCtx.IsExporting Then
                    CaptureVideoFrame(oCam, exportCtx, oApp)
                    SafeYield(2)
                Else
                    If s04.RunMode = "PREVIEW" Then
                        System.Threading.Thread.Sleep(CInt(1000.0 / s04.FPS))
                        System.Windows.Forms.Application.DoEvents()
                    End If
                End If
            Next
        Next

        outLastEye = lastEye
        outLastTarget = lastTarget
        outLastUp = lastUp
        outLastFOV = lastFOV

        Return True
    End Function

    ' --------------------------------------------------------------------------
    ' 6.5. ENGINE THI CÔNG CẢNH 5: HELICAL ORBIT FLY-AROUND -> HERO HOLD -> GRAND ESCAPE
    ' --------------------------------------------------------------------------
    Public Function ExecuteShot05(ByVal oDoc As Document, ByVal s05 As Shot05Settings, ByVal s04 As Shot04Settings, ByVal s03 As Shot03Settings, ByVal s02 As Shot02Settings, ByVal s01 As Shot01Settings, ByVal model As ModelInfo, ByVal heroes As Dictionary(Of String, HeroTarget), _
                                  Optional ByVal fromPrevEye As Vec3 = Nothing, _
                                  Optional ByVal fromPrevTarget As Vec3 = Nothing, _
                                  Optional ByRef outLastEye As Vec3 = Nothing, _
                                  Optional ByRef outLastTarget As Vec3 = Nothing, _
                                  Optional ByRef outLastUp As Vec3 = Nothing, _
                                  Optional ByRef outLastFOV As Double = 50.0, _
                                  Optional ByVal exportCtx As VideoExportContext = Nothing) As Boolean
        Dim oApp As Inventor.Application = oDoc.Parent
        Dim oView As Inventor.View = oApp.ActiveView
        Dim oCam As Inventor.Camera = oView.Camera
        Dim tg As TransientGeometry = oApp.TransientGeometry

        Dim C As Vec3 = model.Center
        Dim RU As Double = model.RU
        Dim RV As Double = model.RV
        Dim RH As Double = model.RH
        Dim baseR As Double = Math.Sqrt(RU * RU + RV * RV)

        ' 1. Xác định vị trí Hero tâm điểm kết thúc
        Dim heroTargetPt As Vec3
        If s05.FocusHeroKey = "LAST_PICK" AndAlso s04.CustomPickPoints.Count > 0 Then
            heroTargetPt = s04.CustomPickPoints(s04.CustomPickPoints.Count - 1)
        ElseIf s05.FocusHeroKey = "CENTER" Then
            heroTargetPt = C
        ElseIf s05.FocusHeroKey = "PUMP" AndAlso heroes.ContainsKey("PUMP") AndAlso heroes("PUMP").Found Then
            heroTargetPt = heroes("PUMP").Center
        ElseIf s05.FocusHeroKey = "MEMBRANE" AndAlso heroes.ContainsKey("MEMBRANE") AndAlso heroes("MEMBRANE").Found Then
            heroTargetPt = heroes("MEMBRANE").Center
        ElseIf s05.FocusHeroKey = "PANEL" AndAlso heroes.ContainsKey("PANEL") AndAlso heroes("PANEL").Found Then
            heroTargetPt = heroes("PANEL").Center
        Else
            heroTargetPt = C
        End If

        ' 2. Thiết lập Điểm Xuất Phát & Góc 3/4 (Corner 3/4 & Orbit Parameters)
        Dim orbitR As Double = baseR * Math.Max(0.5, s05.OrbitRadiusScale)
        Dim elevRad As Double = s05.ElevationDeg * Math.PI / 180.0
        Dim camYOffset As Double = orbitR * Math.Tan(elevRad)

        Dim ptStart As Vec3 = Nothing

        ' Trong Master Showreel (hoặc khi nối cảnh): Bắt buộc kế thừa 100% tọa độ từ cảnh trước để tuyệt đối không nhảy giật
        If fromPrevEye IsNot Nothing Then
            ptStart = fromPrevEye
        ElseIf s05.StartCornerMode = "CURRENT_VIEW" Then
            Dim curCamNow As Inventor.Camera = oView.Camera
            ptStart = New Vec3(curCamNow.Eye.X, curCamNow.Eye.Y, curCamNow.Eye.Z)
        Else
            ' Tính tọa độ 4 góc 3/4 chuẩn công nghiệp
            Dim cornerAngDeg As Double = -135.0 ' Mặc định Góc 1: Trước - Trái (-X, -Z)
            Select Case s05.StartCornerMode
                Case "FRONT_RIGHT" : cornerAngDeg = -45.0  ' Góc 2: Trước - Phải (+X, -Z)
                Case "BACK_RIGHT"  : cornerAngDeg = 45.0   ' Góc 3: Sau - Phải (+X, +Z)
                Case "BACK_LEFT"   : cornerAngDeg = 135.0  ' Góc 4: Sau - Trái (-X, +Z)
                Case Else          : cornerAngDeg = -135.0 ' Góc 1: Trước - Trái (-X, -Z)
            End Select
            Dim cornerRad As Double = cornerAngDeg * Math.PI / 180.0
            ptStart = New Vec3(C.X + orbitR * Math.Cos(cornerRad), C.Y + camYOffset, C.Z + orbitR * Math.Sin(cornerRad))
        End If

        Dim startR As Double = Math.Sqrt((ptStart.X - C.X) * (ptStart.X - C.X) + (ptStart.Z - C.Z) * (ptStart.Z - C.Z))
        If startR < 10.0 Then startR = orbitR

        Dim theta0 As Double = Math.Atan2(ptStart.Z - C.Z, ptStart.X - C.X)
        Dim dirSign As Double = If(s05.OrbitDirection = "CW", -1.0, 1.0)
        Dim sweepRad As Double = dirSign * (s05.OrbitSweepDeg * Math.PI / 180.0)

        ' Bán kính lướt quỹ đạo xoay quanh mô hình
        Dim passR As Double = orbitR

        ' Điểm dừng ngắm Hero (ptHoldEye) tại cuối vòng xoay
        Dim holdAngle As Double = theta0 + sweepRad
        Dim ptHoldEye As Vec3 = heroTargetPt + New Vec3(Math.Cos(holdAngle), 0.35, Math.Sin(holdAngle)).Normalize() * (baseR * Math.Max(0.5, s05.ClosePassScale))

        ' Điểm thoát ly Grand Escape (ptEscapeEye): lùi vút ra xa theo hướng mở rộng
        Dim escapeDir As Vec3 = (ptHoldEye - C).Normalize()
        If escapeDir.Length() < 1E-5 Then escapeDir = New Vec3(-0.7071, 0.5, -0.7071).Normalize()
        Dim ptEscapeEye As Vec3 = C + escapeDir * (baseR * s05.EscapeDistanceScale) + New Vec3(0, s05.EscapeClimbScale * RH, 0)

        ' 3. Thiết lập khung hình
        Dim effectiveDur As Double = s05.DurationSeconds / Math.Max(0.05, s05.SpeedMultiplier)
        Dim totalFrames As Integer = Math.Max(30, CInt(effectiveDur * s05.FPS))

        oCam.Perspective = True

        Dim lastEye As Vec3 = ptStart
        Dim startTarget As Vec3 = If(fromPrevTarget IsNot Nothing, fromPrevTarget, C)
        Dim lastTarget As Vec3 = startTarget
        Dim lastUp As New Vec3(0, 1, 0)
        Dim startFOV As Double = If(fromPrevEye IsNot Nothing, s04.NormalFOV, 52.0)
        Dim lastFOV As Double = startFOV

        ' --- GIAI ĐOẠN 1: HELICAL FLY-AROUND ORBIT (Bay lượn xoay vòng quanh mô hình) ---
        Dim orbitFrames As Integer = Math.Max(15, CInt(totalFrames * 0.65))
        For frame As Integer = 0 To orbitFrames
            If CheckEscapeKey() Then
                MessageBox.Show("Đã dừng Cảnh 5 (Phím ESC)", "WT3D WhipCam", MessageBoxButtons.OK, MessageBoxIcon.Information)
                Return False
            End If

            Dim u As Double = CDbl(frame) / CDbl(orbitFrames)
            Dim ws As Double = SmoothStepQuintic(u)

            Dim curTheta As Double = theta0 + sweepRad * ws
            Dim curR As Double = startR + (passR - startR) * ws
            Dim curX As Double = C.X + curR * Math.Cos(curTheta)
            Dim curZ As Double = C.Z + curR * Math.Sin(curTheta)
            Dim curY As Double = ptStart.Y + (heroTargetPt.Y + 0.30 * RH - ptStart.Y) * ws + Math.Sin(ws * Math.PI) * (0.25 * RH)

            Dim eye As New Vec3(curX, curY, curZ)
            Dim targetPt As Vec3 = Vec3.Lerp(startTarget, heroTargetPt, ws)
            Dim curFOV As Double = startFOV + (s05.HeroFOV - startFOV) * ws
            Dim curBankDeg As Double = dirSign * s05.BankWhipDeg * Math.Sin(ws * Math.PI * 2.0)

            Dim bankRad As Double = curBankDeg * Math.PI / 180.0
            Dim forward As Vec3 = (targetPt - eye).Normalize()
            Dim worldUp As New Vec3(0, 1, 0)
            Dim camRight As Vec3 = worldUp.Cross(forward).Normalize()
            If camRight.Length() < 1E-6 Then camRight = New Vec3(1, 0, 0)
            Dim camUp0 As Vec3 = forward.Cross(camRight).Normalize()
            Dim rolledUp As Vec3 = camUp0 * Math.Cos(bankRad) + camRight * Math.Sin(bankRad)

            lastEye = eye : lastTarget = targetPt : lastUp = rolledUp : lastFOV = curFOV

            oCam.Eye = tg.CreatePoint(eye.X, eye.Y, eye.Z)
            oCam.Target = tg.CreatePoint(targetPt.X, targetPt.Y, targetPt.Z)
            oCam.UpVector = tg.CreateUnitVector(rolledUp.X, rolledUp.Y, rolledUp.Z)
            oCam.PerspectiveAngle = curFOV * Math.PI / 180.0
            oCam.ApplyWithoutTransition()

            If exportCtx IsNot Nothing AndAlso exportCtx.IsExporting Then
                CaptureVideoFrame(oCam, exportCtx, oApp)
                SafeYield(2)
            Else
                If s05.RunMode = "PREVIEW" Then
                    System.Threading.Thread.Sleep(CInt(1000.0 / s05.FPS))
                    System.Windows.Forms.Application.DoEvents()
                End If
            End If
        Next

        ' --- GIAI ĐOẠN 2: DỪNG NGẮM HERO CÓ HIỆU LỰC CHÍNH XÁC (Dedicated Hold Loop) ---
        If s05.HeroHoldSec > 0.0 Then
            Dim holdFrames As Integer = Math.Max(1, CInt(s05.HeroHoldSec * s05.FPS))
            For hf As Integer = 0 To holdFrames
                If CheckEscapeKey() Then
                    MessageBox.Show("Đã dừng Cảnh 5 (Phím ESC)", "WT3D WhipCam", MessageBoxButtons.OK, MessageBoxIcon.Information)
                    Return False
                End If

                Dim hw As Double = CDbl(hf) / CDbl(holdFrames)
                Dim drift As New Vec3(Math.Sin(hw * Math.PI) * 0.5, 0, Math.Cos(hw * Math.PI) * 0.5)
                Dim hEye As Vec3 = ptHoldEye + drift

                Dim forward As Vec3 = (heroTargetPt - hEye).Normalize()
                Dim worldUp As New Vec3(0, 1, 0)
                Dim camRight As Vec3 = worldUp.Cross(forward).Normalize()
                If camRight.Length() < 1E-6 Then camRight = New Vec3(1, 0, 0)
                Dim camUp0 As Vec3 = forward.Cross(camRight).Normalize()

                lastEye = hEye : lastTarget = heroTargetPt : lastUp = camUp0 : lastFOV = s05.HeroFOV

                oCam.Eye = tg.CreatePoint(hEye.X, hEye.Y, hEye.Z)
                oCam.Target = tg.CreatePoint(heroTargetPt.X, heroTargetPt.Y, heroTargetPt.Z)
                oCam.UpVector = tg.CreateUnitVector(camUp0.X, camUp0.Y, camUp0.Z)
                oCam.PerspectiveAngle = s05.HeroFOV * Math.PI / 180.0
                oCam.ApplyWithoutTransition()

                If exportCtx IsNot Nothing AndAlso exportCtx.IsExporting Then
                    CaptureVideoFrame(oCam, exportCtx, oApp)
                    SafeYield(2)
                Else
                    If s05.RunMode = "PREVIEW" Then
                        System.Threading.Thread.Sleep(CInt(1000.0 / s05.FPS))
                        System.Windows.Forms.Application.DoEvents()
                    End If
                End If
            Next
        End If

        ' --- GIAI ĐOẠN 3: GRAND ESCAPE REVEAL (Bứt tốc thoát ly lùi ra xa & Bốc đầu) ---
        Dim escapeFrames As Integer = Math.Max(10, CInt(totalFrames * 0.35))
        For frame As Integer = 0 To escapeFrames
            If CheckEscapeKey() Then
                MessageBox.Show("Đã dừng Cảnh 5 (Phím ESC)", "WT3D WhipCam", MessageBoxButtons.OK, MessageBoxIcon.Information)
                Return False
            End If

            Dim u As Double = CDbl(frame) / CDbl(escapeFrames)
            Dim ws As Double = SmoothStepQuintic(u)

            Dim eye As Vec3 = Vec3.Lerp(ptHoldEye, ptEscapeEye, ws)
            Dim targetPt As Vec3 = Vec3.Lerp(heroTargetPt, C, ws)
            Dim curFOV As Double = s05.HeroFOV + (s05.EscapeFOV - s05.HeroFOV) * ws
            Dim curBankDeg As Double = 4.0 * Math.Sin(Math.PI * ws)

            Dim bankRad As Double = curBankDeg * Math.PI / 180.0
            Dim forward As Vec3 = (targetPt - eye).Normalize()
            Dim worldUp As New Vec3(0, 1, 0)
            Dim camRight As Vec3 = worldUp.Cross(forward).Normalize()
            If camRight.Length() < 1E-6 Then camRight = New Vec3(1, 0, 0)
            Dim camUp0 As Vec3 = forward.Cross(camRight).Normalize()
            Dim rolledUp As Vec3 = camUp0 * Math.Cos(bankRad) + camRight * Math.Sin(bankRad)

            lastEye = eye : lastTarget = targetPt : lastUp = rolledUp : lastFOV = curFOV

            oCam.Eye = tg.CreatePoint(eye.X, eye.Y, eye.Z)
            oCam.Target = tg.CreatePoint(targetPt.X, targetPt.Y, targetPt.Z)
            oCam.UpVector = tg.CreateUnitVector(rolledUp.X, rolledUp.Y, rolledUp.Z)
            oCam.PerspectiveAngle = curFOV * Math.PI / 180.0
            oCam.ApplyWithoutTransition()

            If exportCtx IsNot Nothing AndAlso exportCtx.IsExporting Then
                CaptureVideoFrame(oCam, exportCtx, oApp)
                SafeYield(2)
            Else
                If s05.RunMode = "PREVIEW" Then
                    System.Threading.Thread.Sleep(CInt(1000.0 / s05.FPS))
                    System.Windows.Forms.Application.DoEvents()
                End If
            End If
        Next

        outLastEye = lastEye
        outLastTarget = lastTarget
        outLastUp = lastUp
        outLastFOV = lastFOV

        Return True
    End Function


    ' --------------------------------------------------------------------------
    ' CƠ CHẾ LƯU TRỮ ĐIỂM VĨNH VIỄN (DUAL PERSISTENCE: ATTRIBUTESETS + JSON)
    ' --------------------------------------------------------------------------
    Public Shared Sub SavePointsToStorage(ByVal oDoc As Document, ByVal points As List(Of Vec3), ByVal dirs As List(Of Vec3), ByVal names As List(Of String))
        If points Is Nothing OrElse points.Count = 0 Then Return
        Try
            ' 1. Tạo chuỗi dữ liệu chuẩn hóa
            Dim sb As New System.Text.StringBuilder()
            For i As Integer = 0 To points.Count - 1
                Dim pName As String = If(i < names.Count AndAlso Not String.IsNullOrEmpty(names(i)), names(i), "Diem_" & (i + 1).ToString())
                pName = pName.Replace("|", "_").Replace(";", "_").Replace(vbCr, " ").Replace(vbLf, " ")
                Dim pt As Vec3 = points(i)
                Dim d As Vec3 = If(i < dirs.Count AndAlso dirs(i) IsNot Nothing, dirs(i), New Vec3(-0.7071, 0.5, -0.7071))
                sb.AppendFormat("{0}|{1:F4};{2:F4};{3:F4}|{4:F4};{5:F4};{6:F4}{7}", _
                    pName, pt.X, pt.Y, pt.Z, d.X, d.Y, d.Z, vbLf)
            Next
            Dim dataStr As String = sb.ToString()

            ' 2. Gắn trực tiếp vào Document AttributeSets của file CAD
            Try
                Dim attSets As AttributeSets = oDoc.AttributeSets
                Dim attSet As AttributeSet = Nothing
                If attSets.NameIsUsed("WT3D_WhipCam") Then
                    attSet = attSets.Item("WT3D_WhipCam")
                Else
                    attSet = attSets.Add("WT3D_WhipCam")
                End If

                If attSet.NameIsUsed("Shot04_Points") Then
                    attSet.Item("Shot04_Points").Value = dataStr
                Else
                    attSet.Add("Shot04_Points", ValueTypeEnum.kStringType, dataStr)
                End If
            Catch exDoc As Exception
            End Try

            ' 3. Xuất file Sidecar JSON bên cạnh file CAD & Backup toàn cục
            Dim filePaths As New List(Of String)()
            Try
                If Not String.IsNullOrEmpty(oDoc.FullFileName) Then
                    Dim sidecarPath As String = System.IO.Path.ChangeExtension(oDoc.FullFileName, ".whipcam_points.txt")
                    filePaths.Add(sidecarPath)
                End If
            Catch
            End Try
            filePaths.Add("D:\WT3D_Project\Z_Tools\WhipCam_Last_Saved_Points.txt")
            filePaths.Add("C:\Users\PHAN TRONG TAN\.gemini\antigravity\brain\0ae66afd-c144-4254-9d6b-7633e3f0365d\WhipCam_Last_Saved_Points.txt")

            For Each fp As String In filePaths
                Try
                    Dim dirName As String = System.IO.Path.GetDirectoryName(fp)
                    If Not String.IsNullOrEmpty(dirName) AndAlso Not System.IO.Directory.Exists(dirName) Then
                        System.IO.Directory.CreateDirectory(dirName)
                    End If
                    System.IO.File.WriteAllText(fp, dataStr, System.Text.Encoding.UTF8)
                Catch
                End Try
            Next
        Catch ex As Exception
        End Try
    End Sub

    Public Shared Function LoadPointsFromStorage(ByVal oDoc As Document, ByRef outPoints As List(Of Vec3), ByRef outDirs As List(Of Vec3), ByRef outNames As List(Of String)) As Boolean
        outPoints = New List(Of Vec3)()
        outDirs = New List(Of Vec3)()
        outNames = New List(Of String)()

        Dim rawData As String = ""

        ' 1. Ưu tiên đọc từ Document AttributeSets
        Try
            Dim attSets As AttributeSets = oDoc.AttributeSets
            If attSets.NameIsUsed("WT3D_WhipCam") Then
                Dim attSet As AttributeSet = attSets.Item("WT3D_WhipCam")
                If attSet.NameIsUsed("Shot04_Points") Then
                    rawData = CStr(attSet.Item("Shot04_Points").Value)
                End If
            End If
        Catch
        End Try

        ' 2. Nếu AttributeSets chưa có, thử đọc từ file Sidecar hoặc Backup
        If String.IsNullOrEmpty(rawData) Then
            Dim filePaths As New List(Of String)()
            Try
                If Not String.IsNullOrEmpty(oDoc.FullFileName) Then
                    filePaths.Add(System.IO.Path.ChangeExtension(oDoc.FullFileName, ".whipcam_points.txt"))
                End If
            Catch
            End Try
            filePaths.Add("D:\WT3D_Project\Z_Tools\WhipCam_Last_Saved_Points.txt")
            filePaths.Add("C:\Users\PHAN TRONG TAN\.gemini\antigravity\brain\0ae66afd-c144-4254-9d6b-7633e3f0365d\WhipCam_Last_Saved_Points.txt")

            For Each fp As String In filePaths
                Try
                    If System.IO.File.Exists(fp) Then
                        rawData = System.IO.File.ReadAllText(fp, System.Text.Encoding.UTF8)
                        If Not String.IsNullOrEmpty(rawData) Then Exit For
                    End If
                Catch
                End Try
            Next
        End If

        If String.IsNullOrEmpty(rawData) Then Return False

        ' 3. Parse chuỗi dữ liệu
        Try
            Dim lines As String() = rawData.Split(New Char() {ControlChars.Lf, ControlChars.Cr}, StringSplitOptions.RemoveEmptyEntries)
            For Each line As String In lines
                Dim parts As String() = line.Split("|"c)
                If parts.Length >= 2 Then
                    Dim pName As String = parts(0).Trim()
                    Dim ptParts As String() = parts(1).Split(";"c)
                    If ptParts.Length >= 3 Then
                        Dim px As Double = Double.Parse(ptParts(0), System.Globalization.CultureInfo.InvariantCulture)
                        Dim py As Double = Double.Parse(ptParts(1), System.Globalization.CultureInfo.InvariantCulture)
                        Dim pz As Double = Double.Parse(ptParts(2), System.Globalization.CultureInfo.InvariantCulture)
                        outPoints.Add(New Vec3(px, py, pz))
                        outNames.Add(pName)

                        If parts.Length >= 3 Then
                            Dim dirParts As String() = parts(2).Split(";"c)
                            If dirParts.Length >= 3 Then
                                Dim dx As Double = Double.Parse(dirParts(0), System.Globalization.CultureInfo.InvariantCulture)
                                Dim dy As Double = Double.Parse(dirParts(1), System.Globalization.CultureInfo.InvariantCulture)
                                Dim dz As Double = Double.Parse(dirParts(2), System.Globalization.CultureInfo.InvariantCulture)
                                outDirs.Add(New Vec3(dx, dy, dz).Normalize())
                            Else
                                outDirs.Add(New Vec3(-0.7071, 0.5, -0.7071).Normalize())
                            End If
                        Else
                            outDirs.Add(New Vec3(-0.7071, 0.5, -0.7071).Normalize())
                        End If
                    End If
                End If
            Next
            Return (outPoints.Count > 0)
        Catch ex As Exception
            Return False
        End Try
    End Function

    ' ==============================================================================
    ' CENTRAL VIDEO EXPORT PIPELINE (TIKTOK 9:16 & CINEMATIC MP4)
    ' ==============================================================================
    Public Sub RunExportPipeline(ByVal isMaster As Boolean, _
                                 ByVal oDoc As Document, _
                                 ByVal s01 As Shot01Settings, _
                                 ByVal s02 As Shot02Settings, _
                                 ByVal s03 As Shot03Settings, _
                                 ByVal s04 As Shot04Settings, _
                                 ByVal s05 As Shot05Settings, _
                                 ByVal model As ModelInfo, _
                                 ByVal heroes As Dictionary(Of String, HeroTarget), _
                                 ByVal currentTab As Integer, _
                                 ByVal runShot01 As Boolean, _
                                 ByVal runShot02 As Boolean, _
                                 ByVal runShot03 As Boolean, _
                                 ByVal runShot04 As Boolean, _
                                 ByVal runShot05 As Boolean, _
                                 ByVal videoFormat As String, _
                                 ByVal fpsVal As Integer, _
                                 ByVal audioMode As String, _
                                 ByVal openFolder As Boolean, _
                                 ByVal cleanupFrames As Boolean, _
                                 ByVal form As System.Windows.Forms.Form)
        Dim oApp As Inventor.Application = oDoc.Parent
        Dim baseDir As String = "d:\WT3D_Project\2_Video_Renders"
        If Not System.IO.Directory.Exists(baseDir) Then
            Try : System.IO.Directory.CreateDirectory(baseDir) : Catch : End Try
        End If

        Dim modelName As String = System.IO.Path.GetFileNameWithoutExtension(oDoc.FullFileName)
        If String.IsNullOrEmpty(modelName) Then modelName = "WT3D_Skid_Model"

        Dim shotTag As String = ""
        Dim shotTitleVN As String = ""
        If isMaster Then
            shotTag = "Master_Sequence"
            shotTitleVN = "SHOWREEL GHÉP LIÊN HOÀN 5 CẢNH"
        Else
            Select Case currentTab
                Case 0 : shotTag = "Shot01_GrandFlyIn" : shotTitleVN = "CẢNH 01: GRAND FLY-IN & FIT VIEW"
                Case 1 : shotTag = "Shot02_PullBackOrbit" : shotTitleVN = "CẢNH 02: PULL-BACK & ORBIT 3/4"
                Case 2 : shotTag = "Shot03_PendulumSway" : shotTitleVN = "CẢNH 03: CON LẮC MẶT TIỀN MÁY"
                Case 3 : shotTag = "Shot04_MacroZoom" : shotTitleVN = "CẢNH 04: MACRO ZOOM ĐA ĐIỂM"
                Case 4 : shotTag = "Shot05_HelicalEscape" : shotTitleVN = "CẢNH 05: HELICAL ORBIT & ESCAPE"
                Case Else : shotTag = "Shot_Custom" : shotTitleVN = "CINEMATIC SHOWREEL"
            End Select
        End If

        Dim runFolder As String = System.IO.Path.Combine(baseDir, modelName & "_" & shotTag & "_Frames")
        If System.IO.Directory.Exists(runFolder) Then
            For Each oldPng As String In System.IO.Directory.GetFiles(runFolder, "*.png")
                Try : System.IO.File.Delete(oldPng) : Catch : End Try
            Next
        Else
            System.IO.Directory.CreateDirectory(runFolder)
        End If

        Dim exportCtx As New VideoExportContext()
        exportCtx.IsExporting = True
        exportCtx.FrameFolder = runFolder
        exportCtx.FrameCounter = 1
        exportCtx.CurrentShotName = shotTitleVN
        exportCtx.VideoFormat = videoFormat
        exportCtx.FPS = fpsVal
        exportCtx.AudioMode = audioMode
        If videoFormat = "native_916" Then
            exportCtx.ExportWidth = 1080
            exportCtx.ExportHeight = 1920
        Else
            exportCtx.ExportWidth = 1920
            exportCtx.ExportHeight = 1080
        End If

        form.Visible = False
        oApp.StatusBarText = "🎬 Đang chụp từng khung hình Video 3D (Giữ ESC để dừng)..."

        Dim oldFlyOut As Boolean = s01.EnableFlyOut
        If isMaster Then s01.EnableFlyOut = False

        Dim aborted As Boolean = False
        Try
            Dim lastEye As Vec3 = Nothing
            Dim lastTarget As Vec3 = Nothing
            Dim lastUp As Vec3 = Nothing
            Dim lastFOV As Double = 50.0

            If Not isMaster Then
                Select Case currentTab
                    Case 0 : If Not ExecuteShot01(oDoc, s01, lastEye, lastTarget, lastUp, lastFOV, exportCtx) Then aborted = True
                    Case 1 : If Not ExecuteShot02(oDoc, s02, s01, model, Nothing, Nothing, lastEye, lastTarget, lastUp, lastFOV, exportCtx) Then aborted = True
                    Case 2 : If Not ExecuteShot03(oDoc, s03, s02, s01, model, heroes, Nothing, Nothing, lastEye, lastTarget, lastUp, lastFOV, exportCtx) Then aborted = True
                    Case 3 : If Not ExecuteShot04(oDoc, s04, s03, s02, s01, model, heroes, Nothing, Nothing, lastEye, lastTarget, lastUp, lastFOV, exportCtx) Then aborted = True
                    Case 4 : If Not ExecuteShot05(oDoc, s05, s04, s03, s02, s01, model, heroes, Nothing, Nothing, lastEye, lastTarget, lastUp, lastFOV, exportCtx) Then aborted = True
                End Select
            Else
                ' Ghép nối các cảnh được chọn
                If runShot01 Then
                    exportCtx.CurrentShotName = "CẢNH 01: GRAND FLY-IN"
                    If Not ExecuteShot01(oDoc, s01, lastEye, lastTarget, lastUp, lastFOV, exportCtx) Then aborted = True
                End If

                If Not aborted AndAlso runShot02 Then
                    exportCtx.CurrentShotName = "CẢNH 02: PULL-BACK & ORBIT 3/4"
                    Dim nEye As Vec3 = Nothing : Dim nTarget As Vec3 = Nothing : Dim nUp As Vec3 = Nothing : Dim nFOV As Double = 50.0
                    If Not ExecuteShot02(oDoc, s02, s01, model, lastEye, lastTarget, nEye, nTarget, nUp, nFOV, exportCtx) Then aborted = True
                    lastEye = nEye : lastTarget = nTarget : lastUp = nUp : lastFOV = nFOV
                End If

                If Not aborted AndAlso runShot03 Then
                    exportCtx.CurrentShotName = "CẢNH 03: CON LẮC MẶT TIỀN MÁY"
                    Dim nEye As Vec3 = Nothing : Dim nTarget As Vec3 = Nothing : Dim nUp As Vec3 = Nothing : Dim nFOV As Double = 50.0
                    If Not ExecuteShot03(oDoc, s03, s02, s01, model, heroes, lastEye, lastTarget, nEye, nTarget, nUp, nFOV, exportCtx) Then aborted = True
                    lastEye = nEye : lastTarget = nTarget : lastUp = nUp : lastFOV = nFOV
                End If

                If Not aborted AndAlso runShot04 Then
                    exportCtx.CurrentShotName = "CẢNH 04: MACRO ZOOM ĐA ĐIỂM"
                    Dim nEye As Vec3 = Nothing : Dim nTarget As Vec3 = Nothing : Dim nUp As Vec3 = Nothing : Dim nFOV As Double = 50.0
                    If Not ExecuteShot04(oDoc, s04, s03, s02, s01, model, heroes, lastEye, lastTarget, nEye, nTarget, nUp, nFOV, exportCtx) Then aborted = True
                    lastEye = nEye : lastTarget = nTarget : lastUp = nUp : lastFOV = nFOV
                End If

                If Not aborted AndAlso runShot05 Then
                    exportCtx.CurrentShotName = "CẢNH 05: HELICAL ORBIT & ESCAPE"
                    Dim nEye As Vec3 = Nothing : Dim nTarget As Vec3 = Nothing : Dim nUp As Vec3 = Nothing : Dim nFOV As Double = 50.0
                    If Not ExecuteShot05(oDoc, s05, s04, s03, s02, s01, model, heroes, lastEye, lastTarget, nEye, nTarget, nUp, nFOV, exportCtx) Then aborted = True
                End If
            End If
        Catch ex As Exception
            MessageBox.Show("Lỗi trong quá trình render frames: " & ex.Message, "WT3D Video Render", MessageBoxButtons.OK, MessageBoxIcon.Error)
            aborted = True
        Finally
            s01.EnableFlyOut = oldFlyOut
            form.Visible = True
        End Try

        If aborted OrElse exportCtx.FrameCounter <= 1 Then
            oApp.StatusBarText = "Đã dừng render video."
            Return
        End If

        ' Kích hoạt Python Exporter đóng gói MP4
        Dim outDir As String = System.IO.Path.Combine(baseDir, modelName)
        If Not System.IO.Directory.Exists(outDir) Then System.IO.Directory.CreateDirectory(outDir)
        Dim outMp4 As String = System.IO.Path.Combine(outDir, modelName & "_" & shotTag & "_" & videoFormat & ".mp4")

        Dim pyScript As String = "D:\WT3D_Project\Z_Tools\WhipCam_TikTok_Exporter.py"
        If Not System.IO.File.Exists(pyScript) Then
            MessageBox.Show("Không tìm thấy script: " & pyScript, "Thiếu Tool", MessageBoxButtons.OK, MessageBoxIcon.Warning)
            Return
        End If

        Dim q As String = Chr(34)
        Dim cmdArgs As String = q & pyScript & q & " --frames-dir " & q & runFolder & q & " --output-mp4 " & q & outMp4 & q & " --model-name " & q & modelName & q & " --shot-title " & q & shotTitleVN & q & " --format " & videoFormat & " --fps " & fpsVal.ToString()
        If audioMode <> "none" Then cmdArgs &= " --audio auto" Else cmdArgs &= " --audio none"
        If cleanupFrames Then cmdArgs &= " --cleanup"
        If openFolder Then cmdArgs &= " --open-folder"

        Try
            Dim psi As New System.Diagnostics.ProcessStartInfo("python.exe", cmdArgs)
            psi.WindowStyle = System.Diagnostics.ProcessWindowStyle.Hidden
            psi.CreateNoWindow = True
            Dim p As System.Diagnostics.Process = System.Diagnostics.Process.Start(psi)
            p.WaitForExit()

            If System.IO.File.Exists(outMp4) Then
                oApp.StatusBarText = "✔ Đã xuất video TikTok thành công: " & System.IO.Path.GetFileName(outMp4)
                MessageBox.Show("🎉 XUẤT VIDEO TIKTOK THÀNH CÔNG!" & vbCrLf & vbCrLf & _
                                "• Đường dẫn: " & outMp4 & vbCrLf & _
                                "• Định dạng: " & videoFormat & vbCrLf & _
                                "• Tổng số frames: " & (exportCtx.FrameCounter - 1).ToString() & " (" & fpsVal.ToString() & " FPS)", _
                                "WT3D Video Exporter", MessageBoxButtons.OK, MessageBoxIcon.Information)
            Else
                MessageBox.Show("Có lỗi khi tạo video MP4. Kiểm tra FFmpeg và Python.", "WT3D Video Exporter", MessageBoxButtons.OK, MessageBoxIcon.Warning)
            End If
        Catch ex As Exception
            MessageBox.Show("Lỗi gọi Python Exporter: " & ex.Message, "WT3D Video Exporter", MessageBoxButtons.OK, MessageBoxIcon.Error)
        End Try
    End Sub

    Public Sub Main()
        System.Threading.Thread.CurrentThread.CurrentCulture = System.Globalization.CultureInfo.InvariantCulture
        System.Threading.Thread.CurrentThread.CurrentUICulture = System.Globalization.CultureInfo.InvariantCulture

        Dim oApp As Inventor.Application = ThisApplication
        Dim oDoc As Document = oApp.ActiveDocument
        If oDoc Is Nothing Then
            MessageBox.Show("Hãy mở một mô hình Assembly trước.", "WT3D WhipCam", MessageBoxButtons.OK, MessageBoxIcon.Warning)
            Return
        End If

        Dim model As ModelInfo = ScanSkidModel(oDoc)
        Dim heroes As Dictionary(Of String, HeroTarget) = DiscoverHeroes(oDoc, model)

        Dim s01 As New Shot01Settings()
        Dim s02 As New Shot02Settings()
        Dim s03 As New Shot03Settings()
        Dim s04 As New Shot04Settings()
        Dim s05 As New Shot05Settings()
        Dim sMaster As New MasterMovieSettings()
        Dim customPointNames As New List(Of String)()

        ' TỰ ĐỘNG NẠP LẠI ĐIỂM ĐÃ LƯU TRƯỚC ĐÓ (AUTO-LOAD)
        If s04.CustomPickPoints.Count = 0 Then
            Dim autoPts As List(Of Vec3) = Nothing
            Dim autoDirs As List(Of Vec3) = Nothing
            Dim autoNames As List(Of String) = Nothing
            If LoadPointsFromStorage(oDoc, autoPts, autoDirs, autoNames) AndAlso autoPts.Count > 0 Then
                s04.CustomPickPoints = autoPts
                s04.CustomApproachVectors = autoDirs
                customPointNames = autoNames
                s04.PointsMode = "CUSTOM_PICK"
            End If
        End If
