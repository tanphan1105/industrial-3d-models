        ' Xử lý nút Click trực tiếp trên 3D
        AddHandler btnInteractivePick04.Click, Sub(s As Object, e As EventArgs)
            activeTabIndex = 3
            formPendingAction = "INTERACTIVE_PICK"
            form.Close()
        End Sub

        ' Xử lý nút Nạp từ SelectSet (bóc tách đa tầng thông minh)
        AddHandler btnSelectSetPick04.Click, Sub(s As Object, e As EventArgs)
            Dim selSet As SelectSet = oDoc.SelectSet
            If selSet IsNot Nothing AndAlso selSet.Count > 0 Then
                Dim addedCount As Integer = 0
                For i As Integer = 1 To selSet.Count
                    Dim obj As Object = selSet.Item(i)
                    Dim pt As Vec3 = Nothing
                    Dim objName As String = "Chi tiết " & (s04.CustomPickPoints.Count + 1).ToString()

                    If TypeOf obj Is ComponentOccurrence Then
                        Dim occ As ComponentOccurrence = CType(obj, ComponentOccurrence)
                        Dim b As Box = occ.RangeBox
                        pt = New Vec3((b.MinPoint.X + b.MaxPoint.X) * 0.5, (b.MinPoint.Y + b.MaxPoint.Y) * 0.5, (b.MinPoint.Z + b.MaxPoint.Z) * 0.5)
                        objName = occ.Name
                    Else
                        Try
                            Dim occ As ComponentOccurrence = CallByName(obj, "ContainingOccurrence", CallType.Get)
                            If occ IsNot Nothing Then
                                Dim b As Box = occ.RangeBox
                                pt = New Vec3((b.MinPoint.X + b.MaxPoint.X) * 0.5, (b.MinPoint.Y + b.MaxPoint.Y) * 0.5, (b.MinPoint.Z + b.MaxPoint.Z) * 0.5)
                                objName = occ.Name
                            End If
                        Catch
                        End Try

                        If pt Is Nothing Then
                            Try
                                Dim b As Box = CallByName(obj, "RangeBox", CallType.Get)
                                pt = New Vec3((b.MinPoint.X + b.MaxPoint.X) * 0.5, (b.MinPoint.Y + b.MaxPoint.Y) * 0.5, (b.MinPoint.Z + b.MaxPoint.Z) * 0.5)
                            Catch
                            End Try
                        End If
                    End If

                    If pt IsNot Nothing Then
                        s04.CustomPickPoints.Add(pt)
                        Dim oCamNow As Inventor.Camera = oApp.ActiveView.Camera
                        Dim curViewVec As Vec3 = (New Vec3(oCamNow.Eye.X, oCamNow.Eye.Y, oCamNow.Eye.Z) - New Vec3(oCamNow.Target.X, oCamNow.Target.Y, oCamNow.Target.Z)).Normalize()
                        If curViewVec.Length() < 1E-5 Then curViewVec = New Vec3(-0.7071, 0.5, -0.7071).Normalize()
                        s04.CustomApproachVectors.Add(curViewVec)
                        customPointNames.Add(objName)
                        addedCount += 1
                    End If
                Next

                If addedCount > 0 Then
                    s04.PointsMode = "CUSTOM_PICK"
                    cboMode04.SelectedIndex = 2
                    lblPolyStatus04.Text = String.Format("✔ Đã nạp {0} điểm: {1}", s04.CustomPickPoints.Count, String.Join(" ➔ ", customPointNames.ToArray()))
                    lblPolyStatus04.ForeColor = System.Drawing.Color.FromArgb(10, 80, 160)
                    ' Tự động lưu vĩnh viễn (Auto-Save)
                    SavePointsToStorage(oDoc, s04.CustomPickPoints, s04.CustomApproachVectors, customPointNames)
                End If
            Else
                MessageBox.Show("Chưa có chi tiết nào được chọn trong Inventor!" & vbCrLf & vbCrLf & _
                                "👉 Cách 1 (Khuyên dùng): Bấm nút màu xanh đậm '🖱️ CLICK CHỌN TRỰC TIẾP TRÊN 3D' để click thẳng vào mô hình." & vbCrLf & _
                                "👉 Cách 2: Chọn trước các chi tiết trên màn hình Inventor rồi bấm lại nút này.", "WT3D Chọn Điểm", MessageBoxButtons.OK, MessageBoxIcon.Information)
            End If
        End Sub


        ' Xử lý nút Lưu điểm chủ động
        AddHandler btnSavePoints04.Click, Sub(s As Object, e As EventArgs)
            If s04.CustomPickPoints.Count > 0 Then
                SavePointsToStorage(oDoc, s04.CustomPickPoints, s04.CustomApproachVectors, customPointNames)
                MessageBox.Show(String.Format("✔ Đã lưu thành công {0} điểm vào file mô hình ({1}) và file sao lưu dự phòng!", s04.CustomPickPoints.Count, oDoc.DisplayName), "WT3D Lưu Điểm Thành Công", MessageBoxButtons.OK, MessageBoxIcon.Information)
            Else
                MessageBox.Show("Chưa có điểm nào để lưu. Vui lòng bấm '🎯 CLICK CHỌN TRỰC TIẾP TRÊN 3D' hoặc '✔ NẠP CHI TIẾT ĐANG CHỌN' trước.", "Thông Báo", MessageBoxButtons.OK, MessageBoxIcon.Warning)
            End If
        End Sub

        ' Xử lý nút Nạp lại điểm đã lưu
        AddHandler btnLoadPoints04.Click, Sub(s As Object, e As EventArgs)
            Dim loadedPts As List(Of Vec3) = Nothing
            Dim loadedDirs As List(Of Vec3) = Nothing
            Dim loadedNames As List(Of String) = Nothing
            If LoadPointsFromStorage(oDoc, loadedPts, loadedDirs, loadedNames) AndAlso loadedPts.Count > 0 Then
                s04.CustomPickPoints = loadedPts
                s04.CustomApproachVectors = loadedDirs
                customPointNames = loadedNames
                s04.PointsMode = "CUSTOM_PICK"
                cboMode04.SelectedIndex = 2
                lblPolyStatus04.Text = String.Format("✔ Đã nạp lại {0} điểm đã lưu: {1}", s04.CustomPickPoints.Count, String.Join(" ➔ ", customPointNames.ToArray()))
                lblPolyStatus04.ForeColor = System.Drawing.Color.FromArgb(10, 80, 160)
                MessageBox.Show(String.Format("✔ Đã nạp lại thành công {0} điểm đã lưu!", s04.CustomPickPoints.Count), "WT3D Nạp Điểm Thành Công", MessageBoxButtons.OK, MessageBoxIcon.Information)
            Else
                MessageBox.Show("Không tìm thấy dữ liệu điểm đã lưu cho mô hình này.", "Thông Báo", MessageBoxButtons.OK, MessageBoxIcon.Information)
            End If
        End Sub

        ' Xử lý nút Xóa điểm
        AddHandler btnClear04.Click, Sub(s As Object, e As EventArgs)
            s04.CustomPickPoints.Clear()
            s04.CustomApproachVectors.Clear()
            customPointNames.Clear()
            cboMode04.SelectedIndex = 0
            lblPolyStatus04.Text = "✔ Đã xóa điểm. Trở về mặc định 4 Điểm TVC High-Tech."
            lblPolyStatus04.ForeColor = System.Drawing.Color.FromArgb(20, 120, 50)
        End Sub

        ' Bento 2: Thông số Phóng Zoom & Góc Ống Kính
        Dim grpZoom04 As New System.Windows.Forms.GroupBox()
