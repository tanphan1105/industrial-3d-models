        Dim numSweepDeg05 As New System.Windows.Forms.NumericUpDown()
        numSweepDeg05.Location = New System.Drawing.Point(220, 52) : numSweepDeg05.Size = New System.Drawing.Size(95, 22)
        numSweepDeg05.DecimalPlaces = 1 : numSweepDeg05.Increment = 15.0D : numSweepDeg05.Minimum = 10.0D : numSweepDeg05.Maximum = 1440.0D
        numSweepDeg05.Value = CDec(s05.OrbitSweepDeg)
        grpWhip05.Controls.Add(numSweepDeg05)
        Dim lblSweepDegInfo05 As New System.Windows.Forms.Label()
        lblSweepDegInfo05.Text = "(180°=nửa vòng, 360°=1 vòng, 720°=2 vòng)"
        lblSweepDegInfo05.Location = New System.Drawing.Point(322, 54) : lblSweepDegInfo05.Size = New System.Drawing.Size(185, 20)
        lblSweepDegInfo05.Font = New System.Drawing.Font("Segoe UI", 7.75!, FontStyle.Italic)
        lblSweepDegInfo05.ForeColor = System.Drawing.Color.FromArgb(20, 120, 60)
        grpWhip05.Controls.Add(lblSweepDegInfo05)

        AddHandler cboSweep05.SelectedIndexChanged, Sub(s As Object, e As EventArgs)
            Select Case cboSweep05.SelectedIndex
                Case 0 : numSweepDeg05.Value = 180.0D
                Case 1 : numSweepDeg05.Value = 270.0D
                Case 2 : numSweepDeg05.Value = 360.0D
                Case 3 : numSweepDeg05.Value = 720.0D
            End Select
        End Sub

        AddHandler numSweepDeg05.ValueChanged, Sub(s As Object, e As EventArgs)
            Dim val As Double = CDbl(numSweepDeg05.Value)
            If Math.Abs(val - 180.0) < 0.1 Then
                If cboSweep05.SelectedIndex <> 0 Then cboSweep05.SelectedIndex = 0
            ElseIf Math.Abs(val - 270.0) < 0.1 Then
                If cboSweep05.SelectedIndex <> 1 Then cboSweep05.SelectedIndex = 1
            ElseIf Math.Abs(val - 360.0) < 0.1 Then
                If cboSweep05.SelectedIndex <> 2 Then cboSweep05.SelectedIndex = 2
            ElseIf Math.Abs(val - 720.0) < 0.1 Then
                If cboSweep05.SelectedIndex <> 3 Then cboSweep05.SelectedIndex = 3
            Else
                If cboSweep05.SelectedIndex <> 4 Then cboSweep05.SelectedIndex = 4
            End If
        End Sub

