        Dim updateSpeedLabel05 As Action = Sub()
            Dim dur As Double = CDbl(numDur05.Value)
            Dim spd As Double = CDbl(numSpeed05.Value)
            Dim realDur As Double = dur / Math.Max(0.05, spd)
            lblSpeedInfo05.Text = "Thời gian chạy Cảnh 5: " & realDur.ToString("F1") & "s (" & spd.ToString("F2") & "x) | 2 Cú Whip ➔ Hold ➔ Escape Reveal"
        End Sub

        AddHandler numDur05.ValueChanged, Sub(s As Object, e As EventArgs) updateSpeedLabel05()
        AddHandler numSpeed05.ValueChanged, Sub(s As Object, e As EventArgs) updateSpeedLabel05()
        updateSpeedLabel05()

        Dim applySettings05 As Action = Sub()
            Select Case cboHero05.SelectedIndex
                Case 1 : s05.FocusHeroKey = "MEMBRANE"
                Case 2 : s05.FocusHeroKey = "PANEL"
                Case 3 : s05.FocusHeroKey = "CENTER"
                Case 4 : s05.FocusHeroKey = "LAST_PICK"
                Case Else : s05.FocusHeroKey = "PUMP"
            End Select

            Select Case cboStartCorner05.SelectedIndex
                Case 1 : s05.StartCornerMode = "FRONT_RIGHT"
                Case 2 : s05.StartCornerMode = "BACK_RIGHT"
                Case 3 : s05.StartCornerMode = "BACK_LEFT"
                Case 4 : s05.StartCornerMode = "CURRENT_VIEW"
                Case 5 : s05.StartCornerMode = "PREV_SHOT"
                Case Else : s05.StartCornerMode = "FRONT_LEFT"
            End Select

            If radBottom05.Checked Then
                s05.ViewAngleMode = "34_BOTTOM"
            ElseIf radLevel05.Checked Then
                s05.ViewAngleMode = "34_LEVEL"
            Else
                s05.ViewAngleMode = "34_TOP"
            End If

            s05.ElevationDeg = CDbl(numElev05.Value)
            s05.OrbitRadiusScale = CDbl(numOrbitR05.Value)


            s05.OrbitSweepDeg = CDbl(numSweepDeg05.Value)

            s05.OrbitDirection = If(cboDir05.SelectedIndex = 1, "CW", "CCW")

            s05.BankWhipDeg = CDbl(numBank05.Value)
            s05.ClosePassScale = CDbl(numPass05.Value)
            s05.HeroHoldSec = CDbl(numHold05.Value)

            s05.EscapeDistanceScale = CDbl(numEscDist05.Value)
            s05.EscapeClimbScale = CDbl(numClimb05.Value)
            s05.EscapeFOV = CDbl(numEscFOV05.Value)

            s05.DurationSeconds = CDbl(numDur05.Value)
            s05.SpeedMultiplier = CDbl(numSpeed05.Value)
        End Sub

