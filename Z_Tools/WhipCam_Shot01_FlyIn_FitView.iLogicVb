        Dim updateSpeedLabel02 As Action = Sub()
            Dim dur As Double = CDbl(numDur02.Value)
            Dim spd As Double = CDbl(numSpeed02.Value)
            Dim hold As Double = CDbl(numHold02.Value)
            Dim actualT As Double = dur / Math.Max(0.05, spd)
            Dim totalT As Double = actualT + hold
            lblSpeedInfo02.Text = String.Format("▶ Bay lùi: {0:F1}s | Ngắm ở xa: {1:F1}s  ➔  Tổng chạy C2: {2:F1}s ({3:F2}x)", actualT, hold, totalT, spd)
        End Sub

