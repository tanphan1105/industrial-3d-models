        Dim updateSpeedLabel04 As Action = Sub()
            Dim dur As Double = CDbl(numDur04.Value)
            Dim spd As Double = CDbl(numSpeed04.Value)
            Dim realDur As Double = dur / Math.Max(0.05, spd)
            Dim nPts As Integer = If(cboMode04.SelectedIndex = 1, 3, (If(cboMode04.SelectedIndex = 2, Math.Max(2, s04.CustomPickPoints.Count), 4)))
            Dim perPt As Double = realDur / CDbl(nPts)
            lblSpeedInfo04.Text = "Thời gian chạy Cảnh 4: " & realDur.ToString("F1") & "s (" & spd.ToString("F2") & "x) | " & nPts.ToString() & " điểm soi (~" & perPt.ToString("F1") & "s/điểm)"
        End Sub

        AddHandler numDur04.ValueChanged, Sub(s As Object, e As EventArgs) updateSpeedLabel04()
        AddHandler numSpeed04.ValueChanged, Sub(s As Object, e As EventArgs) updateSpeedLabel04()
        AddHandler cboMode04.SelectedIndexChanged, Sub(s As Object, e As EventArgs) updateSpeedLabel04()
        updateSpeedLabel04()

        Dim applySettings04 As Action = Sub()
            Select Case cboMode04.SelectedIndex
                Case 1 : s04.PointsMode = "3_POINTS"
                Case 2 : s04.PointsMode = "CUSTOM_PICK"
                Case Else : s04.PointsMode = "4_POINTS"
            End Select

            Select Case cboApproach04.SelectedIndex
                Case 1 : s04.ApproachMode = "RECORDED_VIEW"
                Case 2 : s04.ApproachMode = "ISOMETRIC_FL"
                Case 3 : s04.ApproachMode = "ISOMETRIC_FR"
                Case 4 : s04.ApproachMode = "FRONT_LOOK"
                Case 5 : s04.ApproachMode = "TOP_DOWN"
                Case Else : s04.ApproachMode = "AUTO_EXTERIOR"
            End Select

            s04.ZoomDollyScale = CDbl(numDolly04.Value)
            s04.NormalFOV = CDbl(numNormFOV04.Value)
            s04.ZoomFOV = CDbl(numZoomFOV04.Value)
            s04.OrbitDistanceScale = CDbl(numOrbitR04.Value)

            s04.MicroHoldSeconds = CDbl(numHoldSec04.Value)
            s04.BankApex = CDbl(numBank04.Value)
            s04.ElevationDeg = CDbl(numElev04.Value)

            s04.DurationSeconds = CDbl(numDur04.Value)
            s04.SpeedMultiplier = CDbl(numSpeed04.Value)
        End Sub

