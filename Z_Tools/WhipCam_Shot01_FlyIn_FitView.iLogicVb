        Dim updateSpeedLabel03 As Action = Sub()
            Dim dur As Double = CDbl(numDur03.Value)
            Dim spd As Double = CDbl(numSpeed03.Value)
            Dim hold As Double = CDbl(numHold03.Value)
            Dim actualT As Double = dur / Math.Max(0.05, spd)
            Dim totalT As Double = actualT + hold
            lblSpeedInfo03.Text = String.Format("▶ Đong đưa: {0:F1}s | Dừng ngắm: {1:F1}s  ➔  Tổng chạy C3: {2:F1}s ({3:F2}x)", actualT, hold, totalT, spd)
        End Sub
        AddHandler numDur03.ValueChanged, Sub(s As Object, e As EventArgs) updateSpeedLabel03()
        AddHandler numSpeed03.ValueChanged, Sub(s As Object, e As EventArgs) updateSpeedLabel03()
        AddHandler numHold03.ValueChanged, Sub(s As Object, e As EventArgs) updateSpeedLabel03()
        updateSpeedLabel03()

