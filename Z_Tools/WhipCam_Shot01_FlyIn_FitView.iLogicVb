Imports System
Imports System.Collections.Generic
Imports System.IO
Imports System.Drawing
Imports System.Windows.Forms
Imports System.Runtime.InteropServices
Imports Inventor

Public Class ThisRule

    ' Trap phím ESC để dừng khẩn cấp (Điều lệ 17)
    Private Declare Function GetAsyncKeyState Lib "user32" (ByVal vKey As Integer) As Short
    Private Const VK_ESCAPE As Integer = &H1B

    Public Function CheckEscapeKey() As Boolean
        Return (GetAsyncKeyState(VK_ESCAPE) And &H8000) <> 0
    End Function

    Public Sub SafeYield(Optional ByVal sleepMs As Integer = 2)
        Try
            System.Windows.Forms.Application.DoEvents()
            If sleepMs > 0 Then System.Threading.Thread.Sleep(sleepMs)
        Catch
        End Try
    End Sub

    Public Sub CaptureVideoFrame(ByVal oCam As Inventor.Camera, ByVal exportCtx As VideoExportContext, ByVal oApp As Inventor.Application)
        If exportCtx Is Nothing OrElse Not exportCtx.IsExporting Then Return
        Try
            Dim frameFile As String = System.IO.Path.Combine(exportCtx.FrameFolder, "frame_" & exportCtx.FrameCounter.ToString("D5") & ".png")
            oCam.SaveAsBitmap(frameFile, exportCtx.ExportWidth, exportCtx.ExportHeight)
            exportCtx.FrameCounter += 1
            oApp.StatusBarText = "🎬 WT3D Video Render: [" & exportCtx.CurrentShotName & "] Khung hình " & (exportCtx.FrameCounter - 1).ToString() & " (Giữ ESC để dừng)..."
        Catch ex As Exception
        End Try
    End Sub

    ' --------------------------------------------------------------------------
    ' 1. 3D VECTOR MATH
    ' --------------------------------------------------------------------------
    Public Class Vec3
        Public X As Double
        Public Y As Double
        Public Z As Double

        Public Sub New()
            X = 0.0 : Y = 0.0 : Z = 0.0
        End Sub

        Public Sub New(ByVal _x As Double, ByVal _y As Double, ByVal _z As Double)
            X = _x : Y = _y : Z = _z
        End Sub

        Public Shared Operator +(ByVal a As Vec3, ByVal b As Vec3) As Vec3
            Return New Vec3(a.X + b.X, a.Y + b.Y, a.Z + b.Z)
        End Operator

        Public Shared Operator -(ByVal a As Vec3, ByVal b As Vec3) As Vec3
            Return New Vec3(a.X - b.X, a.Y - b.Y, a.Z - b.Z)
        End Operator

        Public Shared Operator *(ByVal a As Vec3, ByVal s As Double) As Vec3
            Return New Vec3(a.X * s, a.Y * s, a.Z * s)
        End Operator

        Public Shared Operator *(ByVal s As Double, ByVal a As Vec3) As Vec3
            Return New Vec3(a.X * s, a.Y * s, a.Z * s)
        End Operator

        Public Shared Operator /(ByVal a As Vec3, ByVal s As Double) As Vec3
            If Math.Abs(s) < 1E-12 Then Return New Vec3(0, 0, 0)
            Return New Vec3(a.X / s, a.Y / s, a.Z / s)
        End Operator

        Public Function Length() As Double
            Return Math.Sqrt(X * X + Y * Y + Z * Z)
        End Function

        Public Function Normalize() As Vec3
            Dim l As Double = Length()
            If l < 1E-12 Then Return New Vec3(0, 1, 0)
            Return New Vec3(X / l, Y / l, Z / l)
        End Function

        Public Function Dot(ByVal b As Vec3) As Double
            Return X * b.X + Y * b.Y + Z * b.Z
        End Function

        Public Function Cross(ByVal b As Vec3) As Vec3
            Return New Vec3(Y * b.Z - Z * b.Y, Z * b.X - X * b.Z, X * b.Y - Y * b.X)
        End Function

        Public Shared Function Distance(ByVal a As Vec3, ByVal b As Vec3) As Double
            Return (a - b).Length()
        End Function

        Public Shared Function Lerp(ByVal a As Vec3, ByVal b As Vec3, ByVal t As Double) As Vec3
            t = Math.Max(0.0, Math.Min(1.0, t))
            Return a + (b - a) * t
        End Function
    End Class

