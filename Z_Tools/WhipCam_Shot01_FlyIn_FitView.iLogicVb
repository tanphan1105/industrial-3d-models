        Dim updateTargetInfo03 As Action = Sub()
            Select Case cboTarget03.SelectedIndex
                Case 0
                    lblTargetInfo03.Text = "✔ Trục con lắc lấy tâm Góc 1 (Trước - Trái) quanh khu vực Bơm"
                Case 1
                    lblTargetInfo03.Text = "✔ Trục con lắc lấy tâm Góc 2 (Trước - Phải) quanh khu vực Màng"
                Case 2
                    lblTargetInfo03.Text = "✔ Trục con lắc lấy tâm Góc 3 (Sau - Phải) quanh đường ống sau & Màng"
                Case 3
                    lblTargetInfo03.Text = "✔ Trục con lắc lấy tâm Góc 4 (Sau - Trái) quanh tủ điện & ống kỹ thuật"
                Case 4
                    lblTargetInfo03.Text = "✔ Quét đong đưa dọc toàn bộ Mặt Tiền (Góc 1 Trước-Trái ➔ Góc 2)"
                Case 5
                    lblTargetInfo03.Text = "✔ Quét đong đưa dọc toàn bộ Mặt Sau (Góc 4 ➔ Góc 3)"
                Case 6
                    lblTargetInfo03.Text = "✔ Trục quay lấy tâm đại cảnh toàn bộ cụm skid"
                Case 7
                    If s03.CustomPickPoint IsNot Nothing Then
                        lblTargetInfo03.Text = String.Format("✔ Đã chọn điểm: (X:{0:F1}, Y:{1:F1}, Z:{2:F1})", s03.CustomPickPoint.X, s03.CustomPickPoint.Y, s03.CustomPickPoint.Z)
                    Else
                        lblTargetInfo03.Text = "ℹ Chọn 1 chi tiết trong Inventor rồi bấm 'LẤY THEO CHI TIẾT ĐANG CHỌN'"
                    End If
                Case Else
                    lblTargetInfo03.Text = "✔ Trục con lắc lấy tâm Góc 1 (Trước - Trái) quanh khu vực Bơm"
            End Select
        End Sub
        AddHandler cboTarget03.SelectedIndexChanged, Sub(s As Object, e As EventArgs) updateTargetInfo03()
        updateTargetInfo03()

        AddHandler btnPick03.Click, Sub(s As Object, e As EventArgs)
            Try
                Dim selectSet As SelectSet = oDoc.SelectSet
                If selectSet IsNot Nothing AndAlso selectSet.Count > 0 Then
                    Dim selectedObj As Object = selectSet.Item(1)
                    Dim pt As Vec3 = Nothing
                    Dim objName As String = "Chi tiết"
                    If TypeOf selectedObj Is ComponentOccurrence Then
                        Dim occ As ComponentOccurrence = CType(selectedObj, ComponentOccurrence)
                        Dim b As Box = occ.RangeBox
                        pt = New Vec3((b.MinPoint.X + b.MaxPoint.X) * 0.5, (b.MinPoint.Y + b.MaxPoint.Y) * 0.5, (b.MinPoint.Z + b.MaxPoint.Z) * 0.5)
                        objName = occ.Name
                    Else
                        Try
                            Dim b As Box = CallByName(selectedObj, "RangeBox", CallType.Get)
                            pt = New Vec3((b.MinPoint.X + b.MaxPoint.X) * 0.5, (b.MinPoint.Y + b.MaxPoint.Y) * 0.5, (b.MinPoint.Z + b.MaxPoint.Z) * 0.5)
                        Catch
                        End Try
                    End If
                    If pt IsNot Nothing Then
                        s03.CustomPickPoint = pt
                        cboTarget03.SelectedIndex = 7
                        lblTargetInfo03.Text = String.Format("✔ Đã lấy tâm '{0}': (X:{1:F1}, Y:{2:F1}, Z:{3:F1})", objName, pt.X, pt.Y, pt.Z)
                    Else
                        MessageBox.Show("Không lấy được tọa độ RangeBox của đối tượng đang chọn.", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information)
                    End If
                Else
                    MessageBox.Show("Chưa có linh kiện nào được chọn trong Inventor." & vbCrLf & vbCrLf & _
                                    "👉 Hướng dẫn:" & vbCrLf & _
                                    "1. Hãy nhấp chọn 1 chi tiết/linh kiện trên Cây mô hình (Model Browser) hoặc trên mô hình." & vbCrLf & _
                                    "2. Sau đó bấm lại nút này để lấy tọa độ làm tâm con lắc.", _
                                    "Chưa chọn linh kiện", MessageBoxButtons.OK, MessageBoxIcon.Information)
                End If
            Catch ex As Exception
                MessageBox.Show("Lỗi lấy chi tiết: " & ex.Message, "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Warning)
            End Try
        End Sub

