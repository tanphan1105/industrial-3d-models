        Dim updateSpeedLabel As Action = Sub()
            Dim durIn As Double = CDbl(numDur.Value)
            Dim spd As Double = CDbl(numSpeed.Value)
            Dim hold As Double = CDbl(numHold.Value)
            Dim flyOut As Boolean = chkFlyOut.Checked
            numDurOut.Enabled = flyOut
            lblDurOut.Enabled = flyOut

            Dim actualIn As Double = durIn / Math.Max(0.05, spd)
            Dim actualOut As Double = If(flyOut, CDbl(numDurOut.Value) / Math.Max(0.05, spd), 0.0)
            Dim totalT As Double = actualIn + hold + actualOut

            If flyOut Then
                lblSpeedInfo.Text = String.Format("▶ Vào: {0:F1}s | Ngắm: {1:F1}s | Ra: {2:F1}s  ➔  Tổng: {3:F1}s ({4:F2}x)", actualIn, hold, actualOut, totalT, spd)
            Else
                lblSpeedInfo.Text = String.Format("▶ Vào: {0:F1}s | Ngắm: {1:F1}s (Dừng Fit View)  ➔  Tổng: {2:F1}s ({3:F2}x)", actualIn, hold, totalT, spd)
            End If
        End Sub

        AddHandler numDur.ValueChanged, Sub(s As Object, e As EventArgs) updateSpeedLabel()
        AddHandler numSpeed.ValueChanged, Sub(s As Object, e As EventArgs) updateSpeedLabel()
        AddHandler numHold.ValueChanged, Sub(s As Object, e As EventArgs) updateSpeedLabel()
        AddHandler chkFlyOut.CheckedChanged, Sub(s As Object, e As EventArgs) updateSpeedLabel()
        AddHandler numDurOut.ValueChanged, Sub(s As Object, e As EventArgs) updateSpeedLabel()
        updateSpeedLabel()

