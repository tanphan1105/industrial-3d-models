        AddHandler btnClose.Click, Sub(s As Object, e As EventArgs)
            form.Close()
        End Sub

        Dim applySettings01 As Action = Sub()
            Select Case cboCorner.SelectedIndex
                Case 1 : s01.CornerMode = "FRONT_RIGHT"
                Case 2 : s01.CornerMode = "BACK_RIGHT"
                Case 3 : s01.CornerMode = "BACK_LEFT"
                Case Else : s01.CornerMode = "FRONT_LEFT"
            End Select

            If radBottom.Checked Then
                s01.ViewAngleMode = "34_BOTTOM"
            ElseIf radLevel.Checked Then
                s01.ViewAngleMode = "34_LEVEL"
            Else
                s01.ViewAngleMode = "34_TOP"
            End If

            s01.DurationSeconds = CDbl(numDur.Value)
            s01.SpeedMultiplier = CDbl(numSpeed.Value)
            s01.StartDistanceScale = CDbl(numDist.Value)
            s01.EndDistanceScale = CDbl(numDistE.Value)
            s01.SwoopCurvature = CDbl(numCurve.Value)
            s01.FOVStart = CDbl(numFovS.Value)
            s01.FOVEnd = CDbl(numFovE.Value)
            s01.BankStart = CDbl(numBankS.Value)
            s01.BankEnd = CDbl(numBankE.Value)
            s01.HoldSeconds = CDbl(numHold.Value)
            s01.EnableFlyOut = chkFlyOut.Checked
            s01.FlyOutDuration = CDbl(numDurOut.Value)
        End Sub

        Dim applySettings02 As Action = Sub()
            Select Case cboCornerS02.SelectedIndex
                Case 1 : s02.CornerStart = "FRONT_LEFT"
                Case 2 : s02.CornerStart = "FRONT_RIGHT"
                Case 3 : s02.CornerStart = "BACK_RIGHT"
                Case 4 : s02.CornerStart = "BACK_LEFT"
                Case Else : s02.CornerStart = "AUTO_C1"
            End Select

            Select Case cboCornerE02.SelectedIndex
                Case 1 : s02.CornerEnd = "FRONT_RIGHT"
                Case 2 : s02.CornerEnd = "BACK_RIGHT"
                Case 3 : s02.CornerEnd = "BACK_LEFT"
                Case Else : s02.CornerEnd = "FRONT_LEFT"
            End Select

            If radBottom02.Checked Then
                s02.ViewAngleModeEnd = "34_BOTTOM"
            ElseIf radLevel02.Checked Then
                s02.ViewAngleModeEnd = "34_LEVEL"
            Else
                s02.ViewAngleModeEnd = "34_TOP"
            End If

            s02.TrajectoryMode = If(radStraight02.Checked, "STRAIGHT", "CURVED")
            s02.SwoopCurvature = CDbl(numCurve02.Value)

            s02.DurationSeconds = CDbl(numDur02.Value)
            s02.SpeedMultiplier = CDbl(numSpeed02.Value)
            s02.StartDistanceScale = CDbl(numDistS02.Value)
            s02.EndDistanceScale = CDbl(numDistE02.Value)
            s02.FOVStart = 50.0
            s02.FOVEnd = 50.0
            Select Case cboEasing02.SelectedIndex
                Case 1 : s02.EasingMode = "EASE_IN"
                Case 2 : s02.EasingMode = "EASE_IN_OUT"
                Case 3 : s02.EasingMode = "LINEAR"
                Case Else : s02.EasingMode = "EASE_OUT"
            End Select
            s02.BankStart = CDbl(numBankS02.Value)
            s02.BankEnd = CDbl(numBankE02.Value)
            s02.HoldSeconds = CDbl(numHold02.Value)
        End Sub

        Dim applySettings03 As Action = Sub()
            Select Case cboTarget03.SelectedIndex
                Case 0 : s03.FocusMode = "CORNER_1"
                Case 1 : s03.FocusMode = "CORNER_2"
                Case 2 : s03.FocusMode = "CORNER_3"
                Case 3 : s03.FocusMode = "CORNER_4"
                Case 4 : s03.FocusMode = "FRONT_FACADE"
                Case 5 : s03.FocusMode = "BACK_FACADE"
                Case 6 : s03.FocusMode = "SKID_CENTER"
                Case 7 : s03.FocusMode = "CUSTOM_PICK"
                Case Else : s03.FocusMode = "CORNER_1"
            End Select

            If radBottom03.Checked Then
                s03.ViewAngleMode = "34_BOTTOM"
            ElseIf radLevel03.Checked Then
                s03.ViewAngleMode = "34_LEVEL"
            Else
                s03.ViewAngleMode = "34_TOP"
            End If

            Select Case cboCycle03.SelectedIndex
                Case 1 : s03.CycleMode = "HALF_CYCLE"
                Case 2 : s03.CycleMode = "2_CYCLES"
                Case Else : s03.CycleMode = "FULL_CYCLE"
            End Select

            s03.SwayPercent = CDbl(numSway03.Value)
            s03.NearDistanceScale = CDbl(numNearDist03.Value)
            s03.FarDistanceScale = CDbl(numFarDist03.Value)

            s03.DurationSeconds = CDbl(numDur03.Value)
            s03.SpeedMultiplier = CDbl(numSpeed03.Value)

            Select Case cboEasing03.SelectedIndex
                Case 1 : s03.EasingMode = "EASE_OUT"
                Case 2 : s03.EasingMode = "EASE_IN"
                Case 3 : s03.EasingMode = "LINEAR"
                Case Else : s03.EasingMode = "EASE_IN_OUT"
            End Select

            s03.BankStart = CDbl(numBankS03.Value)
            s03.BankEnd = CDbl(numBankE03.Value)
            s03.VerticalBobPercent = CDbl(numBob03.Value)
            s03.HoldSeconds = CDbl(numHold03.Value)
        End Sub

        ' Xử lý nút CHẠY THỬ CẢNH ĐANG CHỌN
        AddHandler btnRunTab.Click, Sub(s As Object, e As EventArgs)
            applySettings01()
            applySettings02()
            applySettings03()
            applySettings04()
            applySettings05()

            form.Visible = False
            Try
                Select Case tabStudio.SelectedIndex
                    Case 0
                        ExecuteShot01(oDoc, s01)
                    Case 1
                        ExecuteShot02(oDoc, s02, s01, model)
                    Case 2
                        ExecuteShot03(oDoc, s03, s02, s01, model, heroes)
                    Case 3
                        ExecuteShot04(oDoc, s04, s03, s02, s01, model, heroes)
                    Case 4
                        ExecuteShot05(oDoc, s05, s04, s03, s02, s01, model, heroes)
                    Case Else
                        MessageBox.Show("Vui lòng chọn Cảnh 1 đến Cảnh 5 để chạy thử.", "WT3D WhipCam", MessageBoxButtons.OK, MessageBoxIcon.Information)
                End Select
            Catch ex As Exception
                MessageBox.Show("Lỗi: " & ex.Message, "WhipCam Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Finally
                form.Visible = True
            End Try
        End Sub

        ' Xử lý nút CHẠY GHÉP PHIM (LIÊN HOÀN CÁC CẢNH ĐƯỢC CHỌN)
        AddHandler btnRunMaster.Click, Sub(s As Object, e As EventArgs)
            applySettings01()
            applySettings02()
            applySettings03()
            applySettings04()
            applySettings05()

            ' Khi ghép phim liên hoàn: Cảnh 1 không bay ra xa
            Dim oldFlyOut As Boolean = s01.EnableFlyOut
            s01.EnableFlyOut = False

            form.Visible = False
            Try
                Dim lastEye As Vec3 = Nothing
                Dim lastTarget As Vec3 = Nothing
                Dim lastUp As Vec3 = Nothing
                Dim lastFOV As Double = 50.0

                Dim aborted As Boolean = False

                ' 1. Cảnh 1
                If chkM01.Checked Then
                    If Not ExecuteShot01(oDoc, s01, lastEye, lastTarget, lastUp, lastFOV) Then aborted = True
                End If

                ' 2. Cảnh 2
                If Not aborted AndAlso chkM02.Checked Then
                    Dim nEye As Vec3 = Nothing : Dim nTarget As Vec3 = Nothing : Dim nUp As Vec3 = Nothing : Dim nFOV As Double = 50.0
                    If Not ExecuteShot02(oDoc, s02, s01, model, lastEye, lastTarget, nEye, nTarget, nUp, nFOV) Then aborted = True
                    lastEye = nEye : lastTarget = nTarget : lastUp = nUp : lastFOV = nFOV
                End If

                ' 3. Cảnh 3
                If Not aborted AndAlso chkM03.Checked Then
                    Dim nEye As Vec3 = Nothing : Dim nTarget As Vec3 = Nothing : Dim nUp As Vec3 = Nothing : Dim nFOV As Double = 50.0
                    If Not ExecuteShot03(oDoc, s03, s02, s01, model, heroes, lastEye, lastTarget, nEye, nTarget, nUp, nFOV) Then aborted = True
                    lastEye = nEye : lastTarget = nTarget : lastUp = nUp : lastFOV = nFOV
                End If

                ' 4. Cảnh 4
                If Not aborted AndAlso chkM04.Checked Then
                    Dim nEye As Vec3 = Nothing : Dim nTarget As Vec3 = Nothing : Dim nUp As Vec3 = Nothing : Dim nFOV As Double = 50.0
                    If Not ExecuteShot04(oDoc, s04, s03, s02, s01, model, heroes, lastEye, lastTarget, nEye, nTarget, nUp, nFOV) Then aborted = True
                    lastEye = nEye : lastTarget = nTarget : lastUp = nUp : lastFOV = nFOV
                End If

                ' 5. Cảnh 5
                If Not aborted AndAlso chkM05.Checked Then
                    Dim nEye As Vec3 = Nothing : Dim nTarget As Vec3 = Nothing : Dim nUp As Vec3 = Nothing : Dim nFOV As Double = 50.0
                    ExecuteShot05(oDoc, s05, s04, s03, s02, s01, model, heroes, lastEye, lastTarget, nEye, nTarget, nUp, nFOV)
                End If
            Catch ex As Exception
                MessageBox.Show("Lỗi Ghép Phim: " & ex.Message, "WhipCam Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Finally
                s01.EnableFlyOut = oldFlyOut
                form.Visible = True
            End Try
        End Sub

        ' Hàm lấy định dạng video chuỗi
        Dim getVideoFormatCode As Func(Of String) = Function()
            Select Case cboVideoFormat.SelectedIndex
                Case 0 : Return "native_916"
                Case 1 : Return "tiktok_blur_916"
                Case 2 : Return "widescreen_169"
                Case Else : Return "native_916"
            End Select
        End Function

        ' Hàm lấy FPS số
        Dim getVideoFPS As Func(Of Integer) = Function()
            If cboFPS.SelectedIndex = 1 Then Return 60 Else Return 30
        End Function

        ' Hàm lấy AudioMode
        Dim getVideoAudioMode As Func(Of String) = Function()
            If cboAudioChoice.SelectedIndex = 1 Then Return "none" Else Return "auto"
        End Function

        ' Xử lý nút XUẤT VIDEO TIKTOK CẢNH ĐANG CHỌN
        AddHandler btnExportTab.Click, Sub(s As Object, e As EventArgs)
            applySettings01()
            applySettings02()
            applySettings03()
            applySettings04()
            applySettings05()

            If tabStudio.SelectedIndex > 4 Then
                MessageBox.Show("Vui lòng chọn Cảnh 1 đến Cảnh 5 trước khi bấm xuất video cảnh lẻ.", "WT3D Video Exporter", MessageBoxButtons.OK, MessageBoxIcon.Information)
                Return
            End If

            RunExportPipeline(False, oDoc, s01, s02, s03, s04, s05, model, heroes, _
                              tabStudio.SelectedIndex, chkM01.Checked, chkM02.Checked, chkM03.Checked, chkM04.Checked, chkM05.Checked, _
                              getVideoFormatCode(), getVideoFPS(), getVideoAudioMode(), chkOpenFolder.Checked, chkCleanup.Checked, form)
        End Sub

        ' Xử lý nút XUẤT VIDEO TIKTOK GHÉP MASTER
        AddHandler btnExportMaster.Click, Sub(s As Object, e As EventArgs)
            applySettings01()
            applySettings02()
            applySettings03()
            applySettings04()
            applySettings05()

            If Not (chkM01.Checked OrElse chkM02.Checked OrElse chkM03.Checked OrElse chkM04.Checked OrElse chkM05.Checked) Then
                MessageBox.Show("Vui lòng chọn ít nhất một Cảnh tham gia ghép phim.", "WT3D Video Exporter", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                Return
            End If

            RunExportPipeline(True, oDoc, s01, s02, s03, s04, s05, model, heroes, _
                              tabStudio.SelectedIndex, chkM01.Checked, chkM02.Checked, chkM03.Checked, chkM04.Checked, chkM05.Checked, _
                              getVideoFormatCode(), getVideoFPS(), getVideoAudioMode(), chkOpenFolder.Checked, chkCleanup.Checked, form)
        End Sub

        tabStudio.SelectedIndex = activeTabIndex
        form.ShowDialog()

        If formPendingAction = "INTERACTIVE_PICK" Then
            ' Form đã đóng hoàn toàn, Inventor 100% tự do tương tác
            Dim pickMore As Boolean = True
            Do
                Try
                    oApp.StatusBarText = "WT3D: Bấm chuột vào chi tiết cần soi trên 3D (Nhấn ESC để hoàn tất)..."
                    Dim pickedObj As Object = oApp.CommandManager.Pick(SelectionFilterEnum.kAssemblyLeafOccurrenceFilter, "Bấm chuột vào chi tiết cần soi trong Cảnh 4 (Nhấn ESC để hoàn tất)...")

                    If pickedObj IsNot Nothing Then
                        Dim occ As ComponentOccurrence = TryCast(pickedObj, ComponentOccurrence)
                        If occ IsNot Nothing Then
                            Dim b As Box = occ.RangeBox
                            Dim pt As New Vec3((b.MinPoint.X + b.MaxPoint.X) * 0.5, (b.MinPoint.Y + b.MaxPoint.Y) * 0.5, (b.MinPoint.Z + b.MaxPoint.Z) * 0.5)
                            s04.CustomPickPoints.Add(pt)
                            s04.PointsMode = "CUSTOM_PICK"
                            customPointNames.Add(occ.Name)

                            ' Đồng thời ghi nhận vector hướng nhìn của Camera hiện tại trong Inventor
                            Dim curCamNow As Inventor.Camera = oApp.ActiveView.Camera
                            Dim cEye As New Vec3(curCamNow.Eye.X, curCamNow.Eye.Y, curCamNow.Eye.Z)
                            Dim cTgt As New Vec3(curCamNow.Target.X, curCamNow.Target.Y, curCamNow.Target.Z)
                            Dim appDir As Vec3 = (cEye - cTgt).Normalize()
                            If appDir.Length() < 1E-5 Then appDir = New Vec3(-0.7071, 0.5, -0.7071).Normalize()
                            s04.CustomApproachVectors.Add(appDir)

                            Dim ask As DialogResult = MessageBox.Show(String.Format("✔ Đã lấy: '{0}' (Điểm thứ {1})." & vbCrLf & vbCrLf & "Bạn có muốn click chọn thêm điểm tiếp theo không?", occ.Name, s04.CustomPickPoints.Count), "WT3D Chọn Điểm Thành Công", MessageBoxButtons.YesNo, MessageBoxIcon.Question)
                            If ask = DialogResult.No Then
                                pickMore = False
                            End If
                        Else
                            pickMore = False
                        End If
                    Else
                        pickMore = False
                    End If
                Catch ex As Exception
                    pickMore = False
                End Try
            Loop While pickMore

            ' Tự động lưu vĩnh viễn (Auto-Save)
            If s04.CustomPickPoints.Count > 0 Then
                SavePointsToStorage(oDoc, s04.CustomPickPoints, s04.CustomApproachVectors, customPointNames)
            End If

            oApp.StatusBarText = ""
            formPendingAction = ""
            keepStudioRunning = True
        Else
            keepStudioRunning = False
        End If
    Loop While keepStudioRunning

    End Sub

End Class
